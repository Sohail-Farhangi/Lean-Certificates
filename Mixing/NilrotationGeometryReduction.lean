module

public import Mixing.NilrotationGeometryConnectivity
public import Mixing.NilrotationGeometryDensity
public import Mathlib.Topology.Connected.LocallyConnected

/-! # Reduction to the subgroup generated by time and the identity component -/

@[expose] public section
noncomputable section

namespace Mixing

open Set Topology
open scoped Pointwise

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The subgroup used to realize all components seen by a single nilrotation. -/
def nilrotationComponentSubgroup (a : G) : Subgroup G :=
  Subgroup.connectedComponentOfOne G ⊔ Subgroup.zpowers a

theorem nilrotationComponentSubgroup_open [LocallyConnectedSpace G] (a : G) :
    IsOpen (nilrotationComponentSubgroup a : Set G) :=
  (nilrotationComponentSubgroup a).isOpen_of_mem_nhds <|
    Filter.mem_of_superset (isOpen_connectedComponent.mem_nhds mem_connectedComponent)
      (show (Subgroup.connectedComponentOfOne G : Set G) ⊆ nilrotationComponentSubgroup a from
        fun _ hx ↦ (show Subgroup.connectedComponentOfOne G ≤ nilrotationComponentSubgroup a
          from le_sup_left) hx)

theorem nilrotationComponentSubgroup_contains_time (a : G) : a ∈ nilrotationComponentSubgroup a :=
  (show Subgroup.zpowers a ≤ nilrotationComponentSubgroup a from le_sup_right)
    (Subgroup.mem_zpowers a)

private theorem nilrotationComponentSubgroup_image_identityComponent (a : G) :
    (Subgroup.connectedComponentOfOne (nilrotationComponentSubgroup a)).map
      (nilrotationComponentSubgroup a).subtype = Subgroup.connectedComponentOfOne G := by
  let H := nilrotationComponentSubgroup a
  let C := Subgroup.connectedComponentOfOne G
  let f : C → H := fun x ↦ ⟨x, (show C ≤ H from le_sup_left) x.2⟩
  have hf : Continuous f := continuous_subtype_val.subtype_mk _
  have hone : f 1 = 1 := Subtype.ext rfl
  have hc : ConnectedSpace C := isConnected_iff_connectedSpace.mp isConnected_connectedComponent
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    change (x : G) ∈ connectedComponent ((1 : H) : G)
    exact (continuous_subtype_val.image_connectedComponent_subset (1 : H)) ⟨x, hx, rfl⟩
  · intro x hx
    let y : C := ⟨x, hx⟩
    refine ⟨f y, ?_, rfl⟩
    change f y ∈ connectedComponent (1 : H)
    rw [← hone]
    exact (hf.image_connectedComponent_subset 1)
      ⟨y, by rw [PreconnectedSpace.connectedComponent_eq_univ]; exact mem_univ _, rfl⟩

/-- On the reduced group, the identity component and time generate the entire group. -/
theorem nilrotationComponentSubgroup_generated (a : G) :
    let H := nilrotationComponentSubgroup a
    let t : H := ⟨a, nilrotationComponentSubgroup_contains_time a⟩
    Subgroup.connectedComponentOfOne H ⊔ Subgroup.zpowers t = ⊤ := by
  let H := nilrotationComponentSubgroup a
  let t : H := ⟨a, nilrotationComponentSubgroup_contains_time a⟩
  change Subgroup.connectedComponentOfOne H ⊔ Subgroup.zpowers t = ⊤
  apply Subgroup.map_injective H.subtype_injective
  rw [Subgroup.map_sup, nilrotationComponentSubgroup_image_identityComponent,
    MonoidHom.map_zpowers, Subgroup.map_top, H.range_subtype]
  rfl

theorem nilrotationComponentSubgroup_dense_cosets_surj [LocallyConnectedSpace G]
    (L : Subgroup G) (a d x : G)
    (hd : Dense {x : G | ∃ (n : ℤ) (γ : L), a ^ n * d * (γ : G) = x}) :
    ∃ (h : nilrotationComponentSubgroup a) (γ : L), (h : G) * d * (γ : G) = x := by
  let H := nilrotationComponentSubgroup a
  let U := (fun g : G ↦ g * x) '' (H : Set G)
  have hU : IsOpen U :=
    (Homeomorph.mulRight x).isOpenMap _ (nilrotationComponentSubgroup_open a)
  obtain ⟨_, ⟨n, γ, rfl⟩, h⟩ :=
    hd.exists_mem_open hU ⟨1 * x, mem_image_of_mem _ H.one_mem⟩
  obtain ⟨k, hk, he⟩ := h
  let t : H := ⟨a, nilrotationComponentSubgroup_contains_time a⟩
  refine ⟨⟨k⁻¹ * a ^ n, H.mul_mem (H.inv_mem hk) (H.zpow_mem t.2 n)⟩, γ, ?_⟩
  change k⁻¹ * a ^ n * d * (γ : G) = x
  calc
    _ = k⁻¹ * (a ^ n * d * (γ : G)) := by group
    _ = x := by rw [← he]; group

/-- The orbit map of the open reduced group descends to an equivariant homeomorphism
from its quotient by the stabilizer of the chosen coset. -/
noncomputable def nilrotationComponentSubgroup_homeomorph [LocallyConnectedSpace G]
    (L : Subgroup G) (a d : G)
    (hd : Dense {x : G | ∃ (n : ℤ) (γ : L), a ^ n * d * (γ : G) = x}) :
    nilrotationComponentSubgroup a ⧸
        MulAction.stabilizer (nilrotationComponentSubgroup a) (QuotientGroup.mk d : G ⧸ L) ≃ₜ
      G ⧸ L := by
  let H := nilrotationComponentSubgroup a
  let x : G ⧸ L := QuotientGroup.mk d
  let D := MulAction.stabilizer H x
  let F (h : H) : G ⧸ L := h • x
  let q : H → H ⧸ D := QuotientGroup.mk
  let f : H ⧸ D → G ⧸ L :=
    Quotient.lift F fun h k hk ↦ by
      have he : (h⁻¹ * k) • x = x := QuotientGroup.leftRel_apply.mp hk
      calc
        h • x = h • ((h⁻¹ * k) • x) := congrArg (h • ·) he.symm
        _ = k • x := by rw [← mul_smul, ← mul_assoc, mul_inv_cancel, one_mul]
  have hf (h : H) : f (q h) = h • x := rfl
  have hBij : Function.Bijective f := by
    constructor
    · intro w z hwz
      obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective w
      obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective z
      change f (q h) = f (q k) at hwz
      rw [hf, hf] at hwz
      apply QuotientGroup.eq.mpr
      change (h⁻¹ * k) • x = x
      rw [mul_smul, ← hwz, inv_smul_smul]
    · intro y
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
      obtain ⟨h, γ, hg⟩ := nilrotationComponentSubgroup_dense_cosets_surj L a d g hd
      refine ⟨q h, ?_⟩
      rw [hf, ← hg]
      change QuotientGroup.mk ((h : G) * d) = QuotientGroup.mk ((h : G) * d * (γ : G))
      apply QuotientGroup.eq.mpr
      have he : (((h : G) * d)⁻¹ * ((h : G) * d * (γ : G))) = (γ : G) := by group
      rw [he]
      exact γ.2
  have hF : F = QuotientGroup.mk ∘ (Homeomorph.mulRight d ∘ ((↑) : H → G)) := rfl
  have hFcont : Continuous F := by
    rw [hF]
    exact QuotientGroup.continuous_mk.comp ((Homeomorph.mulRight d).continuous.comp
      continuous_subtype_val)
  have hFopen : IsOpenMap F := by
    rw [hF]
    exact QuotientGroup.isOpenMap_coe.comp ((Homeomorph.mulRight d).isOpenMap.comp
      (nilrotationComponentSubgroup_open a).isOpenEmbedding_subtypeVal.isOpenMap)
  have hq : IsOpenQuotientMap q := QuotientGroup.isOpenQuotientMap_mk
  have hcont : Continuous f := hq.continuous_comp_iff.mp hFcont
  have hopen : IsOpenMap f := by
    intro U hU
    have he : f '' U = F '' (q ⁻¹' U) := by
      calc
        _ = f '' (q '' (q ⁻¹' U)) := by rw [image_preimage_eq U hq.surjective]
        _ = _ := by rw [image_image]; rfl
    rw [he]
    exact hFopen _ (hq.continuous.isOpen_preimage _ hU)
  exact (Equiv.ofBijective f hBij).toHomeomorphOfContinuousOpen hcont hopen

theorem nilrotationComponentSubgroup_homeomorph_smul [LocallyConnectedSpace G]
    (L : Subgroup G) (a d : G)
    (hd : Dense {x : G | ∃ (n : ℤ) (γ : L), a ^ n * d * (γ : G) = x})
    (h : nilrotationComponentSubgroup a)
    (q : nilrotationComponentSubgroup a ⧸
      MulAction.stabilizer (nilrotationComponentSubgroup a) (QuotientGroup.mk d : G ⧸ L)) :
    nilrotationComponentSubgroup_homeomorph L a d hd (h • q) =
      (h : G) • nilrotationComponentSubgroup_homeomorph L a d hd q := by
  obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective q
  change (h * k) • (QuotientGroup.mk d : G ⧸ L) =
    h • (k • (QuotientGroup.mk d : G ⧸ L))
  exact mul_smul h k _

end Mixing
