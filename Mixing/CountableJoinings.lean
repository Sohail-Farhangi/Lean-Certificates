module

public import Mixing.GeneratedSigma

@[expose] public section

namespace Mixing

open MeasureTheory Set

variable {G ι : Type*} [CommGroup G] {X : ι → Type*} [mX : ∀ i, MeasurableSpace (X i)]

/-- A joining of a family of systems is an invariant probability measure on the
product space with the given coordinate marginals. -/
structure IsFamilyJoining (S : ∀ i, System G (X i)) (μ : Measure (∀ i, X i)) : Prop where
  probability : IsProbabilityMeasure μ
  coordinate : ∀ i, MeasurePreserving (fun x : ∀ j, X j ↦ x i) μ (S i).measure
  invariant : ∀ g, MeasurePreserving (fun x i ↦ (S i).act g (x i)) μ μ

variable {S : ∀ i, System G (X i)} {μ : Measure (∀ i, X i)}

def IsFamilyJoining.system (h : IsFamilyJoining S μ) : System G (∀ i, X i) where
  measure := μ
  probability := h.probability
  act g x i := (S i).act g (x i)
  act_one := by
    funext x i
    exact congrFun (S i).act_one (x i)
  act_mul g k := by
    funext x i
    exact congrFun ((S i).act_mul g k) (x i)
  preserves := h.invariant

def IsFamilyJoining.coordinateFactor (h : IsFamilyJoining S μ) (i : ι) :
    FactorMap h.system (S i) :=
  ⟨fun x ↦ x i, h.coordinate i, fun _ ↦ rfl⟩

/-- Lemma 9 in its σ-algebra formulation. A joining of systems generated by
individual ultrafilter families is generated by their union. -/
theorem lemma9_generatedSigma (h : IsFamilyJoining S μ)
    (P : ι → Set (Ultrafilter G))
    (hgen : ∀ i, (S i).generatedSigma (P i) = mX i) :
    h.system.generatedSigma (⋃ i, P i) = (inferInstance : MeasurableSpace (∀ i, X i)) := by
  apply le_antisymm (h.system.generatedSigma_le _)
  have hc (i : ι) :
      @Measurable (∀ i, X i) (X i) (h.system.generatedSigma (⋃ i, P i)) _
        (fun x ↦ x i) := by
    have hi := (h.coordinateFactor i).measurable_generatedSigma (subset_iUnion P i)
    rw [hgen i] at hi
    exact hi
  have hid : @Measurable (∀ i, X i) (∀ i, X i) (h.system.generatedSigma (⋃ i, P i)) _ id :=
    @Measurable.of_eval _ _ _ (h.system.generatedSigma (⋃ i, P i)) _ _ hc
  simpa only [measurable_iff_comap_le, MeasurableSpace.comap_id] using hid

end Mixing
