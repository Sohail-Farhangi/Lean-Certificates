module

public import Mixing.ConditionalCopiesSystem
public import Mixing.StandardGeneratedFactor

@[expose] public section
noncomputable section

namespace Mixing

open Filter MeasureTheory ProbabilityTheory Set
open scoped BigOperators ENNReal ProbabilityTheory Topology

variable {G X Y : Type*} [CommGroup G] [Countable G]
  [MeasurableSpace X] [MeasurableSpace Y] [StandardBorelSpace X] [StandardBorelSpace Y]
  [Nonempty X] [Nonempty Y] {S : System G X} {T : System G Y} {μ : Measure (X × Y)}

namespace IsJoining

/-- The conditional probability of an event in the second coordinate,
viewed as a bounded observable of the first coordinate. -/
def conditionalEventObservable (h : IsJoining S T μ) {B : Set Y} (hB : MeasurableSet B) :
    BoundedObservable X where
  toFun x := (h.conditionalSecond x).real B
  measurable := Complex.continuous_ofReal.measurable.comp
    (h.conditionalSecond.measurable_coe hB).ennreal_toReal
  bound := 1
  bound_nonneg := zero_le_one
  norm_le x := by
    change ‖((h.conditionalSecond x B).toReal : ℂ)‖ ≤ 1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    simpa only [ENNReal.toReal_one] using
      ENNReal.toReal_mono ENNReal.one_ne_top (prob_le_one : h.conditionalSecond x B ≤ 1)

/-- The factor generated by all translates of the conditional probability
of a single event. -/
def conditionalEventSystem (h : IsJoining S T μ) {B : Set Y} (hB : MeasurableSet B) :
    System G (G × ℕ → ℂ) :=
  S.observationSystem fun _ ↦ (h.conditionalEventObservable hB).l2 S.measure

def conditionalEventFactor (h : IsJoining S T μ) {B : Set Y} (hB : MeasurableSet B) :
    FactorMap S (h.conditionalEventSystem hB) :=
  S.observationFactor fun _ ↦ (h.conditionalEventObservable hB).l2 S.measure

/-- The sample limit of event frequencies at all translates of the samples. -/
def conditionalEventSamples (T : System G Y) (B : Set Y) (w : ℕ → Y) (i : G × ℕ) : ℂ :=
  (limsup (fun n ↦ independentSampleMean
    ((T.act i.1 ⁻¹' B).indicator (fun _ ↦ (1 : ℝ))) n w) atTop : ℝ)

omit [Countable G] [StandardBorelSpace Y] [Nonempty Y] in
theorem measurable_conditionalEventSamples (T : System G Y) {B : Set Y}
    (hB : MeasurableSet B) : Measurable (conditionalEventSamples T B) := by
  apply Measurable.of_eval
  intro i
  apply Complex.continuous_ofReal.measurable.comp
  apply Measurable.limsup
  intro n
  unfold independentSampleMean
  exact (Finset.measurable_sum _ fun j _ ↦
    (measurable_const.indicator ((T.preserves i.1).measurable hB)).comp
      (measurable_pi_apply j)).div_const _

/-- The conditional event factor of the first coordinate is also a factor
of the countable joining of conditionally independent second samples. -/
def independentCopiesEventFactor (h : IsJoining S T μ) {B : Set Y} (hB : MeasurableSet B) :
    FactorMap h.independentCopiesSystem (h.conditionalEventSystem hB) where
  toFun := conditionalEventSamples T B
  equivariant g := by
    funext w i
    have he (y : Y) : (T.act i.1 ⁻¹' B).indicator (fun _ ↦ (1 : ℝ)) (T.act g y) =
        (T.act (i.1 * g) ⁻¹' B).indicator (fun _ ↦ (1 : ℝ)) y := by
      rw [T.act_mul]; rfl
    simp only [Function.comp_apply, conditionalEventSystem, System.observationSystem, shiftObservation,
      conditionalEventSamples, independentCopiesSystem, independentSampleMean, he]
  preserves := by
    let K := independentCopies h.conditionalSecond
    let ρ := S.measure ⊗ₘ K
    let f := (h.conditionalEventFactor hB).toFun
    let ψ := conditionalEventSamples T B
    have hf : Measurable f := (h.conditionalEventFactor hB).preserves.measurable
    have hψ : Measurable ψ := measurable_conditionalEventSamples T hB
    have hfst : ρ.fst = S.measure := Measure.fst_compProd S.measure K
    have hae (i : G × ℕ) : ∀ᵐ v ∂ρ, ψ v.2 i = f v.1 i := by
      let b := h.conditionalEventObservable hB
      let d := b.l2 S.measure
      have hObs : f = S.observe (fun _ ↦ d) := rfl
      have hD : ∀ᵐ x ∂S.measure, d (S.act i.1 x) = b (S.act i.1 x) :=
        (S.preserves i.1).quasiMeasurePreserving.ae_eq_comp (b.coe_l2 S.measure)
      apply Measure.ae_compProd_of_ae_ae
      · exact measurableSet_eq_fun (((measurable_pi_apply i).comp hψ).comp measurable_snd)
          (((measurable_pi_apply i).comp hf).comp measurable_fst)
      filter_upwards [h.conditionalSecond_equivariant i.1, hD] with x hx hd
      let C := T.act i.1 ⁻¹' B
      let e : Y → ℝ := C.indicator (fun _ ↦ 1)
      have hC : MeasurableSet C := (T.preserves i.1).measurable hB
      have he : Integrable e (h.conditionalSecond x) := (integrable_const _).indicator hC
      have hμ : (∫ y, e y ∂h.conditionalSecond x) = (h.conditionalSecond (S.act i.1 x)).real B := by
        rw [integral_indicator_const _ hC, smul_eq_mul, mul_one, ← hx]
        unfold Measure.real
        rw [Measure.map_apply (T.preserves i.1).measurable hB]
      filter_upwards [ae_independentSampleMean h.conditionalSecond x e
        (measurable_const.indicator hC) he] with w hw
      rw [hObs]
      change ((limsup (fun n ↦ independentSampleMean e n w) atTop : ℝ) : ℂ) = d (S.act i.1 x)
      rw [hw.limsup_eq, hμ]
      exact hd.symm
    have heq : ψ ∘ Prod.snd =ᵐ[ρ] f ∘ Prod.fst := by
      filter_upwards [ae_all_iff.2 hae] with w hw
      exact funext hw
    refine ⟨hψ, ?_⟩
    change (K ∘ₘ S.measure).map ψ = _
    calc
      _ = ρ.snd.map ψ := by rw [show ρ.snd = K ∘ₘ S.measure from Measure.snd_compProd S.measure K]
      _ = ρ.map (ψ ∘ Prod.snd) := by
        exact Measure.map_map hψ measurable_snd
      _ = ρ.map (f ∘ Prod.fst) := Measure.map_congr heq
      _ = S.measure.map f := by
        rw [← Measure.map_map hf measurable_fst]
        exact congrArg (Measure.map f) hfst
      _ = _ := (h.conditionalEventFactor hB).preserves.map_eq

end IsJoining

end Mixing
