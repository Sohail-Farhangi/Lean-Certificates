module

public import Mixing.CantorSumModes
public import Mixing.GeneratedMultiplier

/-! # The Cantor sum-coordinate factor is not generated by free ultrafilters -/

@[expose] public section

open MeasureTheory Filter
open scoped BigOperators

namespace Mixing

local notation "𝕋" => UnitAddCircle
local notation "𝕐" => ((UnitAddCircle × UnitAddCircle) × UnitAddCircle)
local notation "haar" => (AddCircle.haarAddCircle : Measure 𝕋)

private theorem sumFactor_generatedProducts_subset_base
    (P : Set (Ultrafilter (Multiplicative ℤ)))
    (hP : ∀ p ∈ P, (p : Filter (Multiplicative ℤ)) ≤ cofinite) :
    example6SumSystem.generatedProducts P ⊆ example6BaseLp := by
  rintro _ ⟨n, p, f, hp, rfl⟩
  let T := example6SumSystem
  let hπ : MeasurePreserving (Prod.fst : 𝕐 → 𝕋 × 𝕋) T.measure example6Base :=
    measurePreserving_fst (ν := haar)
  let F (i : Fin n) := T.ultrafilterTranslate (p i) (f i)
  have hmem (i : Fin n) : (F i).l2 T.measure ∈ example6BaseLp := by
    rw [← example6_sum_ultrafilter_range (p i) (hP (p i) (hp i))]
    change (T.ultrafilterTranslate (p i) (f i)).l2 T.measure ∈ _
    rw [T.l2_ultrafilterTranslate]
    exact LinearMap.mem_range_self _ _
  choose u hu using hmem
  let b (i : Fin n) := BoundedObservable.ofLp (u i) (F i).bound (F i).bound_nonneg
  have hBaseAe (i : Fin n) : F i =ᵐ[T.measure] fun x ↦ b i x.1 := by
    have h₁ : (u i ∘ Prod.fst) =ᵐ[T.measure] (F i).l2 T.measure := by
      have h := (Lp.coeFn_compMeasurePreserving (u i) hπ).symm
      change (u i ∘ Prod.fst) =ᵐ[T.measure] example6BaseEmbedding (u i) at h
      exact h.trans (EventuallyEq.of_eq (congrArg
        (fun v : Lp ℂ 2 T.measure ↦ (v : 𝕐 → ℂ)) (hu i)))
    have h₂ := h₁.trans ((F i).coe_l2 T.measure)
    filter_upwards [h₂] with x hx
    change u i x.1 = F i x at hx
    change F i x = if ‖u i x.1‖ ≤ (F i).bound then u i x.1 else 0
    rw [ite_eq_left (by rw [hx]; exact (F i).norm_le x), hx]
  let bprod := BoundedObservable.prod Finset.univ b
  have hProd : T.ultrafilterProduct p f =ᵐ[T.measure] fun x ↦ bprod x.1 := by
    filter_upwards [ae_all_iff.mpr hBaseAe] with x hx
    simp only [System.ultrafilterProduct, BoundedObservable.prod_apply, bprod]
    exact Finset.prod_congr rfl fun i _ ↦ hx i
  refine ⟨bprod.l2 example6Base, Lp.ext ?_⟩
  change Lp.compMeasurePreserving Prod.fst hπ (bprod.l2 example6Base) =ᵐ[T.measure]
    (T.ultrafilterProduct p f).l2 T.measure
  exact (Lp.coeFn_compMeasurePreserving _ hπ).trans
    ((hπ.quasiMeasurePreserving.ae_eq_comp (bprod.coe_l2 example6Base)).trans
      (hProd.symm.trans ((T.ultrafilterProduct p f).coe_l2 T.measure).symm))

/-- The proper sum-coordinate factor in Examples 6 and 7 is not generated by any family of
free ultrafilters. -/
theorem example6_sum_not_isUGenerated (P : Set (Ultrafilter (Multiplicative ℤ)))
    (hP : ∀ p ∈ P, (p : Filter (Multiplicative ℤ)) ≤ cofinite) :
    ¬ example6SumSystem.IsUGenerated P := by
  intro hgen
  have hspan : Submodule.span ℂ (example6SumSystem.generatedProducts P) ≤ example6BaseLp :=
    Submodule.span_le.mpr (sumFactor_generatedProducts_subset_base P hP)
  have hclosure := Submodule.topologicalClosure_minimal _ hspan example6BaseLp_closed
  have htop : (Submodule.span ℂ (example6SumSystem.generatedProducts P)).topologicalClosure =
      ⊤ := by
    apply SetLike.ext'
    rw [Submodule.topologicalClosure_coe, Submodule.top_coe]
    exact hgen.closure_eq
  rw [htop] at hclosure
  exact example6BaseLp_ne_top (le_antisymm le_top hclosure)

/-- Example 7's factor fails to be generated even by the set of all free ultrafilters. -/
theorem example7_sum_factor_not_generated :
    ¬ example6SumSystem.IsUGenerated
      {p : Ultrafilter (Multiplicative ℤ) | (p : Filter (Multiplicative ℤ)) ≤ cofinite} :=
  example6_sum_not_isUGenerated _ fun _ h ↦ h


/-- If all the generating ultrafilter ranges are contained in the pullback from a proper
factor, the source system is not generated by those ultrafilters. -/
theorem FactorMap.not_isUGenerated_of_pullback_range {G X Y : Type*} [CommGroup G]
    [MeasurableSpace X] [MeasurableSpace Y] {T : System G X} {R : System G Y}
    (π : FactorMap T R) (P : Set (Ultrafilter G))
    (hRange : ∀ p ∈ P, (ultrafilterOperator T.koopmanRep p).range ≤
      π.pullback.toLinearMap.range)
    (hProper : π.pullback.toLinearMap.range ≠ ⊤) : ¬ T.IsUGenerated P := by
  intro hgen
  have hsub : T.generatedProducts P ⊆ π.pullback.toLinearMap.range := by
    rintro _ ⟨n, p, f, hp, rfl⟩
    let F (i : Fin n) := T.ultrafilterTranslate (p i) (f i)
    have hmem (i : Fin n) : (F i).l2 T.measure ∈ π.pullback.toLinearMap.range := by
      apply hRange (p i) (hp i)
      change (T.ultrafilterTranslate (p i) (f i)).l2 T.measure ∈ _
      rw [T.l2_ultrafilterTranslate]
      exact LinearMap.mem_range_self _ _
    choose u hu using hmem
    let b (i : Fin n) := BoundedObservable.ofLp (u i) (F i).bound (F i).bound_nonneg
    have hBaseAe (i : Fin n) : F i =ᵐ[T.measure] b i ∘ π.toFun := by
      have h₁ : (u i ∘ π.toFun) =ᵐ[T.measure] (F i).l2 T.measure := by
        have h := (Lp.coeFn_compMeasurePreserving (u i) π.preserves).symm
        change (u i ∘ π.toFun) =ᵐ[T.measure] π.pullback (u i) at h
        exact h.trans (EventuallyEq.of_eq (congrArg
          (fun v : Lp ℂ 2 T.measure ↦ (v : X → ℂ)) (hu i)))
      have h₂ := h₁.trans ((F i).coe_l2 T.measure)
      filter_upwards [h₂] with x hx
      change u i (π.toFun x) = F i x at hx
      change F i x = if ‖u i (π.toFun x)‖ ≤ (F i).bound then u i (π.toFun x) else 0
      rw [ite_eq_left (by rw [hx]; exact (F i).norm_le x), hx]
    let bprod := BoundedObservable.prod Finset.univ b
    have hProd : T.ultrafilterProduct p f =ᵐ[T.measure] bprod ∘ π.toFun := by
      filter_upwards [ae_all_iff.mpr hBaseAe] with x hx
      simp only [System.ultrafilterProduct, BoundedObservable.prod_apply, bprod, Function.comp_apply]
      exact Finset.prod_congr rfl fun i _ ↦ hx i
    refine ⟨bprod.l2 R.measure, Lp.ext ?_⟩
    change Lp.compMeasurePreserving π.toFun π.preserves (bprod.l2 R.measure) =ᵐ[T.measure]
      (T.ultrafilterProduct p f).l2 T.measure
    exact (Lp.coeFn_compMeasurePreserving _ π.preserves).trans
      ((π.preserves.quasiMeasurePreserving.ae_eq_comp (bprod.coe_l2 R.measure)).trans
        (hProd.symm.trans ((T.ultrafilterProduct p f).coe_l2 T.measure).symm))
  have hspan := Submodule.span_le.mpr hsub
  have hclosed : IsClosed (π.pullback.toLinearMap.range : Set (Lp ℂ 2 T.measure)) :=
    π.pullback.isometry.isClosedEmbedding.isClosed_range
  have hclosure := Submodule.topologicalClosure_minimal _ hspan hclosed
  have htop : (Submodule.span ℂ (T.generatedProducts P)).topologicalClosure = ⊤ := by
    apply SetLike.ext'
    rw [Submodule.topologicalClosure_coe, Submodule.top_coe]
    exact hgen.closure_eq
  rw [htop] at hclosure
  exact hProper (le_antisymm le_top hclosure)

end Mixing
