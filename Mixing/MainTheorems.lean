module

public import Mixing.CountableJoinings
public import Mixing.GeneratedDensity
public import Mixing.GeneratedDisjointness
public import Mixing.GenerationAgreement
public import Mixing.StrongMixing

@[expose] public section

namespace Mixing

open Set

universe u

variable {G : Type*} {X : Type u} [CommGroup G] [MeasurableSpace X]

/-- The two formulations of generation used in Sections 4 and 6. -/
theorem System.isUGenerated_iff_generatedSigma_eq (S : System G X) (P : Set (Ultrafilter G)) :
    S.IsUGenerated P ↔ S.generatedSigma P = ‹MeasurableSpace X› :=
  ⟨S.generatedSigma_eq_of_isUGenerated, S.isUGenerated_of_generatedSigma_eq P⟩

/-- Lemma 8. The generated factor is itself generated. -/
theorem lemma8 (S : System G X) (P : Set (Ultrafilter G)) :
    (S.generatedFactor P).IsUGenerated P :=
  (S.generatedFactor P).isUGenerated_of_generatedSigma_eq P (S.generatedSigma_idempotent P)

/-- Lemma 9. A joining is generated by the union of the ultrafilter families of
the joined systems. -/
theorem lemma9 {ι : Type*} {Y : ι → Type*} [∀ i, MeasurableSpace (Y i)]
    {S : ∀ i, System G (Y i)} {μ : MeasureTheory.Measure (∀ i, Y i)}
    (h : IsFamilyJoining S μ) (P : ι → Set (Ultrafilter G))
    (hgen : ∀ i, (S i).IsUGenerated (P i)) : h.system.IsUGenerated (⋃ i, P i) :=
  h.system.isUGenerated_of_generatedSigma_eq _
    (lemma9_generatedSigma h P (fun i ↦ (S i).generatedSigma_eq_of_isUGenerated (hgen i)))

/-- Theorem 1.3(ii) ⇔ (iii). -/
theorem theorem1_3_ii_iii (S : System G X) (P : Set (Ultrafilter G)) :
    (∀ (Y : Type u) [MeasurableSpace Y] (T : System G Y), T.IsUGenerated P → Disjoint S T) ↔
      S.IsUMixing P :=
  ⟨theorem1_3_ii_iii_of_generatedFactor S P (lemma8 S P),
    fun h _ _ T hT ↦ theorem1_3_iii_ii S P h T hT⟩

/-- Theorem 1.3. The two disjointness conditions are equivalent to U-mixing. -/
theorem theorem1_3 (S : System G X) (P : Set (Ultrafilter G)) :
    (S.IsUMixing P ↔
      ∀ (K : Type u) [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
        (V : G →* (K ≃ₗᵢ[ℂ] K)), IsUGenerated V P →
        SpectrallyDisjoint S.koopmanZeroRep V) ∧
    (S.IsUMixing P ↔
      ∀ (Y : Type u) [MeasurableSpace Y] (T : System G Y), T.IsUGenerated P → Disjoint S T) :=
  ⟨theorem1_3_i_iii S P, (theorem1_3_ii_iii S P).symm⟩

/-- Theorem 1.2. Here strongly mixing is expressed on the mean-zero Koopman
representation, and G-generated means generated by the free ultrafilters. -/
theorem theorem1_2 (S : System G X) :
    IsStronglyMixing S.koopmanZeroRep ↔
      ∀ (Y : Type u) [MeasurableSpace Y] (T : System G Y),
        T.IsUGenerated (freeUltrafilters G) → Disjoint S T :=
  (isStronglyMixing_iff_isUMixing_free S.koopmanZeroRep).trans
    (theorem1_3_ii_iii S (freeUltrafilters G)).symm

/-- Corollary 1, including generation and nontriviality of the factor obtained. -/
theorem corollary1 {Y : Type*} [MeasurableSpace Y]
    {S : System G X} {T : System G Y} {P : Set (Ultrafilter G)}
    (hgen : S.IsUGenerated P) (f : FactorMap S T)
    {B : Set Y} (hB : MeasurableSet B) (hB₀ : 0 < T.measure B) (hB₁ : T.measure B < 1) :
    (T.generatedFactor P).IsUGenerated P ∧
      ∃ A : Set (WithSigma (T.generatedSigma P)), MeasurableSet A ∧
        0 < (T.generatedFactor P).measure A ∧ (T.generatedFactor P).measure A < 1 :=
  ⟨lemma8 T P, corollary1_nontrivial hgen f hB hB₀ hB₁⟩

end Mixing
