/-! # Generation of the Cantor skew rotation -/

@[expose] public section

open MeasureTheory Filter

namespace Mixing

local notation "𝕏" => (UnitAddCircle × UnitAddCircle)

private noncomputable def cantorObservable (f : C(𝕏, ℂ)) : BoundedObservable 𝕏 where
  toFun := f
  measurable := f.continuous.measurable
  bound := ‖f‖
  bound_nonneg := norm_nonneg f
  norm_le := f.norm_coe_le_norm

private theorem cantorObservable_l2 (f : C(𝕏, ℂ)) :
    (cantorObservable f).l2 example5CantorSystem.measure =
      ContinuousMap.toLp (E := ℂ) 2 example5CantorSystem.measure ℂ f := by
  exact Lp.ext (((cantorObservable f).coe_l2 example5CantorSystem.measure).trans
    (ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) example5CantorSystem.measure f).symm)

private noncomputable def cantorCharacterPreimage (n : Fin 2 → ℤ) : BoundedObservable 𝕏 :=
  cantorObservable ((cantorFourier ((-(n 1) : ℤ) : ℝ))⁻¹ • circlePairFourier n)

private theorem cantorCharacterPreimage_ae (n : Fin 2 → ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p)
    (hn : cantorFourier ((-(n 1) : ℤ) : ℝ) ≠ 0) :
    example5CantorSystem.ultrafilterTranslate p (cantorCharacterPreimage n) =ᵐ[example5CantorSystem.measure]
      circlePairFourier n := by
  have hv :
      ultrafilterOperator example5CantorSystem.koopmanRep p
        ((cantorCharacterPreimage n).l2 example5CantorSystem.measure) =
          circlePairFourierLp example5CantorSystem.measure n := by
    unfold cantorCharacterPreimage
    rw [cantorObservable_l2, map_smul, map_smul]
    change (cantorFourier ((-(n 1) : ℤ) : ℝ))⁻¹ •
        ultrafilterOperator example5CantorSystem.koopmanRep p
          (circlePairFourierLp example5CantorSystem.measure n) =
      circlePairFourierLp example5CantorSystem.measure n
    rw [example5_cantor_ultrafilter_eigenvector n p hp hsupp, smul_smul, inv_mul_cancel₀ hn, one_smul]
  exact ((example5CantorSystem.ultrafilterTranslate_ae p (cantorCharacterPreimage n)).trans
    (EventuallyEq.of_eq (congrArg (fun f : Lp ℂ 2 example5CantorSystem.measure ↦
      (f : 𝕏 → ℂ)) hv))).trans
    (ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) example5CantorSystem.measure _)

private theorem cantorFrequency_split (b : ℤ) :
    ∃ j k : ℤ, j + k = b ∧ cantorFourier ((-j : ℤ) : ℝ) ≠ 0 ∧
      cantorFourier ((-k : ℤ) : ℝ) ≠ 0 := by
  by_cases hb : b % 2 = 0
  · refine ⟨b - 1, 1, by omega, cantorFourier_ne_zero_of_odd ⟨-(b / 2), by omega⟩,
      cantorFourier_ne_zero_of_odd ⟨-1, by decide⟩⟩
  · refine ⟨b, 0, add_zero _, cantorFourier_ne_zero_of_odd ⟨-(b / 2) - 1, by omega⟩, ?_⟩
    simp

/-- The Cantor skew rotation is generated by each free ultrafilter supported on the powers of
four, as stated in Example 5. -/
theorem example5_cantor_isUGenerated
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    example5CantorSystem.IsUGenerated {p} := by
  have hrange : Set.range (circlePairFourierLp example5CantorSystem.measure) ⊆
      example5CantorSystem.generatedProducts {p} := by
    rintro _ ⟨n, rfl⟩
    obtain ⟨j, k, hjk, hj, hk⟩ := cantorFrequency_split (n 1)
    let a : Fin 2 → ℤ := ![n 0, j]
    let b : Fin 2 → ℤ := ![0, k]
    let f : Fin 2 → BoundedObservable 𝕏 := ![cantorCharacterPreimage a, cantorCharacterPreimage b]
    let w := example5CantorSystem.ultrafilterProduct (fun _ : Fin 2 ↦ p) f
    refine ⟨2, fun _ ↦ p, f, fun _ ↦ rfl, ?_⟩
    change circlePairFourierLp example5CantorSystem.measure n = w.l2 example5CantorSystem.measure
    have hw : w =ᵐ[example5CantorSystem.measure] circlePairFourier n := by
      have ha := cantorCharacterPreimage_ae a p hp hsupp hj
      have hb := cantorCharacterPreimage_ae b p hp hsupp hk
      filter_upwards [ha, hb] with x hax hbx
      dsimp only [w, System.ultrafilterProduct]
      rw [BoundedObservable.prod_apply, Fin.prod_univ_two]
      change example5CantorSystem.ultrafilterTranslate p (cantorCharacterPreimage a) x *
        example5CantorSystem.ultrafilterTranslate p (cantorCharacterPreimage b) x = _
      rw [hax, hbx]
      change (fourier (n 0) x.1 * fourier j x.2) *
        (fourier 0 x.1 * fourier k x.2) = fourier (n 0) x.1 * fourier (n 1) x.2
      rw [fourier_zero, one_mul, mul_assoc, ← fourier_add, hjk]
    exact Lp.ext ((ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2)
      example5CantorSystem.measure (circlePairFourier n)).trans
        ((w.coe_l2 example5CantorSystem.measure).trans hw).symm)
  have hdense : Dense (Submodule.span ℂ (Set.range (circlePairFourierLp
      example5CantorSystem.measure)) : Set (Lp ℂ 2 example5CantorSystem.measure)) := by
    rw [dense_iff_closure_eq, ← Submodule.topologicalClosure_coe, circlePairFourierLp_closure_span,
      Submodule.top_coe]
  exact hdense.mono (Submodule.span_mono hrange)

/-- There is a free ultrafilter supported on the powers of four that generates the
Cantor skew rotation. -/
theorem example5_exists_cantor_generating_ultrafilter :
    ∃ p : Ultrafilter (Multiplicative ℤ),
      (p : Filter (Multiplicative ℤ)) ≤ cofinite ∧
      Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p ∧
      example5CantorSystem.IsUGenerated {p} := by
  let g : ℕ → Multiplicative ℤ := fun j ↦ Multiplicative.ofAdd ((4 : ℤ)^j)
  have hg : Function.Injective g := (pow_right_strictMono₀ (by norm_num : (1 : ℤ) < 4)).injective
  let p := Ultrafilter.of (Filter.map g atTop)
  have hle : (p : Filter (Multiplicative ℤ)) ≤ Filter.map g atTop := Ultrafilter.of_le _
  have hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite :=
    hle.trans (Nat.cofinite_eq_atTop ▸ hg.tendsto_cofinite)
  have hsupp : Set.range g ∈ p :=
    hle (Filter.mem_map.mpr (Filter.Eventually.of_forall Set.mem_range_self))
  exact ⟨p, hp, hsupp, example5_cantor_isUGenerated p hp hsupp⟩


/-- The fibre mode gives a nonzero p-mixing vector in the mean-zero Koopman representation. -/
theorem example5_cantor_meanZero_annihilated_fibre_character
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    ∃ f : meanZero example5CantorSystem.measure, f ≠ 0 ∧
      ultrafilterOperator example5CantorSystem.koopmanZeroRep p f = 0 := by
  let T := example5CantorSystem
  obtain ⟨f, hf, hz⟩ := example5_cantor_annihilated_fibre_character p hp hsupp
  let c := constantOne T.measure
  have hc (g : Multiplicative ℤ) : inner ℂ c (T.koopmanRep g f) = inner ℂ c f := by
    have h := (T.koopmanRep g).inner_map_map c f
    change inner ℂ (T.koopman g (constantOne T.measure)) (T.koopmanRep g f) = _ at h
    rw [T.koopman_constantOne] at h
    exact h
  have hlim := tendsto_ultrafilterOperator_coeff T.koopmanRep p c f
  have hzero : ultrafilterOperator T.koopmanRep p f = 0 := hz
  simp_rw [hc, hzero, inner_zero_right] at hlim
  have hmean : inner ℂ c f = 0 := (tendsto_nhds_unique hlim tendsto_const_nhds).symm
  let v : meanZero T.measure := ⟨f, Submodule.mem_orthogonal_singleton_iff_inner_right.mpr hmean⟩
  let J : meanZero T.measure →L[ℂ] Lp ℂ 2 T.measure := (meanZero T.measure).subtypeL
  have hJ : Intertwines T.koopmanZeroRep T.koopmanRep J := fun _ _ ↦ rfl
  refine ⟨v, fun h ↦ hf (congrArg J h), ?_⟩
  apply Subtype.ext
  change J (ultrafilterOperator T.koopmanZeroRep p v) = 0
  rw [hJ.ultrafilter]
  exact hzero

/-- In particular, the Cantor system's spectrum is not disjoint from all
p-mixing unitary representations. -/
theorem example5_cantor_spectral_obstruction
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    ¬ (∀ (K : Type) [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
      (V : Multiplicative ℤ →* (K ≃ₗᵢ[ℂ] K)), IsUMixing V {p} →
        SpectrallyDisjoint example5CantorSystem.koopmanZeroRep V) := by
  intro h
  let U := example5CantorSystem.koopmanZeroRep
  have hg := isUGenerated_of_spectrallyDisjoint_all_mixing U {p} h
  have hb := (isUGenerated_iff U {p}).mp hg
  obtain ⟨f, hf, hz⟩ := example5_cantor_meanZero_annihilated_fibre_character p hp hsupp
  have hm : f ∈ mixingSubspace U {p} := by
    apply (Submodule.mem_iInf _).mpr
    intro q
    have he : (q : Ultrafilter (Multiplicative ℤ)) = p := Set.mem_singleton_iff.mp q.2
    change ultrafilterOperator U (q : Ultrafilter (Multiplicative ℤ)) f = 0
    rw [he]
    exact hz
  rw [hb, Submodule.mem_bot] at hm
  exact hf hm

open scoped Topology in
/-- The frequency-two spectral coefficients, including every fixed translate, vanish along
the Example 5 ultrafilter. These are the cross-covariances for the associated Gaussian
realization. -/
theorem example5_fibreTwo_fourier_tendsto_zero (a : ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    Tendsto (fun g : Multiplicative ℤ ↦ cantorFourier ((-2 * g.toAdd + a : ℤ) : ℝ))
      (p : Filter (Multiplicative ℤ)) (𝓝 0) := by
  have hi : Function.Injective (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) :=
    (pow_right_strictMono₀ (by norm_num : (1 : ℤ) < 4)).injective
  refine (tendsto_injective_sequence_iff _ hi
    (fun g : Multiplicative ℤ ↦ cantorFourier ((-2 * g.toAdd + a : ℤ) : ℝ)) 0).mp ?_ p hp hsupp
  change Tendsto (fun j : ℕ ↦ cantorFourier ((-2 * (4 : ℤ)^j + a : ℤ) : ℝ)) atTop (𝓝 0)
  have hz : cantorFourier ((-2 : ℤ) : ℝ) = 0 := by
    convert cantorFourier_eq_zero_mod_four_two (-1) using 1
    norm_num
  have hlim := cantorFourier_tendsto_four_pow_add (-2) a
  rw [hz, mul_zero] at hlim
  exact hlim

end Mixing
