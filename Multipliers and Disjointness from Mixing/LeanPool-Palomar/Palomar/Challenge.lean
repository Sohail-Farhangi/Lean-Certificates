module

public import Mathlib.Analysis.CStarAlgebra.Classes
public import Mathlib.Analysis.InnerProductSpace.Basic
public import Mathlib.Dynamics.Ergodic.MeasurePreserving
public import Mathlib.MeasureTheory.Function.L2Space
public import Mathlib.MeasureTheory.Measure.Prod
public import Mathlib.Topology.Compactification.StoneCech

@[expose] public section
noncomputable section

namespace Mixing.Submission

open Filter MeasureTheory Set
open scoped Topology

/-- A probability-preserving action of a discrete group. -/
structure System (G X : Type*) [Group G] [MeasurableSpace X] where
  measure : Measure X
  probability : IsProbabilityMeasure measure
  act : G → X → X
  act_one : act 1 = id
  act_mul : ∀ g h, act (g * h) = act g ∘ act h
  preserves : ∀ g, MeasurePreserving (act g) measure measure

attribute [instance] System.probability

variable {G X Y Z : Type*} [CommGroup G]
  [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]

/-- Invariance for the diagonal action, together with the prescribed marginals. -/
structure IsJoining (S : System G X) (T : System G Y) (μ : Measure (X × Y)) : Prop where
  probability : IsProbabilityMeasure μ
  fst : MeasurePreserving Prod.fst μ S.measure
  snd : MeasurePreserving Prod.snd μ T.measure
  invariant : ∀ g, MeasurePreserving (Prod.map (S.act g) (T.act g)) μ μ

/-- A joining, regarded as a probability-preserving system on the product. -/
def IsJoining.system {S : System G X} {T : System G Y} {μ : Measure (X × Y)}
    (h : IsJoining S T μ) : System G (X × Y) where
  measure := μ
  probability := h.probability
  act g := Prod.map (S.act g) (T.act g)
  act_one := by ext <;> simp [S.act_one, T.act_one]
  act_mul g k := by ext <;> simp [S.act_mul, T.act_mul]
  preserves := h.invariant

/-- Disjoint systems admit only their independent product joining. -/
def Disjoint (S : System G X) (T : System G Y) : Prop :=
  ∀ μ, IsJoining S T μ → μ = S.measure.prod T.measure

/-- Event mixing along every ultrafilter in the given family. -/
def System.IsMixingAlong (S : System G X) (P : Set (Ultrafilter G)) : Prop :=
  ∀ p ∈ P, ∀ A B : Set X, MeasurableSet A → MeasurableSet B →
    Tendsto (fun g ↦ S.measure.real (A ∩ S.act g ⁻¹' B)) (p : Filter G)
      (𝓝 (S.measure.real A * S.measure.real B))

/-- Event mixing as the group element leaves every finite set. -/
def System.IsStronglyMixing (S : System G X) : Prop :=
  ∀ A B : Set X, MeasurableSet A → MeasurableSet B →
    Tendsto (fun g ↦ S.measure.real (A ∩ S.act g ⁻¹' B)) cofinite
      (𝓝 (S.measure.real A * S.measure.real B))

/-- The weak ultrafilter limit of an L² observable, specified by its matrix elements. -/
def System.WeakLimit (S : System G X) (p : Ultrafilter G) (f v : Lp ℂ 2 S.measure) : Prop :=
  ∀ h : Lp ℂ 2 S.measure, Tendsto
    (fun g ↦ inner ℂ h (Lp.compMeasurePreserving (S.act g) (S.preserves g) f))
    (p : Filter G) (𝓝 (inner ℂ h v))

/-- The σ-algebra generated by the weak limits and all measurable null sets. -/
@[instance_reducible]
def System.generatedSigma (S : System G X) (P : Set (Ultrafilter G)) : MeasurableSpace X :=
  MeasurableSpace.generateFrom
    {A | MeasurableSet A ∧ S.measure A = 0 ∨
      ∃ p ∈ P, ∃ f v : Lp ℂ 2 S.measure, S.WeakLimit p f v ∧
        ∃ B : Set ℂ, MeasurableSet B ∧ A = v ⁻¹' B}

/-- A system is generated if the given family recovers its full σ-algebra. -/
def System.IsGenerated (S : System G X) (P : Set (Ultrafilter G)) : Prop :=
  S.generatedSigma P = ‹MeasurableSpace X›

/-- Free ultrafilters contain the cofinite filter. -/
def freeUltrafilters (G : Type*) : Set (Ultrafilter G) := {p | (p : Filter G) ≤ cofinite}

/-- The ordered product of ultrafilters, with the second coordinate taken first. -/
def orderedProduct {A B : Type*} (p : Ultrafilter A) (q : Ultrafilter B) :
    Ultrafilter (A × B) :=
  p.bind (fun a ↦ q.map (fun b ↦ (a, b)))

/-- Theorem 1.2. Strong mixing is dual to disjointness from systems
generated by all free ultrafilters. -/
theorem strongMixing_duality {X₀ : Type u} [MeasurableSpace X₀] (S : System G X₀) :
    S.IsStronglyMixing ↔ ∀ (Y₀ : Type u) [MeasurableSpace Y₀] (T : System G Y₀),
      T.IsGenerated (freeUltrafilters G) → Disjoint S T := by
  sorry

/-- Theorem 5.1. Partial rigidity and partial mixing along the same ultrafilter
force disjointness if the two coefficients sum to more than one. -/
theorem partialRigidity_disjoint
    (T : System G X) (S : System G Y) (p : Ultrafilter G) {a b : ℝ}
    (ha : a ≤ 1) (hb : b ≤ 1) (hsum : 1 < a + b)
    (hRigid : ∀ A : Set X, MeasurableSet A → a * T.measure.real A ≤
      limUnder (p : Filter G) (fun g ↦ T.measure.real (A ∩ T.act g ⁻¹' A)))
    (hMix : ∀ A B : Set Y, MeasurableSet A → MeasurableSet B →
      b * S.measure.real A * S.measure.real B ≤
        limUnder (p : Filter G) (fun g ↦ S.measure.real (A ∩ S.act g ⁻¹' B))) :
    Disjoint T S := by
  sorry

/-- Theorem 6.3. A generated system multiplies the disjointness class of
systems mixing along the specified ultrafilter family. -/
theorem generated_multiplier
    (T : System G X) (S : System G Y) (R : System G Z)
    {μ : Measure (X × Y)} (h : IsJoining T S μ)
    (P : Set (Ultrafilter G)) (hT : T.IsGenerated P) (hR : R.IsMixingAlong P)
    (hdis : Disjoint S R) :
    Disjoint h.system R := by
  sorry

/-- Lemma 10. The two outside ultrafilters collect the coordinates before
and after the coordinate tested by the van der Corput condition. -/
theorem nested_van_der_corput {A B S E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (q : Ultrafilter A) (p : Ultrafilter S) (w : Ultrafilter B)
    (x : A → S → B → E) (y : A → B → E)
    {C D : ℝ} (hx : ∀ a s b, ‖x a s b‖ ≤ C) (hy : ∀ a b, ‖y a b‖ ≤ D)
    (hc : Tendsto (fun v : A × ((S × S) × B) ↦
        inner ℂ (x v.1 v.2.1.1 v.2.2) (x v.1 v.2.1.2 v.2.2))
      (orderedProduct q (orderedProduct (orderedProduct p p) w) : Filter _) (𝓝 0)) :
    Tendsto (fun v : A × (S × B) ↦ inner ℂ (y v.1 v.2.2) (x v.1 v.2.1 v.2.2))
      (orderedProduct q (orderedProduct p w) : Filter _) (𝓝 0) := by
  sorry

end Mixing.Submission
