module

public import Mixing.SupportingJdLG.FolnerMeasuredMeans

/-!
# Følner and Banach densities on measured semigroups

The limsup and liminf of the normalized block masses are both masses
assigned by left-invariant means generated by the same net. Their bounds
by the upper and lower Banach densities therefore hold for every left
Følner net of compact blocks.
-/

@[expose] public section

open Filter MeasureTheory Set
open scoped ENNReal Topology

namespace Mixing.JdLGBridge

variable {S I : Type*} [Semigroup S] [MeasurableSpace S] {μ : Measure S}

omit [Semigroup S] in
/-- The normalized restriction evaluates measurable sets by the real
measure ratio used in the definitions of the Følner densities. -/
theorem normalizedRestrictedMeasure_real_eq_div (μ : Measure S) (F : Set S)
    {A : Set S} (hA : MeasurableSet A) :
    (normalizedRestrictedMeasure μ F).real A = (μ.real (A ∩ F)) / (μ.real F) := by
  rw [Measure.real, normalizedRestrictedMeasure, smul_apply,
    Measure.restrict_apply hA, smul_eq_mul, ENNReal.toReal_mul, ENNReal.toReal_inv]
  exact mul_comm _ _

/-- Upper left Banach density defined as the supremum of indicator masses
over the left-invariant means on L∞. -/
noncomputable def MeasuredMean.upperBanachDensity (μ : Measure S) (A : Set S)
    (hA : MeasurableSet A) : ℝ :=
  sSup {r : ℝ | ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = r}

/-- A cluster value of the mass of a measurable set along a left Følner net
is its mass for a generated left-invariant mean. -/
theorem exists_generatedLeftMean_mass_eq_clusterPoint
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) {a : ℝ}
    (ha : MapClusterPt a l (fun i ↦ (normalizedRestrictedMeasure μ (F i)).real A)) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = a ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  let ν (i : I) := normalizedRestrictedMeasure μ (F i)
  have hp (i : I) : IsProbabilityMeasure (ν i) :=
    normalizedRestrictedMeasure_probability μ (hpos i) (hfin i)
  have hac (i : I) : ν i ≪ μ := normalizedRestrictedMeasure_absolutelyContinuous μ (F i)
  obtain ⟨q, hq, ht⟩ := mapClusterPt_iff_ultrafilter.1 ha
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter ν hp hac q
  have hg : m.IsGeneratedBy ν l := ⟨q, hq, hm⟩
  refine ⟨m, hg.leftInvariant hac hns hν, ?_, hg⟩
  refine tendsto_nhds_unique (hm _ (MeasuredMean.memLp_indicator_one hA)) (ht.congr' ?_)
  exact Eventually.of_forall fun i ↦ by
    change (ν i).real A = ∫ s, A.indicator (fun _ ↦ (1 : ℝ)) s ∂ν i
    rw [integral_indicator hA, setIntegral_const, smul_eq_mul, mul_one]

section CompactBlocks

variable [TopologicalSpace S] [IsFiniteMeasureOnCompacts μ]

/-- The lower and upper densities of a measurable set along a left Følner
net of compact blocks are realized by generated invariant means. -/
theorem exists_generatedLeftMeans_mass_eq_folner_densities
    (F : I → Set S) (hF : ∀ i, IsCompact (F i)) (hpos : ∀ i, μ (F i) ≠ 0)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) :
    let d (i : I) := (μ.real (A ∩ F i)) / (μ.real (F i))
    (∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = liminf d l ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) ∧
    (∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = limsup d l ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) := by
  dsimp only
  simp_rw [← normalizedRestrictedMeasure_real_eq_div μ _ hA]
  let ν (i : I) := normalizedRestrictedMeasure μ (F i)
  let d (i : I) := (ν i).real A
  have hfin (i : I) : μ (F i) ≠ ∞ := (hF i).measure_ne_top
  have hd₁ (i : I) : d i ≤ 1 := by
    let : IsProbabilityMeasure (ν i) := normalizedRestrictedMeasure_probability μ (hpos i) (hfin i)
    exact measureReal_le_one
  have hd₀ (i : I) : 0 ≤ d i := measureReal_nonneg
  have hu : IsBoundedUnder (· ≤ ·) l d :=
    ⟨1, show ∀ᶠ i in l, d i ≤ 1 from Eventually.of_forall hd₁⟩
  have hl : IsBoundedUnder (· ≥ ·) l d :=
    ⟨0, show ∀ᶠ i in l, 0 ≤ d i from Eventually.of_forall hd₀⟩
  exact ⟨exists_generatedLeftMean_mass_eq_clusterPoint F hpos hfin hns hν hA
      (MapClusterPt.liminf hu.isCoboundedUnder_ge hl),
    exists_generatedLeftMean_mass_eq_clusterPoint F hpos hfin hns hν hA
      (MapClusterPt.limsup hl.isCoboundedUnder_le hu)⟩

/-- The lower left Banach density bounds the lower density along each
left Følner net from below, and the upper left Banach density bounds its
upper density from above. -/
theorem folnerBlock_densities_compare_Banach
    (F : I → Set S) (hF : ∀ i, IsCompact (F i)) (hpos : ∀ i, μ (F i) ≠ 0)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) :
    let d (i : I) := (μ.real (A ∩ F i)) / (μ.real (F i))
    MeasuredMean.lowerBanachDensity (measure := μ) A hA ≤ liminf d l ∧
      limsup d l ≤ MeasuredMean.upperBanachDensity μ A hA := by
  dsimp only
  obtain ⟨⟨m, hm, hml, _⟩, n, hn, hnu, _⟩ :=
    exists_generatedLeftMeans_mass_eq_folner_densities F hF hpos hns hν hA
  constructor
  · rw [← hml, MeasuredMean.lowerBanachDensity]
    exact csInf_le ⟨0, fun _ ⟨k, _, hk⟩ ↦ hk ▸ k.mass_nonneg hA⟩ ⟨m, hm, rfl⟩
  · rw [← hnu, MeasuredMean.upperBanachDensity]
    exact le_csSup ⟨1, fun _ ⟨k, _, hk⟩ ↦ hk ▸ k.mass_le_one hA⟩ ⟨n, hn, rfl⟩

end CompactBlocks

universe u

variable [TopologicalSpace S]

/-- A compact left Følner net on the underlying measured semigroup.
The index filter is proper and each block has positive measure. -/
structure CompactLeftFolnerNet (μ : Measure S) (I : Type u) where
  indexFilter : Filter I
  proper : NeBot indexFilter
  block : I → Set S
  isCompact : ∀ i, IsCompact (block i)
  measure_ne_zero : ∀ i, μ (block i) ≠ 0
  folner : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (block i)) indexFilter

/-- Lower left Følner density as the infimum of lower densities over all
left Følner nets in the indicated universe of index types. -/
noncomputable def lowerFolnerDensity (μ : Measure S) (A : Set S) : ℝ :=
  ⨅ N : (Σ I : Type u, CompactLeftFolnerNet μ I),
    liminf (fun i ↦ (μ.real (A ∩ N.2.block i)) / μ.real (N.2.block i)) N.2.indexFilter

/-- Upper left Følner density as the supremum of upper densities over all
left Følner nets in the indicated universe of index types. -/
noncomputable def upperFolnerDensity (μ : Measure S) (A : Set S) : ℝ :=
  ⨆ N : (Σ I : Type u, CompactLeftFolnerNet μ I),
    limsup (fun i ↦ (μ.real (A ∩ N.2.block i)) / μ.real (N.2.block i)) N.2.indexFilter

/-- The comparison between Følner and Banach densities in Section 2.3,
with the Følner densities taken over every compact left Følner net. -/
theorem folner_densities_compare_Banach [IsFiniteMeasureOnCompacts μ]
    [Nonempty (Σ I : Type u, CompactLeftFolnerNet μ I)]
    (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    {A : Set S} (hA : MeasurableSet A) :
    MeasuredMean.lowerBanachDensity (measure := μ) A hA ≤ lowerFolnerDensity.{u} μ A ∧
      upperFolnerDensity.{u} μ A ≤ MeasuredMean.upperBanachDensity μ A hA := by
  have h (N : Σ I : Type u, CompactLeftFolnerNet μ I) :=
    @folnerBlock_densities_compare_Banach _ N.1 _ _ μ _ _ N.2.block N.2.isCompact
      N.2.measure_ne_zero N.2.indexFilter N.2.proper hns N.2.folner A hA
  exact ⟨le_ciInf fun N ↦ (h N).1, ciSup_le fun N ↦ (h N).2⟩

end Mixing.JdLGBridge
