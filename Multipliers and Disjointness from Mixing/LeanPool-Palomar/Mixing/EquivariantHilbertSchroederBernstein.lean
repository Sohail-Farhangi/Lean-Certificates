module

public import Mixing.SpectralDisjointness

/-! # Schröder–Bernstein for unitary representations -/

@[expose] public section
noncomputable section

namespace Mixing

open scoped InnerProductSpace

variable {G H K : Type*} [Group G]
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

omit [CompleteSpace H] in
private theorem unitary_orthogonal_preserves (U : G →* (H ≃ₗᵢ[ℂ] H))
    (W : Submodule ℂ H) (hW : ∀ g x, x ∈ W → U g x ∈ W) :
    ∀ g x, x ∈ Wᗮ → U g x ∈ Wᗮ := by
  intro g x hx
  rw [Submodule.mem_orthogonal] at hx ⊢
  intro y hy
  have hg : U g (U g⁻¹ y) = y := by
    change (U g * U g⁻¹) y = y
    rw [← map_mul, mul_inv_cancel, map_one]
    rfl
  calc
    ⟪y, U g x⟫_ℂ = ⟪U g (U g⁻¹ y), U g x⟫_ℂ := by rw [hg]
    _ = ⟪U g⁻¹ y, x⟫_ℂ := (U g).toLinearIsometry.inner_map_map _ _
    _ = 0 := hx _ (hW _ _ hy)

omit [CompleteSpace H] in
private theorem unitary_starProjection_commutes (U : G →* (H ≃ₗᵢ[ℂ] H))
    (W : Submodule ℂ H) [W.HasOrthogonalProjection] (hW : ∀ g x, x ∈ W → U g x ∈ W)
    (g : G) (x : H) : W.starProjection (U g x) = U g (W.starProjection x) := by
  apply W.eq_starProjection_of_mem_orthogonal (hW g _ (W.starProjection_apply_mem x))
  rw [← map_sub]
  exact unitary_orthogonal_preserves U W hW g _ (W.sub_starProjection_mem_orthogonal x)

/-- Two unitary representations that embed isometrically and equivariantly into each
other are unitarily equivalent. -/
theorem equivariant_hilbert_schroeder_bernstein
    (U : G →* (H ≃ₗᵢ[ℂ] H)) (V : G →* (K ≃ₗᵢ[ℂ] K))
    (J : H →ₗᵢ[ℂ] K) (I : K →ₗᵢ[ℂ] H)
    (hJ : Intertwines U V J.toContinuousLinearMap)
    (hI : Intertwines V U I.toContinuousLinearMap) :
    ∃ F : H ≃ₗᵢ[ℂ] K, Intertwines U V F.toLinearIsometry.toContinuousLinearMap := by
  let R := LinearMap.range I.toLinearMap
  let P := Rᗮ
  let E := I.comp J
  -- The closed span generated by repeated applications of E to the complement of R.
  let Dn (n : ℕ) := P.map (E.toLinearMap ^ n)
  let D := ⨆ n, Dn n
  let W := D.topologicalClosure
  let M := W.map E.toLinearMap
  have hRclosed : IsClosed (R : Set H) := I.isometry.isClosedEmbedding.isClosed_range
  have hWclosed : IsClosed (W : Set H) := D.isClosed_topologicalClosure
  have hMclosed : IsClosed (M : Set H) :=
    E.isometry.isClosedEmbedding.isClosedMap (W : Set H) hWclosed
  let : CompleteSpace R := hRclosed.completeSpace_coe
  let : CompleteSpace W := hWclosed.completeSpace_coe
  let : CompleteSpace M := hMclosed.completeSpace_coe
  have hDnW (n : ℕ) : Dn n ≤ W := (le_iSup Dn n).trans D.le_topologicalClosure
  have hPn : Dn 0 = P := by
    change P.map (LinearMap.id : H →ₗ[ℂ] H) = P
    exact Submodule.map_id _
  have hPW : P ≤ W := hPn ▸ hDnW 0
  have hWperpR : Wᗮ ≤ R := by
    rw [← R.orthogonal_orthogonal]
    exact Submodule.orthogonal_le hPW
  have hStep (n : ℕ) : Dn (n + 1) = (Dn n).map E.toLinearMap := by
    simp only [Dn, pow_succ']
    exact Submodule.map_comp (E.toLinearMap ^ n) E.toLinearMap P
  have hMR : M ≤ R := by
    rintro _ ⟨w, _, rfl⟩
    exact ⟨J w, rfl⟩
  have hMW : M ≤ W := by
    apply Submodule.map_le_iff_le_comap.mpr
    apply D.topologicalClosure_minimal _ (hWclosed.preimage E.continuous)
    apply iSup_le
    intro n
    apply Submodule.map_le_iff_le_comap.mp
    simpa only [← hStep] using hDnW (n + 1)
  have hPerp (y : H) (hy : y ∈ R) (hyM : y ∈ Mᗮ) : y ∈ Wᗮ := by
    change y ∈ D.topologicalClosureᗮ
    rw [Submodule.orthogonal_closure, ← Submodule.iInf_orthogonal, Submodule.mem_iInf]
    intro n
    cases n with
    | zero =>
      rw [hPn]
      exact R.le_orthogonal_orthogonal hy
    | succ n =>
      have hle : Dn (n + 1) ≤ M := by
        rw [hStep]
        exact Submodule.map_mono (hDnW n)
      exact Submodule.orthogonal_le hle hyM
  have hRinv : ∀ g x, x ∈ R → U g x ∈ R := by
    rintro g _ ⟨y, rfl⟩
    exact ⟨V g y, hI g y⟩
  have hPinv := unitary_orthogonal_preserves U R hRinv
  have hEcomm (g : G) : Commute (U g).toLinearMap E.toLinearMap := by
    apply LinearMap.ext
    intro x
    change U g (I (J x)) = I (J (U g x))
    rw [show J (U g x) = V g (J x) from hJ g x]
    exact (hI g (J x)).symm
  have hWinv (g : G) : ∀ x, x ∈ W → U g x ∈ W := by
    have hle : W ≤ W.comap (U g).toLinearMap := by
      apply D.topologicalClosure_minimal _ (hWclosed.preimage (U g).continuous)
      apply iSup_le
      intro n
      rintro _ ⟨y, hy, rfl⟩
      have hc := (hEcomm g).pow_right n
      have hm : U g ((E.toLinearMap ^ n) y) = (E.toLinearMap ^ n) (U g y) :=
        congrArg (fun f : H →ₗ[ℂ] H ↦ f y) hc.eq
      change U g ((E.toLinearMap ^ n) y) ∈ W
      rw [hm]
      exact hDnW n ⟨U g y, hPinv g y hy, rfl⟩
    exact fun _ hx ↦ hle hx
  have hWperpinv := unitary_orthogonal_preserves U W hWinv
  let A : H →L[ℂ] K := J.toContinuousLinearMap.comp W.starProjection +
    I.toContinuousLinearMap.adjoint.comp Wᗮ.starProjection
  have hLeftInv (z : K) : I.toContinuousLinearMap.adjoint (I z) = z :=
    DFunLike.congr_fun I.adjoint_comp_self z
  have hRightInv (x : H) (hx : x ∈ R) : I (I.toContinuousLinearMap.adjoint x) = x := by
    obtain ⟨z, rfl⟩ := hx
    change I (I.toContinuousLinearMap.adjoint (I z)) = I z
    rw [hLeftInv]
  have hIA (x : H) : I (A x) = E (W.starProjection x) + Wᗮ.starProjection x := by
    change I (J (W.starProjection x) + I.toContinuousLinearMap.adjoint (Wᗮ.starProjection x)) = _
    rw [map_add, hRightInv _ (hWperpR (Wᗮ.starProjection_apply_mem x))]
    rfl
  have hNorm (x : H) : ‖A x‖ = ‖x‖ := by
    have hProjected : W.starProjection x + Wᗮ.starProjection x = x :=
      W.starProjection_add_starProjection_orthogonal x
    have hIn : W.starProjection x ∈ W := W.starProjection_apply_mem x
    have hIn' : E (W.starProjection x) ∈ W := hMW ⟨_, hIn, rfl⟩
    have hOut : Wᗮ.starProjection x ∈ Wᗮ := Wᗮ.starProjection_apply_mem x
    rw [← I.norm_map (A x), hIA, ← sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _), pow_two, pow_two]
    rw [norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _
      (Submodule.inner_right_of_mem_orthogonal hIn' hOut), E.norm_map]
    rw [← norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _
      (Submodule.inner_right_of_mem_orthogonal hIn hOut), hProjected]
  have hSurj : Function.Surjective A := by
    intro z
    let y := I z
    -- The residual component of y after projection onto E(W) belongs to Wᗮ.
    obtain ⟨w, hw, he⟩ : M.starProjection y ∈ W.map E.toLinearMap :=
      M.starProjection_apply_mem y
    let r := y - E w
    have hy : y ∈ R := ⟨z, rfl⟩
    have hrR : r ∈ R := R.sub_mem hy (hMR ⟨w, hw, rfl⟩)
    have hrM : r ∈ Mᗮ := by
      change y - E w ∈ Mᗮ
      rw [show E w = M.starProjection y from he]
      exact M.sub_starProjection_mem_orthogonal y
    have hrW := hPerp r hrR hrM
    have hwProj : W.starProjection (w + r) = w := by
      apply W.eq_starProjection_of_mem_orthogonal hw
      rwa [add_sub_cancel_left]
    have hrProj : Wᗮ.starProjection (w + r) = r := by
      apply Wᗮ.eq_starProjection_of_mem_orthogonal hrW
      rwa [W.orthogonal_orthogonal, add_sub_cancel_right]
    refine ⟨w + r, I.injective ?_⟩
    rw [hIA, hwProj, hrProj]
    exact add_sub_cancel _ _
  let F : H →ₗᵢ[ℂ] K := ⟨A.toLinearMap, hNorm⟩
  refine ⟨LinearIsometryEquiv.ofSurjective F hSurj, ?_⟩
  intro g x
  change A (U g x) = V g (A x)
  change J.toContinuousLinearMap (W.starProjection (U g x)) +
    I.toContinuousLinearMap.adjoint (Wᗮ.starProjection (U g x)) =
    V g (J.toContinuousLinearMap (W.starProjection x) +
      I.toContinuousLinearMap.adjoint (Wᗮ.starProjection x))
  rw [unitary_starProjection_commutes U W hWinv, unitary_starProjection_commutes U Wᗮ hWperpinv,
    hJ, hI.adjoint, map_add]

end Mixing
