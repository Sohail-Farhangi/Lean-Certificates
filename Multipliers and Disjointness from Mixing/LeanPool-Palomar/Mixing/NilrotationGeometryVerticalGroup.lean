module

public import Mixing.NilrotationGeometryCompactQuotient
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Tactic.Group

/-! # The compact central action on a compact homogeneous quotient -/

@[expose] public section
noncomputable section

namespace Mixing

open Set Topology
open scoped Pointwise commutatorElement

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

theorem nilrotation_closed_normalizer (L : Subgroup G) (hL : IsClosed (L : Set G)) :
    IsClosed (Subgroup.normalizer (L : Set G) : Set G) := by
  have he : (Subgroup.normalizer (L : Set G) : Set G) = ⋂ l : L,
      {g | g * (l : G) * g⁻¹ ∈ L} ∩ {g | g⁻¹ * (l : G) * g ∈ L} := by
    ext g
    simp only [mem_iInter, mem_inter_iff, mem_ofPred_eq]
    constructor
    · intro hg l
      exact ⟨((Subgroup.mem_normalizer_iff.mp hg) l).mp l.2,
        ((Subgroup.mem_normalizer_iff''.mp hg) l).mp l.2⟩
    · intro hg
      apply Subgroup.mem_normalizer_iff.mpr
      intro l
      constructor
      · intro hl
        exact (hg ⟨l, hl⟩).1
      · intro hl
        have hh := (hg ⟨_, hl⟩).2
        change g⁻¹ * (g * l * g⁻¹) * g ∈ L at hh
        have hform : g⁻¹ * (g * l * g⁻¹) * g = l := by group
        rwa [hform] at hh
  rw [he]
  exact isClosed_iInter fun l ↦ (hL.preimage ((continuous_id.mul continuous_const).mul
    continuous_inv)).inter (hL.preimage ((continuous_inv.mul continuous_const).mul continuous_id))

/-- Closure of the group generated by the central subgroup and the lattice. -/
def nilrotationVerticalClosure (C L : Subgroup G) : Subgroup G :=
  (C ⊔ L).topologicalClosure

theorem nilrotation_lattice_le_verticalClosure (C L : Subgroup G) :
    L ≤ nilrotationVerticalClosure C L :=
  le_sup_right.trans (Subgroup.le_topologicalClosure _)

theorem nilrotation_centre_le_verticalClosure (C L : Subgroup G) :
    C ≤ nilrotationVerticalClosure C L :=
  le_sup_left.trans (Subgroup.le_topologicalClosure _)

theorem nilrotation_verticalClosure_le_normalizer (C L : Subgroup G)
    (hC : C ≤ Subgroup.center G) (hL : IsClosed (L : Set G)) :
    nilrotationVerticalClosure C L ≤ Subgroup.normalizer (L : Set G) := by
  apply Subgroup.topologicalClosure_minimal
  · apply sup_le _ L.le_normalizer
    intro c hc
    apply Subgroup.mem_normalizer_iff.mpr
    intro l
    rw [((Subgroup.mem_center_iff.mp (hC hc)) l).symm, mul_assoc, mul_inv_cancel, mul_one]
  · exact nilrotation_closed_normalizer L hL

/-- The lattice remains normal inside the closure of its product with the centre. -/
theorem nilrotation_verticalLattice_normal (C L : Subgroup G)
    (hC : C ≤ Subgroup.center G) (hL : IsClosed (L : Set G)) :
    (L.subgroupOf (nilrotationVerticalClosure C L)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer (nilrotation_verticalClosure_le_normalizer C L hC hL)

/-- Normality for the vertical group only requires centrality modulo the
stabilizer. -/
theorem nilrotation_verticalLattice_normal_of_commutator_le (C L : Subgroup G)
    (hC : ⁅C, (⊤ : Subgroup G)⁆ ≤ L) (hL : IsClosed (L : Set G)) :
    (L.subgroupOf (nilrotationVerticalClosure C L)).Normal := by
  apply Subgroup.normal_subgroupOf_of_le_normalizer
  apply Subgroup.topologicalClosure_minimal _ _ (nilrotation_closed_normalizer L hL)
  apply sup_le _ Subgroup.le_normalizer
  rw [Subgroup.le_normalizer_iff_commutator_le_right]
  exact (Subgroup.commutator_mono_right le_top).trans hC

/-- The central compact group reached by closing the central translations on the
homogeneous quotient. This construction does not assume that their image is closed. -/
abbrev NilrotationVerticalGroup (C L : Subgroup G) :=
  nilrotationVerticalClosure C L ⧸ L.subgroupOf (nilrotationVerticalClosure C L)

theorem nilrotation_verticalGroup_compactSpace (C L : Subgroup G) [CompactSpace (G ⧸ L)] :
    CompactSpace (NilrotationVerticalGroup C L) :=
  compactSpace_subgroup_quotient_of_closed _ _ (nilrotation_lattice_le_verticalClosure C L)
    (Subgroup.isClosed_topologicalClosure _)

/-- The natural continuous homomorphism from the central subgroup to the vertical group. -/
def nilrotation_verticalImage (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    C →* NilrotationVerticalGroup C L :=
  (QuotientGroup.mk' _).comp (Subgroup.inclusion (nilrotation_centre_le_verticalClosure C L))

theorem nilrotation_continuous_verticalImage (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    Continuous (nilrotation_verticalImage C L) :=
  QuotientGroup.continuous_mk.comp (continuous_subtype_val.subtype_mk _)

theorem nilrotation_denseRange_verticalImage (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    DenseRange (nilrotation_verticalImage C L) := by
  let H := nilrotationVerticalClosure C L
  let D := L.subgroupOf H
  let q : H →* H ⧸ D := QuotientGroup.mk' _
  have hd : Dense ((C ⊔ L).subgroupOf H : Set H) := by
    intro h
    rw [closure_subtype]
    have he : ((↑) : H → G) '' ((C ⊔ L).subgroupOf H : Set H) = ((C ⊔ L : Subgroup G) : Set G) := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        exact ⟨⟨x, Subgroup.le_topologicalClosure _ hx⟩, hx, rfl⟩
    rw [he]
    exact h.2
  have hi : Dense (q '' ((C ⊔ L).subgroupOf H : Set H)) :=
    (QuotientGroup.mk_surjective (s := D)).denseRange.dense_image QuotientGroup.continuous_mk hd
  refine hi.mono ?_
  rintro _ ⟨h, hh, rfl⟩
  have hc : C ≤ Subgroup.normalizer (L : Set G) :=
    (nilrotation_centre_le_verticalClosure C L).trans
      (Subgroup.le_normalizer_of_normal_subgroupOf (nilrotation_lattice_le_verticalClosure C L))
  have hprod : (h : G) ∈ (C : Set G) * (L : Set G) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right C L hc]
    exact hh
  obtain ⟨c, hc, l, hl, he⟩ := Set.mem_mul.mp hprod
  refine ⟨⟨c, hc⟩, ?_⟩
  change q ⟨c, nilrotation_centre_le_verticalClosure C L hc⟩ = q h
  apply QuotientGroup.eq.mpr
  change c⁻¹ * (h : G) ∈ L
  rw [← he, ← mul_assoc, inv_mul_cancel, one_mul]
  exact hl

/-- Centrality modulo the stabilizer gives an abelian compact fibre group. -/
@[instance_reducible] def nilrotationVerticalCommGroup (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    [T2Space (NilrotationVerticalGroup C L)] (hC : ⁅C, (⊤ : Subgroup G)⁆ ≤ L) :
    CommGroup (NilrotationVerticalGroup C L) where
  toGroup := inferInstance
  mul_comm v w := by
    let q := nilrotation_verticalImage C L
    have hd := nilrotation_denseRange_verticalImage C L
    have hc (c d : C) : q c * q d = q d * q c := by
      apply commutatorElement_eq_one_iff_mul_comm.mp
      rw [← map_commutatorElement q]
      apply (QuotientGroup.eq_one_iff _).mpr
      change ⁅(c : G), (d : G)⁆ ∈ L
      exact hC (Subgroup.commutator_mem_commutator c.2 (Subgroup.mem_top _))
    have hclosed : IsClosed {p : NilrotationVerticalGroup C L × NilrotationVerticalGroup C L |
        p.1 * p.2 = p.2 * p.1} :=
      isClosed_eq (continuous_fst.mul continuous_snd) (continuous_snd.mul continuous_fst)
    exact (hd.prodMap hd).induction_on (p := fun p ↦ p.1 * p.2 = p.2 * p.1)
      (v, w) hclosed fun p ↦ hc p.1 p.2

/-- Right translation by the inverse representative of a vertical coset. -/
def nilrotationVerticalTranslate (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    NilrotationVerticalGroup C L → G ⧸ L → G ⧸ L := by
  let H := nilrotationVerticalClosure C L
  let D := L.subgroupOf H
  intro v x
  refine Quotient.liftOn₂ v x (fun h g ↦ QuotientGroup.mk (g * (h : G)⁻¹)) ?_
  intro h g h' g' hh hg
  have hu' : h⁻¹ * h' ∈ D := QuotientGroup.leftRel_apply.mp hh
  have hu : (h : G)⁻¹ * (h' : G) ∈ L := hu'
  have hv : g⁻¹ * g' ∈ L := QuotientGroup.leftRel_apply.mp hg
  apply QuotientGroup.eq.mpr
  have he : (g * (h : G)⁻¹)⁻¹ * (g' * (h' : G)⁻¹) =
      (h : G) * ((g⁻¹ * g') * ((h : G)⁻¹ * (h' : G))⁻¹) * (h : G)⁻¹ := by group
  rw [he]
  have hn := Subgroup.le_normalizer_of_normal_subgroupOf (nilrotation_lattice_le_verticalClosure C L)
  exact (Subgroup.mem_normalizer_iff.mp (hn h.2) _).mp (L.mul_mem hv (L.inv_mem hu))

theorem nilrotation_continuous_verticalTranslate (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    Continuous (fun z : NilrotationVerticalGroup C L × (G ⧸ L) ↦
      nilrotationVerticalTranslate C L z.1 z.2) := by
  let H := nilrotationVerticalClosure C L
  let D := L.subgroupOf H
  rw [← ((QuotientGroup.isOpenQuotientMap_mk (N := D)).prodMap
    (QuotientGroup.isOpenQuotientMap_mk (N := L))).continuous_comp_iff]
  have hf : Continuous (fun z : H × G ↦ ((z.1 : H) : G)) :=
    continuous_subtype_val.comp continuous_fst
  exact QuotientGroup.continuous_mk.comp (continuous_snd.mul hf.inv)

theorem nilrotationVerticalTranslate_mk (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    (h : nilrotationVerticalClosure C L) (g : G) :
    nilrotationVerticalTranslate C L (QuotientGroup.mk h) (QuotientGroup.mk g) =
      QuotientGroup.mk (g * (h : G)⁻¹) := rfl

/-- The right translations, with inverse representatives, are a left action. -/
@[instance_reducible] def nilrotationVerticalMulAction (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] :
    MulAction (NilrotationVerticalGroup C L) (G ⧸ L) where
  smul := nilrotationVerticalTranslate C L
  one_smul x := by
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    change QuotientGroup.mk (g * (1 : G)⁻¹) = (QuotientGroup.mk g : G ⧸ L)
    rw [inv_one, mul_one]
  mul_smul v w x := by
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective v
    obtain ⟨k, rfl⟩ := QuotientGroup.mk_surjective w
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    change QuotientGroup.mk (g * ((h : G) * (k : G))⁻¹) =
      (QuotientGroup.mk (g * (k : G)⁻¹ * (h : G)⁻¹) : G ⧸ L)
    rw [mul_inv_rev, mul_assoc]

/-- The vertical action is free on the homogeneous quotient. -/
theorem nilrotationVerticalTranslate_free (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] (x : G ⧸ L) :
    Function.Injective (fun v : NilrotationVerticalGroup C L ↦ nilrotationVerticalTranslate C L v x) := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  intro v w h
  obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective v
  obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective w
  change nilrotationVerticalTranslate C L (QuotientGroup.mk v) (QuotientGroup.mk g) =
    nilrotationVerticalTranslate C L (QuotientGroup.mk w) (QuotientGroup.mk g) at h
  rw [nilrotationVerticalTranslate_mk, nilrotationVerticalTranslate_mk] at h
  have he := QuotientGroup.eq.mp h
  have hEq : (g * (v : G)⁻¹)⁻¹ * (g * (w : G)⁻¹) = (v : G) * (w : G)⁻¹ := by group
  rw [hEq] at he
  have hi : (w : G) * (v : G)⁻¹ ∈ L := by simpa only [mul_inv_rev, inv_inv] using L.inv_mem he
  have hn := Subgroup.le_normalizer_of_normal_subgroupOf (nilrotation_lattice_le_verticalClosure C L)
  have hconj := (Subgroup.mem_normalizer_iff''.mp (hn v.2) _).mp hi
  have heQ : (v : G)⁻¹ * ((w : G) * (v : G)⁻¹) * (v : G) = (v : G)⁻¹ * (w : G) := by group
  rw [heQ] at hconj
  exact QuotientGroup.eq.mpr (show v⁻¹ * w ∈ L.subgroupOf (nilrotationVerticalClosure C L) from hconj)

/-- The compact vertical translations commute with every left translation. -/
theorem nilrotation_verticalTranslate_smul (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    (g : G) (v : NilrotationVerticalGroup C L) (x : G ⧸ L) :
    nilrotationVerticalTranslate C L v (g • x) = g • nilrotationVerticalTranslate C L v x := by
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective v
  obtain ⟨q, rfl⟩ := QuotientGroup.mk_surjective x
  change QuotientGroup.mk (g * q * (h : G)⁻¹) =
    QuotientGroup.mk (g * (q * (h : G)⁻¹))
  rw [mul_assoc]

/-- Actual central translations are the inverse right translations of their images. -/
theorem nilrotation_verticalImage_translate (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    (hC : C ≤ Subgroup.center G) (c : C) (x : G ⧸ L) :
    nilrotationVerticalTranslate C L (nilrotation_verticalImage C L c) x = (c : G)⁻¹ • x := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  change QuotientGroup.mk (g * (c : G)⁻¹) = QuotientGroup.mk ((c : G)⁻¹ * g)
  rw [(Subgroup.mem_center_iff.mp (Subgroup.inv_mem _ (hC c.2))) g]

theorem nilrotation_verticalImage_translate_of_commutator_le (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    (hC : ⁅C, (⊤ : Subgroup G)⁆ ≤ L) (c : C) (x : G ⧸ L) :
    nilrotationVerticalTranslate C L (nilrotation_verticalImage C L c) x = (c : G)⁻¹ • x := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  change (QuotientGroup.mk (g * (c : G)⁻¹) : G ⧸ L) = QuotientGroup.mk ((c : G)⁻¹ * g)
  apply QuotientGroup.eq.mpr
  have he : (g * (c : G)⁻¹)⁻¹ * ((c : G)⁻¹ * g) = ⁅(c : G), g⁻¹⁆ := by
    rw [commutatorElement_def]
    group
  rw [he]
  exact hC (Subgroup.commutator_mem_commutator c.2 (Subgroup.mem_top _))

/-- The projection forgetting the vertical coordinate. -/
abbrev nilrotationVerticalProjection (C L : Subgroup G) :
    G ⧸ L → G ⧸ nilrotationVerticalClosure C L :=
  Subgroup.quotientMapOfLE (nilrotation_lattice_le_verticalClosure C L)

theorem nilrotationVerticalProjection_translate (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal]
    (v : NilrotationVerticalGroup C L) (x : G ⧸ L) :
    nilrotationVerticalProjection C L (nilrotationVerticalTranslate C L v x) =
      nilrotationVerticalProjection C L x := by
  obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective v
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
  change QuotientGroup.mk (g * (h : G)⁻¹) =
    (QuotientGroup.mk g : G ⧸ nilrotationVerticalClosure C L)
  apply QuotientGroup.eq.mpr
  have he : (g * (h : G)⁻¹)⁻¹ * g = (h : G) := by group
  rw [he]
  exact h.2

theorem nilrotationVerticalProjection_eq_iff (C L : Subgroup G)
    [(L.subgroupOf (nilrotationVerticalClosure C L)).Normal] {x y : G ⧸ L} :
    nilrotationVerticalProjection C L x = nilrotationVerticalProjection C L y ↔
      ∃ v, nilrotationVerticalTranslate C L v x = y := by
  constructor
  · obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective y
    intro he
    have hm : g⁻¹ * h ∈ nilrotationVerticalClosure C L := QuotientGroup.eq.mp he
    let v : nilrotationVerticalClosure C L := ⟨(g⁻¹ * h)⁻¹, Subgroup.inv_mem _ hm⟩
    refine ⟨QuotientGroup.mk v, ?_⟩
    change QuotientGroup.mk (g * ((g⁻¹ * h)⁻¹)⁻¹) = (QuotientGroup.mk h : G ⧸ L)
    rw [inv_inv, ← mul_assoc, mul_inv_cancel, one_mul]
  · rintro ⟨v, rfl⟩
    exact (nilrotationVerticalProjection_translate C L v x).symm

end Mixing
