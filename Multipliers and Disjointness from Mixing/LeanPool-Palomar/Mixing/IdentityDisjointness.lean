module

public import Mixing.System
public import Mathlib.Dynamics.Ergodic.Extreme

@[expose] public section

noncomputable section

namespace Mixing

open MeasureTheory Set Filter
open scoped ENNReal

variable {G X Y : Type*} [Group G] [MeasurableSpace X] [MeasurableSpace Y]

/-- A system with the identity action at every group element. -/
def System.identity (G : Type*) [Group G] (ν : Measure Y) [IsProbabilityMeasure ν] :
    System G Y where
  measure := ν
  probability := inferInstance
  act _ := id
  act_one := rfl
  act_mul _ _ := rfl
  preserves _ := MeasurePreserving.id ν

/-- A system with an ergodic acting element is disjoint from every identity system. -/
theorem disjoint_identity_of_ergodic (S : System G X) (g : G)
    (he : Ergodic (S.act g) S.measure) (ν : Measure Y) [IsProbabilityMeasure ν] :
    Disjoint S (System.identity G ν) := by
  intro joining hj
  have : IsProbabilityMeasure joining := hj.probability
  symm
  apply Measure.prod_eq
  intro A B hA hB
  let η := joining.restrict (Prod.snd ⁻¹' B)
  let τ := η.map Prod.fst
  have hτ : τ ≤ S.measure := by
    rw [← hj.fst.map_eq]
    exact Measure.map_mono Measure.restrict_le_self (by fun_prop)
  have hfin : IsFiniteMeasure τ := ⟨(hτ univ).trans_lt (measure_lt_top _ _)⟩
  have hpres : MeasurePreserving (S.prodAct (System.identity G ν) g) η η := by
    apply (hj.invariant g).restrict_preimage (measurable_snd hB)
  have hτpres : MeasurePreserving (S.act g) τ τ := by
    refine ⟨(S.preserves g).measurable, ?_⟩
    have hcomp : S.act g ∘ Prod.fst = Prod.fst ∘ S.prodAct (System.identity G ν) g := rfl
    change (η.map Prod.fst).map (S.act g) = η.map Prod.fst
    rw [Measure.map_map (S.preserves g).measurable measurable_fst, hcomp,
      ← Measure.map_map measurable_fst hpres.measurable, hpres.map_eq]
  obtain ⟨c, hc⟩ := he.eq_smul_of_absolutelyContinuous hτpres hτ.absolutelyContinuous
  have hrect : τ A = joining (A ×ˢ B) := by
    change (joining.restrict (Prod.snd ⁻¹' B)).map Prod.fst A = _
    rw [Measure.map_apply measurable_fst hA, Measure.restrict_apply (measurable_fst hA)]
    rfl
  have huniv : τ univ = ν B := by
    change (joining.restrict (Prod.snd ⁻¹' B)).map Prod.fst univ = _
    rw [Measure.map_apply measurable_fst MeasurableSet.univ, preimage_univ,
      Measure.restrict_apply_univ]
    exact hj.snd.measure_preimage hB.nullMeasurableSet
  have hc_eq : c = ν B := by
    rw [hc, smul_apply, measure_univ, smul_eq_mul, mul_one] at huniv
    exact huniv
  rw [← hrect, hc, hc_eq, smul_apply, smul_eq_mul, mul_comm]
  rfl

/-- A factor with an event of intermediate measure produces a non-product graph joining. -/
theorem FactorMap.not_disjoint_of_event {S : System G X} {T : System G Y}
    (f : FactorMap S T) {B : Set Y} (hB : MeasurableSet B) (hB₀ : 0 < T.measure B)
    (hB₁ : T.measure B < 1) : ¬ Disjoint S T := by
  intro hd
  let π : X → X × Y := fun x ↦ (x, f.toFun x)
  have hπ : Measurable π := measurable_id.prodMk f.preserves.measurable
  let A := f.toFun ⁻¹' B
  have hA : MeasurableSet A := f.preserves.measurable hB
  have h := hd _ f.graph_isJoining
  change S.measure.map π = S.measure.prod T.measure at h
  have hp : π ⁻¹' (A ×ˢ B) = A := by
    ext x
    change (x ∈ A ∧ x ∈ A) ↔ x ∈ A
    exact and_self_iff
  have hmass := congrArg (fun m : Measure (X × Y) ↦ m (A ×ˢ B)) h
  change S.measure.map π (A ×ˢ B) = S.measure.prod T.measure (A ×ˢ B) at hmass
  rw [Measure.map_apply hπ (hA.prod hB), hp, Measure.prod_prod] at hmass
  change S.measure (f.toFun ⁻¹' B) = S.measure (f.toFun ⁻¹' B) * T.measure B at hmass
  rw [f.preserves.measure_preimage hB.nullMeasurableSet] at hmass
  have htop : T.measure B ≠ ∞ :=
    (measure_lt_top T.measure _).ne
  have hlt : T.measure B * T.measure B < 1 * T.measure B :=
    ENNReal.mul_lt_mul_left hB₀.ne' htop hB₁
  rw [one_mul, ← hmass] at hlt
  exact (lt_irrefl _ hlt)

/-- Theorem 1.1(i), for an action of a group generated by one element.

The specialization to the paper's transformation takes the generator to be `1 : ℤ`
in multiplicative notation. -/
theorem theorem1_1_i (S : System G X) (g₀ : G) (hgen : ∀ g : G, ∃ n : ℤ, g = g₀ ^ n) :
    Ergodic (S.act g₀) S.measure ↔
      ∀ (Y : Type) [MeasurableSpace Y] (ν : Measure Y) [IsProbabilityMeasure ν],
        Disjoint S (System.identity G ν) := by
  constructor
  · intro h Y _ ν _
    exact disjoint_identity_of_ergodic S g₀ h ν
  · intro hd
    apply Ergodic.of_preimage_eq (S.preserves g₀)
    intro A hA hAg
    by_contra h
    have hm₀ : 0 < S.measure A := by
      refine pos_iff_ne_zero.mpr fun hz ↦ h ?_
      exact eventuallyEmptyOrUniv_iff.mpr (Or.inr (by simpa [ae_iff] using hz))
    have hm₁ : S.measure A < 1 := by
      refine lt_of_le_of_ne (prob_le_one) fun he ↦ h ?_
      have hz : S.measure Aᶜ = 0 := by rw [prob_compl_eq_one_sub hA, he, tsub_self]
      exact eventuallyEmptyOrUniv_iff.mpr (Or.inl (by
        rw [ae_iff]
        exact hz))
    let K : Subgroup G :=
      { carrier := {g | S.act g ⁻¹' A = A}
        one_mem' := by change S.act 1 ⁻¹' A = A; rw [S.act_one, preimage_id]
        mul_mem' := fun {g k} hg hk ↦ by
          change S.act g ⁻¹' A = A at hg
          change S.act k ⁻¹' A = A at hk
          change S.act (g * k) ⁻¹' A = A
          rw [S.act_mul]
          change S.act k ⁻¹' (S.act g ⁻¹' A) = A
          rw [hg, hk]
        inv_mem' := fun {g} hg ↦ by
          change S.act g ⁻¹' A = A at hg
          change S.act g⁻¹ ⁻¹' A = A
          calc
            S.act g⁻¹ ⁻¹' A = S.act g⁻¹ ⁻¹' (S.act g ⁻¹' A) :=
              congrArg (fun B ↦ S.act g⁻¹ ⁻¹' B) hg.symm
            _ = A := by
              change (S.act g ∘ S.act g⁻¹) ⁻¹' A = A
              rw [← S.act_mul, mul_inv_cancel, S.act_one, preimage_id] }
    have hAact (g : G) : S.act g ⁻¹' A = A := by
      obtain ⟨n, rfl⟩ := hgen g
      exact K.zpow_mem hAg n
    classical
    let t : X → Bool := fun x ↦ if x ∈ A then true else false
    have ht : Measurable t := measurable_const.ite hA measurable_const
    let ν := S.measure.map t
    have hν : IsProbabilityMeasure ν := (Measure.isProbabilityMeasure_map_iff ht.aemeasurable).2
      inferInstance
    let T := System.identity G ν
    let f : FactorMap S T :=
      ⟨t, ⟨ht, rfl⟩, fun g ↦ by
        funext x
        have he : S.act g x ∈ A ↔ x ∈ A :=
          congrArg (fun E : Set X ↦ x ∈ E) (hAact g) |>.to_iff
        change t (S.act g x) = t x
        simp [t, he]⟩
    have hpre : t ⁻¹' ({true} : Set Bool) = A := by ext x; simp [t]
    have hm : T.measure ({true} : Set Bool) = S.measure A := by
      change S.measure.map t {true} = _
      rw [Measure.map_apply ht (measurableSet_singleton true), hpre]
    exact f.not_disjoint_of_event (measurableSet_singleton true) (by rwa [hm]) (by rwa [hm])
      (hd Bool ν)

end Mixing
