module

public import Mixing.PurePointLebesgue

/-! # The Kronecker σ-algebra generated by Koopman eigenfunctions -/

@[expose] public section

open MeasureTheory Filter Set
open scoped ENNReal

namespace Mixing

variable {X : Type*} [m : MeasurableSpace X]

local instance : Fact (1 ≤ (2 : ℝ≥0∞)) := ⟨by norm_num⟩

/-- The σ-algebra generated modulo null sets by the Koopman eigenfunctions. -/
@[instance_reducible]
noncomputable def System.eigenfunctionSigma (S : System (Multiplicative ℤ) X) : MeasurableSpace X :=
  MeasurableSpace.generateFrom {A | MeasurableSet A ∧ S.measure A = 0 ∨
    ∃ f : Lp ℂ 2 S.measure, f ∈ unitaryEigenvectors S.koopmanRep ∧
      ∃ B : Set ℂ, MeasurableSet B ∧ A = f ⁻¹' B}

private theorem System.eigenfunctionSigma_le (S : System (Multiplicative ℤ) X) :
    S.eigenfunctionSigma ≤ m := by
  apply MeasurableSpace.generateFrom_le
  rintro A (⟨hA, _⟩ | ⟨v, _, B, hB, rfl⟩)
  · exact hA
  · exact (Lp.stronglyMeasurable v).measurable hB

private theorem System.eigenfunctionSigma_measurable_null (S : System (Multiplicative ℤ) X)
    {A : Set X} (hA : MeasurableSet A) (hnull : S.measure A = 0) :
    @MeasurableSet X S.eigenfunctionSigma A :=
  MeasurableSpace.measurableSet_generateFrom (Or.inl ⟨hA, hnull⟩)

private theorem System.eigenfunctionSigma_measurable_of_ae_eq (S : System (Multiplicative ℤ) X)
    {f g : X → ℂ} (hf : Measurable f) (hg : @Measurable X ℂ S.eigenfunctionSigma _ g)
    (heq : f =ᵐ[S.measure] g) : @Measurable X ℂ S.eigenfunctionSigma _ f := by
  intro B hB
  let N := {x | f x ≠ g x}
  have hg' : Measurable g := fun _ hA ↦ S.eigenfunctionSigma_le _ (hg hA)
  have hN : MeasurableSet N := (measurableSet_eq_fun hf hg').compl
  have hNzero : S.measure N = 0 := ae_iff.mp heq
  have hs : f ⁻¹' B = (f ⁻¹' B ∩ N) ∪ (g ⁻¹' B \ N) := by
    ext x
    by_cases he : f x = g x <;> simp [N, he]
  rw [hs]
  exact (S.eigenfunctionSigma_measurable_null ((hf hB).inter hN)
    (measure_mono_null inter_subset_right hNzero)).union
      ((hg hB).diff (S.eigenfunctionSigma_measurable_null hN hNzero))

/-- Taking the closed linear span of the eigenfunctions preserves the σ-algebra
they generate modulo null sets. -/
theorem System.kroneckerSigma_eq_eigenfunctionSigma (S : System (Multiplicative ℤ) X) :
    S.kroneckerSigma = S.eigenfunctionSigma := by
  let μ' : Measure (WithSigma S.eigenfunctionSigma) := S.measure.trim S.eigenfunctionSigma_le
  let F : X → WithSigma S.eigenfunctionSigma := id
  have hF : MeasurePreserving F S.measure μ' :=
    ⟨measurable_id'' S.eigenfunctionSigma_le, (trim_eq_map S.eigenfunctionSigma_le).symm⟩
  let J : Lp ℂ 2 μ' →ₗᵢ[ℂ] Lp ℂ 2 S.measure := Lp.compMeasurePreservingₗᵢ ℂ F hF
  have hV : Submodule.span ℂ (unitaryEigenvectors S.koopmanRep) ≤ J.toLinearMap.range := by
    apply Submodule.span_le.mpr
    intro v hv
    let v' : WithSigma S.eigenfunctionSigma → ℂ := v
    have hm : @Measurable X ℂ S.eigenfunctionSigma _ v := fun B hB ↦
      MeasurableSpace.measurableSet_generateFrom (Or.inr ⟨v, hv, B, hB, rfl⟩)
    have hmem : MemLp v' 2 μ' := by
      change @eLpNorm X ℂ _ _ S.eigenfunctionSigma v 2 (S.measure.trim S.eigenfunctionSigma_le) < ⊤
      rw [eLpNorm_trim S.eigenfunctionSigma_le hm.stronglyMeasurable]
      exact (Lp.memLp v).eLpNorm_lt_top
    refine ⟨hmem.toLp v', Lp.ext ?_⟩
    exact (Lp.coeFn_compMeasurePreserving (hmem.toLp v') hF).trans
      (hF.quasiMeasurePreserving.ae_eq_comp hmem.coeFn_toLp)
  have hP : purePointPart S.koopmanRep ≤ J.toLinearMap.range :=
    Submodule.topologicalClosure_minimal _ hV J.isometry.isClosedEmbedding.isClosed_range
  apply le_antisymm
  · apply MeasurableSpace.generateFrom_le
    rintro A (⟨hA, hz⟩ | ⟨v, hv, B, hB, rfl⟩)
    · exact S.eigenfunctionSigma_measurable_null hA hz
    · obtain ⟨v', hv'⟩ := hP hv
      have hAE : v =ᵐ[S.measure] fun x ↦ v' (F x) := by
        rw [← hv']
        exact Lp.coeFn_compMeasurePreserving v' hF
      have hm : @Measurable X ℂ S.eigenfunctionSigma _ (fun x ↦ v' (F x)) :=
        (Lp.stronglyMeasurable v').measurable
      exact (S.eigenfunctionSigma_measurable_of_ae_eq (Lp.stronglyMeasurable v).measurable hm hAE) hB
  · apply MeasurableSpace.generateFrom_le
    rintro A (⟨hA, hz⟩ | ⟨v, hv, B, hB, rfl⟩)
    · exact MeasurableSpace.measurableSet_generateFrom (Or.inl ⟨hA, hz⟩)
    · exact MeasurableSpace.measurableSet_generateFrom
        (Or.inr ⟨v, Submodule.le_topologicalClosure _ (Submodule.subset_span hv), B, hB, rfl⟩)

end Mixing
