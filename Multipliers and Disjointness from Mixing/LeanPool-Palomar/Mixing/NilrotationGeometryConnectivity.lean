module

public import Mathlib.GroupTheory.Nilpotent.LowerCentralSeries
public import Mathlib.Topology.Algebra.Group.Quotient
public import Mathlib.Topology.Algebra.Group.Subgroup

/-! # The lower central series of a group generated by a connected component and one element -/

@[expose] public section

namespace Mixing

open Set
open scoped commutatorElement

variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

private def componentInside (C : Subgroup G) : Subgroup G :=
  (Subgroup.connectedComponentOfOne C).map C.subtype

private theorem componentInside_normal (C : Subgroup G) [C.Normal] :
    (componentInside C).Normal where
  conj_mem x hx g := by
    obtain ⟨u, hu, rfl⟩ := hx
    let f : C → C := fun v ↦ ⟨g * (v : G) * g⁻¹, Subgroup.Normal.conj_mem _ v.2 _⟩
    have hf : Continuous f :=
      ((continuous_const.mul continuous_subtype_val).mul continuous_const).subtype_mk _
    have hone : f 1 = 1 := by apply Subtype.ext; simp [f]
    refine ⟨f u, ?_, rfl⟩
    have hm : f u ∈ connectedComponent (f 1) :=
      (hf.image_connectedComponent_subset 1) ⟨u, hu, rfl⟩
    change f u ∈ connectedComponent (1 : C)
    simpa only [hone] using hm

private theorem connected_of_le_componentInside (C : Subgroup G)
    (hC : C ≤ componentInside C) : ConnectedSpace C := by
  apply connectedSpace_iff_connectedComponent.mpr
  refine ⟨1, eq_univ_of_forall fun x ↦ ?_⟩
  obtain ⟨u, hu, he⟩ := hC x.2
  have he' : u = x := Subtype.ext he
  exact he' ▸ hu

private theorem commutator_mem_componentInside {C : Subgroup G}
    (H : Subgroup G) [ConnectedSpace H] (g : G)
    (hg : ∀ b : H, ⁅g, (b : G)⁆ ∈ C) (b : H) :
    ⁅g, (b : G)⁆ ∈ componentInside C := by
  let f : H → C := fun b ↦ ⟨⁅g, (b : G)⁆, hg b⟩
  have hf : Continuous f := by
    change Continuous (fun b : H ↦ (⟨g * (b : G) * g⁻¹ * (b : G)⁻¹, _⟩ : C))
    exact (((continuous_const.mul continuous_subtype_val).mul continuous_const).mul
      continuous_subtype_val.inv).subtype_mk _
  have hone : f 1 = 1 := by apply Subtype.ext; simp [f]
  have hcomp : f b ∈ connectedComponent (f 1) := (hf.image_connectedComponent_subset 1)
    ⟨b, by rw [PreconnectedSpace.connectedComponent_eq_univ]; exact mem_univ _, rfl⟩
  refine ⟨f b, ?_, rfl⟩
  change f b ∈ connectedComponent (1 : C)
  simpa only [hone] using hcomp

/-- Commutators with a connected subgroup generate a connected subgroup. -/
theorem connectedSpace_subgroup_commutator_right (A B : Subgroup G) [ConnectedSpace B] :
    ConnectedSpace (⁅A, B⁆ : Subgroup G) := by
  apply connected_of_le_componentInside
  apply Subgroup.commutator_le.mpr
  intro g hg b hb
  exact commutator_mem_componentInside B g
    (fun b ↦ Subgroup.commutator_mem_commutator hg b.2) ⟨b, hb⟩

/-- The commutator subgroup is connected if the group is generated by its identity
component and one element. -/
theorem connectedSpace_commutator_of_component_sup_zpowers (a : G)
    (hgen : Subgroup.connectedComponentOfOne G ⊔ Subgroup.zpowers a = ⊤) :
    ConnectedSpace (commutator G) := by
  let A := Subgroup.connectedComponentOfOne G
  let : ConnectedSpace A := isConnected_iff_connectedSpace.mp isConnected_connectedComponent
  let C := commutator G
  let D := componentInside C
  let : D.Normal := componentInside_normal C
  let q := QuotientGroup.mk' D
  have hcomm (g : G) (b : A) : Commute (q g) (q b) := by
    have hm : ⁅g, (b : G)⁆ ∈ D :=
      commutator_mem_componentInside A g (fun b ↦
        Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top (b : G))) b
    apply commutatorElement_eq_one_iff_commute.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr hm
  let K (g : G) := (Subgroup.centralizer ({q g} : Set (G ⧸ D))).comap q
  have hK (g x : G) : x ∈ K g ↔ Commute (q g) (q x) := by
    change q x ∈ Subgroup.centralizer ({q g} : Set (G ⧸ D)) ↔ _
    rw [Subgroup.mem_centralizer_iff]
    simp only [Set.mem_singleton_iff, forall_eq]
    rfl
  have hA (g : G) : A ≤ K g := fun x hx ↦ (hK g x).mpr (hcomm g ⟨x, hx⟩)
  have htop (g : G) (hg : a ∈ K g) : K g = ⊤ := by
    apply top_unique
    rw [← hgen]
    exact sup_le (hA g) (Subgroup.zpowers_le.mpr hg)
  have ha : K a = ⊤ := htop a ((hK a a).mpr (Commute.refl _))
  have hAll (g : G) : K g = ⊤ := htop g ((hK g a).mpr
    ((hK a g).mp (ha.symm ▸ Subgroup.mem_top g)).symm)
  apply connected_of_le_componentInside C
  change ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ ≤ D
  apply Subgroup.commutator_le.mpr
  intro g _ x _
  apply (QuotientGroup.eq_one_iff _).mp
  change q ⁅g, x⁆ = 1
  rw [map_commutatorElement]
  exact ((hK g x).mp ((hAll g).symm ▸ Subgroup.mem_top x)).commutator_eq

/-- Every noninitial term of the lower central series is connected under the cyclic
component-generation hypothesis. The series in Mathlib starts at index zero. -/
theorem connectedSpace_lowerCentralSeries_succ_of_component_sup_zpowers (a : G)
    (hgen : Subgroup.connectedComponentOfOne G ⊔ Subgroup.zpowers a = ⊤) (n : ℕ) :
    ConnectedSpace ((⊤ : Subgroup G).lowerCentralSeries (n + 1)) := by
  induction n with
  | zero =>
    rw [Subgroup.top_lowerCentralSeries_one]
    exact connectedSpace_commutator_of_component_sup_zpowers a hgen
  | succ n ih =>
    rw [Subgroup.lowerCentralSeries_succ, Subgroup.commutator_comm]
    let := ih
    exact connectedSpace_subgroup_commutator_right _ _

end Mixing
