    _ ≤ w * (‖∑ l ∈ I, A l‖ + ‖∑ l ∈ J, A l‖ + (‖∑ l ∈ B, A l‖ + ‖E‖)) := by
      apply mul_le_mul_of_nonneg_left _ (chaconColumnWeight_nonneg n)
