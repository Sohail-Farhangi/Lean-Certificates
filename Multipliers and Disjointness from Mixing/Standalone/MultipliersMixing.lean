      have h₂ := norm_add_le ((∑ l ∈ I, A l) + (∑ l ∈ J, A l)) (∑ l ∈ B, A l)
      have h₃ := norm_add_le ((∑ l ∈ I, A l) + (∑ l ∈ J, A l) + (∑ l ∈ B, A l)) E
      linarith
    _ ≤ _ := by
      rw [mul_add w, mul_add w, mul_add D]
      exact add_le_add (add_le_add hI hJ) hBad

