private theorem norm_mul_l2_le (μ : Measure X) [IsFiniteMeasure μ] (f h : BoundedObservable X) :
    ‖(f.mul h).l2 μ‖ ≤ f.bound * ‖h.l2 μ‖ := by
  apply Lp.norm_le_mul_norm_of_ae_le_mul
