      obtain ⟨χ, hχ, hX⟩ := exists_principalExtension_infinite_vertical_modes μ e heK hK η hη hη'
      have hY (j : ℕ) : ∃ y : Lp ℂ 2 μ, (∀ k, R k y = (χ j k : ℂ) • y) ∧
