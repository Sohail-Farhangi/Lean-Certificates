      have hNontriv : Nontrivial K := by
        obtain ⟨c, hc, hnc⟩ : ∃ c, c ∈ C ∧ c ∉ L := by
          by_contra! heq
          exact hnontriv heq
        let z : H := ⟨c, nilrotation_centre_le_verticalClosure C L hc⟩
