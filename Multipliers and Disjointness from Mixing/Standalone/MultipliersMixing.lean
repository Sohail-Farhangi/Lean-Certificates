private def positiveIntegerEmbedding : ℕ ↪ Multiplicative ℤ where
  toFun n := Multiplicative.ofAdd (n : ℤ)
  inj' := by
    intro a b hab
    have he := congrArg Multiplicative.toAdd hab
    change (a : ℤ) = (b : ℤ) at he
