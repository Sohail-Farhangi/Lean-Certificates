  filter_upwards [hfibre, ae_ball_mass_of_fibre_majorization ν κ π hπ hfibre a hmajorize]
    with y hfy hy
  filter_upwards [hfy, (κ y).support_mem_ae] with x hxy hx
  rw [hxy]
  exact measure_singleton_ge_of_ball_lower_bound _ (hy x hx)

