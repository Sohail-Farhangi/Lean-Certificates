/-! # The product joining of a weakly mixing system is extreme -/


open Filter MeasureTheory Set
open scoped ComplexConjugate ENNReal Topology

namespace Mixing

variable {G X Y : Type*} [CommGroup G] [MeasurableSpace X] [MeasurableSpace Y]

/-- An extreme point of the convex set of joinings of the two fixed systems. -/
def IsExtremeJoining (T : System G X) (S : System G Y) (τ : Measure (X × Y)) : Prop :=
  IsJoining T S τ ∧
    ∀ μ₁ μ₂, IsJoining T S μ₁ → IsJoining T S μ₂ →
      ∀ (a : ℝ≥0∞), 0 < a → a < 1 → a • μ₁ + (1 - a) • μ₂ = τ → μ₁ = τ ∧ μ₂ = τ

private noncomputable def changeMeasureCLM {W : Type*} [MeasurableSpace W]
    {μ ν : Measure W} {C : ℝ≥0∞} (hC : C ≠ ∞) (hμν : μ ≤ C • ν) :
    Lp ℂ 2 ν →L[ℂ] Lp ℂ 2 μ where
  toFun := Lp.LpToLpOfMeasureLeSMul hC hμν
  map_add' := map_add (Lp.LpToLpOfMeasureLeSMul hC hμν)
  map_smul' k v := by
    apply Lp.ext
    have hn := Measure.absolutelyContinuous_of_le_smul hμν
    filter_upwards [Lp.coeFn_LpToLpOfMeasureLeSMul hC hμν (k • v),
      Lp.coeFn_LpToLpOfMeasureLeSMul hC hμν v,
      Lp.coeFn_smul k (Lp.LpToLpOfMeasureLeSMul hC hμν v),
      hn.ae_eq (Lp.coeFn_smul k v)] with x hv₁ hv₂ h₁ h₂
    simp only [RingHom.id_apply]
    rw [hv₁, h₁, h₂, Pi.smul_apply, Pi.smul_apply, hv₂]
  cont := (Lp.LpToLpOfMeasureLeSMul hC hμν).continuous

private theorem changeMeasureCLM_ae {W : Type*} [MeasurableSpace W]
    {μ ν : Measure W} {C : ℝ≥0∞} (hC : C ≠ ∞) (hμν : μ ≤ C • ν) (v : Lp ℂ 2 ν) :
    changeMeasureCLM hC hμν v =ᵐ[μ] v :=
  Lp.coeFn_LpToLpOfMeasureLeSMul hC hμν v

private def observableTensor (f : BoundedObservable X) (F : BoundedObservable Y) :
    BoundedObservable (X × Y) :=
  (f.comp Prod.fst measurable_fst).mul (F.comp Prod.snd measurable_snd)

private theorem dominated_joining_centered_integral
    {T : System G X} {S : System G Y} {τ : Measure (X × Y)}
    (hτ : IsJoining T S τ) {ν : Measure Y} [IsProbabilityMeasure ν]
    {C : ℝ≥0∞} (hC : C ≠ ∞) (hDom : τ ≤ C • T.measure.prod ν)
    (p : Ultrafilter G) (hMix : T.IsUMixing {p})
    (f : BoundedObservable X) (F : BoundedObservable Y)
    (hMean : ∫ x, f x ∂T.measure = 0) :
    (∫ w, f w.1 * F w.2 ∂τ) = 0 := by
  let := hτ.probability
  let ρ := T.measure.prod ν
  let B (g : G) := observableTensor (T.translated g f) (S.translated g F)
  let x (g : G) := (B g).l2 ρ
  have hNorm (g : G) : ‖x g‖ ≤ f.bound * F.bound := (B g).norm_l2_le ρ
  have hCorr : Tendsto (fun v : G × G => inner ℂ (x v.1) (x v.2))
      (fubiniUltrafilter p p : Filter _) (𝓝 0) := by
    apply tendsto_fubiniUltrafilter (g := fun _ => 0) _ tendsto_const_nhds
    intro r
    have hT := (System.hasMixingCorrelations hMix) p (by simp) (T.translated r f) f
    have hT' : Tendsto (fun g => ∫ a, conj (f (T.act r a)) * f (T.act g a) ∂T.measure)
        (p : Filter G) (𝓝 0) := by
      simpa only [System.translated_apply, hMean, mul_zero] using hT
    have hSBound (g : G) :
        ‖∫ b, conj (F (S.act r b)) * F (S.act g b) ∂ν‖ ≤ F.bound * F.bound :=
      (((S.translated r F).conjugate).mul (S.translated g F)).norm_integral_le ν
    have hLim := hT'.zero_mul_isBoundedUnder_le
      ⟨_, eventually_map.mpr (Eventually.of_forall hSBound)⟩
    have hEq (g : G) :
        inner ℂ (x r) (x g) =
          (∫ a, conj (f (T.act r a)) * f (T.act g a) ∂T.measure) *
          ∫ b, conj (F (S.act r b)) * F (S.act g b) ∂ν := by
      rw [show x r = (B r).l2 ρ from rfl, show x g = (B g).l2 ρ from rfl,
        BoundedObservable.inner_l2, ← integral_prod_mul]
      apply integral_congr_ae
      exact Eventually.of_forall fun w => by
        simp only [B, observableTensor, BoundedObservable.mul_apply, BoundedObservable.comp_apply,
          System.translated_apply, map_mul]
        ring
    simpa only [hEq] using hLim
  let L := changeMeasureCLM hC hDom
  let e := (BoundedObservable.const (1 : ℂ) : BoundedObservable (X × Y)).l2 τ
  have hL := tendsto_inner_zero_of_fubini_correlations_single p x hNorm hCorr (L.adjoint e)
  have hEq (g : G) : inner ℂ (L.adjoint e) (x g) = ∫ w, B g w ∂τ := by
    rw [ContinuousLinearMap.adjoint_inner_left, L2.inner_def]
    apply integral_congr_ae
    have hx : x g =ᵐ[τ] B g :=
      (Measure.absolutelyContinuous_of_le_smul hDom).ae_eq ((B g).coe_l2 ρ)
    filter_upwards [(BoundedObservable.const (1 : ℂ) : BoundedObservable (X × Y)).coe_l2 τ,
      changeMeasureCLM_ae hC hDom (x g), hx] with w he hLx hxx
    change e w = _ at he
    change (L (x g)) w = _ at hLx
    rw [he, hLx, hxx, RCLike.inner_apply']
    simp
  have hInv (g : G) : (∫ w, B g w ∂τ) = ∫ w, f w.1 * F w.2 ∂τ :=
    (observableTensor f F).integral_comp_of_preserving (hτ.invariant g)
  have hConstant : Tendsto (fun _ : G => ∫ w, f w.1 * F w.2 ∂τ) (p : Filter G) (𝓝 0) := by
    simpa only [hEq, hInv] using hL
  exact tendsto_nhds_unique tendsto_const_nhds hConstant

private theorem dominated_joining_integral_mul
    {T : System G X} {S : System G Y} {τ : Measure (X × Y)}
    (hτ : IsJoining T S τ) {ν : Measure Y} [IsProbabilityMeasure ν]
    {C : ℝ≥0∞} (hC : C ≠ ∞) (hDom : τ ≤ C • T.measure.prod ν)
    (p : Ultrafilter G) (hMix : T.IsUMixing {p})
    (f : BoundedObservable X) (F : BoundedObservable Y) :
    (∫ w, f w.1 * F w.2 ∂τ) =
      (∫ x, f x ∂T.measure) * ∫ y, F y ∂S.measure := by
  let := hτ.probability
  let c := ∫ x, f x ∂T.measure
  let d := f.sub (BoundedObservable.const c)
  have hMean : ∫ x, d x ∂T.measure = 0 := by
    change (∫ x : X, f x - c ∂T.measure) = 0
    have hf : Integrable (fun x => f x) T.measure := f.integrable _
    rw [integral_sub hf (integrable_const c)]
    simp [c]
  have h0 := dominated_joining_centered_integral hτ hC hDom p hMix d F hMean
  change (∫ w : X × Y, (f w.1 - c) * F w.2 ∂τ) = 0 at h0
  simp_rw [sub_mul] at h0
  have h₁ : Integrable (fun w : X × Y => f w.1 * F w.2) τ :=
    (observableTensor f F).integrable τ
  have h₂ : Integrable (fun w : X × Y => c * F w.2) τ :=
    (observableTensor (BoundedObservable.const c) F).integrable τ
  rw [integral_sub h₁ h₂, integral_const_mul, F.integral_comp_of_preserving hτ.snd] at h0
  exact sub_eq_zero.mp h0

private noncomputable def rectangleIndicator {W : Type*} [MeasurableSpace W]
    (s : Set W) (hs : MeasurableSet s) : BoundedObservable W where
  toFun := s.indicator (fun _ => 1)
  measurable := measurable_const.indicator hs
  bound := 1
  bound_nonneg := zero_le_one
  norm_le x := by
    classical
    by_cases h : x ∈ s <;> simp [h]

/-- Domination by a product with the mixing system's marginal forces independence.
The second probability in the dominating product may be any probability on the
second coordinate space. -/
theorem dominated_joining_eq_prod_of_reference
    {T : System G X} {S : System G Y} {τ : Measure (X × Y)}
    (hτ : IsJoining T S τ) {ν : Measure Y} [IsProbabilityMeasure ν]
    {C : ℝ≥0∞} (hC : C ≠ ∞) (hDom : τ ≤ C • T.measure.prod ν)
    (p : Ultrafilter G) (hMix : T.IsUMixing {p}) : τ = T.measure.prod S.measure := by
  let := hτ.probability
  apply Measure.ext_prod
  intro a b ha hb
  classical
  have h := dominated_joining_integral_mul hτ hC hDom p hMix
    (rectangleIndicator a ha) (rectangleIndicator b hb)
  have he : (fun w : X × Y => rectangleIndicator a ha w.1 * rectangleIndicator b hb w.2) =
      (a ×ˢ b).indicator (fun _ => (1 : ℂ)) := by
    funext w
    by_cases h₁ : w.1 ∈ a <;> by_cases h₂ : w.2 ∈ b <;>
      simp [rectangleIndicator, h₁, h₂]
  rw [he] at h
  change (∫ w : X × Y, (a ×ˢ b).indicator (fun _ => (1 : ℂ)) w ∂τ) =
    (∫ x, a.indicator (fun _ => (1 : ℂ)) x ∂T.measure) *
      ∫ y, b.indicator (fun _ => (1 : ℂ)) y ∂S.measure at h
  rw [integral_indicator_const _ (ha.prod hb), integral_indicator_const _ ha,
    integral_indicator_const _ hb] at h
  have hRe := congrArg Complex.re h
  simp only [Complex.real_smul, mul_one, Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, mul_zero, sub_zero] at hRe
  have hReal : (τ (a ×ˢ b)).toReal = ((T.measure.prod S.measure) (a ×ˢ b)).toReal := by
    rw [Measure.prod_prod, ENNReal.toReal_mul]
    exact hRe
  simpa only [ENNReal.ofReal_toReal (measure_ne_top _ _)] using congrArg ENNReal.ofReal hReal

/-- A joining dominated by a finite multiple of the product is the product when
one coordinate is mixing along an ultrafilter. -/
theorem dominated_joining_eq_prod
    {T : System G X} {S : System G Y} {τ : Measure (X × Y)}
    (hτ : IsJoining T S τ) {C : ℝ≥0∞} (hC : C ≠ ∞) (hDom : τ ≤ C • T.measure.prod S.measure)
    (p : Ultrafilter G) (hMix : T.IsUMixing {p}) : τ = T.measure.prod S.measure :=
  dominated_joining_eq_prod_of_reference hτ hC hDom p hMix

/-- An upper bound on a measure scaled by a finite positive constant. -/
theorem le_inv_smul_of_smul_le {W : Type*} [MeasurableSpace W]
    {a : ℝ≥0∞} (ha₀ : a ≠ 0) (haTop : a ≠ ∞) {μ ν : Measure W} (h : a • μ ≤ ν) :
    μ ≤ a⁻¹ • ν := by
  calc
    μ = a⁻¹ • (a • μ) := by rw [smul_smul, ENNReal.inv_mul_cancel ha₀ haTop, one_smul]
    _ ≤ _ := by gcongr

/-- A weakly mixing system is mixing along some ultrafilter. -/
theorem System.exists_isUMixing_singleton [Countable G] {T : System G X}
    (hWeak : IsWeaklyMixing T.koopmanZeroRep) : ∃ p : Ultrafilter G, T.IsUMixing {p} := by
  obtain ⟨F, hF⟩ := exists_isFolnerSequence (G := G)
  have hPos : HasPositiveFolnerDensity (univ : Set G) := by
    refine ⟨F, hF, 1, zero_lt_one, Eventually.frequently (Eventually.of_forall fun n => ?_)⟩
    have hCard : (F n).card ≠ 0 := (hF.1 n).card_ne_zero
    simp [finsetDensity, hCard]
  obtain ⟨p, hp, _⟩ := exists_essentialUltrafilter_mem_of_hasPositiveFolnerDensity hPos
  refine ⟨p, fun q hq => ?_⟩
  have hqp : q = p := Set.mem_singleton_iff.mp hq
  subst q
  exact isUMixing_essential_of_isWeaklyMixing T.koopmanZeroRep hWeak p hp

/-- Lemma 3. A weakly mixing system and an arbitrary second system have an extreme
product joining. The proof uses domination of the measures in a convex decomposition. -/
theorem lemma3 [Countable G] {T : System G X} (S : System G Y)
    (hWeak : IsWeaklyMixing T.koopmanZeroRep) :
    IsExtremeJoining T S (T.measure.prod S.measure) := by
  obtain ⟨p, hMix⟩ := System.exists_isUMixing_singleton hWeak
  refine ⟨product_isJoining T S, fun μ₁ μ₂ h₁ h₂ a ha₀ ha₁ he => ?_⟩
  have h₁le : a • μ₁ ≤ T.measure.prod S.measure := by
    rw [← he]
    apply Measure.le_iff'.mpr
    intro A
    rw [add_apply]
    exact le_self_add
  have h₂le : (1 - a) • μ₂ ≤ T.measure.prod S.measure := by
    rw [← he]
    apply Measure.le_iff'.mpr
    intro A
    rw [add_apply]
    exact le_add_self
  have hb₀ : 1 - a ≠ 0 := (tsub_pos_of_lt ha₁).ne'
  have hbTop : 1 - a ≠ ∞ := (tsub_le_self.trans_lt ENNReal.one_lt_top).ne
  refine ⟨dominated_joining_eq_prod h₁ (ENNReal.inv_ne_top.mpr ha₀.ne')
    (le_inv_smul_of_smul_le ha₀.ne' (ha₁.trans ENNReal.one_lt_top).ne h₁le) p hMix,
    dominated_joining_eq_prod h₂ (ENNReal.inv_ne_top.mpr hb₀)
      (le_inv_smul_of_smul_le hb₀ hbTop h₂le) p hMix⟩

end Mixing
end

/- Source module Mixing.EventMixing. -/
section
noncomputable section

namespace Mixing

open Filter MeasureTheory Set
open scoped Topology

universe u

variable {G X : Type*} [CommGroup G] [MeasurableSpace X]

/-- The L² equivalence class of the indicator of a measurable event. -/
def eventVector (S : System G X) {A : Set X} (hA : MeasurableSet A) :
    Lp ℂ 2 S.measure := indicatorConstLp 2 hA (measure_ne_top _ _) 1

/-- The mean of the indicator of an event is its probability. -/
theorem integral_eventVector (S : System G X) {A : Set X} (hA : MeasurableSet A) :
    ∫ x, eventVector S hA x ∂S.measure = (S.measure.real A : ℂ) := by
  exact (integral_congr_ae indicatorConstLp_coeFn).trans (by rw [integral_indicator hA]; simp)

theorem koopman_event_coeff (S : System G X) (g : G) {A B : Set X}
    (hA : MeasurableSet A) (hB : MeasurableSet B) :
    inner ℂ (eventVector S hA) (S.koopmanRep g (eventVector S hB)) =
      (S.measure.real (A ∩ S.act g ⁻¹' B) : ℂ) := by
  change inner ℂ (eventVector S hA)
    (Lp.compMeasurePreserving (S.act g) (S.preserves g) (eventVector S hB)) = _
  rw [eventVector, eventVector, Lp.indicatorConstLp_compMeasurePreserving]
  exact L2.inner_indicatorConstLp_one_indicatorConstLp_one _ _

/-- The event formulation in part (iii) of Theorem 1.3. `Measure.real` represents
the values of the probability measure as real numbers. -/
def System.IsUMixingEvents (S : System G X) (P : Set (Ultrafilter G)) : Prop :=
  ∀ p ∈ P, ∀ A B : Set X, MeasurableSet A → MeasurableSet B →
    Tendsto (fun g ↦ S.measure.real (A ∩ S.act g ⁻¹' B)) (p : Filter G)
      (𝓝 (S.measure.real A * S.measure.real B))

/-- A bounded operator vanishes if all its matrix coefficients on event indicators vanish. -/
theorem zero_of_event_coefficients (S : System G X) (D : Lp ℂ 2 S.measure →L[ℂ] Lp ℂ 2 S.measure)
    (hD : ∀ A B : Set X, ∀ (hA : MeasurableSet A) (hB : MeasurableSet B),
      inner ℂ (eventVector S hA) (D (eventVector S hB)) = 0) : D = 0 := by
  have hind : ∀ (z : ℂ) (A : Set X) (hA : MeasurableSet A),
      (Lp.simpleFunc.indicatorConst (μ := S.measure) 2 hA (measure_ne_top _ _) z : Lp ℂ 2 S.measure) =
        z • eventVector S hA := by
    intro z A hA
    let e := Lp.simpleFunc.indicatorConst (μ := S.measure) 2 hA (measure_ne_top _ _) z
    have he := (Lp.simpleFunc.toSimpleFunc_eq_toFun e).symm.trans
      (Lp.simpleFunc.toSimpleFunc_indicatorConst hA (measure_ne_top _ _) z)
    apply Lp.ext
    filter_upwards [he, Lp.coeFn_smul z (eventVector S hA),
      indicatorConstLp_coeFn (p := 2) (hs := hA) (hμs := measure_ne_top S.measure A) (c := (1 : ℂ))]
      with x hx hc heA
    rw [hx, hc]
    change _ = z * eventVector S hA x
    rw [show eventVector S hA x = _ from heA]
    classical
    by_cases h : x ∈ A <;> simp [h]
  have hleft : ∀ (f : Lp ℂ 2 S.measure) (B : Set X) (hB : MeasurableSet B),
      inner ℂ f (D (eventVector S hB)) = 0 := by
    intro f B hB
    refine Lp.induction (μ := S.measure) (p := 2) (by norm_num)
      (fun f ↦ inner ℂ f (D (eventVector S hB)) = 0) ?_ ?_ ?_ f
    · intro c A hA hmass
      rw [hind c A hA, inner_smul_left, hD A B hA hB, mul_zero]
    · intro x y hx₀ hy₀ _ hx hy
      change inner ℂ ((hx₀.add hy₀).toLp (x + y)) (D (eventVector S hB)) = 0
      rw [MemLp.toLp_add hx₀ hy₀, inner_add_left, hx, hy, add_zero]
    · exact isClosed_eq (continuous_id.inner continuous_const) continuous_const
  apply ContinuousLinearMap.ext
  intro k
  apply ext_inner_left ℂ
  intro f
  rw [zero_apply, inner_zero_right]
  refine Lp.induction (μ := S.measure) (p := 2) (by norm_num)
    (fun k ↦ inner ℂ f (D k) = 0) ?_ ?_ ?_ k
  · intro c B hB hmass
    rw [hind c B hB, map_smul, inner_smul_right, hleft f B hB, mul_zero]
  · intro x y hx₀ hy₀ _ hx hy
    change inner ℂ f (D ((hx₀.add hy₀).toLp (x + y))) = 0
    rw [MemLp.toLp_add hx₀ hy₀, map_add, inner_add_right, hx, hy, add_zero]
  · exact isClosed_eq (continuous_const.inner D.continuous) continuous_const

/-- Equivalence of the event and Koopman formulations of Theorem 1.3(iii). -/
theorem System.isUMixing_iff_events (S : System G X) (P : Set (Ultrafilter G)) :
    S.IsUMixing P ↔ S.IsUMixingEvents P := by
  rw [S.isUMixing_iff_lp_correlations]
  constructor
  · intro h p hp A B hA hB
    have hlim := h p hp (eventVector S hA) (eventVector S hB)
    simp only [koopman_event_coeff, integral_eventVector, Complex.star_def, Complex.conj_ofReal,
      ← Complex.ofReal_mul] at hlim
    simpa only [Function.comp_def, Complex.ofReal_re] using (Complex.continuous_re.tendsto _).comp hlim
  · intro h p hp f k
    let c := constantOne S.measure
    let Q := InnerProductSpace.rankOne ℂ c c
    let A := ultrafilterOperator S.koopmanRep p
    have hQ (f k : Lp ℂ 2 S.measure) :
        inner ℂ f (Q k) = star (∫ x, f x ∂S.measure) * ∫ x, k x ∂S.measure := by
      simp only [Q, InnerProductSpace.rankOne_apply, inner_smul_right]
      rw [mul_comm, ← inner_conj_symm]
      exact congrArg₂ (· * ·) (congrArg star (inner_constantOne_left _ f))
        (inner_constantOne_left _ k)
    have hzero : A - Q = 0 := by
      apply zero_of_event_coefficients S
      intro C D hC hD
      have hc := (Complex.continuous_ofReal.tendsto _).comp (h p hp C D hC hD)
      have hl := tendsto_ultrafilterOperator_coeff S.koopmanRep p (eventVector S hC) (eventVector S hD)
      simp only [koopman_event_coeff] at hl
      have he := tendsto_nhds_unique hl hc
      rw [sub_apply, inner_sub_right, hQ, integral_eventVector,
        integral_eventVector, Complex.star_def, Complex.conj_ofReal, ← Complex.ofReal_mul]
      exact sub_eq_zero.mpr he
    have hAQ : A = Q := sub_eq_zero.mp hzero
    have hl := tendsto_ultrafilterOperator_coeff S.koopmanRep p f k
    change Tendsto _ _ (𝓝 (inner ℂ f (A k))) at hl
    rwa [hAQ, hQ] at hl

/-- Theorem 1.3 with part (iii) stated directly in terms of measurable events. -/
theorem theorem1_3_events {G : Type*} {X : Type u} [CommGroup G] [MeasurableSpace X]
    (S : System G X) (P : Set (Ultrafilter G)) :
    (S.IsUMixingEvents P ↔
      ∀ (K : Type u) [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
        (V : G →* (K ≃ₗᵢ[ℂ] K)), IsUGenerated V P →
        SpectrallyDisjoint S.koopmanZeroRep V) ∧
    (S.IsUMixingEvents P ↔
      ∀ (Y : Type u) [MeasurableSpace Y] (T : System G Y), T.IsUGenerated P → Disjoint S T) :=
  ⟨(S.isUMixing_iff_events P).symm.trans (theorem1_3 S P).1,
    (S.isUMixing_iff_events P).symm.trans (theorem1_3 S P).2⟩

end Mixing
end

/- Source module Mixing.FibreMass. -/
section
namespace Mixing

open Filter MeasureTheory ProbabilityTheory Set
open scoped ENNReal ProbabilityTheory

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]

/-- The fibre-mass argument in Theorem 5.2.

The input from the partially rigid Markov operator is `hmajorize`: each
indicator admits a factor-measurable image with the same integral and with
pointwise lower bound `a` on that event. -/
theorem ae_measure_gap_of_fibre_majorization
    (ν : Measure Y) [IsProbabilityMeasure ν]
    (κ : Kernel Y X) [IsMarkovKernel κ] (π : X → Y) (hπ : Measurable π)
    (hfibre : ∀ᵐ y ∂ν, ∀ᵐ x ∂κ y, π x = y)
    (a : ℝ≥0∞)
    (hmajorize : ∀ A : Set X, MeasurableSet A →
      ∃ h : Y → ℝ≥0∞, Measurable h ∧
        (∀ᵐ x ∂(κ ∘ₘ ν), x ∈ A → a ≤ h (π x)) ∧
        (∫⁻ y, h y ∂ν) = (κ ∘ₘ ν) A)
    {A : Set X} (hA : MeasurableSet A) :
    ∀ᵐ y ∂ν, κ y A = 0 ∨ a ≤ κ y A := by
  classical
  let E : Set Y := {y | 0 < κ y A ∧ κ y A < a}
  have hm := κ.measurable_coe hA
  have hE : MeasurableSet E := (measurableSet_lt measurable_const hm).inter
    (measurableSet_lt hm measurable_const)
  have hνE : ν E = 0 := by
    by_contra hpos
    let A' := A ∩ π ⁻¹' E
    have hA' : MeasurableSet A' := hA.inter (hπ hE)
    obtain ⟨h, _, hlo, hμ⟩ := hmajorize A' hA'
    have hcomp : (κ ∘ₘ ν) A' = ∫⁻ y in E, κ y A ∂ν := by
      rw [Measure.bind_apply hA' κ.aemeasurable, ← lintegral_indicator hE]
      apply lintegral_congr_ae
      filter_upwards [hfibre] with y hy
      by_cases hyE : y ∈ E
      · rw [indicator_of_mem hyE]
        apply measure_congr
        filter_upwards [hy] with x hx
        exact ⟨fun he ↦ he.1, fun he ↦ ⟨he, by simpa only [mem_preimage, hx] using hyE⟩⟩
      · rw [indicator_of_notMem hyE]
        apply measure_eq_zero_iff_ae_notMem.mpr
        filter_upwards [hy] with x hx hxA
        exact hyE (by simpa only [mem_preimage, hx] using hxA.2)
    have haE : ∀ᵐ y ∂ν, y ∈ E → a ≤ h y := by
      filter_upwards [hfibre, Measure.ae_ae_of_ae_comp hlo] with y hy hAy hyE
      have hmem : ¬ ∀ᵐ x ∂κ y, x ∉ A := by
        rw [← measure_eq_zero_iff_ae_notMem]
        exact (show 0 < κ y A from hyE.1).ne'
      have hex : ∃ x, x ∈ A ∧ π x = y ∧ (x ∈ A' → a ≤ h (π x)) := by
        by_contra! hn
        apply hmem
        filter_upwards [hy, hAy] with x hx hx' hxA
        obtain ⟨hxA', hlt⟩ := hn x hxA hx
        exact (not_lt_of_ge (hx' hxA')) hlt
      obtain ⟨x, hxA, hxy, hAx⟩ := hex
      specialize hAx ⟨hxA, by simpa only [mem_preimage, hxy] using hyE⟩
      simpa only [hxy] using hAx
    have hbound : a * ν E ≤ ∫⁻ y, h y ∂ν := by
      rw [← lintegral_indicator_const hE]
      apply lintegral_mono_ae
      filter_upwards [haE] with y hy
      by_cases hyE : y ∈ E
      · simpa only [indicator_of_mem hyE] using hy hyE
      · simp only [indicator_of_notMem hyE, zero_le]
    have hstrict : (∫⁻ y in E, κ y A ∂ν) < a * ν E := by
      rw [← setLIntegral_const E a]
      apply lintegral_strict_mono
      · intro hz
        exact hpos (by simpa using congrArg (fun μ : Measure Y ↦ μ univ) hz)
      · exact measurable_const.aemeasurable
      · rw [← hcomp]
        exact measure_ne_top _ _
      · rw [ae_restrict_iff' hE]
        exact ae_of_all _ fun y hy ↦ hy.2
    rw [hμ, hcomp] at hbound
    exact (not_lt_of_ge hbound) hstrict
  rw [ae_iff]
  have hcompl : {y | ¬ (κ y A = 0 ∨ a ≤ κ y A)} = E := by
    ext y
    simp only [E, mem_ofPred_eq, not_or, not_le, pos_iff_ne_zero]
  rw [hcompl]
  exact hνE

private theorem ae_ball_mass_of_fibre_majorization
    [MetricSpace X] [SecondCountableTopology X] [BorelSpace X]
    (ν : Measure Y) [IsProbabilityMeasure ν]
    (κ : Kernel Y X) [IsMarkovKernel κ] (π : X → Y) (hπ : Measurable π)
    (hfibre : ∀ᵐ y ∂ν, ∀ᵐ x ∂κ y, π x = y)
    (a : ℝ≥0∞)
    (hmajorize : ∀ A : Set X, MeasurableSet A →
      ∃ h : Y → ℝ≥0∞, Measurable h ∧
        (∀ᵐ x ∂(κ ∘ₘ ν), x ∈ A → a ≤ h (π x)) ∧
        (∫⁻ y, h y ∂ν) = (κ ∘ₘ ν) A) :
    ∀ᵐ y ∂ν, ∀ x ∈ (κ y).support, ∀ r : ℝ, 0 < r → a ≤ κ y (Metric.ball x r) := by
  let basis := TopologicalSpace.countableBasis X
  have hgap (A : basis) : ∀ᵐ y ∂ν, κ y A = 0 ∨ a ≤ κ y A :=
    ae_measure_gap_of_fibre_majorization ν κ π hπ hfibre a hmajorize
      (TopologicalSpace.isOpen_of_mem_countableBasis A.property).measurableSet
  filter_upwards [ae_all_iff.2 hgap] with y hy
  intro x hx r hr
  have hnhds := Metric.ball_mem_nhds x hr
  obtain ⟨A, hA, hxA, hsub⟩ :=
    (TopologicalSpace.isBasis_countableBasis X).mem_nhds_iff.mp hnhds
  have hpos := (Measure.mem_support_iff_forall x).mp hx A
    ((TopologicalSpace.isOpen_of_mem_countableBasis hA).mem_nhds hxA)
  exact ((hy ⟨A, hA⟩).resolve_left hpos.ne').trans (measure_mono hsub)

/-- The finite-support conclusion of the fibre-mass argument, with a simultaneous
almost-everywhere assertion over a countable open basis. -/
theorem ae_finite_fibre_support_of_majorization
    [MetricSpace X] [SecondCountableTopology X] [BorelSpace X]
    (ν : Measure Y) [IsProbabilityMeasure ν]
    (κ : Kernel Y X) [IsMarkovKernel κ] (π : X → Y) (hπ : Measurable π)
    (hfibre : ∀ᵐ y ∂ν, ∀ᵐ x ∂κ y, π x = y)
