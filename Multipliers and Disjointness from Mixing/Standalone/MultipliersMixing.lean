/-! # The sum-coordinate factor of the Cantor skew products -/


open MeasureTheory Filter
open scoped Topology

namespace Mixing

local notation "𝕋" => UnitAddCircle
local notation "haar" => (AddCircle.haarAddCircle : Measure 𝕋)

/-- The base translation angle in the factor of Example 6. -/
def example6Angle (x : 𝕋 × 𝕋) : 𝕋 := x.1 + (2 : ℤ) • x.2

@[fun_prop]
theorem example6Angle_continuous : Continuous example6Angle := by
  unfold example6Angle
  fun_prop

/-- The two independent Cantor base coordinates. -/
noncomputable def example6Base : Measure (𝕋 × 𝕋) := cantorCircleMeasure.prod cantorCircleMeasure

instance : IsProbabilityMeasure example6Base := by
  unfold example6Base
  infer_instance

/-- The sum-fibre factor from Example 6, over the unchanged pair of Cantor base coordinates. -/
noncomputable def example6SumSystem : System (Multiplicative ℤ) ((𝕋 × 𝕋) × 𝕋) where
  measure := example6Base.prod haar
  probability := inferInstance
  act g x := (x.1, x.2 + g.toAdd • example6Angle x.1)
  act_one := by
    funext x
    simp
  act_mul g h := by
    funext x
    change (x.1, x.2 + (g.toAdd + h.toAdd) • example6Angle x.1) =
      (x.1, x.2 + h.toAdd • example6Angle x.1 + g.toAdd • example6Angle x.1)
    rw [add_zsmul]
    congr 1
    abel
  preserves g := by
    refine (MeasurePreserving.id example6Base).skew_product
      (g := fun x y ↦ y + g.toAdd • example6Angle x) (by fun_prop) ?_
    exact ae_of_all _ fun x ↦ (measurePreserving_add_right haar
      (g.toAdd • example6Angle x)).map_eq

/-- Grouping the two Cantor coordinates and the two Haar coordinates preserves the product law. -/
theorem measurePreserving_reorder_cantor_haar :
    MeasurePreserving (fun x : (𝕋 × 𝕋) × (𝕋 × 𝕋) ↦ ((x.1.1, x.2.1), (x.1.2, x.2.2)))
      ((cantorCircleMeasure.prod haar).prod (cantorCircleMeasure.prod haar))
      (example6Base.prod ((haar).prod haar)) := by
  let ν := cantorCircleMeasure
  let m := haar
  have h₁ := measurePreserving_prodAssoc ν m (ν.prod m)
  have h₂ := (MeasurePreserving.id ν).prod
    ((measurePreserving_prodAssoc m ν m).symm MeasurableEquiv.prodAssoc)
  have h₃ := (MeasurePreserving.id ν).prod
    ((Measure.measurePreserving_swap (μ := m) (ν := ν)).prod (MeasurePreserving.id m))
  have h₄ := (MeasurePreserving.id ν).prod (measurePreserving_prodAssoc ν m m)
  have h₅ := (measurePreserving_prodAssoc ν ν (m.prod m)).symm MeasurableEquiv.prodAssoc
  exact h₅.comp (h₄.comp (h₃.comp (h₂.comp h₁)))

/-- The map retaining the two base coordinates and summing the two fibre coordinates
is the factor map used in Example 6. -/
noncomputable def example6SumFactor : FactorMap example6CantorSystem example6SumSystem where
  toFun x := ((x.1.1, x.2.1), x.1.2 + x.2.2)
  preserves :=
    ((MeasurePreserving.id example6Base).prod
      (measurePreserving_fst.comp (measurePreserving_add_prod haar haar))).comp
        measurePreserving_reorder_cantor_haar
  equivariant g := by
    funext x
    change ((x.1.1, x.2.1),
        x.1.2 + (g.toAdd * 1) • x.1.1 + (x.2.2 + (g.toAdd * 2) • x.2.1)) =
      ((x.1.1, x.2.1), x.1.2 + x.2.2 +
        g.toAdd • (x.1.1 + (2 : ℤ) • x.2.1))
    rw [mul_one, zsmul_add, smul_smul]
    congr 1
    abel

/-- The same sum-coordinate factor is a factor of the product of two copies of the
speed-one Cantor skew rotation, as asserted in Example 7. -/
noncomputable def example7SumFactor :
    FactorMap ((circleSkew cantorCircleMeasure 1).prod (circleSkew cantorCircleMeasure 1))
      example6SumSystem :=
  example6SumFactor.comp (example7_productFactor cantorCircleMeasure)

private noncomputable def continuousCircleIntegral (μ : Measure 𝕋) [IsFiniteMeasure μ] :
    C(𝕋, ℂ) →L[ℂ] ℂ :=
  (L1.integralCLM' ℂ).comp (ContinuousMap.toLp (E := ℂ) 1 μ ℂ)

private theorem continuousCircleIntegral_apply (μ : Measure 𝕋) [IsFiniteMeasure μ] (f : C(𝕋, ℂ)) :
    continuousCircleIntegral μ f = ∫ x, f x ∂μ := by
  change L1.integralCLM' ℂ (ContinuousMap.toLp (E := ℂ) 1 μ ℂ f) = _
  rw [← L1.integral_eq' ℂ, L1.integral_eq_integral]
  exact integral_congr_ae (ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 1) μ f)

theorem circleMeasure_eq_of_fourier_eq (μ ν : Measure 𝕋)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ n : ℤ, (∫ x, fourier n x ∂μ) = ∫ x, fourier n x ∂ν) : μ = ν := by
  let Ψ := continuousCircleIntegral μ - continuousCircleIntegral ν
  have hspan : Submodule.span ℂ (Set.range (fourier (T := 1))) ≤ Ψ.ker := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    change continuousCircleIntegral μ (fourier n) - continuousCircleIntegral ν (fourier n) = 0
    rw [continuousCircleIntegral_apply, continuousCircleIntegral_apply, h, sub_self]
  have ht := Submodule.topologicalClosure_minimal _ hspan Ψ.isClosed_ker
  rw [span_fourier_closure_eq_top] at ht
  apply ext_of_forall_integral_eq_of_IsFiniteMeasure
  intro f
  let g : C(𝕋, ℂ) := ⟨fun x ↦ (f x : ℂ), Complex.continuous_ofReal.comp f.continuous⟩
  have hg : continuousCircleIntegral μ g - continuousCircleIntegral ν g = 0 := ht Submodule.mem_top
  rw [continuousCircleIntegral_apply, continuousCircleIntegral_apply] at hg
  change (∫ x, (f x : ℂ) ∂μ) - (∫ x, (f x : ℂ) ∂ν) = 0 at hg
  have hμ : (∫ x, (f x : ℂ) ∂μ) = ((∫ x, f x ∂μ : ℝ) : ℂ) :=
    integral_ofReal (𝕜 := ℂ) (μ := μ) (f := fun x ↦ f x)
  have hν : (∫ x, (f x : ℂ) ∂ν) = ((∫ x, f x ∂ν : ℝ) : ℂ) :=
    integral_ofReal (𝕜 := ℂ) (μ := ν) (f := fun x ↦ f x)
  exact Complex.ofReal_injective ((hμ.symm.trans (sub_eq_zero.mp hg)).trans hν)

theorem integral_haar_fourier_zero (n : ℤ) (hn : n ≠ 0) :
    (∫ x, fourier n x ∂haar) = 0 :=
  integral_eq_zero_of_add_right_eq_neg (μ := haar) (fourier_add_half_inv_index hn (by norm_num))

/-- The translation angle in the sum-coordinate factor is Haar distributed. -/
theorem example6Angle_measurePreserving : MeasurePreserving example6Angle example6Base haar := by
  have hm := example6Angle_continuous.measurable
  let _ : IsProbabilityMeasure (example6Base.map example6Angle) :=
    (Measure.isProbabilityMeasure_map_iff hm.aemeasurable).mpr inferInstance
  refine ⟨hm, circleMeasure_eq_of_fourier_eq _ _ fun n ↦ ?_⟩
  rw [integral_map hm.aemeasurable (fourier (T := 1) n).continuous.aestronglyMeasurable]
  by_cases hn : n = 0
  · subst n
    simp only [fourier_zero, integral_const, probReal_univ, one_smul]
  · rw [integral_haar_fourier_zero n hn]
    have hpoint (x : 𝕋 × 𝕋) : fourier n (example6Angle x) =
        fourier n x.1 * fourier (2 * n) x.2 := by
      simp only [example6Angle, fourier_apply, zsmul_add, AddCircle.toCircle_add, Circle.coe_mul,
        smul_smul, mul_comm n 2]
    simpa only [hpoint, example6Base] using example6_base_fourier_integral_zero n hn


open scoped ComplexConjugate InnerProductSpace in
/-- Every L² weight on the Cantor base has vanishing Fourier coefficients after
transfer to the Haar-distributed translation angle. -/
theorem example6_weighted_angle_fourier_tendsto (h : Lp ℂ 2 example6Base) :
    Tendsto (fun n : ℤ ↦ ∫ x, conj (h x) * fourier n (example6Angle x) ∂example6Base)
      cofinite (𝓝 0) := by
  let W : Lp ℂ 2 haar →ₗᵢ[ℂ] Lp ℂ 2 example6Base :=
    Lp.compMeasurePreservingₗᵢ ℂ example6Angle example6Angle_measurePreserving
  let v (n : ℤ) := W (fourierLp (T := 1) 2 n)
  have hON : Orthonormal ℂ v := by
    rw [orthonormal_iff_ite]
    intro i j
    change ⟪W (fourierLp (T := 1) 2 i), W (fourierLp (T := 1) 2 j)⟫_ℂ = _
    rw [W.inner_map_map]
    exact (orthonormal_iff_ite.mp (orthonormal_fourier (T := 1))) i j
  have hs (n : ℤ) : Real.sqrt (‖⟪v n, h⟫_ℂ‖ ^ 2) = ‖⟪h, v n⟫_ℂ‖ := by
    rw [Real.sqrt_sq (norm_nonneg _), norm_inner_symm]
  have ht : Tendsto (fun n ↦ ⟪h, v n⟫_ℂ) cofinite (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    have hsqrt := (Real.continuous_sqrt.tendsto (0 : ℝ)).comp
      (hON.inner_products_summable h).tendsto_cofinite_zero
    change Tendsto (fun n : ℤ ↦ Real.sqrt (‖⟪v n, h⟫_ℂ‖ ^ 2)) cofinite
      (𝓝 (Real.sqrt 0)) at hsqrt
    simpa only [hs, Real.sqrt_zero] using hsqrt
  have hv (n : ℤ) : v n =ᵐ[example6Base] fun x ↦ fourier n (example6Angle x) :=
    (Lp.coeFn_compMeasurePreserving _ example6Angle_measurePreserving).trans
      (example6Angle_measurePreserving.quasiMeasurePreserving.ae_eq_comp
        (coeFn_fourierLp (T := 1) 2 n))
  have heq (n : ℤ) : ⟪h, v n⟫_ℂ =
      ∫ x, conj (h x) * fourier n (example6Angle x) ∂example6Base := by
    rw [MeasureTheory.L2.inner_def]
    apply integral_congr_ae
    filter_upwards [hv n] with x hx
    rw [hx, RCLike.inner_apply']
  simpa only [heq] using ht

open scoped ComplexConjugate in
/-- The weighted decay holds on each nonzero fibre Fourier mode. -/
theorem example6_weighted_fibre_fourier_tendsto (h : Lp ℂ 2 example6Base)
    (t : ℤ) (ht : t ≠ 0) :
    Tendsto (fun n : ℤ ↦ ∫ x, conj (h x) * fourier (t * n) (example6Angle x) ∂example6Base)
      cofinite (𝓝 0) := by
  have hinj : Function.Injective (fun n : ℤ ↦ t * n) := fun _ _ h ↦ mul_left_cancel₀ ht h
  exact (example6_weighted_angle_fourier_tendsto h).comp hinj.tendsto_cofinite

end Mixing
end

/- Source module Mixing.CantorProductGeneration. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Generation of the Cantor product systems in Examples 6 and 7 -/


open MeasureTheory Filter
open scoped InnerProductSpace Topology

namespace Mixing

/-- The product case of Lemma 9, expressed in terms of the ordinary binary product. -/
theorem System.isUGenerated_prod_union {G X Y : Type*} [CommGroup G]
    [MeasurableSpace X] [MeasurableSpace Y] (S : System G X) (T : System G Y)
    (P Q : Set (Ultrafilter G)) (hS : S.IsUGenerated P) (hT : T.IsUGenerated Q) :
    (S.prod T).IsUGenerated (P ∪ Q) := by
  apply (S.prod T).isUGenerated_of_generatedSigma_eq
  apply le_antisymm ((S.prod T).generatedSigma_le _)
  let J := product_isJoining S T
  have hfst := J.fstFactor.measurable_generatedSigma (P := P) (Set.subset_union_left (t := Q))
  have hsnd := J.sndFactor.measurable_generatedSigma (P := Q) (Set.subset_union_right (s := P))
  rw [S.generatedSigma_eq_of_isUGenerated hS] at hfst
  rw [T.generatedSigma_eq_of_isUGenerated hT] at hsnd
  have hi : @Measurable (X × Y) (X × Y) ((S.prod T).generatedSigma (P ∪ Q)) _ id :=
    hfst.prodMk hsnd
  simpa only [measurable_iff_comap_le, MeasurableSpace.comap_id] using hi

/-- Doubling an integer, written in the multiplicative presentation of the acting group. -/
def cantorDilation (g : Multiplicative ℤ) : Multiplicative ℤ :=
  Multiplicative.ofAdd (g.toAdd * 2)

private theorem cantorDilation_injective : Function.Injective cantorDilation := by
  intro g h he
  change g.toAdd * 2 = h.toAdd * 2 at he
  have hh : g.toAdd = h.toAdd := mul_right_cancel₀ (by decide : (2 : ℤ) ≠ 0) he
  exact hh

private theorem cantorDilation_map_free (p : Ultrafilter (Multiplicative ℤ))
    (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite) :
    ((p.map cantorDilation : Ultrafilter (Multiplicative ℤ)) : Filter (Multiplicative ℤ)) ≤
      cofinite := by
  exact (Filter.map_mono hp).trans cantorDilation_injective.tendsto_cofinite

private theorem cantorDilation_map_map_support (p : Ultrafilter (Multiplicative ℤ))
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈
      (p.map cantorDilation).map cantorDilation := by
  change cantorDilation ⁻¹' (cantorDilation ⁻¹' _) ∈ p
  refine Filter.mem_of_superset hsupp ?_
  rintro _ ⟨j, rfl⟩
  refine ⟨j + 1, ?_⟩
  change (4 : ℤ)^(j + 1) = ((4 : ℤ)^j * 2) * 2
  rw [pow_succ]
  ring

private theorem cantorDouble_koopman (g : Multiplicative ℤ)
    (x : Lp ℂ 2 example5CantorSystem.measure) :
    (circleSkew cantorCircleMeasure 2).koopmanRep g x =
      example5CantorSystem.koopmanRep (cantorDilation g) x := by
  have hact : (circleSkew cantorCircleMeasure 2).act g =
      example5CantorSystem.act (cantorDilation g) := by
    funext w
    change (w.1, w.2 + (g.toAdd * 2) • w.1) =
      (w.1, w.2 + ((g.toAdd * 2) * 1) • w.1)
    rw [mul_one]
  apply Lp.ext
  exact (Lp.coeFn_compMeasurePreserving x ((circleSkew cantorCircleMeasure 2).preserves g)).trans
    ((EventuallyEq.of_eq (congrArg (fun a ↦ (x : _ → ℂ) ∘ a) hact)).trans
      (Lp.coeFn_compMeasurePreserving x (example5CantorSystem.preserves (cantorDilation g))).symm)

private theorem cantorDouble_ultrafilterOperator (q : Ultrafilter (Multiplicative ℤ)) :
    ultrafilterOperator (circleSkew cantorCircleMeasure 2).koopmanRep q =
      ultrafilterOperator example5CantorSystem.koopmanRep (q.map cantorDilation) := by
  apply ContinuousLinearMap.ext
  intro x
  apply ext_inner_left ℂ
  intro y
  have h₂ := tendsto_ultrafilterOperator_coeff (circleSkew cantorCircleMeasure 2).koopmanRep q y x
  have h₂' := h₂.congr (fun g ↦ congrArg (inner ℂ y) (cantorDouble_koopman g x))
  have h₁ := tendsto_ultrafilterOperator_coeff example5CantorSystem.koopmanRep
    (q.map cantorDilation) y x
  have h₁' := h₁.comp (tendsto_map (f := cantorDilation) (x := (q : Filter (Multiplicative ℤ))))
  exact tendsto_nhds_unique h₂' h₁'

private theorem cantorDouble_isUGenerated_from (q : Ultrafilter (Multiplicative ℤ))
    (hgen : example5CantorSystem.IsUGenerated {q.map cantorDilation}) :
    (circleSkew cantorCircleMeasure 2).IsUGenerated {q} := by
  let T := circleSkew cantorCircleMeasure 2
  have htranslate (f : BoundedObservable (UnitAddCircle × UnitAddCircle)) :
      T.ultrafilterTranslate q f =
        example5CantorSystem.ultrafilterTranslate (q.map cantorDilation) f := by
    unfold System.ultrafilterTranslate
    change BoundedObservable.ofLp
        (ultrafilterOperator T.koopmanRep q (f.l2 T.measure)) f.bound f.bound_nonneg = _
    rw [cantorDouble_ultrafilterOperator q]
    rfl
  have hsub : example5CantorSystem.generatedProducts {q.map cantorDilation} ⊆
      T.generatedProducts {q} := by
    rintro _ ⟨n, p, f, hp, rfl⟩
    have he : p = fun _ ↦ q.map cantorDilation :=
      funext fun i ↦ Set.mem_singleton_iff.mp (hp i)
    subst p
    refine ⟨n, fun _ ↦ q, f, fun _ ↦ rfl, ?_⟩
    unfold System.ultrafilterProduct
    simp_rw [htranslate]
    rfl
  exact hgen.mono (Submodule.span_mono hsub)

/-- Doubling the ultrafilter generates the speed-two skew rotation, as in (12). -/
theorem example6_doubleSpeed_isUGenerated (p : Ultrafilter (Multiplicative ℤ))
    (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    (circleSkew cantorCircleMeasure 2).IsUGenerated {p.map cantorDilation} :=
  cantorDouble_isUGenerated_from (p.map cantorDilation)
    (example5_cantor_isUGenerated _ (cantorDilation_map_free _ (cantorDilation_map_free p hp))
      (cantorDilation_map_map_support p hsupp))

/-- Example 6's product is generated by the original ultrafilter and its double. -/
theorem example6_cantor_product_isUGenerated (p : Ultrafilter (Multiplicative ℤ))
    (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    example6CantorSystem.IsUGenerated {p, p.map cantorDilation} := by
  have h := System.isUGenerated_prod_union example5CantorSystem (circleSkew cantorCircleMeasure 2)
    {p} {p.map cantorDilation} (example5_cantor_isUGenerated p hp hsupp)
      (example6_doubleSpeed_isUGenerated p hp hsupp)
  change (example5CantorSystem.prod (circleSkew cantorCircleMeasure 2)).IsUGenerated _
  simpa only [Set.singleton_union] using h

/-- The source system in Example 7 is generated by the same single free ultrafilter. -/
theorem example7_cantor_product_isUGenerated (p : Ultrafilter (Multiplicative ℤ))
    (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    (example5CantorSystem.prod example5CantorSystem).IsUGenerated {p} := by
  have h := example5_cantor_isUGenerated p hp hsupp
  simpa only [Set.union_self] using
    System.isUGenerated_prod_union example5CantorSystem example5CantorSystem {p} {p} h h


/-- Projection onto the second skew rotation of the Example 6 product. -/
noncomputable def example6SecondProjection :
    FactorMap example6CantorSystem (circleSkew cantorCircleMeasure 2) :=
  (product_isJoining example5CantorSystem (circleSkew cantorCircleMeasure 2)).sndFactor

/-- Equation (12), for the fibre character of the second skew rotation in the product. -/
theorem example6_second_fibre_eigenvector (p : Ultrafilter (Multiplicative ℤ))
    (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    let f := circlePairFourierLp (circleSkew cantorCircleMeasure 2).measure ![0, 1]
    ultrafilterOperator example6CantorSystem.koopmanRep (p.map cantorDilation)
      (example6SecondProjection.pullback f) =
      cantorFourier (-1) • example6SecondProjection.pullback f := by
  let q := p.map cantorDilation
  let n : Fin 2 → ℤ := ![0, 1]
  let f := circlePairFourierLp example5CantorSystem.measure n
  let J : Lp ℂ 2 example5CantorSystem.measure →ₗᵢ[ℂ] Lp ℂ 2 example6CantorSystem.measure :=
    example6SecondProjection.pullback
  change ultrafilterOperator example6CantorSystem.koopmanRep q
      (J f) = cantorFourier (-1) • J f
  have hcomm := example6SecondProjection.intertwines_pullback.ultrafilter q f
  have h := example5_cantor_ultrafilter_eigenvector n (q.map cantorDilation)
    (cantorDilation_map_free q (cantorDilation_map_free p hp)) (cantorDilation_map_map_support p hsupp)
  have hn : n 1 = 1 := rfl
  have hf : ultrafilterOperator example5CantorSystem.koopmanRep (q.map cantorDilation) f =
      cantorFourier (-1) • f := by
    simpa only [hn, Int.cast_neg, Int.cast_one] using h
  calc
    _ = J (ultrafilterOperator (circleSkew cantorCircleMeasure 2).koopmanRep q f) := hcomm.symm
    _ = J (ultrafilterOperator example5CantorSystem.koopmanRep (q.map cantorDilation) f) :=
      congrArg J (DFunLike.congr_fun (cantorDouble_ultrafilterOperator q) f)
    _ = J (cantorFourier (-1) • f) := congrArg J hf
    _ = _ := map_smul J _ _

end Mixing
end

/- Source module Mixing.CyclicSpectral. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # The commutative operator algebra of a unitary representation -/


open Filter Set WeakDual
open scoped ComplexConjugate InnerProductSpace IsMulCommutative Topology

namespace Mixing

variable {G H : Type*} [Group G] [IsMulCommutative G] [NormedAddCommGroup H]
  [InnerProductSpace ℂ H] [CompleteSpace H]

noncomputable section

variable (U : G →* (H ≃ₗᵢ[ℂ] H))

/-- The bounded operators in the norm-closed unital star algebra generated by the action. -/
def spectralAlgebra : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range (linearRepresentation U))).topologicalClosure

theorem linearRepresentation_star (g : G) :
    star (linearRepresentation U g) = linearRepresentation U g⁻¹ := by
  change (U g : H →L[ℂ] H).adjoint = (U g⁻¹ : H →L[ℂ] H)
  rw [LinearIsometryEquiv.adjoint_eq_symm, map_inv]
  rfl

omit [CompleteSpace H] in
theorem linearRepresentation_commute (a b : G) :
    Commute (linearRepresentation U a) (linearRepresentation U b) := by
  change linearRepresentation U a * linearRepresentation U b =
    linearRepresentation U b * linearRepresentation U a
  rw [← map_mul, ← map_mul, mul_comm' a b]

instance spectralAlgebra_isMulCommutative : IsMulCommutative (spectralAlgebra U) := by
  let _ : IsMulCommutative (StarAlgebra.adjoin ℂ (Set.range (linearRepresentation U))) := by
    apply StarAlgebra.isMulCommutative_adjoin
    · rintro _ ⟨g, rfl⟩
      exact ⟨linearRepresentation_star U g ▸ linearRepresentation_commute U g⁻¹ g⟩
    · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩ _
      exact linearRepresentation_commute U a b
    · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩ _
      rw [linearRepresentation_star]
      exact linearRepresentation_commute U a b⁻¹
  unfold spectralAlgebra
  infer_instance

instance spectralAlgebra_cstarAlgebra : CStarAlgebra (spectralAlgebra U) :=
  StarSubalgebra.cstarAlgebra _ (h_closed := StarSubalgebra.isClosed_topologicalClosure _)

instance spectralAlgebra_commCStarAlgebra : CommCStarAlgebra (spectralAlgebra U) := inferInstance

/-- The original unitary operators take values in their generated C⋆-algebra. -/
def spectralGenerator : G →* spectralAlgebra U where
  toFun g := ⟨linearRepresentation U g,
    StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩)⟩
  map_one' := Subtype.ext (by
    change linearRepresentation U 1 = 1
    ext x
    change U 1 x = x
    rw [map_one]
    rfl)
  map_mul' a b := Subtype.ext (map_mul (linearRepresentation U) a b)

theorem spectralGenerator_star (g : G) :
    star (spectralGenerator U g) = spectralGenerator U g⁻¹ :=
  Subtype.ext (linearRepresentation_star U g)

/-- The compact Gelfand spectrum of the operator algebra. -/
abbrev RepresentationSpectrum := characterSpace ℂ (spectralAlgebra U)

/-- The inverse Gelfand transform, interpreted as a bounded Hilbert-space operator. -/
def spectralCalculus : C(RepresentationSpectrum U, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) :=
  (StarSubalgebra.subtype (spectralAlgebra U)).comp
    (gelfandStarTransform (spectralAlgebra U)).symm.toStarAlgHom

/-- Evaluation of a spectrum point on the original generators gives a unitary character. -/
def spectralPointCharacter (z : RepresentationSpectrum U) : G →* Circle where
  toFun g := ⟨z (spectralGenerator U g), by
    apply mem_sphere_zero_iff_norm.mpr
    let f := gelfandStarTransform (spectralAlgebra U)
    have he : conj (z (spectralGenerator U g)) * z (spectralGenerator U g) = 1 := by
      have h : star (spectralGenerator U g) * spectralGenerator U g = 1 := by
        rw [spectralGenerator_star, ← map_mul, inv_mul_cancel, map_one]
      have hEval (a : spectralAlgebra U) : f a z = z a := rfl
      have heq := congrArg (fun a : spectralAlgebra U => f a z) h
      simpa only [map_mul, map_star, map_one, ContinuousMap.mul_apply, ContinuousMap.star_apply,
        ContinuousMap.one_apply, Complex.star_def, hEval] using heq
    have hn := congrArg norm he
    rw [norm_mul, Complex.norm_conj, norm_one] at hn
    nlinarith [norm_nonneg (z (spectralGenerator U g))]⟩
  map_one' := Subtype.ext (by
    change z (spectralGenerator U 1) = 1
    rw [map_one, map_one])
  map_mul' a b := Subtype.ext (by
    change z (spectralGenerator U (a * b)) = z (spectralGenerator U a) * z (spectralGenerator U b)
    rw [map_mul, map_mul])

/-- The continuous function on the spectrum for a single group element. -/
def spectralCoefficient (g : G) : C(RepresentationSpectrum U, ℂ) :=
  gelfandStarTransform (spectralAlgebra U) (spectralGenerator U g)

theorem spectralCoefficient_apply (g : G) (z : RepresentationSpectrum U) :
    spectralCoefficient U g z = (spectralPointCharacter U z g : ℂ) := rfl

theorem spectralCalculus_spectralCoefficient (g : G) :
    spectralCalculus U (spectralCoefficient U g) = linearRepresentation U g := by
  let Γ := gelfandStarTransform (spectralAlgebra U)
  change ((Γ.symm (Γ (spectralGenerator U g)) : spectralAlgebra U) : H →L[ℂ] H) = _
  rw [Γ.symm_apply_apply]
  rfl

/-- A finitely supported coefficient vector evaluated as a trigonometric polynomial. -/
def trigonometricPolynomial (a : G →₀ ℂ) (χ : G →* Circle) : ℂ :=
  a.sum (fun g c => c * (χ g : ℂ))

/-- The same polynomial evaluated at the represented operators. -/
def trigonometricOperator (a : G →₀ ℂ) : H →L[ℂ] H :=
  a.sum (fun g c => c • linearRepresentation U g)

/-- The polynomial made into a continuous function on the representation spectrum. -/
def spectralPolynomial (a : G →₀ ℂ) : C(RepresentationSpectrum U, ℂ) :=
  a.sum (fun g c => c • spectralCoefficient U g)

theorem spectralPolynomial_apply (a : G →₀ ℂ) (z : RepresentationSpectrum U) :
    spectralPolynomial U a z = trigonometricPolynomial a (spectralPointCharacter U z) := by
  simp only [spectralPolynomial, trigonometricPolynomial, Finsupp.sum, ContinuousMap.sum_apply,
    ContinuousMap.smul_apply, smul_eq_mul, spectralCoefficient_apply]

theorem spectralCalculus_spectralPolynomial (a : G →₀ ℂ) :
    spectralCalculus U (spectralPolynomial U a) = trigonometricOperator U a := by
  simp only [spectralPolynomial, trigonometricOperator, Finsupp.sum, map_sum, map_smul,
    spectralCalculus_spectralCoefficient]

theorem spectralCalculus_norm (f : C(RepresentationSpectrum U, ℂ)) :
    ‖spectralCalculus U f‖ = ‖f‖ := by
  let Γ := gelfandStarTransform (spectralAlgebra U)
  have h : Isometry Γ := gelfandTransform_isometry (spectralAlgebra U)
  have hn := h.norm_map_of_map_zero (map_zero Γ) (Γ.symm f)
  rw [Γ.apply_symm_apply] at hn
  exact hn.symm

theorem spectralPointCharacter_injective : Function.Injective (spectralPointCharacter U) := by
  intro z w he
  let Γ := gelfandStarTransform (spectralAlgebra U)
  let φ : spectralAlgebra U →⋆ₐ[ℂ] ℂ := (ContinuousMap.evalStarAlgHom ℂ ℂ z).comp Γ.toStarAlgHom
  let ψ : spectralAlgebra U →⋆ₐ[ℂ] ℂ := (ContinuousMap.evalStarAlgHom ℂ ℂ w).comp Γ.toStarAlgHom
  have hφ : Continuous φ := map_continuous z
  have hψ : Continuous ψ := map_continuous w
  have h : φ = ψ := by
    apply StarAlgHom.ext_topologicalClosure hφ hψ
    apply StarAlgHom.ext_adjoin
    rintro ⟨a, ha⟩ ⟨g, rfl⟩
    change (spectralPointCharacter U z g : ℂ) = (spectralPointCharacter U w g : ℂ)
    rw [he]
  exact DFunLike.ext z w (fun a => congrArg (fun F : spectralAlgebra U →⋆ₐ[ℂ] ℂ => F a) h)

end

end Mixing
end

/- Source module Mixing.CyclicMeasure. -/
section
/-
