/-- Alternate binary digit blocks whose endpoints are consecutive squares. -/
def evenMask : Set ℕ := {k | ∃ i : ℕ, (2*i)^2 ≤ k ∧ k < (2*i + 1)^2}

private theorem notMem_evenMask_of_oddBlock {i k : ℕ}
    (hk : (2*i+1)^2 ≤ k) (hk' : k < (2*i+2)^2) : k ∉ evenMask := by
  rintro ⟨j, hJ, hJ'⟩
