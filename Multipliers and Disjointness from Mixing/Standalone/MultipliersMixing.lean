    (BoundedObservable.const c).l2 T.measure ∈ T.generatedProductsClosure U := by
  let p : Fin 0 → Ultrafilter G := Fin.elim0
  let f : Fin 0 → BoundedObservable X := Fin.elim0
  have h := (T.generatedProductsClosure U).smul_mem c
