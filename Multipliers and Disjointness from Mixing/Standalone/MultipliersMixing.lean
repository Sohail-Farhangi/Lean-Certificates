/-! # The Lebesgue spectrum in Example 6 -/


open MeasureTheory Filter
open scoped ComplexConjugate InnerProductSpace Topology

namespace Mixing

local notation "𝕋" => UnitAddCircle
local notation "𝕏" => ((UnitAddCircle × UnitAddCircle) × (UnitAddCircle × UnitAddCircle))
local notation "haar" => (AddCircle.haarAddCircle : Measure 𝕋)

section IntegerSpectrum

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (U : Multiplicative ℤ →* (H ≃ₗᵢ[ℂ] H))

/-- A spectral point for a ℤ-representation is viewed on the unit circle by evaluating
its character at the integer generator and expressing that value as an angle. -/
noncomputable def integerSpectralAngle (z : RepresentationSpectrum U) : 𝕋 :=
  (AddCircle.homeomorphCircle (T := (1 : ℝ)) one_ne_zero).symm
    (spectralPointCharacter U z (Multiplicative.ofAdd 1))

theorem integerSpectralAngle_continuous : Continuous (integerSpectralAngle U) :=
  (AddCircle.homeomorphCircle (T := (1 : ℝ)) one_ne_zero).symm.continuous.comp
    ((spectralCoefficient U (Multiplicative.ofAdd 1)).continuous.subtype_mk _)

theorem integerSpectralAngle_fourier (n : ℤ) (z : RepresentationSpectrum U) :
    fourier n (integerSpectralAngle U z) = spectralCoefficient U (Multiplicative.ofAdd n) z := by
  let e := AddCircle.homeomorphCircle (T := (1 : ℝ)) one_ne_zero
  have hp : (Multiplicative.ofAdd (1 : ℤ)) ^ n = Multiplicative.ofAdd n := by
    change n • (1 : ℤ) = n
    simp
  rw [fourier_apply, AddCircle.toCircle_zsmul, spectralCoefficient_apply]
  have he : AddCircle.toCircle (integerSpectralAngle U z) =
      spectralPointCharacter U z (Multiplicative.ofAdd 1) := by
    rw [← AddCircle.homeomorphCircle_apply one_ne_zero]
    exact e.apply_symm_apply _
  rw [he, ← map_zpow, hp]

/-- The vector spectral measure in the usual angle coordinates for ℤ. -/
noncomputable def integerVectorSpectralMeasure (f : H) : Measure 𝕋 :=
  (vectorSpectralMeasure U f).map (integerSpectralAngle U)

instance (f : H) : IsFiniteMeasure (integerVectorSpectralMeasure U f) :=
  Measure.isFiniteMeasure_map _ _

/-- Fourier moments of the vector spectral measure are the Koopman autocorrelations. -/
theorem integral_fourier_integerVectorSpectralMeasure (f : H) (n : ℤ) :
    (∫ x, fourier n x ∂integerVectorSpectralMeasure U f) =
      ⟪f, U (Multiplicative.ofAdd n) f⟫_ℂ := by
  rw [integerVectorSpectralMeasure,
    integral_map (integerSpectralAngle_continuous U).measurable.aemeasurable
      (fourier (T := 1) n).continuous.aestronglyMeasurable]
  simp_rw [integerSpectralAngle_fourier]
  rw [integral_vectorSpectralMeasure, spectralCalculus_spectralCoefficient]
  rfl

end IntegerSpectrum

/-- The character of frequency `t` of the sum of the two fibre coordinates. -/
noncomputable def example6FibreCharacterContinuous (t : ℤ) : C(𝕏, ℂ) where
  toFun := example6CantorCharacter t
  continuous_toFun := by unfold example6CantorCharacter; fun_prop

/-- The vector `f_t` in the Example 6 product system. -/
noncomputable def example6FibreCharacterLp (t : ℤ) : Lp ℂ 2 example6CantorSystem.measure :=
  ContinuousMap.toLp (E := ℂ) 2 example6CantorSystem.measure ℂ
    (example6FibreCharacterContinuous t)

theorem example6FibreCharacterLp_autocorrelation (t n : ℤ) :
    ⟪example6FibreCharacterLp t,
      example6CantorSystem.koopmanRep (Multiplicative.ofAdd n) (example6FibreCharacterLp t)⟫_ℂ =
      if t * n = 0 then 1 else 0 := by
  let g := Multiplicative.ofAdd n
  have hAe : example6FibreCharacterLp t =ᵐ[example6CantorSystem.measure] example6CantorCharacter t :=
    ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) example6CantorSystem.measure
      (example6FibreCharacterContinuous t)
  have hAction : example6CantorSystem.koopmanRep g (example6FibreCharacterLp t) =ᵐ[
      example6CantorSystem.measure] fun x ↦ example6CantorCharacter t (example6CantorSystem.act g x) :=
    (Lp.coeFn_compMeasurePreserving _ (example6CantorSystem.preserves g)).trans
      ((example6CantorSystem.preserves g).quasiMeasurePreserving.ae_eq_comp hAe)
  rw [← example6_cantorCharacter_autocorrelation, MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hAe, hAction] with x hfx hActx
  rw [hfx, hActx, RCLike.inner_apply']

/-- Example 6's nonzero fibre characters have exactly normalized Lebesgue spectral measure. -/
theorem example6_fibreLebesgueSpectralMeasure (t : ℤ) (ht : t ≠ 0) :
    integerVectorSpectralMeasure example6CantorSystem.koopmanRep (example6FibreCharacterLp t) =
      haar := by
  apply circleMeasure_eq_of_fourier_eq
  intro n
  rw [integral_fourier_integerVectorSpectralMeasure, example6FibreCharacterLp_autocorrelation]
  by_cases hn : n = 0
  · subst n
    simp
  · rw [ite_eq_right (mul_ne_zero ht hn), integral_haar_fourier_zero n hn]

end Mixing
end

/- Source module Mixing.CantorSpeedEigenvectors. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Ultrafilter eigenvectors for the Cantor skew rotations of arbitrary integer speed -/


open MeasureTheory Filter
open scoped ComplexConjugate InnerProductSpace Topology

namespace Mixing

private theorem cantorSpeed_correlations (s a b c d : ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    Tendsto (fun g : Multiplicative ℤ ↦
      ∫ x, example5CantorCharacter a b x *
        example5CantorCharacter d c ((circleSkew cantorCircleMeasure s).act g x)
        ∂(circleSkew cantorCircleMeasure s).measure)
      (p : Filter (Multiplicative ℤ)) (𝓝 (cantorFourier ((-(a + d) : ℤ) : ℝ) *
        cantorFourier ((-c * s : ℤ) : ℝ) *
        (∫ y : UnitAddCircle, fourier (b + c) y ∂AddCircle.haarAddCircle))) := by
  have hInj : Function.Injective (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) :=
    (pow_right_strictMono₀ (by norm_num : (1 : ℤ) < 4)).injective
  refine (tendsto_injective_sequence_iff _ hInj (fun g ↦
    ∫ x, example5CantorCharacter a b x *
      example5CantorCharacter d c ((circleSkew cantorCircleMeasure s).act g x)
      ∂(circleSkew cantorCircleMeasure s).measure) _).mp ?_ p hp hsupp
  have hfinite (j : ℕ) :
      (∫ x, example5CantorCharacter a b x *
        example5CantorCharacter d c
          ((circleSkew cantorCircleMeasure s).act (Multiplicative.ofAdd ((4 : ℤ)^j)) x)
        ∂(circleSkew cantorCircleMeasure s).measure) =
        cantorFourier (((-c * s) * (4 : ℤ)^j + (-(a + d)) : ℤ) : ℝ) *
          (∫ y : UnitAddCircle, fourier (b + c) y ∂AddCircle.haarAddCircle) := by
    have hact : (circleSkew cantorCircleMeasure s).act (Multiplicative.ofAdd ((4 : ℤ)^j)) =
        (circleSkew cantorCircleMeasure 1).act (Multiplicative.ofAdd ((4 : ℤ)^j * s)) := by
      funext x
      change (x.1, x.2 + ((4 : ℤ)^j * s) • x.1) =
        (x.1, x.2 + (((4 : ℤ)^j * s) * 1) • x.1)
      rw [mul_one]
    have hi : (-c * ((4 : ℤ)^j * s) - (a + d)) =
        (-c * s) * (4 : ℤ)^j + -(a + d) := by ring
    rw [hact]
    change (∫ x, example5CantorCharacter a b x *
        example5CantorCharacter d c
          ((circleSkew cantorCircleMeasure 1).act (Multiplicative.ofAdd ((4 : ℤ)^j * s)) x)
        ∂(circleSkew cantorCircleMeasure 1).measure) = _
    rw [example5_cantor_character_correlation, hi]
  change Tendsto (fun j : ℕ ↦
    ∫ x, example5CantorCharacter a b x * example5CantorCharacter d c
      ((circleSkew cantorCircleMeasure s).act (Multiplicative.ofAdd ((4 : ℤ)^j)) x)
      ∂(circleSkew cantorCircleMeasure s).measure) atTop _
  simp_rw [hfinite]
  exact (cantorFourier_tendsto_four_pow_add (-c * s) (-(a + d))).mul tendsto_const_nhds

private theorem cantorSpeed_inner (s : ℤ) (m n : Fin 2 → ℤ) (g : Multiplicative ℤ) :
    let T := circleSkew cantorCircleMeasure s
    ⟪circlePairFourierLp T.measure m, T.koopmanRep g (circlePairFourierLp T.measure n)⟫_ℂ =
      ∫ x, example5CantorCharacter (-(m 0)) (-(m 1)) x *
        example5CantorCharacter (n 0) (n 1) (T.act g x) ∂T.measure := by
  let T := circleSkew cantorCircleMeasure s
  change ⟪circlePairFourierLp T.measure m, T.koopmanRep g (circlePairFourierLp T.measure n)⟫_ℂ = _
  rw [MeasureTheory.L2.inner_def]
  have hn : T.koopmanRep g (circlePairFourierLp T.measure n) =ᵐ[T.measure]
      fun x ↦ example5CantorCharacter (n 0) (n 1) (T.act g x) :=
    (Lp.coeFn_compMeasurePreserving _ (T.preserves g)).trans
      ((T.preserves g).quasiMeasurePreserving.ae_eq_comp (circlePairFourierLp_ae_eq T.measure n))
  apply integral_congr_ae
  filter_upwards [circlePairFourierLp_ae_eq T.measure m, hn] with x hmx hnx
  rw [hmx, hnx, RCLike.inner_apply']
  simp only [example5CantorCharacter, map_mul, ← fourier_neg]
  rfl

/-- The Cantor character eigenvalue for a skew rotation of integer speed. -/
theorem cantorSpeed_ultrafilter_eigenvector (s : ℤ) (n : Fin 2 → ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    let T := circleSkew cantorCircleMeasure s
    ultrafilterOperator T.koopmanRep p (circlePairFourierLp T.measure n) =
      cantorFourier ((-(n 1) * s : ℤ) : ℝ) • circlePairFourierLp T.measure n := by
  let T := circleSkew cantorCircleMeasure s
  let v := circlePairFourierLp T.measure n
  let c := cantorFourier ((-(n 1) * s : ℤ) : ℝ)
  let y := ultrafilterOperator T.koopmanRep p v - c • v
  have hinner (m : Fin 2 → ℤ) :
      ⟪circlePairFourierLp T.measure m, ultrafilterOperator T.koopmanRep p v⟫_ℂ =
        ⟪circlePairFourierLp T.measure m, c • v⟫_ℂ := by
    have hlim := tendsto_ultrafilterOperator_coeff T.koopmanRep p
      (circlePairFourierLp T.measure m) v
    change Tendsto (fun g ↦ ⟪circlePairFourierLp T.measure m,
      T.koopmanRep g (circlePairFourierLp T.measure n)⟫_ℂ) _ _ at hlim
    have hlim' := hlim.congr (fun g ↦ cantorSpeed_inner s m n g)
    have hvalue := tendsto_nhds_unique hlim'
      (cantorSpeed_correlations s (-(m 0)) (-(m 1)) (n 1) (n 0) p hp hsupp)
    have hbase :
        ⟪circlePairFourierLp T.measure m, v⟫_ℂ =
          cantorFourier ((-(-(m 0) + n 0) : ℤ) : ℝ) *
            ∫ y : UnitAddCircle, fourier (-(m 1) + n 1) y ∂AddCircle.haarAddCircle := by
      have ht := cantorSpeed_inner s m n 1
      change ⟪circlePairFourierLp T.measure m, T.koopmanRep 1 v⟫_ℂ = _ at ht
      have hact₁ : T.act 1 = id := T.act_one
      rw [map_one, hact₁] at ht
      have h₀ := example5_cantor_character_correlation (-(m 0)) (-(m 1)) (n 1) (n 0) 0
      rw [show Multiplicative.ofAdd (0 : ℤ) = 1 from rfl,
        (circleSkew cantorCircleMeasure 1).act_one, mul_zero, zero_sub] at h₀
      exact ht.trans h₀
    rw [hvalue, inner_smul_right, hbase]
    dsimp only [c]
    ring
  have hspan : Submodule.span ℂ (Set.range (circlePairFourierLp T.measure)) ≤ (innerSL ℂ y).ker := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨m, rfl⟩
    change ⟪y, circlePairFourierLp T.measure m⟫_ℂ = 0
    rw [inner_eq_zero_symm]
    dsimp only [y]
    rw [inner_sub_right, hinner, sub_self]
  have ht := Submodule.topologicalClosure_minimal _ hspan (innerSL ℂ y).isClosed_ker
  rw [circlePairFourierLp_closure_span] at ht
  exact sub_eq_zero.mp ((inner_self_eq_zero (𝕜 := ℂ)).mp (ht Submodule.mem_top))

end Mixing
end

/- Source module Mixing.CantorSumModes. -/
section
/-
