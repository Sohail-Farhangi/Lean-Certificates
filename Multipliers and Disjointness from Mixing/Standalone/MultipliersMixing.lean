/-!
# The spacer cocycle in the polynomial weak limits of Chacon's automorphism

The identities below use the actual spacer set of `chaconTowerSystem`. The
polynomial recursion is Theorem 3.3 of Janvresse, Prikhod’ko, de la Rue and
Ryzhikov, arXiv:1301.2904.
-/


open MeasureTheory MeasureTheory.Measure Polynomial Set
open scoped Classical ENNReal

namespace Mixing

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The zero-or-one spacer function of the Chacon tower. -/
noncomputable def chaconSpacerBit (x : ChaconOdometer) : ℕ :=
  if x ∈ chaconSpacer then 1 else 0

private theorem chaconSpacer_divides (x : ChaconOdometer) :
    x ∈ chaconSpacer ↔ ∃ n : ℕ, (3 : ChaconOdometer) ^ (n + 1) ∣ x + 1 - 2 * 3^n := by
  simp only [chaconSpacer, mem_iUnion, mem_ofPred_eq]
  refine exists_congr fun n ↦ ?_
  rw [PadicInt.norm_le_pow_iff_mem_span_pow (p := 3) _ (n+1), Ideal.mem_span_singleton, Nat.cast_ofNat]

theorem chaconSpacerBit_three_mul (x : ChaconOdometer) :
    chaconSpacerBit (3*x) = 0 := by
  have hs : (3*x : ChaconOdometer) ∉ chaconSpacer := by
    intro hx
    obtain ⟨n, hn⟩ := (chaconSpacer_divides _).mp hx
    have h := (dvd_pow_self (3 : ChaconOdometer) (by omega : n + 1 ≠ 0)).trans hn
    have hr : PadicInt.toZModPow (p := 3) 1 (3*x + 1 - 2*3^n) = 0 := by
      rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton, pow_one]
      exact h
    rw [map_sub, map_add, map_mul, map_ofNat, map_one, map_mul, map_ofNat, map_pow, map_ofNat] at hr
    change (0 : ZMod 3) * _ + 1 - 2 * 0^n = 0 at hr
    cases n with
    | zero =>
      simp only [zero_mul, zero_add, pow_zero, mul_one] at hr
      exact (by decide : (1:ZMod 3) - 2 ≠ 0) hr
    | succ n => simp at hr
  exact ite_eq_right_iff.mpr fun h => (hs h).elim

theorem chaconSpacerBit_three_mul_add_one (x : ChaconOdometer) :
    chaconSpacerBit (3*x+1) = 1 := by
  have hs : (3*x + 1 : ChaconOdometer) ∈ chaconSpacer := by
    refine (chaconSpacer_divides _).mpr ⟨0, ?_⟩
    rw [show (3*x+1+1-2*3^0 : ChaconOdometer) = 3*x by ring]
    exact dvd_mul_right _ _
  simp only [chaconSpacerBit, hs, ite_true]

theorem chaconSpacerBit_three_mul_add_two (x : ChaconOdometer) :
    chaconSpacerBit (3*x+2) = chaconSpacerBit x := by
  have hs : (3*x + 2 : ChaconOdometer) ∈ chaconSpacer ↔ x ∈ chaconSpacer := by
    rw [chaconSpacer_divides, chaconSpacer_divides]
    constructor
    · rintro ⟨n, hn⟩
      cases n with
      | zero =>
        have hr : PadicInt.toZModPow (p := 3) 1 (3*x+2+1-2*3^0) = 0 := by
          rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton]
          exact hn
        simp only [pow_zero, mul_one, map_sub, map_add, map_mul, map_one, map_ofNat] at hr
        change (0 : ZMod 3) * _ + 2 + 1 - 2 = 0 at hr
        norm_num at hr
      | succ n =>
        rw [show (3*x+2+1-2*3^(n+1) : ChaconOdometer) = 3*(x+1-2*3^n) by ring,
          pow_succ' (3 : ChaconOdometer) (n+1)] at hn
        exact ⟨n, (mul_dvd_mul_iff_left (by norm_num : (3 : ChaconOdometer) ≠ 0)).mp hn⟩
    · rintro ⟨n, hn⟩
      refine ⟨n+1, ?_⟩
      rw [show (3*x+2+1-2*3^(n+1) : ChaconOdometer) = 3*(x+1-2*3^n) by ring,
        pow_succ' (3 : ChaconOdometer) (n+1)]
      exact mul_dvd_mul_left _ hn
  unfold chaconSpacerBit
  rw [hs]

/-- The number of spacers crossed in the first `m` odometer steps. -/
noncomputable def chaconSpacerCount (m : ℕ) (x : ChaconOdometer) : ℕ :=
  ∑ j : Fin m, chaconSpacerBit (x + (j.val : ChaconOdometer))

theorem chaconReturnSum_eq_add_spacerCount (m : ℕ) (x : ChaconOdometer) :
    chaconReturnSum m x = m + chaconSpacerCount m x := rfl

theorem chaconSpacerCount_succ (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (m+1) x = chaconSpacerBit x + chaconSpacerCount m (x+1) := by
  rw [chaconSpacerCount, Fin.sum_univ_succ, chaconSpacerCount]
  simp only [Fin.val_zero, Nat.cast_zero, add_zero, Fin.val_succ, Nat.cast_add,
    Nat.cast_one]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  congr 1
  ring

theorem chaconSpacerCount_add (m n : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (m+n) x = chaconSpacerCount m x +
      chaconSpacerCount n (x + (m : ChaconOdometer)) := by
  induction m generalizing x with
  | zero =>
    rw [zero_add, Nat.cast_zero, add_zero]
    have hzero : chaconSpacerCount 0 x = 0 := by simp [chaconSpacerCount]
    rw [hzero, zero_add]
  | succ m hm =>
    rw [show m+1+n = m+n+1 by omega, chaconSpacerCount_succ, hm,
      chaconSpacerCount_succ]
    rw [show (x+1+(m : ChaconOdometer)) = x + ((m+1 : ℕ) : ChaconOdometer) by
      push_cast
      ring]
    omega

private theorem chaconSpacerCount_three0 (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (3*m) (3*x) = m + chaconSpacerCount m x := by
  induction m generalizing x with
  | zero => simp [chaconSpacerCount]
  | succ m hm =>
    rw [show 3*(m+1) = 3*m+1+1+1 by omega, chaconSpacerCount_succ,
      chaconSpacerCount_succ, chaconSpacerCount_succ, chaconSpacerBit_three_mul,
      chaconSpacerBit_three_mul_add_one,
      show (3*x+1+1 : ChaconOdometer) = 3*x+2 by ring,
      chaconSpacerBit_three_mul_add_two,
      show (3*x+2+1 : ChaconOdometer) = 3*(x+1) by ring, hm,
      chaconSpacerCount_succ]
    omega

private theorem chaconSpacerCount_three1 (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (3*m) (3*x+1) = m + chaconSpacerCount m x := by
  induction m generalizing x with
  | zero => simp [chaconSpacerCount]
  | succ m hm =>
    rw [show 3*(m+1) = 3*m+1+1+1 by omega, chaconSpacerCount_succ,
      chaconSpacerCount_succ, chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_one,
      show (3*x+1+1 : ChaconOdometer) = 3*x+2 by ring,
      chaconSpacerBit_three_mul_add_two,
      show (3*x+2+1 : ChaconOdometer) = 3*(x+1) by ring, chaconSpacerBit_three_mul, hm,
      chaconSpacerCount_succ]
    omega

private theorem chaconSpacerCount_three2 (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (3*m) (3*x+2) = m + chaconSpacerCount m x := by
  induction m generalizing x with
  | zero => simp [chaconSpacerCount]
  | succ m hm =>
    rw [show 3*(m+1) = 3*m+1+1+1 by omega, chaconSpacerCount_succ,
      chaconSpacerCount_succ, chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_two,
      show (3*x+2+1 : ChaconOdometer) = 3*(x+1) by ring,
      chaconSpacerBit_three_mul, chaconSpacerBit_three_mul_add_one,
      show (3*(x+1)+1+1 : ChaconOdometer) = 3*(x+1)+2 by ring,
      hm, chaconSpacerCount_succ]
    omega

/-- In every complete block of three, the two nonrecursive digits contribute one. -/
theorem chaconSpacerCount_three (m : ℕ) (r : Fin 3) (x : ChaconOdometer) :
    chaconSpacerCount (3*m) (3*x+(r.val : ChaconOdometer)) = m + chaconSpacerCount m x := by
  fin_cases r
  · simpa using chaconSpacerCount_three0 m x
  · exact chaconSpacerCount_three1 m x
  · exact chaconSpacerCount_three2 m x

theorem chaconSpacerCount_three_add_one (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (3*m+1) (3*x) = m + chaconSpacerCount m x ∧
      chaconSpacerCount (3*m+1) (3*x+1) = m + 1 + chaconSpacerCount m x ∧
      chaconSpacerCount (3*m+1) (3*x+2) = m + chaconSpacerCount (m+1) x := by
  refine ⟨?_, ?_, ?_⟩
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul, chaconSpacerCount_three1, zero_add]
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_one,
      show (3*x+1+1 : ChaconOdometer) = 3*x+2 by ring, chaconSpacerCount_three2]
    omega
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_two,
      show (3*x+2+1 : ChaconOdometer) = 3*(x+1) by ring, chaconSpacerCount_three0,
      chaconSpacerCount_succ]
    omega

theorem chaconSpacerCount_three_add_two (m : ℕ) (x : ChaconOdometer) :
    chaconSpacerCount (3*m+2) (3*x) = m + 1 + chaconSpacerCount m x ∧
      chaconSpacerCount (3*m+2) (3*x+1) = m + 1 + chaconSpacerCount (m+1) x ∧
      chaconSpacerCount (3*m+2) (3*x+2) = m + chaconSpacerCount (m+1) x := by
  refine ⟨?_, ?_, ?_⟩
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul, (chaconSpacerCount_three_add_one m x).2.1,
      zero_add]
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_one,
      show (3*x+1+1 : ChaconOdometer) = 3*x+2 by ring, (chaconSpacerCount_three_add_one m x).2.2]
    omega
  · rw [chaconSpacerCount_succ, chaconSpacerBit_three_mul_add_two,
      show (3*x+2+1 : ChaconOdometer) = 3*(x+1) by ring, (chaconSpacerCount_three_add_one m (x+1)).1,
      chaconSpacerCount_succ]
    omega

/-- The three affine digit branches prepend 0, 1, or 2 to an odometer tail. -/
noncomputable def chaconDigitBranch (r : ℕ) (x : ChaconOdometer) : ChaconOdometer := 3*x+r

theorem measurable_chaconDigitBranch (r : ℕ) : Measurable (chaconDigitBranch r) := by
  unfold chaconDigitBranch
  fun_prop

private theorem exists_chaconDigitBranch (a : ChaconOdometer) :
    ∃ (r : Fin 3) (x : ChaconOdometer), chaconDigitBranch r.val x = a := by
  let z : ZMod 3 := PadicInt.toZModPow (p := 3) 1 a
  have h : PadicInt.toZModPow (p := 3) 1 (a - (z.val : ChaconOdometer)) = 0 := by
    rw [map_sub, map_natCast, ZMod.natCast_zmod_val, sub_self]
  rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, Ideal.mem_span_singleton, pow_one] at h
  have h₃ : (3 : ChaconOdometer) ∣ a - (z.val : ChaconOdometer) := by simpa using h
  obtain ⟨x, hx⟩ := h₃
  exact ⟨⟨z.val, ZMod.val_lt z⟩, x, (eq_sub_iff_add_eq.mp hx.symm)⟩

private theorem map_chaconDigitBranch_translate (r s : ℕ) (x : ChaconOdometer) :
    ((chaconOdometerMeasure.map (chaconDigitBranch r)).map
      (fun y ↦ chaconDigitBranch s x + y)) = chaconOdometerMeasure.map (chaconDigitBranch (r+s)) := by
  have hmeas : Measurable (fun y ↦ chaconDigitBranch s x + y) := measurable_const.add measurable_id
  rw [Measure.map_map hmeas (measurable_chaconDigitBranch r)]
  have hx := chaconOdometer_translate_preserving x
  nth_rw 2 [← hx.map_eq]
  rw [Measure.map_map (measurable_chaconDigitBranch _) hx.measurable]
  congr 1
  funext y
  simp only [Function.comp_apply, chaconDigitBranch, Nat.cast_add]
  ring

private theorem map_chaconDigitBranch_add_three (r : ℕ) :
    chaconOdometerMeasure.map (chaconDigitBranch (r+3)) =
      chaconOdometerMeasure.map (chaconDigitBranch r) := by
  have hx := chaconOdometer_translate_preserving 1
  nth_rw 2 [← hx.map_eq]
  rw [Measure.map_map (measurable_chaconDigitBranch _) hx.measurable]
  congr 1
  funext y
  simp only [Function.comp_apply, chaconDigitBranch, Nat.cast_add, Nat.cast_ofNat]
  ring

/-- Prepending an independent uniform ternary digit to a Haar-distributed tail
leaves Haar probability unchanged. -/
theorem chaconOdometerMeasure_digitBranch_decomposition :
    chaconOdometerMeasure = (1/3 : ℝ≥0∞) •
      (chaconOdometerMeasure.map (chaconDigitBranch 0) +
       chaconOdometerMeasure.map (chaconDigitBranch 1) +
       chaconOdometerMeasure.map (chaconDigitBranch 2)) := by
  let D r := chaconOdometerMeasure.map (chaconDigitBranch r)
  let ν : Measure ChaconOdometer := (1/3 : ℝ≥0∞) • (D 0 + D 1 + D 2)
  change _ = ν
  have hu (r : ℕ) : D r univ = 1 := by
    simp [D, Measure.map_apply (measurable_chaconDigitBranch r) MeasurableSet.univ]
  have hν : IsProbabilityMeasure ν := by
    constructor
    change (1/3 : ℝ≥0∞) * (D 0 univ + D 1 univ + D 2 univ) = 1
    simp only [hu]
    rw [show (1+1+1 : ℝ≥0∞) = 3 by norm_num, one_div,
      ENNReal.inv_mul_cancel (by norm_num) (by simp)]
  have hInv : IsAddLeftInvariant ν := by
    constructor
    intro a
    obtain ⟨r, x, rfl⟩ := exists_chaconDigitBranch a
    have hmeas : Measurable (fun y ↦ chaconDigitBranch r.val x + y) := measurable_const.add measurable_id
    have hmaps (s : ℕ) : (D s).map (fun y ↦ chaconDigitBranch r.val x + y) = D (s+r.val) :=
      map_chaconDigitBranch_translate s r.val x
    have hrec (s : ℕ) : D (s+3) = D s := map_chaconDigitBranch_add_three s
    unfold ν
    rw [Measure.map_smul (1/3 : ℝ≥0∞) hmeas.aemeasurable, Measure.map_add _ _ hmeas,
      Measure.map_add _ _ hmeas, hmaps, hmaps, hmaps]
    congr 1
    fin_cases r
    · rfl
    · change D 1 + D 2 + D (0+3) = _
      rw [hrec]
      ac_rfl
    · change D 2 + D (0+3) + D (1+3) = _
      rw [hrec, hrec]
      ac_rfl
  let : IsAddHaarMeasure ν := isAddHaarMeasure_of_isCompact_nonempty_interior ν univ
    isCompact_univ (by simp) (by simp) (by simp)
  exact isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

theorem measurable_chaconSpacerCount (m : ℕ) : Measurable (chaconSpacerCount m) := by
  have hbit : Measurable chaconSpacerBit :=
    measurable_const.piecewise chaconSpacer_measurable measurable_const
  exact Finset.measurable_sum _ fun j _ ↦ hbit.comp (measurable_id.add measurable_const)

theorem chaconSpacerCount_le (m : ℕ) (x : ChaconOdometer) : chaconSpacerCount m x ≤ m := by
  calc
    chaconSpacerCount m x ≤ ∑ _ : Fin m, (1 : ℕ) :=
      Finset.sum_le_sum fun j _ ↦ by unfold chaconSpacerBit; split <;> omega
    _ = m := by simp

/-- The Chacon polynomial whose coefficient at `k` is the probability of
crossing `k` spacers in `m` successive odometer steps. -/
noncomputable def chaconPolynomial (m : ℕ) : ℝ[X] :=
  ∑ k ∈ Finset.range (m+1),
    C (chaconOdometerMeasure.real {x | chaconSpacerCount m x = k}) * X^k

private theorem spacerWeight_eq_sum (m : ℕ) (z : ℝ) :
    (fun x ↦ z ^ chaconSpacerCount m x) = fun x ↦
      ∑ k ∈ Finset.range (m+1), {y | chaconSpacerCount m y = k}.indicator (fun _ ↦ z^k) x := by
  funext x
  have h := chaconSpacerCount_le m x
  simp only [Set.indicator, mem_ofPred_eq, Finset.sum_ite_eq (a := chaconSpacerCount m x),
    Finset.mem_range, Nat.lt_succ_iff.mpr h, ite_true]

private theorem integrable_spacerWeight (m : ℕ) (z : ℝ) (μ : Measure ChaconOdometer)
    [IsFiniteMeasure μ] : Integrable (fun x ↦ z ^ chaconSpacerCount m x) μ := by
  rw [spacerWeight_eq_sum]
  exact integrable_finsetSum _ fun k _ ↦ (integrable_const (z^k)).indicator
    ((measurable_chaconSpacerCount m) (measurableSet_singleton k))

theorem chaconPolynomial_eval (m : ℕ) (z : ℝ) :
    (chaconPolynomial m).eval z = ∫ x, z ^ chaconSpacerCount m x ∂chaconOdometerMeasure := by
  rw [spacerWeight_eq_sum, integral_finsetSum]
  · simp only [chaconPolynomial, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X]
    exact Finset.sum_congr rfl fun k _ ↦
      (integral_indicator_const _ ((measurable_chaconSpacerCount m) (measurableSet_singleton k))).symm
  · exact fun k _ ↦ (integrable_const (z^k)).indicator
      ((measurable_chaconSpacerCount m) (measurableSet_singleton k))

private theorem chaconPolynomial_eval_digit_split (m : ℕ) (z : ℝ) :
    (chaconPolynomial m).eval z = (1/3) *
      ((∫ x, z ^ chaconSpacerCount m (chaconDigitBranch 0 x) ∂chaconOdometerMeasure) +
       (∫ x, z ^ chaconSpacerCount m (chaconDigitBranch 1 x) ∂chaconOdometerMeasure) +
       (∫ x, z ^ chaconSpacerCount m (chaconDigitBranch 2 x) ∂chaconOdometerMeasure)) := by
  let f (x : ChaconOdometer) := z ^ chaconSpacerCount m x
  let D r := chaconOdometerMeasure.map (chaconDigitBranch r)
  rw [chaconPolynomial_eval]
  change (∫ x, f x ∂chaconOdometerMeasure) = _
  conv_lhs => rw [chaconOdometerMeasure_digitBranch_decomposition]
  rw [integral_smul_measure]
  have hg (r : ℕ) : Integrable f (D r) := integrable_spacerWeight m z (D r)
  change ((1/3 : ℝ≥0∞).toReal) * (∫ x, f x ∂(D 0 + D 1 + D 2)) = _
  rw [integral_add_measure ((hg 0).add_measure (hg 1)) (hg 2), integral_add_measure (hg 0) (hg 1)]
  have hm (r : ℕ) : (∫ x, f x ∂(D r)) =
      ∫ x, f (chaconDigitBranch r x) ∂chaconOdometerMeasure :=
    integral_map (measurable_chaconDigitBranch r).aemeasurable (hg r).aestronglyMeasurable
  rw [hm 0, hm 1, hm 2, ENNReal.toReal_div]
  norm_num [f]

/-- Janvresse–Prikhod’ko–de la Rue–Ryzhikov, Theorem 3.3, first recurrence. -/
theorem chaconPolynomial_three (m : ℕ) : chaconPolynomial (3*m) = X^m * chaconPolynomial m := by
  apply Polynomial.funext
  intro z
  rw [chaconPolynomial_eval_digit_split]
  simp only [chaconDigitBranch, Nat.cast_zero, add_zero, Nat.cast_one, Nat.cast_ofNat,
    chaconSpacerCount_three0, chaconSpacerCount_three1, chaconSpacerCount_three2, pow_add, integral_const_mul,
    Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X, chaconPolynomial_eval]
  ring

/-- Janvresse–Prikhod’ko–de la Rue–Ryzhikov, Theorem 3.3, second recurrence. -/
theorem chaconPolynomial_three_add_one (m : ℕ) :
    chaconPolynomial (3*m+1) =
      C (1/3 : ℝ) * X^m * ((1 + X) * chaconPolynomial m + chaconPolynomial (m+1)) := by
  apply Polynomial.funext
  intro z
  rw [chaconPolynomial_eval_digit_split]
  simp only [chaconDigitBranch, Nat.cast_zero, add_zero, Nat.cast_one, Nat.cast_ofNat,
    fun x ↦ (chaconSpacerCount_three_add_one m x).1,
    fun x ↦ (chaconSpacerCount_three_add_one m x).2.1,
    fun x ↦ (chaconSpacerCount_three_add_one m x).2.2,
    pow_add, pow_one, integral_const_mul, Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_C,
    Polynomial.eval_pow, Polynomial.eval_one, Polynomial.eval_X, chaconPolynomial_eval]
  ring

/-- Janvresse–Prikhod’ko–de la Rue–Ryzhikov, Theorem 3.3, third recurrence. -/
theorem chaconPolynomial_three_add_two (m : ℕ) :
    chaconPolynomial (3*m+2) =
      C (1/3 : ℝ) * X^m * (X * chaconPolynomial m + (1 + X) * chaconPolynomial (m+1)) := by
  apply Polynomial.funext
  intro z
  rw [chaconPolynomial_eval_digit_split]
  simp only [chaconDigitBranch, Nat.cast_zero, add_zero, Nat.cast_one, Nat.cast_ofNat,
    fun x ↦ (chaconSpacerCount_three_add_two m x).1,
    fun x ↦ (chaconSpacerCount_three_add_two m x).2.1,
    fun x ↦ (chaconSpacerCount_three_add_two m x).2.2,
    pow_add, pow_one, integral_const_mul, Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_C,
    Polynomial.eval_pow, Polynomial.eval_one, Polynomial.eval_X, chaconPolynomial_eval]
  ring

theorem chaconPolynomial_eval_one (m : ℕ) : (chaconPolynomial m).eval 1 = 1 := by
  simp [chaconPolynomial_eval]

theorem chaconPolynomial_ne_zero (m : ℕ) : chaconPolynomial m ≠ 0 := by
  intro h
  have he := chaconPolynomial_eval_one m
  rw [h, Polynomial.eval_zero] at he
  exact zero_ne_one he

theorem chaconPolynomial_zero : chaconPolynomial 0 = 1 := by
  apply Polynomial.funext
  intro z
  simp [chaconPolynomial_eval, chaconSpacerCount]

theorem chaconPolynomial_one : chaconPolynomial 1 = C (1/2 : ℝ) * (1 + X) := by
  apply Polynomial.funext
  intro z
  have h := congrArg (Polynomial.eval z) (chaconPolynomial_three_add_one 0)
  norm_num [chaconPolynomial_zero] at h ⊢
  linarith

end Mixing
end

/- Source module Mixing.ChaconTowerClock. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Return times at every cutting-and-stacking scale of Chacon's tower -/


open MeasureTheory MeasureTheory.Measure Set
open scoped Classical ENNReal

namespace Mixing

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The height after `n` cuts into three and one additional middle spacer. -/
def chaconTowerHeight : ℕ → ℕ
  | 0 => 1
  | n+1 => 3 * chaconTowerHeight n + 1

theorem chaconTowerHeight_twice_add_one (n : ℕ) :
    2 * chaconTowerHeight n + 1 = 3^(n+1) := by
  induction n with
  | zero => rfl
  | succ n hn =>
    rw [chaconTowerHeight, pow_succ (3 : ℕ) (n+1), ← hn]
    omega

/-- Number of steps to advance `3^n*m` odometer positions from a specified
low-digit cylinder. The excess over `m` copies of the nominal tower height
is the same spacer cocycle on the high-digit tail. -/
theorem chaconReturnSum_at_height (n m r : ℕ) (hr : r < 3^n) (x : ChaconOdometer) :
    chaconReturnSum (3^n*m) (3^n*x+r) =
      m * chaconTowerHeight n + chaconSpacerCount m x := by
  induction n generalizing r x with
  | zero =>
    have hr' : r = 0 := by simpa using hr
    subst r
    simp [chaconTowerHeight, chaconReturnSum_eq_add_spacerCount]
  | succ n hn =>
    let d : Fin 3 := ⟨r % 3, Nat.mod_lt _ (by decide)⟩
    have hq : r / 3 < 3^n :=
      (Nat.div_lt_iff_lt_mul (by decide : 0 < 3)).mpr (by simpa only [pow_succ] using hr)
    have hrq : (3^ (n+1)*x+(r : ChaconOdometer)) =
        3*(3^n*x+((r/3 : ℕ) : ChaconOdometer))+(d.val : ChaconOdometer) := by
      have h : ((r : ℕ) : ChaconOdometer) = 3*((r/3 : ℕ) : ChaconOdometer) + ((r%3 : ℕ) : ChaconOdometer) := by
        exact_mod_cast (Nat.div_add_mod r 3).symm
      rw [pow_succ' (3 : ChaconOdometer), h]
      change _ = 3*(3^n*x+((r/3 : ℕ) : ChaconOdometer))+((r%3 : ℕ) : ChaconOdometer)
      ring
    have hi := hn (r/3) hq x
    rw [chaconReturnSum_eq_add_spacerCount] at hi ⊢
    have ht := congrArg (fun t : ℕ ↦ t*m) (chaconTowerHeight_twice_add_one n)
    rw [pow_succ' (3 : ℕ) n, add_mul, mul_assoc, one_mul, mul_assoc] at ht
    rw [pow_succ' (3 : ℕ) n, mul_assoc, hrq, chaconSpacerCount_three, chaconTowerHeight]
    rw [show m * (3 * chaconTowerHeight n + 1) = 3 * (chaconTowerHeight n * m) + m by ring]
    rw [Nat.mul_comm m (chaconTowerHeight n)] at hi
    omega

/-- The actual tower transformation at a multiple of a tower height. -/
theorem chaconTower_action_at_height (n m r : ℕ) (hr : r < 3^n) (x : ChaconOdometer) :
    chaconTowerSystem.act (Multiplicative.ofAdd (m*chaconTowerHeight n : ℕ)) (3^n*x+r, false) =
      chaconTowerSystem.act (Multiplicative.ofAdd (-(chaconSpacerCount m x : ℤ)))
        (3^n*(x+m)+r, false) := by
  have ha := chaconTower_return_action (3^n*m) (3^n*x+r)
  rw [chaconReturnSum_at_height n m r hr x] at ha
  have hsum : Multiplicative.ofAdd (((m * chaconTowerHeight n + chaconSpacerCount m x : ℕ)) : ℤ) =
      Multiplicative.ofAdd (chaconSpacerCount m x : ℤ) *
        Multiplicative.ofAdd (↑(m * chaconTowerHeight n) : ℤ) := by
    change (↑(m * chaconTowerHeight n + chaconSpacerCount m x) : ℤ) =
      ↑(chaconSpacerCount m x) + ↑(m * chaconTowerHeight n)
    push_cast
    ring
  rw [hsum, chaconTowerSystem.act_mul] at ha
  have h := congrArg (chaconTowerSystem.act (Multiplicative.ofAdd (-(chaconSpacerCount m x : ℤ)))) ha
  change (chaconTowerSystem.act (Multiplicative.ofAdd (-(chaconSpacerCount m x : ℤ))) ∘
    chaconTowerSystem.act (Multiplicative.ofAdd (chaconSpacerCount m x : ℤ))) _ =
      chaconTowerSystem.act _ _ at h
  rw [← chaconTowerSystem.act_mul] at h
  have hid : Multiplicative.ofAdd (-(chaconSpacerCount m x : ℤ)) *
      Multiplicative.ofAdd (chaconSpacerCount m x : ℤ) = 1 := by
    change -(chaconSpacerCount m x : ℤ) + chaconSpacerCount m x = 0
    omega
  rw [hid, chaconTowerSystem.act_one, id_eq] at h
  have hx : (3^n*x+(r : ChaconOdometer) + ((3^n*m : ℕ) : ChaconOdometer)) =
      3^n*(x+m)+r := by
    push_cast
    ring
  rwa [hx] at h

end Mixing
end

/- Source module Mixing.ChaconScaleDecomposition. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Scale decomposition for escaping times in Chacon's tower -/


open Filter Set
open scoped Topology

namespace Mixing

theorem chaconTowerHeight_pos (n : ℕ) : 0 < chaconTowerHeight n := by
  cases n <;> simp [chaconTowerHeight]

theorem chaconTowerHeight_strictMono : StrictMono chaconTowerHeight := by
  apply strictMono_nat_of_lt_succ
  intro n
  rw [chaconTowerHeight]
  omega

theorem le_chaconTowerHeight (n : ℕ) : n ≤ chaconTowerHeight n := by
  induction n with
  | zero => exact Nat.zero_le _
  | succ n ih => simpa only [Nat.succ_eq_add_one] using
      (Nat.succ_le_of_lt (ih.trans_lt (chaconTowerHeight_strictMono n.lt_succ_self)))

theorem tendsto_chaconTowerHeight_atTop : Tendsto chaconTowerHeight atTop atTop :=
  tendsto_atTop_mono le_chaconTowerHeight tendsto_id

theorem chaconHeightScale_exists (k : ℕ) : ∃ n, k < chaconTowerHeight (n + 1) :=
  ⟨k, k.lt_succ_self.trans_le (le_chaconTowerHeight (k + 1))⟩

/-- The height interval containing a positive time, with zero assigned to scale zero. -/
noncomputable def chaconHeightScale (k : ℕ) : ℕ := Nat.find (chaconHeightScale_exists k)

theorem lt_succ_chaconHeightScale_height (k : ℕ) :
    k < chaconTowerHeight (chaconHeightScale k + 1) :=
  Nat.find_spec (chaconHeightScale_exists k)

theorem chaconHeightScale_height_le {k : ℕ} (hk : 0 < k) :
    chaconTowerHeight (chaconHeightScale k) ≤ k := by
  cases h : chaconHeightScale k with
  | zero => simpa only [chaconTowerHeight] using Nat.succ_le_of_lt hk
  | succ n =>
    have hn : n < chaconHeightScale k := h ▸ n.lt_succ_self
    exact le_of_not_gt (Nat.find_min (chaconHeightScale_exists k) hn)

theorem tendsto_chaconHeightScale_atTop : Tendsto chaconHeightScale atTop atTop := by
  refine tendsto_atTop.2 fun n ↦ ?_
  filter_upwards [eventually_ge_atTop (chaconTowerHeight n)] with k hk
  by_contra! h
  exact (lt_succ_chaconHeightScale_height k).not_ge
    ((chaconTowerHeight_strictMono.monotone (Nat.succ_le_of_lt h)).trans hk)

theorem chaconTowerHeight_add_real (n r : ℕ) :
    (chaconTowerHeight (n + r) : ℝ) =
      3 ^ r * (chaconTowerHeight n : ℝ) + (3 ^ r - 1) / 2 := by
  have h₁ : 2 * (chaconTowerHeight (n + r) : ℝ) + 1 = 3 ^ (n + r + 1) := by
    exact_mod_cast chaconTowerHeight_twice_add_one (n + r)
  have h₂ : 2 * (chaconTowerHeight n : ℝ) + 1 = 3 ^ (n + 1) := by
    exact_mod_cast chaconTowerHeight_twice_add_one n
  rw [show n + r + 1 = r + (n + 1) by omega, pow_add, ← h₂] at h₁
  linarith

/-- A positive time normalized by its containing Chacon tower height. -/
noncomputable def chaconScaleRatio (k : ℕ) : ℝ :=
  (k : ℝ) / (chaconTowerHeight (chaconHeightScale k) : ℝ)

theorem chaconScaleRatio_mem_Icc {k : ℕ} (hk : 0 < k) :
    chaconScaleRatio k ∈ Icc (1 : ℝ) 3 := by
  have hp : 0 < (chaconTowerHeight (chaconHeightScale k) : ℝ) := by
    exact_mod_cast chaconTowerHeight_pos (chaconHeightScale k)
  have hlt := lt_succ_chaconHeightScale_height k
  rw [chaconTowerHeight] at hlt
  unfold chaconScaleRatio
  exact ⟨(le_div_iff₀ hp).2 (by simpa only [one_mul] using
      (show (chaconTowerHeight (chaconHeightScale k) : ℝ) ≤ (k : ℝ) by
        exact_mod_cast chaconHeightScale_height_le hk)),
    (div_le_iff₀ hp).2 (by exact_mod_cast (show k ≤ 3 * chaconTowerHeight (chaconHeightScale k) by
      omega))⟩

/-- A free time filter gives a limit of the positive scale ratios. -/
theorem exists_chaconScaleRatio_tendsto {ι : Type*} (p : Ultrafilter ι) {k : ι → ℕ}
    (hk : Tendsto k p atTop) :
    ∃ τ ∈ Icc (1 : ℝ) 3, Tendsto (fun j ↦ chaconScaleRatio (k j)) p (𝓝 τ) := by
  have hp : ∀ᶠ j in (p : Filter ι), chaconScaleRatio (k j) ∈ Icc (1 : ℝ) 3 :=
    (hk.eventually (eventually_ge_atTop 1)).mono fun _ hj ↦ chaconScaleRatio_mem_Icc hj
  exact isCompact_Icc.ultrafilter_le_nhds (p.map (fun j ↦ chaconScaleRatio (k j)))
    (le_principal_iff.2 hp)

theorem tendsto_chaconScale_index_sub {ι : Type*} {F : Filter ι} {k : ι → ℕ}
    (hk : Tendsto k F atTop) (r : ℕ) :
    Tendsto (fun j ↦ chaconHeightScale (k j) - r) F atTop := by
  refine tendsto_atTop.2 fun n ↦ ?_
  filter_upwards [(tendsto_chaconHeightScale_atTop.comp hk).eventually
    (eventually_ge_atTop (n + r))] with j h
  exact Nat.le_sub_of_add_le h

/-- Descending a fixed number of tower scales multiplies the limiting ratio
by the corresponding power of three. -/
theorem tendsto_chaconScaleRatio_sub {ι : Type*} {F : Filter ι} {k : ι → ℕ}
    (hk : Tendsto k F atTop) {τ : ℝ}
    (hτ : Tendsto (fun j ↦ chaconScaleRatio (k j)) F (𝓝 τ)) (r : ℕ) :
    Tendsto (fun j ↦ (k j : ℝ) /
      (chaconTowerHeight (chaconHeightScale (k j) - r) : ℝ)) F (𝓝 (τ * 3 ^ r)) := by
  let n (j : ι) := chaconHeightScale (k j)
  let h (j : ι) := (chaconTowerHeight (n j - r) : ℝ)
  have hh : Tendsto h F atTop :=
    tendsto_natCast_atTop_atTop.comp
      (tendsto_chaconTowerHeight_atTop.comp (tendsto_chaconScale_index_sub hk r))
  have he : Tendsto (fun j ↦ ((3 : ℝ) ^ r - 1) / 2 / h j) F (𝓝 0) := by
    simpa [div_eq_mul_inv] using (tendsto_inv_atTop_zero.comp hh).const_mul (((3 : ℝ) ^ r - 1) / 2)
  have hc : Tendsto (fun j ↦ 3 ^ r + ((3 : ℝ) ^ r - 1) / 2 / h j) F (𝓝 ((3 : ℝ) ^ r)) := by
    simpa only [add_zero] using he.const_add ((3 : ℝ) ^ r)
  refine (hτ.mul hc).congr' ?_
  filter_upwards [(tendsto_chaconHeightScale_atTop.comp hk).eventually
    (eventually_ge_atTop r)] with j hj
  have hcast : (chaconTowerHeight (n j) : ℝ) =
      3 ^ r * h j + (3 ^ r - 1) / 2 := by
    change r ≤ n j at hj
    have heq := chaconTowerHeight_add_real (n j - r) r
    rw [Nat.sub_add_cancel hj] at heq
    exact heq
  have hn : (chaconTowerHeight (n j) : ℝ) ≠ 0 := by
    exact_mod_cast (chaconTowerHeight_pos (n j)).ne'
  have hd : h j ≠ 0 := by
    unfold h
    exact_mod_cast (chaconTowerHeight_pos (n j - r)).ne'
  change (k j : ℝ) / (chaconTowerHeight (n j) : ℝ) *
    (3 ^ r + (3 ^ r - 1) / 2 / h j) = (k j : ℝ) / h j
  field_simp
  linarith only [congrArg (fun t : ℝ ↦ (k j : ℝ) * t) hcast]

/-- The quotient at a scale whose limiting ratio is strictly between two
consecutive integers eventually equals the integer part of that ratio. -/
theorem eventually_chaconHeight_div_eq {ι : Type*} {F : Filter ι} {k : ι → ℕ}
    (hk : Tendsto k F atTop) {τ : ℝ}
    (hτ : Tendsto (fun j ↦ chaconScaleRatio (k j)) F (𝓝 τ)) {r m : ℕ}
    (hlo : (m : ℝ) < τ * 3 ^ r) (hhi : τ * 3 ^ r < m + 1) :
    ∀ᶠ j in F, k j / chaconTowerHeight (chaconHeightScale (k j) - r) = m := by
  have h := tendsto_chaconScaleRatio_sub hk hτ r
  filter_upwards [h.eventually (eventually_gt_nhds hlo),
    h.eventually (eventually_lt_nhds hhi)] with j h₀ h₁
  let b := chaconTowerHeight (chaconHeightScale (k j) - r)
  have hb : 0 < b := chaconTowerHeight_pos _
  have hbr : 0 < (b : ℝ) := by exact_mod_cast hb
  have h₀' : m * b ≤ k j := by
    have hm : (m : ℝ) * b < k j := (lt_div_iff₀ hbr).mp h₀
    exact le_of_lt (by exact_mod_cast hm)
  have h₁' : k j < (m + 1) * b := by
    have hm : (k j : ℝ) < ((m : ℝ) + 1) * b := (div_lt_iff₀ hbr).mp h₁
    exact_mod_cast hm
  change k j / b = m
  exact le_antisymm (Nat.lt_succ_iff.mp ((Nat.div_lt_iff_lt_mul hb).2 h₁'))
    ((Nat.le_div_iff_mul_le hb).2 h₀')

/-- At an integral limiting ratio, the signed remainder is sub-height. -/
theorem tendsto_chaconHeight_relative_remainder {ι : Type*} {F : Filter ι} {k : ι → ℕ}
    (hk : Tendsto k F atTop) {τ : ℝ}
    (hτ : Tendsto (fun j ↦ chaconScaleRatio (k j)) F (𝓝 τ)) {r m : ℕ}
    (hm : τ * 3 ^ r = (m : ℝ)) :
    Tendsto (fun j ↦
      (((k j : ℤ) - m * chaconTowerHeight (chaconHeightScale (k j) - r)).natAbs : ℝ) /
        chaconTowerHeight (chaconHeightScale (k j) - r)) F (𝓝 0) := by
  have h := ((tendsto_chaconScaleRatio_sub hk hτ r).sub_const (m : ℝ)).abs
  rw [hm, sub_self, abs_zero] at h
  refine h.congr fun j ↦ ?_
  let b := chaconTowerHeight (chaconHeightScale (k j) - r)
  have hb : 0 < (b : ℝ) := by exact_mod_cast chaconTowerHeight_pos (chaconHeightScale (k j) - r)
  change |(k j : ℝ) / b - m| = (((k j : ℤ) - m * b).natAbs : ℝ) / b
  have he : (k j : ℝ) / b - m = ((k j : ℝ) - m * b) / b := by
    field_simp
  rw [he, abs_div, abs_of_pos hb]
  congr 1
  let z : ℤ := (k j : ℤ) - m * b
  have hcast : ((z.natAbs : ℤ) : ℝ) = |(z : ℝ)| := by
    rw [Int.natCast_natAbs, Int.cast_abs]
  simpa only [z, Int.cast_natCast, Int.cast_sub, Int.cast_mul] using hcast.symm

/-- Integer parts of the limiting normalized time at the successive scales. -/
noncomputable def chaconScaleCoefficient (τ : ℝ) (r : ℕ) : ℕ := ⌊τ * 3 ^ r⌋₊

theorem chaconScaleCoefficient_pos {τ : ℝ} (hτ : 1 ≤ τ) (r : ℕ) :
    0 < chaconScaleCoefficient τ r := by
  unfold chaconScaleCoefficient
  refine (Nat.le_floor_iff' (by decide : (1 : ℕ) ≠ 0)).2 ?_
  have hpow : (1 : ℝ) ≤ 3 ^ r := one_le_pow₀ (by norm_num)
  simpa only [Nat.cast_one, one_mul] using mul_le_mul hτ hpow
    (by positivity : (0 : ℝ) ≤ 1) (zero_le_one.trans hτ)

theorem eventually_chaconHeight_div_eq_floor {ι : Type*} {F : Filter ι} {k : ι → ℕ}
    (hk : Tendsto k F atTop) {τ : ℝ} (hτ₀ : 0 ≤ τ)
    (hτ : Tendsto (fun j ↦ chaconScaleRatio (k j)) F (𝓝 τ)) (r : ℕ)
    (hn : ∀ m : ℕ, τ * 3 ^ r ≠ (m : ℝ)) :
    ∀ᶠ j in F, k j / chaconTowerHeight (chaconHeightScale (k j) - r) =
      chaconScaleCoefficient τ r := by
  apply eventually_chaconHeight_div_eq hk hτ
  · exact (Nat.floor_le (by positivity)).lt_of_ne (Ne.symm (hn _))
  · exact Nat.lt_floor_add_one _

/-- The next ternary digit read from the scale ratio. -/
noncomputable def chaconScaleDigit (τ : ℝ) (r : ℕ) : ℕ :=
  chaconScaleCoefficient τ (r + 1) - 3 * chaconScaleCoefficient τ r

theorem chaconScaleCoefficient_succ (τ : ℝ) (r : ℕ) (hτ : 0 ≤ τ) :
    chaconScaleCoefficient τ (r + 1) =
      3 * chaconScaleCoefficient τ r + chaconScaleDigit τ r := by
  unfold chaconScaleDigit
  rw [Nat.add_sub_of_le]
  have he : (↑(3 * chaconScaleCoefficient τ r) : ℝ) ≤ τ * 3 ^ (r + 1) := by
    rw [pow_succ]
    push_cast
    have hh : (chaconScaleCoefficient τ r : ℝ) ≤ τ * 3 ^ r :=
      Nat.floor_le (by positivity)
    linarith
  exact Nat.le_floor he

theorem chaconScaleDigit_le_two (τ : ℝ) (r : ℕ) (hτ : 0 ≤ τ) :
    chaconScaleDigit τ r ≤ 2 := by
  have hlt : τ * 3 ^ (r + 1) < (3 * chaconScaleCoefficient τ r + 3 : ℕ) := by
    rw [pow_succ]
    push_cast
    have hh : τ * 3 ^ r < (chaconScaleCoefficient τ r : ℝ) + 1 := Nat.lt_floor_add_one _
    linarith
  have h : chaconScaleCoefficient τ (r + 1) < 3 * chaconScaleCoefficient τ r + 3 :=
    (Nat.floor_lt (by positivity)).2 hlt
  unfold chaconScaleDigit
  omega

/-- A tail consisting entirely of zeros or entirely of twos implies that
the normalized limit is integral at some scale. -/
theorem chaconScale_integral_of_constant_tail {τ : ℝ} (hτ : 0 ≤ τ) {d r : ℕ}
    (hd : d = 0 ∨ d = 2) (hTail : ∀ i ≥ r, chaconScaleDigit τ i = d) :
    ∃ m : ℕ, τ * 3 ^ r = (m : ℝ) := by
  let a := chaconScaleCoefficient τ
  have he (n : ℕ) : (a (r + n) : ℝ) + (d : ℝ) / 2 =
      3 ^ n * ((a r : ℝ) + (d : ℝ) / 2) := by
    induction n with
    | zero => simp
    | succ n ih =>
      have h := chaconScaleCoefficient_succ τ (r + n) hτ
      rw [hTail (r+n) (by omega)] at h
      have h' : (a (r + (n + 1)) : ℝ) = 3 * (a (r+n) : ℝ) + d := by
        exact_mod_cast h
      rw [h', pow_succ]
      linear_combination 3 * ih
  have hb : (0 : ℝ) ≤ (d : ℝ) / 2 ∧ (d : ℝ) / 2 ≤ 1 := by
    rcases hd with rfl | rfl <;> norm_num
  have hbound (n : ℕ) : |τ * 3 ^ r - ((a r : ℝ) + (d : ℝ) / 2)| ≤
      ((3 : ℝ)^n)⁻¹ := by
    have h₀ : (a (r+n) : ℝ) ≤ τ * (3 : ℝ) ^ (r+n) := Nat.floor_le (by positivity)
    have h₁ : τ * (3 : ℝ) ^ (r+n) < (a (r+n) : ℝ) + 1 := Nat.lt_floor_add_one _
    have h : |τ * (3 : ℝ) ^ (r+n) - ((a (r+n) : ℝ) + (d : ℝ) / 2)| ≤ 1 :=
      abs_le.2 ⟨by linarith [hb.2], by linarith [hb.1]⟩
    rw [he, pow_add, show τ * ((3 : ℝ)^r * 3^n) -
        3^n * ((a r : ℝ) + (d : ℝ) / 2) =
        3^n * (τ * 3^r - ((a r : ℝ) + (d : ℝ) / 2)) by ring,
      abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 3^n), mul_comm] at h
    rw [← one_div]
    exact (le_div_iff₀ (by positivity)).2 h
  have ht : Tendsto (fun n : ℕ ↦ ((3 : ℝ)^n)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 3))
  have hzero : |τ * 3 ^ r - ((a r : ℝ) + (d : ℝ) / 2)| = 0 :=
    le_antisymm (le_of_tendsto_of_tendsto' tendsto_const_nhds ht hbound) (abs_nonneg _)
  have h := sub_eq_zero.mp (abs_eq_zero.mp hzero)
  rcases hd with rfl | rfl
  · exact ⟨a r, by simpa using h⟩
  · exact ⟨a r + 1, by push_cast; norm_num at h; exact h⟩

/-- A ratio which is nonintegral at every scale has arbitrarily late
digits different from zero and arbitrarily late digits different from two. -/
theorem chaconScaleDigit_frequently_ne {τ : ℝ} (hτ : 0 ≤ τ)
    (hn : ∀ r m : ℕ, τ * 3 ^ r ≠ (m : ℝ)) {d : ℕ} (hd : d = 0 ∨ d = 2) :
    ∃ᶠ r : ℕ in atTop, chaconScaleDigit τ r ≠ d := by
  by_contra! hf
  obtain ⟨r, hr⟩ := eventually_atTop.1 hf
  obtain ⟨m, hm⟩ := chaconScale_integral_of_constant_tail hτ hd hr
  exact hn r m hm

end Mixing
end

