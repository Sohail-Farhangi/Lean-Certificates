/-! # Exhausting all free limits of the concrete Chacon transformation -/


open Filter Set MeasureTheory
open scoped Topology

namespace Mixing

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩
local instance : IsProbabilityMeasure chaconTowerSystem.measure := chaconTowerSystem.probability

/-- At a nonintegral normalized limit, the adjacent polynomials decay
and the sub-height column bound forces the weak limit to vanish. -/
theorem chaconNonintegralScaleDecay_verified : ChaconNonintegralScaleDecay := by
  intro q _ τ hτ hNon hProfile
  have hτ₀ : 0 ≤ τ := zero_le_one.trans hτ.1
  let m := chaconScaleCoefficient τ
  let n := chaconScaleLevel
  let e (r j : ℕ) := j % chaconTowerHeight (n r j)
  have he (r : ℕ) : ∀ᶠ j in (q : Filter ℕ),
      e r j < chaconTowerHeight (n r j) ∧ j = m r * chaconTowerHeight (n r j) + e r j := by
    filter_upwards [(hProfile r).2] with j hj
    refine ⟨Nat.mod_lt _ (chaconTowerHeight_pos _), ?_⟩
    calc
      j = chaconTowerHeight (n r j) * (j / chaconTowerHeight (n r j)) + e r j :=
        (Nat.div_add_mod _ _).symm
      _ = m r * chaconTowerHeight (n r j) + e r j := by
        rw [show j / chaconTowerHeight (n r j) = m r from hj, Nat.mul_comm]
  let d (r : ℕ) : Fin 3 :=
    ⟨chaconScaleDigit τ r, Nat.lt_succ_of_le (chaconScaleDigit_le_two τ r hτ₀)⟩
  have hd (r : ℕ) : m (r + 1) = 3 * m r + (d r).val :=
    chaconScaleCoefficient_succ τ r hτ₀
  have h0 : ¬ ∃ N, ∀ r ≥ N, d r = 0 := by
    rintro ⟨N, hN⟩
    refine (chaconScaleDigit_frequently_ne hτ₀ hNon (Or.inl rfl)) ?_
    filter_upwards [eventually_ge_atTop N] with r hr
    exact fun hn ↦ hn (congrArg Fin.val (hN r hr))
  have h2 : ¬ ∃ N, ∀ r ≥ N, d r = 2 := by
    rintro ⟨N, hN⟩
    refine (chaconScaleDigit_frequently_ne hτ₀ hNon (Or.inr rfl)) ?_
    filter_upwards [eventually_ge_atTop N] with r hr
    exact fun hn ↦ hn (congrArg Fin.val (hN r hr))
  refine chaconUltrafilter_zero_of_subHeight_decompositions q id m n e
    (fun r ↦ (hProfile r).1) he fun v ↦ ?_
  exact ⟨tendsto_chaconDecayOperator_ternary_prefix_zero m d hd h0 h2 false false v,
    tendsto_chaconDecayOperator_ternary_prefix_zero m d hd h0 h2 true false v⟩

/-- Every free, nonzero Chacon weak limit splits off a positive-height
polynomial or its adjoint. -/
theorem chaconHeightExtraction_verified (p : Ultrafilter (Multiplicative ℤ))
    (hp : p ∈ freeUltrafilters (Multiplicative ℤ))
    (hNZ : ultrafilterOperator chaconTowerSystem.koopmanZeroRep p ≠ 0) :
    ∃ (reverse : Bool) (m : ℕ) (q : Ultrafilter (Multiplicative ℤ)), 0 < m ∧
      ultrafilterOperator chaconTowerSystem.koopmanZeroRep p =
        chaconDecayOperator reverse m * ultrafilterOperator chaconTowerSystem.koopmanZeroRep q := by
  rcases chaconFree_zero_or_signed_height_factor chaconSmallRemainderFactorization_verified
      chaconNonintegralScaleDecay_verified p hp with hz | ⟨b, m, q, hm, he⟩
  · exact (hNZ hz).elim
  · exact ⟨b, m, q, hm,
      by simpa only [chaconSignedHeightPolynomialOperatorZero, chaconDecayOperator,
        ContinuousLinearMap.star_eq_adjoint] using he⟩

/-- The concrete Chacon system satisfies the mixing-or-generation
dichotomy and the accompanying spectral disjointness statement. -/
theorem example2_chaconTower (p : Ultrafilter (Multiplicative ℤ)) :
    chaconTowerSystem.IsUMixing {p} ∨
      (chaconTowerSystem.generatedSigma {p} = (inferInstance : MeasurableSpace (ChaconOdometer × Bool)) ∧
        ∀ {Y : Type*} [MeasurableSpace Y] (T : System (Multiplicative ℤ) Y), T.IsUMixing {p} →
          SpectrallyDisjoint chaconTowerSystem.koopmanZeroRep T.koopmanZeroRep) :=
  example2_chaconTower_of_height_extraction chaconHeightExtraction_verified p

/-- Every full Koopman weak limit of powers of Chacon's transformation is
the projection onto constants or a finite convex combination of powers. -/
theorem chaconTower_weakLimit_convex_powers (p : Ultrafilter (Multiplicative ℤ)) :
    let S := chaconTowerSystem
    ultrafilterOperator S.koopmanRep p =
      InnerProductSpace.rankOne ℂ (constantOne S.measure) (constantOne S.measure) ∨
      ∃ l, ChaconConvexWeights l ∧
        ultrafilterOperator S.koopmanRep p = chaconWeightedPowerSum S.koopmanRep l :=
  chaconDecay_convex_full_of_extraction chaconHeightExtraction_verified p

end Mixing
end

/- Source module Mixing.JoiningBarycenters. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Barycenters of joinings -/


open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal ProbabilityTheory

namespace Mixing

variable {G X Y Z : Type*} [CommGroup G] [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]

private theorem map_joiningBarycenter_eq {V : Type*} [MeasurableSpace V]
    (ν : Measure Z) [IsProbabilityMeasure ν] (κ : Kernel Z (X × Y))
    {f : X × Y → V} {μ : Measure V} (hf : Measurable f)
    (hm : ∀ᵐ z ∂ν, (κ z).map f = μ) : (κ ∘ₘ ν).map f = μ := by
  rw [Measure.map_comp ν κ hf]
  calc
    _ = Kernel.const Z μ ∘ₘ ν := by
      apply Measure.comp_congr
      filter_upwards [hm] with z hz
      rw [Kernel.map_apply _ hf, Kernel.const_apply, hz]
    _ = _ := by rw [Measure.const_comp, measure_univ, one_smul]

/-- Barycenters over a probability measure preserve fixed marginals and invariance. -/
theorem isJoining_comp_of_ae_isJoining {S : System G X} {T : System G Y}
    (ν : Measure Z) [IsProbabilityMeasure ν] (κ : Kernel Z (X × Y)) [IsMarkovKernel κ]
    (hκ : ∀ᵐ z ∂ν, IsJoining S T (κ z)) : IsJoining S T (κ ∘ₘ ν) := by
  refine ⟨inferInstance,
    ⟨measurable_fst, map_joiningBarycenter_eq ν κ measurable_fst (hκ.mono fun _ h ↦ h.fst.map_eq)⟩,
    ⟨measurable_snd, map_joiningBarycenter_eq ν κ measurable_snd (hκ.mono fun _ h ↦ h.snd.map_eq)⟩, ?_⟩
  intro g
  have hf : Measurable (S.prodAct T g) :=
    (S.preserves g).measurable.prodMap (T.preserves g).measurable
  refine ⟨hf, ?_⟩
  rw [Measure.map_comp ν κ hf]
  apply Measure.comp_congr
  filter_upwards [hκ] with z hz
  rw [Kernel.map_apply _ hf, (hz.invariant g).map_eq]

/-- An extreme joining can be the barycenter of a family of joinings only
when that family almost everywhere equals the extreme joining. -/
theorem ae_kernel_eq_of_extremeJoining_barycenter [StandardBorelSpace (X × Y)] [Nonempty (X × Y)]
    {S : System G X} {T : System G Y} {τ : Measure (X × Y)}
    (hτ : IsExtremeJoining S T τ)
    (ν : Measure Z) [IsProbabilityMeasure ν] (κ : Kernel Z (X × Y)) [IsMarkovKernel κ]
    (hJoin : ∀ᵐ z ∂ν, IsJoining S T (κ z)) (hAvg : κ ∘ₘ ν = τ) :
    ∀ᵐ z ∂ν, κ z = τ := by
  let := hτ.1.probability
  have hrestrict (A : Set Z) (hA : MeasurableSet A) :
      κ ∘ₘ (ν.restrict A) = ν A • τ := by
    by_cases h₀ : ν A = 0
    · rw [Measure.restrict_eq_zero.mpr h₀, h₀, zero_smul]
      exact Measure.bind_zero_left κ
    by_cases h₁ : ν A = 1
    · have hAc : ν Aᶜ = 0 := by rw [measure_compl hA (measure_ne_top _ _), measure_univ, h₁, tsub_self]
      have hr := Measure.restrict_add_restrict_compl (μ := ν) hA
      rw [Measure.restrict_eq_zero.mpr hAc, add_zero] at hr
      rw [hr, hAvg, h₁, one_smul]
    let a := ν A
    let b := ν Aᶜ
    have ha : a < 1 := lt_of_le_of_ne (prob_le_one) h₁
    have hb : b = 1 - a := by rw [show b = ν Aᶜ from rfl, measure_compl hA (measure_ne_top _ _), measure_univ]
    have hb₀ : b ≠ 0 := hb ▸ (tsub_pos_of_lt ha).ne'
    let νA := a⁻¹ • ν.restrict A
    let νB := b⁻¹ • ν.restrict Aᶜ
    have hνA : IsProbabilityMeasure νA := ⟨by
      change a⁻¹ • (ν.restrict A) univ = 1
      rw [Measure.restrict_apply_univ]
      exact ENNReal.inv_mul_cancel h₀ (measure_ne_top _ _)⟩
    have hνB : IsProbabilityMeasure νB := ⟨by
      change b⁻¹ • (ν.restrict Aᶜ) univ = 1
      rw [Measure.restrict_apply_univ]
      exact ENNReal.inv_mul_cancel hb₀ (measure_ne_top _ _)⟩
    have hJA := isJoining_comp_of_ae_isJoining νA κ
      (((Measure.absolutelyContinuous_of_le Measure.restrict_le_self).smul_left _).ae_le hJoin)
    have hJB := isJoining_comp_of_ae_isJoining νB κ
      (((Measure.absolutelyContinuous_of_le Measure.restrict_le_self).smul_left _).ae_le hJoin)
    have hEA : a • (κ ∘ₘ νA) = κ ∘ₘ (ν.restrict A) := by
      rw [show νA = a⁻¹ • ν.restrict A from rfl, Measure.comp_smul, smul_smul,
        ENNReal.mul_inv_cancel h₀ (measure_ne_top _ _), one_smul]
    have hEB : b • (κ ∘ₘ νB) = κ ∘ₘ (ν.restrict Aᶜ) := by
      rw [show νB = b⁻¹ • ν.restrict Aᶜ from rfl, Measure.comp_smul, smul_smul,
        ENNReal.mul_inv_cancel hb₀ (measure_ne_top _ _), one_smul]
    have hSum : a • (κ ∘ₘ νA) + (1 - a) • (κ ∘ₘ νB) = τ := by
      rw [← hb, hEA, hEB, ← Measure.comp_add, Measure.restrict_add_restrict_compl hA, hAvg]
    have hEq := (hτ.2 _ _ hJA hJB a (pos_iff_ne_zero.mpr h₀) ha hSum).1
    rw [← hEA, hEq]
  have hprod : ν ⊗ₘ κ = ν.prod τ := by
    apply Measure.ext_prod
    intro A B hA hB
    rw [Measure.compProd_apply_prod hA hB, Measure.prod_prod]
    change (∫⁻ z in A, κ z B ∂ν) = _
    rw [← Measure.bind_apply hB κ.aemeasurable]
    change (κ ∘ₘ (ν.restrict A)) B = _
    rw [hrestrict A hA, smul_apply, smul_eq_mul]
  let ρ := ν ⊗ₘ κ
  have hfst : ρ.fst = ν := Measure.fst_compProd _ _
  have hκ : ρ = ρ.fst ⊗ₘ κ := by rw [hfst]
  have hConst : ρ = ρ.fst ⊗ₘ Kernel.const Z τ := by
    rw [hfst, Measure.compProd_const]
    exact hprod
  have h₁ := eq_condKernel_of_measure_eq_compProd κ hκ
  have h₂ := eq_condKernel_of_measure_eq_compProd (Kernel.const Z τ) hConst
  rw [hfst] at h₁ h₂
  filter_upwards [h₁, h₂] with z hz₁ hz₂
  exact hz₁.trans hz₂.symm

end Mixing
end

/- Source module Mixing.CompactGroupSkew. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


/-! # Weak-mixing disjointness lifts to compact-group skew extensions -/


open MeasureTheory MeasureTheory.Measure ProbabilityTheory Set Filter
open scoped ENNReal ProbabilityTheory

namespace Mixing

variable {G X Y K : Type*} [CommGroup G] [Group K]
variable [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace K] [MeasurableMul₂ K]

/-- A measurable cocycle taking values in the fibre group. -/
structure MeasurableSkewCocycle (T : System G Y) where
  toFun : G → Y → K
  measurable : ∀ g, Measurable (toFun g)
  one : ∀ y, toFun 1 y = 1
  mul : ∀ g h y, toFun (g * h) y = toFun g (T.act h y) * toFun h y

theorem measurePreserving_left_shear {W : Type*} [MeasurableSpace W]
    (μ : Measure W) [IsFiniteMeasure μ] (mK : Measure K) [IsProbabilityMeasure mK] [IsMulLeftInvariant mK]
    (c : W → K) (hc : Measurable c) :
    MeasurePreserving (fun w : W × K ↦ (w.1, c w.1 * w.2)) (μ.prod mK) (μ.prod mK) := by
  let F : W × K → W × K := fun w ↦ (w.1, c w.1 * w.2)
  have hF : Measurable F := measurable_fst.prodMk ((hc.comp measurable_fst).mul measurable_snd)
  refine ⟨hF, ?_⟩
  apply Measure.ext_prod
  intro A B hA hB
  rw [Measure.map_apply hF (hA.prod hB), Measure.prod_apply (hF (hA.prod hB)),
    Measure.prod_apply (hA.prod hB)]
  apply lintegral_congr_ae
  exact .of_forall fun w ↦ by
    change mK (Prod.mk w ⁻¹' (F ⁻¹' (A ×ˢ B))) = mK (Prod.mk w ⁻¹' (A ×ˢ B))
    by_cases hw : w ∈ A
    · have h₁ : Prod.mk w ⁻¹' (F ⁻¹' (A ×ˢ B)) = (fun k ↦ c w * k) ⁻¹' B := by
        ext k
        simp [F, hw]
      have h₂ : Prod.mk w ⁻¹' (A ×ˢ B) = B := by ext k; simp [hw]
      rw [h₁, h₂, (measurePreserving_mul_left mK (c w)).measure_preimage hB.nullMeasurableSet]
    · have h₁ : Prod.mk w ⁻¹' (F ⁻¹' (A ×ˢ B)) = ∅ := by ext k; simp [F, hw]
      have h₂ : Prod.mk w ⁻¹' (A ×ˢ B) = ∅ := by ext k; simp [hw]
      rw [h₁, h₂]

variable (T : System G Y) (c : MeasurableSkewCocycle (K := K) T)
variable (mK : Measure K) [IsProbabilityMeasure mK] [IsMulLeftInvariant mK]

/-- The skew product by a compact-group cocycle, using normalized Haar
probability as the fibre measure. -/
noncomputable def compactGroupSkewSystem : System G (Y × K) where
  measure := T.measure.prod mK
  probability := inferInstance
  act g w := (T.act g w.1, c.toFun g w.1 * w.2)
  act_one := by funext w; simp [T.act_one, c.one]
  act_mul g h := by funext w; simp [T.act_mul, c.mul, mul_assoc]
  preserves g :=
    ((T.preserves g).prod (MeasurePreserving.id mK)).comp
      (measurePreserving_left_shear T.measure mK (c.toFun g) (c.measurable g))

/-- The base factor of the skew product is the first coordinate. -/
noncomputable def compactGroupSkewFactor : FactorMap (compactGroupSkewSystem T c mK) T where
  toFun := Prod.fst
  preserves := measurePreserving_fst
  equivariant _ := rfl

variable [IsMulRightInvariant mK]

private noncomputable def skewRightFactor (r : K) :
    FactorMap (compactGroupSkewSystem T c mK) (compactGroupSkewSystem T c mK) where
  toFun w := (w.1, w.2 * r)
  preserves := (MeasurePreserving.id T.measure).prod (measurePreserving_mul_right mK r)
  equivariant g := by
    funext w
    change (T.act g w.1, (c.toFun g w.1 * w.2) * r) =
      (T.act g w.1, c.toFun g w.1 * (w.2 * r))
    rw [mul_assoc]

private def skewJoiningRight (r : K) (w : X × (Y × K)) : X × (Y × K) :=
  (w.1, (w.2.1, w.2.2 * r))

private theorem measurable_skewJoiningRight (r : K) :
    Measurable (skewJoiningRight (X := X) (Y := Y) r) := by unfold skewJoiningRight; fun_prop

private theorem measurable_uncurry_skewJoiningRight :
    Measurable (Function.uncurry (skewJoiningRight (X := X) (Y := Y) (K := K))) := by
  unfold Function.uncurry skewJoiningRight
  fun_prop

private noncomputable def skewJoiningAverageKernel (τ : Measure (X × (Y × K))) : Kernel K (X × (Y × K)) :=
  (Kernel.id ×ₖ Kernel.const K τ).map (Function.uncurry skewJoiningRight)

private instance (τ : Measure (X × (Y × K))) [IsProbabilityMeasure τ] :
    IsMarkovKernel (skewJoiningAverageKernel τ) :=
  Kernel.IsMarkovKernel.map _ measurable_uncurry_skewJoiningRight

private theorem skewJoiningAverageKernel_apply (τ : Measure (X × (Y × K))) [IsProbabilityMeasure τ]
    (r : K) : skewJoiningAverageKernel τ r = τ.map (skewJoiningRight r) := by
  ext A hA
  rw [skewJoiningAverageKernel, Kernel.map_apply' _ measurable_uncurry_skewJoiningRight _ hA,
    Kernel.id_prod_apply' _ _ (measurable_uncurry_skewJoiningRight hA),
    Kernel.const_apply, Measure.map_apply (measurable_skewJoiningRight r) hA]
  rfl

