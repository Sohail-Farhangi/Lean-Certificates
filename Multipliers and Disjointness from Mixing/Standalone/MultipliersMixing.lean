      (Tendsto (fun r ↦ chaconHeightPolynomialOperatorZero (m r+1) v) atTop (𝓝 0))) :
    ultrafilterOperator chaconTowerSystem.koopmanZeroRep
      (p.map fun j ↦ Multiplicative.ofAdd (t j : ℤ)) = 0 := by
