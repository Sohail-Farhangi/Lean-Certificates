noncomputable section

namespace Mixing

open Filter MeasureTheory Set
open scoped BigOperators Classical ENNReal Topology

private theorem rudinShapiro_reconstruct_sample (k a j : ℕ) (i : ℤ)
    (ha : a < 2 ^ (k + 1)) (hj : j % 2 ^ (k + 1) = a)
    (hlo : 0 ≤ (a : ℤ) + i) (hhi : (a : ℤ) + i < (2 : ℤ) ^ (k + 1))
    (hhalf : a / 2 ^ k = ((a : ℤ) + i).toNat / 2 ^ k) :
    signValue (signWordShift j rudinShapiroWord 0) *
      signValue (signWordShift j rudinShapiroWord i) =
      rudinShapiro a * rudinShapiro ((a : ℤ) + i).toNat := by
  let B := (2 : ℕ) ^ (k + 1)
  let q := j / B
  let b := ((a : ℤ) + i).toNat
  have hb : b < B := by
    have h : (b : ℤ) < (B : ℤ) := by
      simpa only [b, Int.toNat_of_nonneg hlo, B, Nat.cast_pow, Nat.cast_ofNat] using hhi
    exact_mod_cast h
  have hj' : j = B * q + a := by
    have hjB : j % B = a := hj
    calc
      j = j % B + B * q := (Nat.mod_add_div j B).symm
      _ = B * q + a := by rw [hjB, add_comm]
  have hcast : (B * q + b : ℕ) = (i + j).toNat := by
    have hb' : (b : ℤ) = (a : ℤ) + i := Int.toNat_of_nonneg hlo
    have hj'' : (j : ℤ) = (B : ℤ) * (q : ℤ) + a := by exact_mod_cast hj'
    have hc : (i + j : ℤ) = (B * q + b : ℕ) := by
      rw [Nat.cast_add, Nat.cast_mul, hb', hj'']
      ring
    exact (congrArg Int.toNat hc).symm
  change signValue (rudinShapiroWord (0 + j)) * signValue (rudinShapiroWord (i + j)) = _
  rw [zero_add, signValue_rudinShapiroWord, signValue_rudinShapiroWord, Int.toNat_natCast, ← hcast, hj']
  change rudinShapiro (2 ^ (k + 1) * q + a) * rudinShapiro (2 ^ (k + 1) * q + b) =
    rudinShapiro a * rudinShapiro b
  rw [rudinShapiro_binary_block k q a ha, rudinShapiro_binary_block k q b hb, ← hhalf]
  let e := q % 2 * (a / 2 ^ k)
  have he : ((-1 : ℝ) ^ e) ^ 2 = 1 := by
    rw [← pow_mul, mul_comm, pow_mul]
    norm_num
  calc
    _ = rudinShapiro q ^ 2 * ((-1 : ℝ) ^ e) ^ 2 * (rudinShapiro a * rudinShapiro b) := by
      dsimp [e]
      ring
    _ = _ := by rw [rudinShapiro_sq, he, one_mul, one_mul]

/-- On a dyadic residue whose centre and tested coordinate lie in the same
half of the block, the two signs have a fixed product. -/
theorem rudinShapiro_signProduct_of_residue {w : SignWords} (hw : w ∈ rudinShapiroSubshift)
    (k a : ℕ) (i : ℤ) (ha : a < 2 ^ (k + 1)) (hr : rudinShapiroResidue (k + 1) a w)
    (hlo : 0 ≤ (a : ℤ) + i) (hhi : (a : ℤ) + i < (2 : ℤ) ^ (k + 1))
    (hhalf : a / 2 ^ k = ((a : ℤ) + i).toNat / 2 ^ k) :
    signValue (w 0) * signValue (w i) = rudinShapiro a * rudinShapiro ((a : ℤ) + i).toNat := by
  let J := rudinShapiroResidueWindow (k + 1) a
  refine (rudinShapiro_local_property
    (P := fun v ↦ rudinShapiroResidue (k + 1) a v →
      signValue (v 0) * signValue (v i) = rudinShapiro a * rudinShapiro ((a : ℤ) + i).toNat)
    (insert 0 (insert i J)) ?_ 0 ?_ hw) hr
  · intro u v h huv hv
    have he := rudinShapiroResidue_iff_of_agree (k + 1) a u v
      (fun j hj ↦ h _ (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hj)))
    rw [← h 0 (Finset.mem_insert_self _ _),
      ← h i (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))]
    exact huv (he.mpr hv)
  · intro j _ hrj
    exact rudinShapiro_reconstruct_sample k a j i ha
      ((rudinShapiroResidue_on_sample (k + 1) a j ha).mp hrj) hlo hhi hhalf

/-- A phase is regular if each tested coordinate eventually lies in the same
half of a sufficiently large dyadic block as the centre. -/
def RudinShapiroRegularPhase (w : SignWords) : Prop :=
  ∀ i : ℤ, ∃ k a : ℕ, a < 2 ^ (k + 1) ∧ rudinShapiroResidue (k + 1) a w ∧
    0 ≤ (a : ℤ) + i ∧ (a : ℤ) + i < (2 : ℤ) ^ (k + 1) ∧
    a / 2 ^ k = ((a : ℤ) + i).toNat / 2 ^ k

private theorem goodHalf_of_interior (k a : ℕ) (i : ℤ) (ha : a < 2 ^ (k + 1))
    (hlo : i.natAbs ≤ a % (2 ^ k)) (hhi : a % (2 ^ k) + i.natAbs < 2 ^ k) :
    0 ≤ (a : ℤ) + i ∧ (a : ℤ) + i < (2 : ℤ) ^ (k + 1) ∧
      a / 2 ^ k = ((a : ℤ) + i).toNat / 2 ^ k := by
  let B := (2 : ℕ) ^ k
  let q := a / B
  let r := a % B
  have hp : 0 < B := by dsimp [B]; positivity
  have hr : r < B := Nat.mod_lt _ hp
  have he : a = r + B * q := (Nat.mod_add_div _ _).symm
  have hB : 2 ^ (k + 1) = B * 2 := pow_succ _ _
  have hQ : q < 2 := (Nat.div_lt_iff_lt_mul hp).2 (by simpa only [hB, mul_comm B 2] using ha)
  have hD : -i ≤ (i.natAbs : ℤ) := by
    simpa only [Int.natAbs_neg] using (Int.le_natAbs (a := -i))
  have hU : i ≤ (i.natAbs : ℤ) := Int.le_natAbs
  have hl : 0 ≤ (r : ℤ) + i := by change i.natAbs ≤ r at hlo; omega
  have hh : (r : ℤ) + i < B := by change r + i.natAbs < B at hhi; omega
  let s := ((r : ℤ) + i).toNat
  have hs : (s : ℤ) = (r : ℤ) + i := Int.toNat_of_nonneg hl
  have hsb : s < B := by omega
  have hAbs : (a : ℤ) + i = (s + B * q : ℕ) := by
    push_cast
    rw [hs, show (a : ℤ) = r + (B : ℤ) * q by exact_mod_cast he]
    ring
  rw [hAbs, Int.toNat_natCast]
  refine ⟨Int.natCast_nonneg _, ?_, ?_⟩
  · have hCast : (2 : ℤ) ^ (k + 1) = ((2 ^ (k + 1) : ℕ) : ℤ) := by norm_cast
    rw [hCast, hB]
    exact_mod_cast (show s + B * q < B * 2 from by
      have hq : q = 0 ∨ q = 1 := by
        generalize q = d at hQ ⊢
        omega
      rcases hq with heq | heq <;> simp [heq] <;> omega)
  · rw [Nat.add_mul_div_left _ _ hp, Nat.div_eq_of_lt hsb, zero_add]

/-- Uniformity of the finite dyadic phase laws makes the regular phase
condition conull. -/
theorem rudinShapiro_ae_regularPhase_of_uniform (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)
    (hLaw : ∀ k (a : Fin (2 ^ k)), (rudinShapiroOrbitLaw p : Measure SignWords)
      {w | rudinShapiroResidue k a w} = ((2 : ℝ≥0∞) ^ k)⁻¹) :
    ∀ᵐ w ∂(rudinShapiroOrbitLaw p : Measure SignWords), RudinShapiroRegularPhase w := by
  let ν := (rudinShapiroOrbitLaw p : Measure SignWords)
  apply ae_all_iff.2
  intro i
  let m := i.natAbs
  let D := {w : SignWords | w ∈ rudinShapiroSubshift ∧
    ¬ ∃ k a : ℕ, a < 2 ^ (k + 1) ∧ rudinShapiroResidue (k + 1) a w ∧
      0 ≤ (a : ℤ) + i ∧ (a : ℤ) + i < (2 : ℤ) ^ (k + 1) ∧
      a / 2 ^ k = ((a : ℤ) + i).toNat / 2 ^ k}
  have hSmall (k : ℕ) : ν D ≤ (2 * m : ℕ) * ((2 : ℝ≥0∞) ^ k)⁻¹ := by
    let B := (2 : ℕ) ^ k
    let I := (Finset.range B).filter fun r ↦ r < m ∨ B ≤ r + m
    have hCard : I.card ≤ 2 * m := by
      have hIncl : I ⊆ Finset.range m ∪ Finset.Ico (B - m) B := by
        intro r hr
        obtain ⟨hr', hbad⟩ := Finset.mem_filter.mp hr
        apply Finset.mem_union.mpr
        rcases hbad with h | h
        · exact Or.inl (Finset.mem_range.mpr h)
        · exact Or.inr (Finset.mem_Ico.mpr ⟨by omega, Finset.mem_range.mp hr'⟩)
      refine (Finset.card_le_card hIncl).trans ((Finset.card_union_le _ _).trans ?_)
      rw [Finset.card_range, Nat.card_Ico]
      omega
    have hCover : D ⊆ ⋃ r ∈ I, {w | rudinShapiroResidue k r w} := by
      intro w hw
      obtain ⟨hW, hFail⟩ : w ∈ rudinShapiroSubshift ∧ _ := hw
      obtain ⟨r, hr, _⟩ := rudinShapiroResidue_existsUnique_of_mem hW k
      obtain ⟨a, ha, _⟩ := rudinShapiroResidue_existsUnique_of_mem hW (k + 1)
      have hCompat := rudinShapiroResidue_succ_coherence_of_mem hW k a r ha hr
      refine mem_iUnion.mpr ⟨r.val, mem_iUnion.mpr ⟨Finset.mem_filter.mpr ⟨
        Finset.mem_range.mpr r.isLt, ?_⟩, hr⟩⟩
      by_contra! h
      obtain ⟨hlo, hhi, hh⟩ := goodHalf_of_interior k a.val i a.isLt
        (by simpa only [hCompat] using h.1) (by simpa only [hCompat] using h.2)
      exact hFail ⟨k, a.val, a.isLt, ha, hlo, hhi, hh⟩
    refine (measure_mono hCover).trans ((measure_biUnion_finset_le _ _).trans ?_)
    calc
      _ = I.card * ((2 : ℝ≥0∞) ^ k)⁻¹ := by
        have he (a : ℕ) (ha : a ∈ I) :
            ν {w | rudinShapiroResidue k a w} = ((2 : ℝ≥0∞) ^ k)⁻¹ :=
          hLaw k ⟨a, Finset.mem_range.mp (Finset.mem_filter.mp ha).1⟩
        rw [Finset.sum_congr rfl he, Finset.sum_const, nsmul_eq_mul]
      _ ≤ _ := by gcongr
  have hReal (k : ℕ) : ν.real D ≤ (2 * m : ℝ) * ((1 / 2 : ℝ) ^ k) := by
    have hFin : ((2 * m : ℕ) : ℝ≥0∞) * ((2 : ℝ≥0∞) ^ k)⁻¹ ≠ ∞ := by
      exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) (ENNReal.inv_ne_top.mpr (by positivity))
    have he := ENNReal.toReal_mono hFin (hSmall k)
    simpa [measureReal_def, ENNReal.toReal_mul, ENNReal.toReal_inv, ENNReal.toReal_pow,
      ← inv_pow, one_div] using he
  have hLim : Tendsto (fun k : ℕ ↦ (2 * m : ℝ) * ((1 / 2 : ℝ) ^ k)) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      (tendsto_pow_atTop_nhds_zero_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)).const_mul
        (2 * m : ℝ)
  have hNull : ν D = 0 := (measureReal_eq_zero_iff (measure_ne_top ν D)).mp <|
    le_antisymm (le_of_tendsto_of_tendsto' tendsto_const_nhds hLim hReal) measureReal_nonneg
  have hAE : ∀ᵐ w ∂ν, w ∉ D := ae_iff.mpr (by simpa using hNull)
  filter_upwards [ae_mem_rudinShapiroSubshift p hp, hAE] with w hw hD
  by_contra h
  exact hD ⟨hw, h⟩

/-- The measured Rudin–Shapiro system has regular phase almost everywhere. -/
theorem rudinShapiro_ae_regularPhase (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop) :
    ∀ᵐ w ∂(rudinShapiroOrbitLaw p : Measure SignWords), RudinShapiroRegularPhase w :=
  rudinShapiro_ae_regularPhase_of_uniform p hp (measure_rudinShapiro_residue p hp)

/-- At a regular phase, the dyadic residues and one sign determine the
entire two-sided word. -/
theorem rudinShapiro_eq_of_regular_phase_and_sign {u v : SignWords}
    (hu : u ∈ rudinShapiroSubshift) (hv : v ∈ rudinShapiroSubshift)
    (hReg : RudinShapiroRegularPhase u) (hSign : u 0 = v 0)
    (hPhase : ∀ k a, a < 2 ^ k → (rudinShapiroResidue k a u ↔ rudinShapiroResidue k a v)) :
    u = v := by
  funext i
  obtain ⟨k, a, ha, hr, hlo, hhi, hhalf⟩ := hReg i
  have he := (rudinShapiro_signProduct_of_residue hu k a i ha hr hlo hhi hhalf).trans
    (rudinShapiro_signProduct_of_residue hv k a i ha ((hPhase _ _ ha).mp hr) hlo hhi hhalf).symm
  rw [hSign] at he
  have hne : signValue (v 0) ≠ 0 := by cases h : v 0 <;> norm_num [signValue, h]
  have hs := mul_left_cancel₀ hne he
  cases h₁ : u i <;> cases h₂ : v i
  all_goals first
    | rfl
    | norm_num [signValue, h₁, h₂] at hs

end Mixing
end

/- Source module Mixing.RudinShapiroPhaseObservation. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section

namespace Mixing

open Filter MeasureTheory Set
open scoped BigOperators Classical ENNReal Topology

/-- The phase read from a word, with a default value when the test is ambiguous. -/
def rudinShapiroPhase (k : ℕ) (w : SignWords) : Fin (2 ^ k) :=
  if h : ∃! a : Fin (2 ^ k), rudinShapiroResidue k a w then Classical.choose h
  else ⟨0, by positivity⟩

theorem rudinShapiroPhase_spec {w : SignWords} (hw : w ∈ rudinShapiroSubshift) (k : ℕ) :
    rudinShapiroResidue k (rudinShapiroPhase k w) w := by
  have h := rudinShapiroResidue_existsUnique_of_mem hw k
  unfold rudinShapiroPhase
  rw [dite_eq_left h]
  exact (Classical.choose_spec h).1

theorem rudinShapiroPhase_eq_iff {w : SignWords} (hw : w ∈ rudinShapiroSubshift)
    (k : ℕ) (a : Fin (2 ^ k)) :
    rudinShapiroPhase k w = a ↔ rudinShapiroResidue k a w := by
  have h := rudinShapiroResidue_existsUnique_of_mem hw k
  constructor
  · rintro rfl
    exact rudinShapiroPhase_spec hw k
  · intro ha
    exact (h.unique (rudinShapiroPhase_spec hw k) ha)

theorem measurable_rudinShapiroPhase (k : ℕ) : Measurable (rudinShapiroPhase k) := by
  classical
  let A (w : SignWords) (a : Fin (2 ^ k)) :=
    if rudinShapiroResidue k a w then true else false
  have hA : Measurable A := Measurable.of_eval fun a ↦
    measurable_const.ite (measurableSet_rudinShapiroResidue k a) measurable_const
  let decode (b : Fin (2 ^ k) → Bool) : Fin (2 ^ k) :=
    if h : ∃! a, b a = true then Classical.choose h else ⟨0, by positivity⟩
  have he : rudinShapiroPhase k = decode ∘ A := by
    funext w
    have h (a : Fin (2 ^ k)) : A w a = true ↔ rudinShapiroResidue k a w := by
      simp [A]
    have he : (∃! a, A w a = true) ↔ ∃! a : Fin (2 ^ k), rudinShapiroResidue k a w :=
      existsUnique_congr h
    change _ = decode (A w)
    unfold rudinShapiroPhase decode
    by_cases hh : ∃! a : Fin (2 ^ k), rudinShapiroResidue k a w
    · have hA' := he.mpr hh
      rw [dite_eq_left hh, dite_eq_left hA']
      exact hh.unique (Classical.choose_spec hh).1 ((h _).mp (Classical.choose_spec hA').1)
    · rw [dite_eq_right hh, dite_eq_right (fun hA' ↦ hh (he.mp hA'))]
  rw [he]
  exact (measurable_of_finite decode).comp hA

theorem measurableSet_rudinShapiroSubshift : MeasurableSet rudinShapiroSubshift := by
  have he : rudinShapiroSubshift =
      ⋂ (I : Finset ℤ) (N : ℕ), {w : SignWords | RudinShapiroPattern I N (fun i ↦ w i)} := by
    ext w
    simp [rudinShapiroSubshift]
  rw [he]
  refine MeasurableSet.iInter fun I ↦ MeasurableSet.iInter fun N ↦ ?_
  have hm : Measurable (fun w : SignWords ↦ fun i : I ↦ w i) :=
    Measurable.of_eval fun i : I ↦ measurable_pi_apply (i : ℤ)
  exact hm (show MeasurableSet {u : I → Bool | RudinShapiroPattern I N u} from
    MeasurableSet.of_discrete)

theorem measurableSet_rudinShapiroRegularPhase : MeasurableSet {w | RudinShapiroRegularPhase w} := by
  let Witness (i : ℤ) :=
    {a : ℕ × ℕ // a.2 < 2 ^ (a.1 + 1) ∧ 0 ≤ (a.2 : ℤ) + i ∧
      (a.2 : ℤ) + i < (2 : ℤ) ^ (a.1 + 1) ∧
      a.2 / 2 ^ a.1 = ((a.2 : ℤ) + i).toNat / 2 ^ a.1}
  have he : {w | RudinShapiroRegularPhase w} =
      ⋂ i : ℤ, ⋃ t : Witness i, {w | rudinShapiroResidue (t.val.1 + 1) t.val.2 w} := by
    ext w
    simp only [mem_ofPred_eq, mem_iInter, mem_iUnion, RudinShapiroRegularPhase]
    constructor
    · intro h i
      obtain ⟨k, a, ha, hr, hlo, hhi, hh⟩ := h i
      exact ⟨⟨(k, a), ha, hlo, hhi, hh⟩, hr⟩
    · intro h i
      obtain ⟨⟨⟨k, a⟩, ha, hlo, hhi, hh⟩, hr⟩ := h i
      exact ⟨k, a, ha, hr, hlo, hhi, hh⟩
  rw [he]
  exact MeasurableSet.iInter fun i ↦ MeasurableSet.iUnion fun t : Witness i ↦
    measurableSet_rudinShapiroResidue (t.val.1 + 1) t.val.2

/-- The space of dyadic phase observations. -/
abbrev RudinShapiroPhases := ∀ k : ℕ, Fin (2 ^ k)

/-- The space of dyadic phase observations together with the central sign. -/
abbrev RudinShapiroObservations := RudinShapiroPhases × Bool

def rudinShapiroPhaseSequence (w : SignWords) : RudinShapiroPhases :=
  fun k ↦ rudinShapiroPhase k w

theorem measurable_rudinShapiroPhaseSequence : Measurable rudinShapiroPhaseSequence :=
  Measurable.of_eval measurable_rudinShapiroPhase

def rudinShapiroObservations (w : SignWords) : RudinShapiroObservations :=
  (rudinShapiroPhaseSequence w, w 0)

theorem measurable_rudinShapiroObservations : Measurable rudinShapiroObservations :=
  measurable_rudinShapiroPhaseSequence.prodMk (measurable_pi_apply 0)

/-- Equality of the phases at one level implies equality at every lower level. -/
theorem rudinShapiroPhase_eq_of_le {u v : SignWords} (hu : u ∈ rudinShapiroSubshift)
    (hv : v ∈ rudinShapiroSubshift) {j k : ℕ} (hjk : j ≤ k)
    (h : rudinShapiroPhase k u = rudinShapiroPhase k v) :
    rudinShapiroPhase j u = rudinShapiroPhase j v := by
  induction hjk with
  | refl => exact h
  | @step n hjn ih =>
    apply ih
    apply Fin.ext
    have hu' := rudinShapiroResidue_succ_coherence_of_mem hu n
      (rudinShapiroPhase (n + 1) u) (rudinShapiroPhase n u)
      (rudinShapiroPhase_spec hu _) (rudinShapiroPhase_spec hu _)
    have hv' := rudinShapiroResidue_succ_coherence_of_mem hv n
      (rudinShapiroPhase (n + 1) v) (rudinShapiroPhase n v)
      (rudinShapiroPhase_spec hv _) (rudinShapiroPhase_spec hv _)
    rw [h] at hu'
    exact hu'.symm.trans hv'

/-- The conull Borel set on which a phase and sign identify the word. -/
def regularRudinShapiroWords : Set SignWords :=
  {w | w ∈ rudinShapiroSubshift ∧ RudinShapiroRegularPhase w}

theorem measurableSet_regularRudinShapiroWords : MeasurableSet regularRudinShapiroWords :=
  measurableSet_rudinShapiroSubshift.inter measurableSet_rudinShapiroRegularPhase

theorem ae_mem_regularRudinShapiroWords (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop) :
    ∀ᵐ w ∂(rudinShapiroOrbitLaw p : Measure SignWords), w ∈ regularRudinShapiroWords :=
  (ae_mem_rudinShapiroSubshift p hp).and (rudinShapiro_ae_regularPhase p hp)

theorem measurableEmbedding_regularRudinShapiroObservations :
    MeasurableEmbedding (fun w : regularRudinShapiroWords ↦ rudinShapiroObservations w.val) := by
  let : StandardBorelSpace regularRudinShapiroWords :=
    measurableSet_regularRudinShapiroWords.standardBorel
  let g (w : regularRudinShapiroWords) := rudinShapiroObservations w.val
  have hg : Measurable g := measurable_rudinShapiroObservations.comp measurable_subtype_coe
  have hi : Function.Injective g := by
    intro u v huv
    apply Subtype.ext
    have hSign : u.val 0 = v.val 0 := congrArg Prod.snd huv
    have hEq (k : ℕ) : rudinShapiroPhase k u.val = rudinShapiroPhase k v.val :=
      congrFun (congrArg Prod.fst huv) k
    apply rudinShapiro_eq_of_regular_phase_and_sign u.property.1 v.property.1 u.property.2 hSign
    intro k a ha
    let b : Fin (2 ^ k) := ⟨a, ha⟩
    change rudinShapiroResidue k b u.val ↔ rudinShapiroResidue k b v.val
    rw [← rudinShapiroPhase_eq_iff u.property.1 k b,
      ← rudinShapiroPhase_eq_iff v.property.1 k b, hEq]
  exact hg.measurableEmbedding hi

/-- On a conull set the phase observations recover each measurable set of words. -/
theorem ae_eq_preimage_rudinShapiroObservations (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)
    {s : Set SignWords} (hs : MeasurableSet s) :
    ∃ t : Set RudinShapiroObservations, MeasurableSet t ∧
      s =ᵐ[(rudinShapiroOrbitLaw p : Measure SignWords)] (rudinShapiroObservations ⁻¹' t) := by
  let g (w : regularRudinShapiroWords) := rudinShapiroObservations w.val
  have hg : MeasurableEmbedding g := measurableEmbedding_regularRudinShapiroObservations
  let T : Set regularRudinShapiroWords := Subtype.val ⁻¹' s
  refine ⟨g '' T, hg.measurableSet_image' (measurable_subtype_coe hs), ?_⟩
  filter_upwards [ae_mem_regularRudinShapiroWords p hp] with w hw
  change w ∈ s ↔ rudinShapiroObservations w ∈ g '' T
  constructor
  · intro h
    exact ⟨⟨w, hw⟩, h, rfl⟩
  · rintro ⟨v, hv, he⟩
    have hvw : v = ⟨w, hw⟩ := hg.injective he
    simpa only [T, mem_preimage, hvw] using hv

end Mixing
end

