    ⟪a.vector, example5GaussianSystem.koopmanRep g b.vector⟫_ℂ =
      ∫ x, gaussianCylChar a.times (fun i ↦ -a.frequencies i) x *
        gaussianCylChar b.times b.frequencies (example5GaussianSystem.act g x)
