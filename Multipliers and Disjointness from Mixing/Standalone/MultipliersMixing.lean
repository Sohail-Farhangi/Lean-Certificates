/-! # Extracting a signed height polynomial from a nonzero free limit -/


open Filter Set MeasureTheory
open scoped Topology ENNReal

namespace Mixing

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩
local instance : IsProbabilityMeasure chaconTowerSystem.measure := chaconTowerSystem.probability

/-- The approximation for an integral scale ratio needed to peel off
one height polynomial. -/
def ChaconSmallRemainderFactorization : Prop :=
  ∀ (q : Ultrafilter ℕ) (m : ℕ) (n : ℕ → ℕ) (s : ℕ → ℤ), Tendsto n q atTop →
    Tendsto (fun j ↦ ((s j).natAbs : ℝ) / chaconTowerHeight (n j)) q (𝓝 0) →
    let U := chaconTowerSystem.koopmanZeroRep
    ultrafilterOperator U (q.map (fun j ↦
      Multiplicative.ofAdd ((m * chaconTowerHeight (n j) : ℕ) + s j))) =
      chaconHeightPolynomialOperatorZero m *
        ultrafilterOperator U (q.map (Multiplicative.ofAdd ∘ s))

/-- The limiting operator is zero in the branch where no normalized
height ratio is integral. -/
def ChaconNonintegralScaleDecay : Prop :=
  ∀ (q : Ultrafilter ℕ), (q : Filter ℕ) ≤ atTop →
    ∀ τ ∈ Icc (1 : ℝ) 3, (∀ r m : ℕ, τ * 3 ^ r ≠ (m : ℝ)) →
      (∀ r : ℕ, Tendsto (chaconScaleLevel r) q atTop ∧
        ∀ᶠ j in (q : Filter ℕ), j / chaconTowerHeight (chaconScaleLevel r j) =
          chaconScaleCoefficient τ r) →
      ultrafilterOperator chaconTowerSystem.koopmanZeroRep (q.map chaconNaturalTime) = 0

/-- The integral branch factors through a positive height polynomial,
while the nonintegral branch vanishes under the decay estimate. -/
theorem chaconNaturalTime_zero_or_height_factor
    (hSmall : ChaconSmallRemainderFactorization) (hDecay : ChaconNonintegralScaleDecay)
    (q : Ultrafilter ℕ) (hq : (q : Filter ℕ) ≤ atTop) :
    let U := chaconTowerSystem.koopmanZeroRep
    ultrafilterOperator U (q.map chaconNaturalTime) = 0 ∨
      ∃ (m : ℕ) (p' : Ultrafilter (Multiplicative ℤ)), 0 < m ∧
        ultrafilterOperator U (q.map chaconNaturalTime) =
          chaconHeightPolynomialOperatorZero m * ultrafilterOperator U p' := by
  rcases chaconNaturalTime_scale_dichotomy q hq with
    ⟨m, n, s, hm, hn, hs, htime⟩ | ⟨τ, hτ, hNon, hProfile⟩
  · have h := hSmall q m n s hn hs
    have he : (fun j ↦ Multiplicative.ofAdd ((m * chaconTowerHeight (n j) : ℕ) + s j)) =
        chaconNaturalTime := by
      funext j
      exact congrArg Multiplicative.ofAdd (htime j).symm
    simp only [he] at h
    exact Or.inr ⟨m, q.map (Multiplicative.ofAdd ∘ s), hm, h⟩
  · exact Or.inl (hDecay q hq τ hτ hNon hProfile)

/-- The sign indicates whether to take the adjoint of the polynomial
limit along positive heights. -/
noncomputable def chaconSignedHeightPolynomialOperatorZero (b : Bool) (m : ℕ) :
    meanZero chaconTowerSystem.measure →L[ℂ] meanZero chaconTowerSystem.measure :=
  if b then (chaconHeightPolynomialOperatorZero m).adjoint
  else chaconHeightPolynomialOperatorZero m

/-- A height polynomial commutes with every weak limit of powers. -/
theorem chaconHeightPolynomialOperatorZero_commute (m : ℕ) (p : Ultrafilter (Multiplicative ℤ)) :
    Commute (chaconHeightPolynomialOperatorZero m)
      (ultrafilterOperator chaconTowerSystem.koopmanZeroRep p) := by
  let q : Ultrafilter ℕ := Ultrafilter.of atTop
  have hq : (q : Filter ℕ) ≤ atTop := Ultrafilter.of_le _
  rw [← ultrafilterOperator_chaconHeight_zero m q hq]
  exact ultrafilterOperator_commute_pair _ _ _

/-- The positive and negative cases of the scale analysis give a signed
height factor for every nonzero free weak limit. -/
theorem chaconFree_zero_or_signed_height_factor
    (hSmall : ChaconSmallRemainderFactorization) (hDecay : ChaconNonintegralScaleDecay)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : p ∈ freeUltrafilters (Multiplicative ℤ)) :
    let U := chaconTowerSystem.koopmanZeroRep
    ultrafilterOperator U p = 0 ∨
      ∃ (b : Bool) (m : ℕ) (p' : Ultrafilter (Multiplicative ℤ)), 0 < m ∧
        ultrafilterOperator U p =
          chaconSignedHeightPolynomialOperatorZero b m * ultrafilterOperator U p' := by
  let U := chaconTowerSystem.koopmanZeroRep
  obtain ⟨q, hq, hqLift⟩ := chaconNaturalTime_lift_or_inverse p hp
  have h := chaconNaturalTime_zero_or_height_factor hSmall hDecay q hq
  dsimp only at h
  rcases hqLift with he | he
  · rw [he] at h
    rcases h with hz | ⟨m, p', hm, hp'⟩
    · exact Or.inl hz
    · exact Or.inr ⟨false, m, p', hm,
        by simpa only [chaconSignedHeightPolynomialOperatorZero, Bool.false_eq_true, ite_false]
          using hp'⟩
  · rw [he, ultrafilterOperator_inverse] at h
    rcases h with hz | ⟨m, p', hm, hp'⟩
    · left
      have hs := congrArg star hz
      change star (star (ultrafilterOperator U p)) = star (0 : _ →L[ℂ] _) at hs
      simpa only [star_star, star_zero] using hs
    · right
      refine ⟨true, m, inverseUltrafilter p', hm, ?_⟩
      have hComm := chaconHeightPolynomialOperatorZero_commute m p'
      rw [hComm.eq] at hp'
      have hs := congrArg star hp'
      change star (star (ultrafilterOperator U p)) =
        star (ultrafilterOperator U p' * chaconHeightPolynomialOperatorZero m) at hs
      simpa only [star_star, star_mul, chaconSignedHeightPolynomialOperatorZero,
        ite_true, ultrafilterOperator_inverse, ContinuousLinearMap.star_eq_adjoint,
        ContinuousLinearMap.adjoint_adjoint] using hs

end Mixing
end

/- Source module Mixing.ChaconColumns. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section
namespace Mixing

open Filter MeasureTheory Set
open scoped Classical ENNReal Topology

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- The point on level `l` over the tail `x` at the `n`th tower scale. -/
def chaconColumnPoint (n : ℕ) (l : ℤ) (x : ChaconOdometer) :
    ChaconOdometer × Bool :=
  chaconTowerSystem.act (Multiplicative.ofAdd l) (chaconScaleBranch n 0 x, false)

theorem measurable_chaconColumnPoint (n : ℕ) (l : ℤ) :
    Measurable (chaconColumnPoint n l) :=
  (chaconTowerSystem.preserves _).measurable.comp
    ((measurable_chaconScaleBranch n 0).prodMk measurable_const)

theorem chaconColumnPoint_shift (n : ℕ) (l s : ℤ) (x : ChaconOdometer) :
    chaconTowerSystem.act (Multiplicative.ofAdd s) (chaconColumnPoint n l x) =
      chaconColumnPoint n (s + l) x := by
  unfold chaconColumnPoint
  exact (congrFun (chaconTowerSystem.act_mul (Multiplicative.ofAdd s)
    (Multiplicative.ofAdd l)) _).symm

/-- Main-column return times depend only on the finite residue. -/
theorem chaconReturnSum_column (n r : ℕ) (hr : r < 3 ^ n) (x : ChaconOdometer) :
    chaconReturnSum r (chaconScaleBranch n 0 x) = chaconReturnSum r 0 := by
  induction r with
  | zero => simp [chaconReturnSum]
  | succ r ih =>
    have h : chaconScaleBranch n 0 x + (r : ChaconOdometer) = chaconScaleBranch n r x := by
      simp [chaconScaleBranch]
    rw [chaconReturnSum_succ, chaconReturnSum_succ, ih (by omega), h, zero_add,
      chaconSpacer_scaleBranch_iff n r hr x]

theorem chaconReturnSum_zero_strictMono : StrictMono (fun r ↦ chaconReturnSum r 0) := by
  apply strictMono_nat_of_lt_succ
  intro r
  rw [chaconReturnSum_succ]
  split <;> omega

private theorem chaconSpacerBit_last_prefix (n : ℕ) (x : ChaconOdometer) :
    chaconSpacerBit (chaconScaleBranch n (3 ^ n - 1) x) = chaconSpacerBit x := by
  induction n with
  | zero => simp [chaconScaleBranch]
  | succ n ih =>
    have h : chaconScaleBranch (n+1) (3^(n+1)-1) x =
        3 * chaconScaleBranch n (3^n-1) x + 2 := by
      unfold chaconScaleBranch
      have hpos : 0 < (3 : ℕ)^n := by positivity
      have he : 3^(n+1)-1 = 3*(3^n-1)+2 := by rw [pow_succ]; omega
      rw [he, pow_succ']
      push_cast
      ring
    rw [h, chaconSpacerBit_three_mul_add_two, ih]

theorem chaconColumn_last_spacer (n : ℕ) (x : ChaconOdometer) :
    chaconScaleBranch n (3 ^ n - 1) x ∈ chaconSpacer ↔ x ∈ chaconSpacer := by
  have h := chaconSpacerBit_last_prefix n x
  unfold chaconSpacerBit at h
  split_ifs at h <;> simp_all

private theorem chaconZero_not_mem_spacer : (0 : ChaconOdometer) ∉ chaconSpacer := by
  have h := chaconSpacerBit_three_mul (0 : ChaconOdometer)
  simp only [mul_zero] at h
  intro h₀
  simp [chaconSpacerBit, h₀] at h

theorem chaconReturnSum_column_height (n : ℕ) :
    chaconReturnSum (3 ^ n) 0 = chaconTowerHeight n := by
  have h := chaconReturnSum_at_height n 1 0 (by positivity) (0 : ChaconOdometer)
  simpa [chaconSpacerCount, chaconSpacerBit, chaconZero_not_mem_spacer] using h

theorem chaconColumnPoint_returnSum (n r : ℕ) (hr : r < 3 ^ n) (x : ChaconOdometer) :
    chaconColumnPoint n (chaconReturnSum r 0 : ℤ) x = (chaconScaleBranch n r x, false) := by
  rw [← chaconReturnSum_column n r hr x]
  exact (chaconTower_return_action r (chaconScaleBranch n 0 x)).trans (by simp [chaconScaleBranch])

theorem chaconColumnPoint_spacer (n r : ℕ) (hr : r < 3 ^ n) (x : ChaconOdometer)
    (hx : chaconScaleBranch n r x ∈ chaconSpacer) :
    chaconColumnPoint n ((chaconReturnSum r 0 : ℤ) + 1) x =
      (chaconScaleBranch n r x, true) := by
  rw [add_comm, ← chaconColumnPoint_shift, chaconColumnPoint_returnSum n r hr,
    chaconTower_bottom_step, ite_eq_left hx]

theorem chaconColumnPoint_top (n : ℕ) (x : ChaconOdometer) (hx : x ∈ chaconSpacer) :
    chaconColumnPoint n (chaconTowerHeight n : ℤ) x =
      (chaconScaleBranch n (3 ^ n - 1) x, true) := by
  have hpos : 0 < (3 : ℕ)^n := by positivity
  have hr : 3 ^ n - 1 < (3 : ℕ) ^ n := by omega
  have hs : 3 ^ n - 1 + 1 = (3 : ℕ)^n := by omega
  have h0 : ((3 ^ n - 1 : ℕ) : ChaconOdometer) ∉ chaconSpacer := by
    simpa only [chaconScaleBranch, mul_zero, zero_add] using
      (chaconColumn_last_spacer n 0).not.mpr chaconZero_not_mem_spacer
  have he := chaconReturnSum_succ (3 ^ n - 1) (0 : ChaconOdometer)
  rw [hs, chaconReturnSum_column_height, zero_add, ite_eq_right h0] at he
  rw [he, Nat.cast_add, Nat.cast_one]
  exact chaconColumnPoint_spacer n _ hr x ((chaconColumn_last_spacer n x).mpr hx)

/-- A level below the height lies in a residue and layer independent of the tail. -/
theorem chaconColumnPoint_core (n l : ℕ) (hl : l < chaconTowerHeight n) :
    ∃ (r : ℕ) (b : Bool), r < 3 ^ n ∧ ∀ x : ChaconOdometer,
      chaconColumnPoint n (l : ℤ) x = (chaconScaleBranch n r x, b) := by
  have he : ∃ r, l < chaconReturnSum r 0 := ⟨3 ^ n, chaconReturnSum_column_height n ▸ hl⟩
  let k := Nat.find he
  have hk := Nat.find_spec he
  have hkle := Nat.find_min' he (show l < chaconReturnSum (3 ^ n) 0 by
    rw [chaconReturnSum_column_height]; exact hl)
  change l < chaconReturnSum k 0 at hk
  change k ≤ 3 ^ n at hkle
  cases h : k with
  | zero => simp [h, chaconReturnSum] at hk
  | succ r =>
    have hr : r < (3 : ℕ)^n := by omega
    have hrl : chaconReturnSum r 0 ≤ l :=
      Nat.le_of_not_gt (Nat.find_min he (show r < Nat.find he by change r < k; omega))
    rw [h, chaconReturnSum_succ, zero_add] at hk
    rcases eq_or_ne l (chaconReturnSum r 0) with rfl | hn
    · exact ⟨r, false, hr, chaconColumnPoint_returnSum n r hr⟩
    · have hs : (r : ChaconOdometer) ∈ chaconSpacer := by
        by_contra h'
        rw [ite_eq_right h'] at hk
        omega
      rw [ite_eq_left hs] at hk
      have hlt : r + 1 < (3 : ℕ)^n := by
        by_contra! h'
        have hr' : r = 3 ^ n - 1 := by omega
        exact chaconZero_not_mem_spacer ((chaconColumn_last_spacer n 0).mp
          (by simpa [chaconScaleBranch, hr'] using hs))
      have h' : l = chaconReturnSum r 0 + 1 := by omega
      subst l
      exact ⟨r, true, hr, fun x ↦ by
        push_cast
        exact chaconColumnPoint_spacer n r hr x ((chaconSpacer_scaleBranch_iff n r hlt x).mpr hs)⟩

/-- The return to the origin of the column after advancing by `m` tails. -/
theorem chaconColumnPoint_advance (n m : ℕ) (l q : ℤ) (x : ChaconOdometer) :
    chaconColumnPoint n ((m * chaconTowerHeight n : ℕ) + q + l) x =
      chaconColumnPoint n (q + l - (chaconSpacerCount m x : ℤ)) (x + m) := by
  have h := chaconTower_action_at_height n m 0 (by positivity) x
  change chaconColumnPoint n (m * chaconTowerHeight n : ℕ) x =
    chaconColumnPoint n (-(chaconSpacerCount m x : ℤ)) (x + m) at h
  rw [show (↑(m * chaconTowerHeight n) : ℤ) + q + l = q + l + ↑(m * chaconTowerHeight n) by ring,
    ← chaconColumnPoint_shift, h, chaconColumnPoint_shift, sub_eq_add_neg]

end Mixing
end

/- Source module Mixing.ChaconColumnMeasure. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section
namespace Mixing

open Filter MeasureTheory Set
open scoped Classical ENNReal Topology

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

/-- Each main level receives this mass times the probability of its tail. -/
def chaconColumnWeight (n : ℕ) : ℝ :=
  ((1 + chaconOdometerMeasure chaconSpacer)⁻¹).toReal * (↑(3^n : ℕ) : ℝ)⁻¹

theorem chaconColumnWeight_nonneg (n : ℕ) : 0 ≤ chaconColumnWeight n := by
  unfold chaconColumnWeight
  positivity

theorem tendsto_chaconColumnWeight : Tendsto chaconColumnWeight atTop (𝓝 0) := by
  change Tendsto (fun n : ℕ ↦ ((1 + chaconOdometerMeasure chaconSpacer)⁻¹).toReal *
    (↑(3^n : ℕ) : ℝ)⁻¹) atTop (𝓝 0)
  simpa only [Nat.cast_pow, Nat.cast_ofNat, inv_pow, mul_zero] using
    (tendsto_pow_atTop_nhds_zero_of_lt_one (r := (3 : ℝ)⁻¹) (by norm_num) (by norm_num)).const_mul
      ((1 + chaconOdometerMeasure chaconSpacer)⁻¹).toReal

private theorem zmod_finEquiv_val (q : ℕ) [NeZero q] (r : Fin q) :
    (ZMod.finEquiv q r).val = r.val := by
  cases q with
  | zero => exact Fin.elim0 r
  | succ q => rfl

private theorem sum_zmod_eq_sum_range {E : Type*} [AddCommMonoid E]
    (q : ℕ) [NeZero q] (f : ℕ → E) :
    (∑ r : ZMod q, f r.val) = ∑ r ∈ Finset.range q, f r := by
  rw [← Fin.sum_univ_eq_sum_range]
  refine (Equiv.sum_comp (ZMod.finEquiv q).toEquiv (fun r : ZMod q ↦ f r.val)).symm.trans ?_
  exact Finset.sum_congr rfl fun r _ ↦ congrArg f (zmod_finEquiv_val q r)

private theorem chaconColumn_sum_returns {E : Type*} [AddCommMonoid E] (f : ℕ → E) (q : ℕ) :
    (∑ l ∈ Finset.range (chaconReturnSum q 0), f l) =
      ∑ r ∈ Finset.range q, (f (chaconReturnSum r 0) +
        if (r : ChaconOdometer) ∈ chaconSpacer then f (chaconReturnSum r 0 + 1) else 0) := by
  induction q with
  | zero => simp [chaconReturnSum]
  | succ q ih =>
    rw [chaconReturnSum_succ, zero_add, Finset.sum_range_succ _ q]
    by_cases h : (q : ChaconOdometer) ∈ chaconSpacer
    · rw [ite_eq_left h, ite_eq_left h,
        show chaconReturnSum q 0 + 2 = (chaconReturnSum q 0 + 1) + 1 by omega,
        Finset.sum_range_succ, Finset.sum_range_succ, ih]
      ac_rfl
    · rw [ite_eq_right h, ite_eq_right h, add_zero, Finset.sum_range_succ, ih]

/-- The exact measure formula for the main tower levels and the possible
extra spacer at one level above the column. -/
theorem integral_chaconColumn {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    {F : ChaconOdometer × Bool → E} (hF : Measurable F)
    {B : ℝ} (hB : ∀ x, ‖F x‖ ≤ B) (n : ℕ) :
    (∫ x, F x ∂chaconTowerSystem.measure) =
      chaconColumnWeight n • ((∑ l ∈ Finset.range (chaconTowerHeight n),
        ∫ x, F (chaconColumnPoint n (l : ℤ) x) ∂chaconOdometerMeasure) +
        ∫ x in chaconSpacer, F (chaconColumnPoint n (chaconTowerHeight n : ℤ) x)
          ∂chaconOdometerMeasure) := by
  let μ := chaconOdometerMeasure
  let g (x : ChaconOdometer) := F (x, false)
  let h (x : ChaconOdometer) := chaconSpacer.indicator (fun x ↦ F (x, true)) x
  let f (l : ℕ) := ∫ x, F (chaconColumnPoint n (l : ℤ) x) ∂μ
  let Q := (3 : ℕ)^n
  let top := ∫ x in chaconSpacer, F (chaconColumnPoint n (chaconTowerHeight n : ℤ) x) ∂μ
  have hQ : 0 < Q := by dsimp [Q]; positivity
  have hB₀ : 0 ≤ B := (norm_nonneg _).trans (hB (0, false))
  have hg : Integrable g μ := Integrable.of_bound
    (hF.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable B
    (ae_of_all _ fun x ↦ hB (x, false))
  have hh : Integrable h μ := (Integrable.of_bound
    (hF.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable B
    (ae_of_all _ fun x ↦ hB (x, true))).indicator chaconSpacer_measurable
  have hIntSp : (∫ x in chaconSpacer, F (x, true) ∂μ) = ∫ x, h x ∂μ :=
    (integral_indicator chaconSpacer_measurable).symm
  rw [integral_chaconTower_split hF hB]
  change ((1 + μ chaconSpacer)⁻¹).toReal •
    ((∫ x, g x ∂μ) + ∫ x in chaconSpacer, F (x, true) ∂μ) = _
  rw [hIntSp, integral_chaconScaleBranch_decomposition n hg,
    integral_chaconScaleBranch_decomposition n hh, ← smul_add, smul_smul]
  change chaconColumnWeight n • _ = chaconColumnWeight n • _
  congr 1
  rw [sum_zmod_eq_sum_range (3^n) (fun r ↦ ∫ x, g (chaconScaleBranch n r x) ∂μ),
    sum_zmod_eq_sum_range (3^n) (fun r ↦ ∫ x, h (chaconScaleBranch n r x) ∂μ),
    ← Finset.sum_add_distrib]
  change (∑ r ∈ Finset.range Q,
    ((∫ x, g (chaconScaleBranch n r x) ∂μ) +
     (∫ x, h (chaconScaleBranch n r x) ∂μ))) =
     (∑ l ∈ Finset.range (chaconTowerHeight n), f l) + top
  have hE : (∑ r ∈ Finset.range Q, if r = Q-1 then top else 0) = top := by
    simp only [Finset.sum_ite_eq', Finset.mem_range, show Q-1 < Q by omega, ite_true]
  rw [← chaconReturnSum_column_height n, chaconColumn_sum_returns, ← hE,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  have hrl : r < 3 ^ n := Finset.mem_range.mp hr
  rw [show (∫ x, g (chaconScaleBranch n r x) ∂μ) = f (chaconReturnSum r 0) by
    simp only [f, g, chaconColumnPoint_returnSum n r hrl]]
  rw [add_assoc]
  congr 1
  by_cases hs : r + 1 < 3 ^ n
  · have hn : r ≠ Q-1 := by omega
    simp only [hn, ite_false, add_zero]
    by_cases hp : (r : ChaconOdometer) ∈ chaconSpacer
    · rw [ite_eq_left hp]
      apply integral_congr_ae
      refine ae_of_all _ fun x ↦ ?_
      have hx := (chaconSpacer_scaleBranch_iff n r hs x).mpr hp
      simp only [h, indicator_of_mem hx]
      rw [Nat.cast_add, Nat.cast_one, chaconColumnPoint_spacer n r hrl x hx]
    · rw [ite_eq_right hp]
      apply integral_eq_zero_of_ae
      exact ae_of_all _ fun x ↦ indicator_of_notMem
        (fun hx ↦ hp ((chaconSpacer_scaleBranch_iff n r hs x).mp hx)) _
  · have hr' : r = Q-1 := by omega
    have hp : (r : ChaconOdometer) ∉ chaconSpacer := by
      intro hsp
      have hbad := (chaconColumn_last_spacer n 0).mp
        (show chaconScaleBranch n (3^n-1) 0 ∈ chaconSpacer by simpa [chaconScaleBranch, hr', Q] using hsp)
      have hz := chaconSpacerBit_three_mul (0 : ChaconOdometer)
      simp [chaconSpacerBit, hbad] at hz
    rw [ite_eq_right hp, ite_eq_left hr', zero_add]
    change _ = ∫ x in chaconSpacer, F (chaconColumnPoint n (chaconTowerHeight n : ℤ) x) ∂μ
    rw [← integral_indicator chaconSpacer_measurable]
    apply integral_congr_ae
    refine ae_of_all _ fun x ↦ ?_
    by_cases hx : x ∈ chaconSpacer
    · rw [indicator_of_mem hx, chaconColumnPoint_top n x hx]
      have hhx := (chaconColumn_last_spacer n x).mpr hx
      change h (chaconScaleBranch n r x) = _
      rw [hr']
      exact indicator_of_mem hhx _
    · rw [indicator_of_notMem hx]
      exact indicator_of_notMem (fun he ↦ hx ((chaconColumn_last_spacer n x).mp (by
        simpa only [hr', Q] using he))) _

end Mixing
end

