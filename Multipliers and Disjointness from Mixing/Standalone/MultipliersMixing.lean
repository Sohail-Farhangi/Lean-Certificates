  have hNA : ∀ᶠ n in atTop, N (j n) ≤ n := by
    filter_upwards [eventually_ge_atTop (N 0)] with n hn
    obtain ⟨i, hi, hij⟩ := (A n).sup_mem_of_nonempty (f := id) ⟨0, hA hn⟩
    change i = j n at hij
