/-!
# Invariant means generated by Følner averages

A limit along an ultrafilter extending the averaging filter is a positive
normalized linear functional on real L∞. Nonsingularity allows each
translation test to use a bounded measurable representative. The same
construction realizes the upper and lower density of a fixed measurable
set along the averaging net as values of invariant means.
-/


open Filter Function MeasureTheory Set
open scoped ENNReal Topology

namespace Mixing.JdLGBridge

variable {S I : Type*} [MeasurableSpace S] {μ : Measure S}

private theorem exists_ae_norm_bound {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ C : ℝ, 0 < C ∧ ∀ᵐ s ∂μ, ‖f s‖ ≤ C := by
  refine ⟨max 1 (eLpNorm f ∞ μ).toReal, zero_lt_one.trans_le (le_max_left ..), ?_⟩
  filter_upwards [eNorm_ae_le_eLpNormEssSup f μ] with s hs
  rw [← eLpNorm_exponent_top hf.aestronglyMeasurable] at hs
  exact (by simpa using (ENNReal.toReal_mono hf.eLpNorm_ne_top hs).trans (le_max_right ..))

private theorem memLp_top_integrable_of_ac {f : S → ℝ} (hf : MemLp f ∞ μ)
    {ν : Measure S} [IsFiniteMeasure ν] (hac : ν ≪ μ) : Integrable f ν := by
  obtain ⟨C, _, hb⟩ := exists_ae_norm_bound hf
  exact (integrable_const C).mono' (hf.aestronglyMeasurable.mono_ac hac)
    (hb.filter_mono hac.ae_le)

private theorem exists_integral_limit (ν : I → Measure S)
    (hp : ∀ i, IsProbabilityMeasure (ν i)) (hac : ∀ i, ν i ≪ μ)
    (q : Ultrafilter I) {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ a : ℝ, Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 a) := by
  obtain ⟨C, _, hC⟩ := exists_ae_norm_bound hf
  have hb (i : I) : ‖∫ s, f s ∂ν i‖ ≤ C := by
    let : IsProbabilityMeasure (ν i) := hp i
    simpa only [probReal_univ, mul_one] using
      norm_integral_le_of_norm_le_const (hC.filter_mono (hac i).ae_le)
  have hmem : Metric.closedBall (0 : ℝ) C ∈ q.map (fun i ↦ ∫ s, f s ∂ν i) := by
    change ∀ᶠ i in (q : Filter I), (∫ s, f s ∂ν i) ∈ Metric.closedBall 0 C
    exact Eventually.of_forall fun i ↦ by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hb i
  obtain ⟨a, _, ha⟩ := (isCompact_closedBall (0 : ℝ) C).ultrafilter_le_nhds' _ hmem
  exact ⟨a, ha⟩

/-- Taking an ultrafilter limit of probability integrals defines a genuine
mean on L∞ of the base measure, provided the probabilities are absolutely
continuous with respect to that measure. -/
theorem exists_measuredMean_of_probability_ultrafilter (ν : I → Measure S)
    (hp : ∀ i, IsProbabilityMeasure (ν i)) (hac : ∀ i, ν i ≪ μ) (q : Ultrafilter I) :
    ∃ m : MeasuredMean μ, ∀ (f : S → ℝ) (hf : MemLp f ∞ μ),
      Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (m.value f hf)) := by
  let a := fun f : Lp ℝ ∞ μ ↦ (exists_integral_limit ν hp hac q (Lp.memLp f)).choose
  have ha (f : Lp ℝ ∞ μ) : Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (a f)) :=
    (exists_integral_limit ν hp hac q (Lp.memLp f)).choose_spec
  have hInt (i : I) (f : Lp ℝ ∞ μ) : Integrable (⇑f) (ν i) := by
    let : IsProbabilityMeasure (ν i) := hp i
    exact memLp_top_integrable_of_ac (Lp.memLp f) (hac i)
  let Φ : Lp ℝ ∞ μ →ₗ[ℝ] ℝ :=
    { toFun := a
      map_add' f g := by
        apply tendsto_nhds_unique (ha (f + g))
        apply ((ha f).add (ha g)).congr'
        exact Eventually.of_forall fun i ↦ by
          change (∫ s, f s ∂ν i) + (∫ s, g s ∂ν i) = ∫ s, (f + g) s ∂ν i
          rw [integral_congr_ae ((Lp.coeFn_add f g).filter_mono (hac i).ae_le)]
          exact (integral_add (hInt i f) (hInt i g)).symm
      map_smul' c f := by
        change a (c • f) = c * a f
        apply tendsto_nhds_unique (ha (c • f))
        apply ((ha f).const_mul c).congr'
        exact Eventually.of_forall fun i ↦ by
          change c * (∫ s, f s ∂ν i) = ∫ s, (c • f) s ∂ν i
          rw [integral_congr_ae ((Lp.coeFn_smul c f).filter_mono (hac i).ae_le)]
          exact (integral_const_mul c (⇑f)).symm }
  let m : MeasuredMean μ :=
    { functional := Φ
      monotone' f g h := by
        apply le_of_tendsto_of_tendsto' (ha f) (ha g)
        exact fun i ↦ integral_mono_ae (hInt i f) (hInt i g) (h.filter_mono (hac i).ae_le)
      unit' := by
        let z := (memLp_top_constant (μ := μ) 1).toLp (fun _ ↦ 1)
        change a z = 1
        apply tendsto_nhds_unique (ha z)
        apply (tendsto_const_nhds (x := (1 : ℝ))).congr'
        exact Eventually.of_forall fun i ↦ by
          let : IsProbabilityMeasure (ν i) := hp i
          exact (integral_eq_const ((MemLp.coeFn_toLp (memLp_top_constant 1)).filter_mono
            (hac i).ae_le)).symm }
  refine ⟨m, fun f hf ↦ (ha (hf.toLp f)).congr' ?_⟩
  exact Eventually.of_forall fun i ↦ integral_congr_ae (hf.coeFn_toLp.filter_mono (hac i).ae_le)

/-- Nonsingular composition preserves essential boundedness and the
almost-everywhere class of the translated representative. -/
theorem memLp_top_comp_nonsingular {f : S → ℝ} (hf : MemLp f ∞ μ)
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ) : MemLp (f ∘ t) ∞ μ := by
  obtain ⟨C, _, hb⟩ := exists_ae_norm_bound hf
  exact memLp_top_of_bound (hf.aestronglyMeasurable.comp_quasiMeasurePreserving ht) C (ht.ae hb)

private theorem exists_measurable_bounded_representative {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ g : S → ℝ, Measurable g ∧ f =ᵐ[μ] g ∧ ∃ C : ℝ, 0 < C ∧ ∀ s, ‖g s‖ ≤ C := by
  classical
  obtain ⟨C, hC, hb⟩ := exists_ae_norm_bound hf
  let h := hf.aestronglyMeasurable.aemeasurable
  let g (s : S) := min (max (-C) (h.mk f s)) C
  have hm : Measurable g := (measurable_const.max h.measurable_mk).min measurable_const
  refine ⟨g, hm, ?_, C, hC, ?_⟩
  · filter_upwards [hb, h.ae_eq_mk] with s hs he
    rw [Real.norm_eq_abs, abs_le] at hs
    show f s = g s
    dsimp only [g]
    rw [← he, max_eq_right hs.1, min_eq_left hs.2]
  · intro s
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨le_min (le_max_left ..) (by linarith), min_le_right ..⟩

/-- The total-variation defect against measurable tests of norm at most one
also bounds the asymptotic defect against any essentially bounded function,
when the underlying translation is nonsingular. -/
theorem tendsto_integral_translate_defect_of_nonsingular
    (ν : I → Measure S) (hac : ∀ i, ν i ≪ μ) {l : Filter I}
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ)
    (h : ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g → (∀ s, ‖g s‖ ≤ 1) →
      ‖(∫ s, g (t s) ∂ν i) - ∫ s, g s ∂ν i‖ < ε)
    {f : S → ℝ} (hf : MemLp f ∞ μ) :
    Tendsto (fun i ↦ (∫ s, f (t s) ∂ν i) - ∫ s, f s ∂ν i) l (𝓝 0) := by
  obtain ⟨g, hgm, hfg, C, hC, hb⟩ := exists_measurable_bounded_representative hf
  have hpre : ∀ s, ‖g s / C‖ ≤ 1 := by
    intro s
    simpa only [norm_div, Real.norm_of_nonneg hC.le, div_le_iff₀ hC, one_mul] using hb s
  refine Metric.tendsto_nhds.2 fun ε hε ↦ ?_
  filter_upwards [h (ε / C) (div_pos hε hC)] with i hi
  have htfg := (ht.ae_eq_comp hfg).filter_mono (hac i).ae_le
  have hg := hi (fun s ↦ g s / C) (hgm.div_const C) hpre
  rw [integral_div, integral_div, ← sub_div, norm_div, Real.norm_of_nonneg hC.le,
    div_lt_div_iff_of_pos_right hC] at hg
  rw [dist_zero_right, integral_congr_ae (hfg.filter_mono (hac i).ae_le)]
  have he : (∫ s, f (t s) ∂ν i) = ∫ s, g (t s) ∂ν i := integral_congr_ae htfg
  rwa [he]

/-- A mean is generated by a net of probabilities if some ultrafilter
extending its index filter gives simultaneous convergence on all L∞ tests. -/
def MeasuredMean.IsGeneratedBy (m : MeasuredMean μ) (ν : I → Measure S) (l : Filter I) : Prop :=
  ∃ q : Ultrafilter I, (q : Filter I) ≤ l ∧ ∀ (f : S → ℝ) (hf : MemLp f ∞ μ),
    Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (m.value f hf))

theorem MeasuredMean.IsGeneratedBy.translate_value {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ)
    (h : ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g → (∀ s, ‖g s‖ ≤ 1) →
      ‖(∫ s, g (t s) ∂ν i) - ∫ s, g s ∂ν i‖ < ε)
    {f : S → ℝ} (hf : MemLp f ∞ μ) (hft : MemLp (f ∘ t) ∞ μ) :
    m.value (f ∘ t) hft = m.value f hf := by
  obtain ⟨q, hq, hlim⟩ := hm
  have hdiff := (tendsto_integral_translate_defect_of_nonsingular ν hac ht h hf).mono_left hq
  exact sub_eq_zero.1 (tendsto_nhds_unique ((hlim _ hft).sub (hlim _ hf)) hdiff)

variable [Semigroup S]

/-- Right-translation analogue of the left Følner probability condition. -/
def RightFolnerProbabilities (ν : I → Measure S) (l : Filter I) : Prop :=
  ∀ s : S, ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g →
    (∀ t, ‖g t‖ ≤ 1) → ‖(∫ t, g (t * s) ∂ν i) - ∫ t, g t ∂ν i‖ < ε

/-- Every measured mean generated by a left Følner net is left invariant. -/
theorem MeasuredMean.IsGeneratedBy.leftInvariant {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ) (hν : LeftFolnerProbabilities ν l) :
    m.IsLeftInvariant := by
  intro s f hf hft
  exact hm.translate_value hac (hns s) (hν s) hf hft

/-- Every measured mean generated by a right Følner net is right invariant. -/
theorem MeasuredMean.IsGeneratedBy.rightInvariant {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    (hns : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ) (hν : RightFolnerProbabilities ν l) :
    m.IsRightInvariant := by
  intro s f hf hft
  exact hm.translate_value hac (hns s) (hν s) hf hft

omit [Semigroup S] in
/-- Normalized restrictions are absolutely continuous with respect to the underlying measure. -/
theorem normalizedRestrictedMeasure_absolutelyContinuous (μ : Measure S) (F : Set S) :
    normalizedRestrictedMeasure μ F ≪ μ :=
  Measure.smul_absolutelyContinuous.trans Measure.absolutelyContinuous_restrict

omit [Semigroup S] in
/-- Integration against the normalized restriction is the normalized
block integral used to generate a mean in Section 2.3. -/
theorem normalizedRestrictedMeasure_integral_eq_div (μ : Measure S)
    (F : Set S) (f : S → ℝ) :
    (∫ s, f s ∂normalizedRestrictedMeasure μ F) = (∫ s in F, f s ∂μ) / μ.real F := by
  rw [normalizedRestrictedMeasure, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul,
    div_eq_mul_inv, Measure.real, mul_comm]

/-- The normalized restrictions of a left Følner net of blocks of positive,
finite measure generate left-invariant means on L∞ of the measured semigroup. -/
theorem exists_measuredLeftInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨q, hq⟩ := Filter.exists_ultrafilter_le l
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter
    (fun i ↦ normalizedRestrictedMeasure μ (F i))
    (fun i ↦ normalizedRestrictedMeasure_probability μ (hpos i) (hfin i))
    (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i)) q
  have hgen : m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := ⟨q, hq, hm⟩
  exact ⟨m, hgen.leftInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i))
    hns hν, hgen⟩

/-- Right Følner blocks likewise generate right-invariant means. -/
theorem exists_measuredRightInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ)
    (hν : RightFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsRightInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨q, hq⟩ := Filter.exists_ultrafilter_le l
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter
    (fun i ↦ normalizedRestrictedMeasure μ (F i))
    (fun i ↦ normalizedRestrictedMeasure_probability μ (hpos i) (hfin i))
    (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i)) q
  have hgen : m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := ⟨q, hq, hm⟩
  exact ⟨m, hgen.rightInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ
    (F i)) hns hν, hgen⟩

/-- The same limit is bi-invariant when the blocks are two-sided Følner
and both translations preserve null sets under preimages. -/
theorem exists_measuredBiInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hL : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hR : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ)
    (hl : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    (hr : RightFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.IsRightInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨m, hm, hg⟩ := exists_measuredLeftInvariantMean_of_folnerBlocks μ F hpos hfin hL hl
  exact ⟨m, hm, hg.rightInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ
    (F i)) hR hr, hg⟩

end Mixing.JdLGBridge
end

/- Source module Mixing.SupportingJdLG.FolnerBanachDensities. -/
section
/-
Adapted from the Apache-2.0 Lean certificate for arXiv:2509.24003v3
by Sohail Farhangi, in the Lean-Certificates repository.
This copy changes local imports and isolates its namespaces.
-/


/-!
# Følner and Banach densities on measured semigroups

The limsup and liminf of the normalized block masses are both masses
assigned by left-invariant means generated by the same net. Their bounds
by the upper and lower Banach densities therefore hold for every left
Følner net of compact blocks.
-/


open Filter MeasureTheory Set
open scoped ENNReal Topology

namespace Mixing.JdLGBridge

variable {S I : Type*} [Semigroup S] [MeasurableSpace S] {μ : Measure S}

omit [Semigroup S] in
/-- The normalized restriction evaluates measurable sets by the real
measure ratio used in the definitions of the Følner densities. -/
theorem normalizedRestrictedMeasure_real_eq_div (μ : Measure S) (F : Set S)
    {A : Set S} (hA : MeasurableSet A) :
    (normalizedRestrictedMeasure μ F).real A = (μ.real (A ∩ F)) / (μ.real F) := by
  rw [Measure.real, normalizedRestrictedMeasure, smul_apply,
    Measure.restrict_apply hA, smul_eq_mul, ENNReal.toReal_mul, ENNReal.toReal_inv]
  exact mul_comm _ _

/-- Upper left Banach density defined as the supremum of indicator masses
over the left-invariant means on L∞. -/
noncomputable def MeasuredMean.upperBanachDensity (μ : Measure S) (A : Set S)
    (hA : MeasurableSet A) : ℝ :=
  sSup {r : ℝ | ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = r}

/-- A cluster value of the mass of a measurable set along a left Følner net
is its mass for a generated left-invariant mean. -/
theorem exists_generatedLeftMean_mass_eq_clusterPoint
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) {a : ℝ}
    (ha : MapClusterPt a l (fun i ↦ (normalizedRestrictedMeasure μ (F i)).real A)) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = a ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  let ν (i : I) := normalizedRestrictedMeasure μ (F i)
  have hp (i : I) : IsProbabilityMeasure (ν i) :=
    normalizedRestrictedMeasure_probability μ (hpos i) (hfin i)
  have hac (i : I) : ν i ≪ μ := normalizedRestrictedMeasure_absolutelyContinuous μ (F i)
  obtain ⟨q, hq, ht⟩ := mapClusterPt_iff_ultrafilter.1 ha
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter ν hp hac q
  have hg : m.IsGeneratedBy ν l := ⟨q, hq, hm⟩
  refine ⟨m, hg.leftInvariant hac hns hν, ?_, hg⟩
  refine tendsto_nhds_unique (hm _ (MeasuredMean.memLp_indicator_one hA)) (ht.congr' ?_)
  exact Eventually.of_forall fun i ↦ by
    change (ν i).real A = ∫ s, A.indicator (fun _ ↦ (1 : ℝ)) s ∂ν i
    rw [integral_indicator hA, setIntegral_const, smul_eq_mul, mul_one]

section CompactBlocks

variable [TopologicalSpace S] [IsFiniteMeasureOnCompacts μ]

/-- The lower and upper densities of a measurable set along a left Følner
net of compact blocks are realized by generated invariant means. -/
theorem exists_generatedLeftMeans_mass_eq_folner_densities
    (F : I → Set S) (hF : ∀ i, IsCompact (F i)) (hpos : ∀ i, μ (F i) ≠ 0)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) :
    let d (i : I) := (μ.real (A ∩ F i)) / (μ.real (F i))
    (∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = liminf d l ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) ∧
    (∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.mass A hA = limsup d l ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) := by
  dsimp only
  simp_rw [← normalizedRestrictedMeasure_real_eq_div μ _ hA]
  let ν (i : I) := normalizedRestrictedMeasure μ (F i)
  let d (i : I) := (ν i).real A
  have hfin (i : I) : μ (F i) ≠ ∞ := (hF i).measure_ne_top
  have hd₁ (i : I) : d i ≤ 1 := by
    let : IsProbabilityMeasure (ν i) := normalizedRestrictedMeasure_probability μ (hpos i) (hfin i)
    exact measureReal_le_one
  have hd₀ (i : I) : 0 ≤ d i := measureReal_nonneg
  have hu : IsBoundedUnder (· ≤ ·) l d :=
    ⟨1, show ∀ᶠ i in l, d i ≤ 1 from Eventually.of_forall hd₁⟩
  have hl : IsBoundedUnder (· ≥ ·) l d :=
    ⟨0, show ∀ᶠ i in l, 0 ≤ d i from Eventually.of_forall hd₀⟩
  exact ⟨exists_generatedLeftMean_mass_eq_clusterPoint F hpos hfin hns hν hA
      (MapClusterPt.liminf hu.isCoboundedUnder_ge hl),
    exists_generatedLeftMean_mass_eq_clusterPoint F hpos hfin hns hν hA
      (MapClusterPt.limsup hl.isCoboundedUnder_le hu)⟩

/-- The lower left Banach density bounds the lower density along each
left Følner net from below, and the upper left Banach density bounds its
upper density from above. -/
theorem folnerBlock_densities_compare_Banach
    (F : I → Set S) (hF : ∀ i, IsCompact (F i)) (hpos : ∀ i, μ (F i) ≠ 0)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    {A : Set S} (hA : MeasurableSet A) :
    let d (i : I) := (μ.real (A ∩ F i)) / (μ.real (F i))
    MeasuredMean.lowerBanachDensity (measure := μ) A hA ≤ liminf d l ∧
      limsup d l ≤ MeasuredMean.upperBanachDensity μ A hA := by
  dsimp only
  obtain ⟨⟨m, hm, hml, _⟩, n, hn, hnu, _⟩ :=
    exists_generatedLeftMeans_mass_eq_folner_densities F hF hpos hns hν hA
  constructor
  · rw [← hml, MeasuredMean.lowerBanachDensity]
    exact csInf_le ⟨0, fun _ ⟨k, _, hk⟩ ↦ hk ▸ k.mass_nonneg hA⟩ ⟨m, hm, rfl⟩
  · rw [← hnu, MeasuredMean.upperBanachDensity]
    exact le_csSup ⟨1, fun _ ⟨k, _, hk⟩ ↦ hk ▸ k.mass_le_one hA⟩ ⟨n, hn, rfl⟩

end CompactBlocks

universe u

variable [TopologicalSpace S]

/-- A compact left Følner net on the underlying measured semigroup.
The index filter is proper and each block has positive measure. -/
structure CompactLeftFolnerNet (μ : Measure S) (I : Type u) where
  indexFilter : Filter I
  proper : NeBot indexFilter
  block : I → Set S
  isCompact : ∀ i, IsCompact (block i)
  measure_ne_zero : ∀ i, μ (block i) ≠ 0
  folner : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (block i)) indexFilter

/-- Lower left Følner density as the infimum of lower densities over all
left Følner nets in the indicated universe of index types. -/
noncomputable def lowerFolnerDensity (μ : Measure S) (A : Set S) : ℝ :=
  ⨅ N : (Σ I : Type u, CompactLeftFolnerNet μ I),
    liminf (fun i ↦ (μ.real (A ∩ N.2.block i)) / μ.real (N.2.block i)) N.2.indexFilter

/-- Upper left Følner density as the supremum of upper densities over all
left Følner nets in the indicated universe of index types. -/
noncomputable def upperFolnerDensity (μ : Measure S) (A : Set S) : ℝ :=
  ⨆ N : (Σ I : Type u, CompactLeftFolnerNet μ I),
    limsup (fun i ↦ (μ.real (A ∩ N.2.block i)) / μ.real (N.2.block i)) N.2.indexFilter

/-- The comparison between Følner and Banach densities in Section 2.3,
with the Følner densities taken over every compact left Følner net. -/
theorem folner_densities_compare_Banach [IsFiniteMeasureOnCompacts μ]
    [Nonempty (Σ I : Type u, CompactLeftFolnerNet μ I)]
    (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    {A : Set S} (hA : MeasurableSet A) :
    MeasuredMean.lowerBanachDensity (measure := μ) A hA ≤ lowerFolnerDensity.{u} μ A ∧
      upperFolnerDensity.{u} μ A ≤ MeasuredMean.upperBanachDensity μ A hA := by
  have h (N : Σ I : Type u, CompactLeftFolnerNet μ I) :=
    @folnerBlock_densities_compare_Banach _ N.1 _ _ μ _ _ N.2.block N.2.isCompact
      N.2.measure_ne_zero N.2.indexFilter N.2.proper hns N.2.folner A hA
  exact ⟨le_ciInf fun N ↦ (h N).1, ciSup_le fun N ↦ (h N).2⟩

end Mixing.JdLGBridge
end

/- Source module Mixing.SupportingJdLG.DiscreteFolnerVariation. -/
section
/-
Adapted from the Apache-2.0 Lean certificate for arXiv:2509.24003v3
by Sohail Farhangi, in the Lean-Certificates repository.
This copy changes local imports and isolates its namespaces.
-/


/-!
# Total-variation defect of a finite counting block

A translation need only be a function, possibly identifying points of the
block. Choose one preimage for each point common to the original block and
its translated image. These paired terms cancel in the difference of the
averages. The remaining terms attain the total-variation bound when tested
by the sign of the complement of the translated image in the original block.
-/


open Filter Function MeasureTheory Set
open scoped ENNReal Topology symmDiff

namespace Mixing.JdLGBridge

variable {S : Type*} [MeasurableSpace S] [DiscreteMeasurableSpace S]

/-- Integration over a normalized finite counting block equals its ordinary
finite average. -/
theorem integral_normalizedCountingBlock (F : Finset S) (g : S → ℝ) :
    (∫ s, g s ∂normalizedRestrictedMeasure Measure.count (F : Set S)) =
      (∑ s ∈ F, g s) / (F.card : ℝ) := by
  have hi : IntegrableOn g (F : Set S) Measure.count := by
    rw [← (F : Set S).biUnion_of_singleton]
    apply integrableOn_finset_iUnion.2
    intro s _
    exact integrableOn_singleton (by finiteness) (by rw [Measure.count_singleton]; norm_num)
  rw [normalizedRestrictedMeasure_integral_eq_div, setIntegral_finset _ hi,
    Measure.real, Measure.count_apply_finset, ENNReal.toReal_natCast]
  simp only [count_real_singleton, one_smul]

variable [DecidableEq S]

omit [DecidableEq S] in
/-- A nonempty finite counting block gives a probability measure. -/
theorem normalizedCountingBlock_probability (F : Finset S) (hF : F.Nonempty) :
    IsProbabilityMeasure (normalizedRestrictedMeasure Measure.count (F : Set S)) :=
  normalizedRestrictedMeasure_probability Measure.count
    (by rw [Measure.count_apply_finset]; exact_mod_cast hF.card_ne_zero)
    (by rw [Measure.count_apply_finset]; exact ENNReal.natCast_ne_top _)

/-- The total-variation norm, expressed as the maximum normalized integral
defect over all real measurable tests of norm at most one, is twice the
proportion of the original finite block missing from its translated image. -/
theorem isGreatest_countingBlock_translation_defect
    (F : Finset S) (hF : F.Nonempty) (t : S → S) :
    let ν := normalizedRestrictedMeasure Measure.count (F : Set S)
    IsGreatest {r : ℝ | ∃ g : S → ℝ, Measurable g ∧ (∀ s, ‖g s‖ ≤ 1) ∧
      ‖(∫ s, g (t s) ∂ν) - ∫ s, g s ∂ν‖ = r}
      (2 * ((F \ F.image t).card : ℝ) / (F.card : ℝ)) := by
  classical
  let : Nonempty S := ⟨hF.choose⟩
  let G := F ∩ F.image t
  let u := invFunOn t (F : Set S)
  let P := G.image u
  let D := F \ F.image t
  have hinv (y : S) (hy : y ∈ G) : u y ∈ F ∧ t (u y) = y := by
    obtain ⟨x, hx, hxy⟩ := Finset.mem_image.1 (Finset.mem_inter.1 hy).2
    exact invFunOn_pos ⟨x, hx, hxy⟩
  have hinj : Set.InjOn u (G : Set S) := by
    intro x hx y hy he
    rw [← (hinv x hx).2, ← (hinv y hy).2, he]
  have hPF : P ⊆ F := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.1 hx
    exact (hinv y hy).1
  have hG : F \ G = D := Finset.sdiff_inter_self_left _ _
  have hc : (F \ P).card = D.card := by
    rw [← hG, Finset.card_sdiff_of_subset hPF,
      Finset.card_sdiff_of_subset Finset.inter_subset_left,
      Finset.card_image_of_injOn hinj]
  have hsum (g : S → ℝ) : (∑ x ∈ F, g (t x)) - (∑ x ∈ F, g x) =
      (∑ x ∈ F \ P, g (t x)) - (∑ x ∈ D, g x) := by
    have hs : (∑ x ∈ P, g (t x)) = ∑ y ∈ G, g y := by
      change (∑ x ∈ G.image u, g (t x)) = _
      rw [Finset.sum_image (fun x hx y hy hxy ↦ hinj hx hy hxy)]
      exact Finset.sum_congr rfl (fun y hy ↦ congrArg g (hinv y hy).2)
    rw [← hG]
    linarith [Finset.sum_sdiff (f := fun x ↦ g (t x)) hPF,
      Finset.sum_sdiff (f := g) (Finset.inter_subset_left : G ⊆ F)]
  have hn (g : S → ℝ) :
      ‖(∫ s, g (t s) ∂normalizedRestrictedMeasure Measure.count (F : Set S)) -
        ∫ s, g s ∂normalizedRestrictedMeasure Measure.count (F : Set S)‖ =
      ‖(∑ x ∈ F \ P, g (t x)) - ∑ x ∈ D, g x‖ / (F.card : ℝ) := by
    rw [integral_normalizedCountingBlock, integral_normalizedCountingBlock,
      ← sub_div, hsum g, norm_div, Real.norm_of_nonneg (Nat.cast_nonneg _)]
  have hb (K : Finset S) (g : S → ℝ) (hg : ∀ x, ‖g x‖ ≤ 1) :
      ‖∑ s ∈ K, g s‖ ≤ (K.card : ℝ) := calc
    _ ≤ ∑ s ∈ K, ‖g s‖ := norm_sum_le _ _
    _ ≤ ∑ _s ∈ K, (1 : ℝ) := Finset.sum_le_sum fun s _ ↦ hg s
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
  constructor
  · let g (s : S) : ℝ := if s ∈ D then -1 else 1
    refine ⟨g, Measurable.of_discrete, fun s ↦ ?_, ?_⟩
    · by_cases hs : s ∈ D <;> simp [g, hs]
    · rw [hn]
      have hpos : (∑ x ∈ F \ P, g (t x)) = ((F \ P).card : ℝ) := by
        calc
          _ = ∑ _x ∈ F \ P, (1 : ℝ) := Finset.sum_congr rfl fun x hx ↦ by
            have ht : t x ∈ F.image t := Finset.mem_image_of_mem t (Finset.mem_sdiff.1 hx).1
            have hd : t x ∉ D := fun h ↦ (Finset.mem_sdiff.1 h).2 ht
            simp [g, hd]
          _ = _ := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
      have hneg : (∑ x ∈ D, g x) = -(D.card : ℝ) := by
        calc
          _ = ∑ _x ∈ D, (-1 : ℝ) := Finset.sum_congr rfl fun x hx ↦ by simp [g, hx]
          _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; ring
      rw [hpos, hneg, hc, sub_neg_eq_add,
        Real.norm_of_nonneg (add_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))]
      congr 1
      ring
  · rintro r ⟨g, _, hg, rfl⟩
    rw [hn]
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    refine (norm_sub_le _ _).trans ?_
    have h₁ := hb (F \ P) (g ∘ t) (fun x ↦ hg (t x))
    have h₂ := hb D g hg
    change ‖∑ x ∈ F \ P, g (t x)‖ ≤ ((F \ P).card : ℝ) at h₁
    rw [hc] at h₁
    change _ ≤ 2 * (D.card : ℝ)
    linarith

omit [DiscreteMeasurableSpace S] [DecidableEq S] in
private theorem integral_sign_indicator (ν : Measure S) [IsProbabilityMeasure ν]
    {A : Set S} (hA : MeasurableSet A) :
    (∫ s, 2 * A.indicator (fun _ ↦ (1 : ℝ)) s - 1 ∂ν) = 2 * ν.real A - 1 := by
  have hI := (integrable_const (1 : ℝ) : Integrable (fun _ : S ↦ (1 : ℝ)) ν).indicator hA
  rw [integral_sub (hI.const_mul 2) (integrable_const 1), integral_const_mul,
    integral_indicator hA, setIntegral_const, integral_const, smul_eq_mul, smul_eq_mul,
    probReal_univ, one_mul, mul_one]

/-- The Hahn–Jordan total variation of the difference between the
translated counting probability and the original counting probability. -/
theorem countingBlock_totalVariation_map_sub
    (F : Finset S) (hF : F.Nonempty) (t : S → S) :
    let ν := normalizedRestrictedMeasure Measure.count (F : Set S)
    letI : IsProbabilityMeasure ν := normalizedCountingBlock_probability F hF
    ((ν.map t).toSignedMeasure - ν.toSignedMeasure).totalVariation.real univ =
      2 * ((F \ F.image t).card : ℝ) / (F.card : ℝ) := by
  classical
  let ν := normalizedRestrictedMeasure Measure.count (F : Set S)
  have hcount : IsProbabilityMeasure ν := normalizedCountingBlock_probability F hF
  let : IsProbabilityMeasure ν := hcount
  let θ := ν.map t
  have htm : Measurable t := Measurable.of_discrete
  let : IsProbabilityMeasure θ := (Measure.isProbabilityMeasure_map_iff htm.aemeasurable).2 hcount
  let σ := θ.toSignedMeasure - ν.toSignedMeasure
  let D := F \ F.image t
  have hσ (A : Set S) : σ A = θ.real A - ν.real A :=
    Measure.toSignedMeasure_sub_apply MeasurableSet.of_discrete
  have hsum (A : Set S) : σ A + σ Aᶜ = 0 := by
    rw [← σ.of_union disjoint_compl_right MeasurableSet.of_discrete MeasurableSet.of_discrete,
      union_compl_self, hσ, probReal_univ, probReal_univ, sub_self]
  change σ.totalVariation.real univ = 2 * (D.card : ℝ) / (F.card : ℝ)
  apply le_antisymm
  · obtain ⟨A, hA, hAp, hAn, hpos, hneg⟩ := σ.toJordanDecomposition_spec
    have hvar : σ.totalVariation.real univ = 2 * σ A := by
      rw [SignedMeasure.totalVariation, measureReal_add_apply, hpos, hneg,
        σ.toMeasureOfZeroLE_real_apply hAp hA MeasurableSet.univ,
        σ.toMeasureOfLEZero_real_apply hAn hA.compl MeasurableSet.univ, inter_univ, inter_univ]
      linarith [hsum A]
    let g (s : S) : ℝ := 2 * A.indicator (fun _ ↦ (1 : ℝ)) s - 1
    have hg (s : S) : ‖g s‖ ≤ 1 := by
      by_cases hs : s ∈ A <;> norm_num [g, hs]
    have he : ‖(∫ s, g (t s) ∂ν) - ∫ s, g s ∂ν‖ = σ.totalVariation.real univ := by
      have hgm : Measurable g := Measurable.of_discrete
      rw [← integral_map htm.aemeasurable hgm.aestronglyMeasurable]
      change ‖(∫ s, g s ∂θ) - ∫ s, g s ∂ν‖ = _
      dsimp only [g]
      rw [integral_sign_indicator θ hA, integral_sign_indicator ν hA, hvar, hσ]
      have hpos' := σ.nonneg_of_zero_le_restrict hAp
      rw [hσ] at hpos'
      rw [Real.norm_of_nonneg (by linarith)]
      ring
    exact (isGreatest_countingBlock_translation_defect F hF t).2
      ⟨g, Measurable.of_discrete, hg, he⟩
  · let B : Set S := D
    have hB : MeasurableSet B := MeasurableSet.of_discrete
    have hBD (s : S) (hs : s ∈ F) : t s ∉ B :=
      fun hd ↦ (Finset.mem_sdiff.1 hd).2 (Finset.mem_image_of_mem t hs)
    have hθB : θ.real B = 0 := by
      rw [Measure.real, Measure.map_apply htm hB]
      have hpre : (t ⁻¹' B) ∩ (F : Set S) = ∅ :=
        eq_empty_iff_forall_notMem.2 fun s hs ↦ hBD s hs.2 hs.1
      change (normalizedRestrictedMeasure Measure.count (F : Set S) (t ⁻¹' B)).toReal = 0
      rw [normalizedRestrictedMeasure, smul_apply, Measure.restrict_apply (htm hB), hpre,
        measure_empty, smul_zero, ENNReal.toReal_zero]
    have hνB : ν.real B = (D.card : ℝ) / (F.card : ℝ) := by
      rw [normalizedRestrictedMeasure_real_eq_div Measure.count (F : Set S) hB,
        inter_eq_left.2 (show B ⊆ (F : Set S) from Finset.sdiff_subset)]
      simp only [B, Measure.real, Measure.count_apply_finset, ENNReal.toReal_natCast]
    have hsB : σ B = -ν.real B := by rw [hσ, hθB, zero_sub]
    have hsBc : σ Bᶜ = ν.real B := by linarith [hsum B]
    have hm := add_le_add (σ.norm_le_totalVariation B) (σ.norm_le_totalVariation Bᶜ)
    rw [hsB, hsBc, norm_neg, Real.norm_of_nonneg measureReal_nonneg,
      measureReal_add_measureReal_compl hB, hνB] at hm
    rwa [mul_div_assoc, two_mul]

omit [MeasurableSpace S] [DiscreteMeasurableSpace S] in
/-- For an injective translation the symmetric-difference cardinality is
twice the number of points missing from the translated image. -/
theorem card_symmDiff_image_eq_two_mul_sdiff
    (F : Finset S) {t : S → S} (ht : Injective t) :
    (F ∆ F.image t).card = 2 * (F \ F.image t).card := by
  have hd : _root_.Disjoint (F \ F.image t) (F.image t \ F) :=
    Finset.disjoint_left.2 fun _ hx hy ↦ (Finset.mem_sdiff.1 hx).2 (Finset.mem_sdiff.1 hy).1
  have hc : (F \ F.image t).card = (F.image t \ F).card :=
    Finset.card_sdiff_eq_card_sdiff_iff.2 (Finset.card_image_of_injective F ht).symm
  rw [Finset.symmDiff_def, Finset.card_union_of_disjoint hd, ← hc, two_mul]

variable {I : Type*} [Semigroup S]

/-- For counting measure, the left Følner probability condition is equivalent
to the strong Følner condition given by the proportion missing from the
left-translated block. No cancellation assumption is needed. -/
theorem leftFolnerProbabilities_counting_iff_strongFolner
    (F : I → Finset S) (hF : ∀ i, (F i).Nonempty) (l : Filter I) :
    LeftFolnerProbabilities
      (fun i ↦ normalizedRestrictedMeasure Measure.count (F i : Set S)) l ↔
    ∀ s : S, Tendsto (fun i ↦ ((F i \ (F i).image (s * ·)).card : ℝ) / (F i).card)
      l (𝓝 0) := by
  let ν (i : I) := normalizedRestrictedMeasure Measure.count (F i : Set S)
  let d (s : S) (i : I) := ((F i \ (F i).image (s * ·)).card : ℝ) / (F i).card
  have hnonneg (s : S) (i : I) : 0 ≤ d s i := div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hmax (s : S) (i : I) := isGreatest_countingBlock_translation_defect (F i) (hF i) (s * ·)
  constructor
  · intro h s
    refine Metric.tendsto_nhds.2 fun ε hε ↦ ?_
    filter_upwards [h s (2 * ε) (by positivity)] with i hi
    obtain ⟨g, hg, hgn, he⟩ := (hmax s i).1
    have hb := hi g hg hgn
    change ‖(∫ x, g (s * x) ∂ν i) - ∫ x, g x ∂ν i‖ = _ at he
    rw [he, mul_div_assoc] at hb
    change 2 * d s i < 2 * ε at hb
    change dist (d s i) 0 < ε
    rw [dist_zero_right, Real.norm_of_nonneg (hnonneg s i)]
    linarith
  · intro h s ε hε
    filter_upwards [Metric.tendsto_nhds.1 (h s) (ε / 2) (by positivity)] with i hi g hg hgn
    change dist (d s i) 0 < ε / 2 at hi
    rw [dist_zero_right, Real.norm_of_nonneg (hnonneg s i)] at hi
    have hb := (hmax s i).2 ⟨g, hg, hgn, rfl⟩
    rw [mul_div_assoc] at hb
    exact hb.trans_lt (show 2 * d s i < ε by linarith)

end Mixing.JdLGBridge
end

/- Source module Mixing.SupportingJdLG.Largeness. -/
section
/-
Adapted from the Apache-2.0 Lean certificate for arXiv:2509.24003v3
by Sohail Farhangi, in the Lean-Certificates repository.
This copy changes local imports and isolates its namespaces.
