      (∫ a : K.carrier, f (s * a.1) ∂μ) = ∫ a : K.carrier, f a.1 ∂μ := by
    let b : K.carrier := ⟨s * K.identity, K.mul_mem_left s K.identity_mem⟩
    have h (a : K.carrier) : s * a.1 = (b * a).1 := by
      change s * a.1 = (s * K.identity) * a.1
      rw [mul_assoc, K.identity_mul a.2]
    simp_rw [h]
