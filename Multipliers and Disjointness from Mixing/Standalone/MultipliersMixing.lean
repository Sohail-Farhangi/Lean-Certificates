Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section

namespace Mixing

open scoped Classical

/-- The centre sign restricted to the zero class at dyadic level k. -/
def rudinShapiroZeroCutoff (k : ℕ) (w : SignWords) : ℝ :=
  if rudinShapiroZeroPhase k w then signValue (w 0) else 0

/-- The same cutoff with the sign of the next binary digit included. -/
def rudinShapiroSignedZeroCutoff (k : ℕ) (w : SignWords) : ℝ :=
  if rudinShapiroZeroPhase (k + 1) w then rudinShapiroZeroCutoff k w
  else -rudinShapiroZeroCutoff k w

private theorem rudinShapiro_pow_mul_two (k q : ℕ) : rudinShapiro (2 ^ k * q) = rudinShapiro q := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ', mul_assoc, rudinShapiro_even, ih]

private theorem zeroCutoff_on_sample (k j : ℕ) :
    rudinShapiroZeroCutoff k (signWordShift j rudinShapiroWord) =
      if j % (2 ^ k) = 0 then rudinShapiro (j / 2 ^ k) else 0 := by
  unfold rudinShapiroZeroCutoff
  rw [if_congr (rudinShapiroZeroPhase_on_sample k j) rfl rfl]
  by_cases hj : j % (2 ^ k) = 0
  · simp only [hj, ite_true]
    change signValue (rudinShapiroWord (0 + j)) = _
    rw [zero_add, signValue_rudinShapiroWord, Int.toNat_natCast,
      ← rudinShapiro_pow_mul_two k (j / 2 ^ k)]
    congr 1
    simpa only [hj, zero_add] using (Nat.mod_add_div j (2 ^ k)).symm
  · simp only [hj, ite_false]

private theorem signedZeroCutoff_on_sample (k j : ℕ) :
    rudinShapiroSignedZeroCutoff k (signWordShift j rudinShapiroWord) =
      if j % (2 ^ k) = 0 then (-1 : ℝ) ^ (j / 2 ^ k) * rudinShapiro (j / 2 ^ k)
      else 0 := by
  unfold rudinShapiroSignedZeroCutoff
  rw [if_congr (rudinShapiroZeroPhase_on_sample (k + 1) j) rfl rfl, zeroCutoff_on_sample]
  by_cases h : j % (2 ^ k) = 0
  · simp only [h, ite_true]
    rw [neg_one_pow_mod_two (j / 2 ^ k)]
    have he : j = 2 ^ k * (j / 2 ^ k) := by
      simpa only [h, zero_add] using (Nat.mod_add_div j (2 ^ k)).symm
    have hm : j % (2 ^ (k + 1)) = 0 ↔ (j / 2 ^ k) % 2 = 0 := by
      conv_lhs => rw [he, pow_succ, Nat.mul_mod_mul_left,
        Nat.mul_eq_zero, or_iff_right (by positivity : (2 : ℕ) ^ k ≠ 0)]
    rw [if_congr hm rfl rfl]
    rcases Nat.mod_two_eq_zero_or_one (j / 2 ^ k) with hq | hq <;> simp [hq]
  · simp [h]

private theorem shiftedSample_eq (j t : ℕ) :
    signWordShift t (signWordShift j rudinShapiroWord) =
      signWordShift (j + t : ℕ) rudinShapiroWord := by
  rw [Nat.cast_add, add_comm, signWordShift_add]
  rfl

private theorem signedCutoff_recursion_sample (k j : ℕ) :
    let w := signWordShift j rudinShapiroWord
    2 * rudinShapiroSignedZeroCutoff (k + 1) w =
      rudinShapiroZeroCutoff k (signWordShift ((2 : ℕ) ^ k : ℕ) w) -
      rudinShapiroSignedZeroCutoff k (signWordShift ((2 : ℕ) ^ k : ℕ) w) := by
  dsimp only
  rw [shiftedSample_eq, zeroCutoff_on_sample, signedZeroCutoff_on_sample, signedZeroCutoff_on_sample]
  let B := (2 : ℕ) ^ k
  let q := j / B
  have hp : 0 < B := by dsimp [B]; positivity
  have hm : (j + B) % B = j % B := Nat.add_mod_right j B
  have hdiv : (j + B) / B = q + 1 := by
    simpa only [mul_one] using (Nat.add_mul_div_left j 1 hp)
  rw [hm, hdiv]
  by_cases h : j % B = 0
  · have he : j = B * q := by simpa only [h, zero_add] using (Nat.mod_add_div j B).symm
    have hMod : j % (2 ^ (k + 1)) = 0 ↔ q % 2 = 0 := by
      conv_lhs => rw [he, pow_succ, Nat.mul_mod_mul_left, Nat.mul_eq_zero, or_iff_right hp.ne']
    simp only [h, ite_true, hMod]
    by_cases hq : q % 2 = 0
    · have hJ : j / 2 ^ (k + 1) = q / 2 := by
        rw [he, pow_succ, Nat.mul_div_mul_left _ _ hp]
      rw [ite_eq_left hq, hJ, show q + 1 = 2 * (q / 2) + 1 by omega,
        rudinShapiro_odd, pow_succ, pow_mul]
      norm_num
      ring
    · have hEven : (q + 1) % 2 = 0 := by omega
      rw [ite_eq_right hq, neg_one_pow_mod_two, hEven, pow_zero, one_mul, sub_self, mul_zero]
  · have hbad : j % (2 ^ (k + 1)) ≠ 0 := by
      intro hz
      apply h
      rw [← Nat.mod_mod_of_dvd j (show B ∣ 2 ^ (k + 1) by rw [pow_succ]; exact dvd_mul_right _ _),
        hz, Nat.zero_mod]
    simp [h, hbad]

theorem rudinShapiroZeroCutoff_succ (k : ℕ) (w : SignWords) :
    2 * rudinShapiroZeroCutoff (k + 1) w =
      rudinShapiroZeroCutoff k w + rudinShapiroSignedZeroCutoff k w := by
  by_cases h : rudinShapiroZeroPhase (k + 1) w
  · have h' : rudinShapiroZeroPhase k w := by
      cases k with
      | zero => trivial
      | succ k => exact h.1
    simp [rudinShapiroZeroCutoff, rudinShapiroSignedZeroCutoff, h, h', two_mul]
  · simp [rudinShapiroZeroCutoff, rudinShapiroSignedZeroCutoff, h]

/-- The paired cutoffs at the next scale come from addition and a shifted
difference of the previous pair. -/
theorem rudinShapiroSignedZeroCutoff_succ {w : SignWords}
    (hw : w ∈ rudinShapiroSubshift) (k : ℕ) :
    2 * rudinShapiroSignedZeroCutoff (k + 1) w =
      rudinShapiroZeroCutoff k (signWordShift ((2 : ℕ) ^ k : ℕ) w) -
      rudinShapiroSignedZeroCutoff k (signWordShift ((2 : ℕ) ^ k : ℕ) w) := by
  let t := ((2 : ℕ) ^ k : ℕ)
  let W (j : ℕ) := insert (0 : ℤ) (rudinShapiroZeroPhaseWindow j)
  let I := W (k + 1) ∪ W (k + 2)
  let J := (W k ∪ W (k + 1)).image fun i ↦ i + (t : ℤ)
  refine rudinShapiro_local_property (P := fun w ↦
    2 * rudinShapiroSignedZeroCutoff (k + 1) w =
      rudinShapiroZeroCutoff k (signWordShift t w) -
      rudinShapiroSignedZeroCutoff k (signWordShift t w)) (I ∪ J) ?_ 0 ?_ hw
  · intro u v h hEq
    have hLocal (j : ℕ) (x y : SignWords) (he : ∀ i ∈ W j, x i = y i) :
        rudinShapiroZeroCutoff j x = rudinShapiroZeroCutoff j y :=
      if_congr (rudinShapiroZeroPhase_iff_of_agree j x y
        (fun _ hi ↦ he _ (Finset.mem_insert_of_mem hi)))
        (congrArg signValue (he 0 (Finset.mem_insert_self _ _))) rfl
    have h₀ : rudinShapiroZeroCutoff (k + 1) u = rudinShapiroZeroCutoff (k + 1) v :=
      hLocal _ _ _ (fun _ hi ↦ h _ (Finset.mem_union_left _ (Finset.mem_union_left _ hi)))
    have h₁ : rudinShapiroZeroPhase (k + 2) u ↔ rudinShapiroZeroPhase (k + 2) v :=
      rudinShapiroZeroPhase_iff_of_agree _ _ _ (fun _ hi ↦ h _ (Finset.mem_union_left _
        (Finset.mem_union_right _ (Finset.mem_insert_of_mem hi))))
    have h₂ : rudinShapiroZeroCutoff k (signWordShift t u) =
        rudinShapiroZeroCutoff k (signWordShift t v) :=
      hLocal _ _ _ (fun i hi ↦ h _ (Finset.mem_union_right _ (Finset.mem_image.mpr
        ⟨i, Finset.mem_union_left _ hi, rfl⟩)))
    have h₃ : rudinShapiroZeroPhase (k + 1) (signWordShift t u) ↔
        rudinShapiroZeroPhase (k + 1) (signWordShift t v) :=
      rudinShapiroZeroPhase_iff_of_agree _ _ _ (fun i hi ↦ h _ (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨i, Finset.mem_union_right _ (Finset.mem_insert_of_mem hi), rfl⟩)))
    unfold rudinShapiroSignedZeroCutoff at hEq ⊢
    rwa [if_congr h₁ h₀ (congrArg Neg.neg h₀), h₂,
      if_congr h₃ rfl rfl] at hEq
  · intro j _
    exact signedCutoff_recursion_sample k j

/-- The centre sign restricted to an arbitrary dyadic class. -/
def rudinShapiroResidueCutoff (k a : ℕ) (w : SignWords) : ℝ :=
  if rudinShapiroResidue k a w then signValue (w 0) else 0

private theorem residueCutoff_sample (k a j : ℕ) (ha : a < 2 ^ (k + 1)) (hj : a ≤ j) :
    rudinShapiroResidueCutoff (k + 1) a (signWordShift j rudinShapiroWord) =
      rudinShapiro a * (if a / 2 ^ k = 0 then
        rudinShapiroZeroCutoff (k + 1) (signWordShift (-(a : ℤ)) (signWordShift j rudinShapiroWord))
      else rudinShapiroSignedZeroCutoff (k + 1)
        (signWordShift (-(a : ℤ)) (signWordShift j rudinShapiroWord))) := by
  let B := (2 : ℕ) ^ (k + 1)
  have hB : 0 < B := by dsimp [B]; positivity
  have hShift : signWordShift (-(a : ℤ)) (signWordShift j rudinShapiroWord) =
      signWordShift ((j - a : ℕ) : ℤ) rudinShapiroWord := by
    change (signWordShift (-(a : ℤ)) ∘ signWordShift j) rudinShapiroWord = _
    rw [← signWordShift_add, Nat.cast_sub hj]
    ring_nf
  unfold rudinShapiroResidueCutoff
  rw [if_congr (rudinShapiroResidue_on_sample (k + 1) a j ha) rfl rfl,
    hShift, zeroCutoff_on_sample, signedZeroCutoff_on_sample]
  have hm : (j - a) % B = 0 ↔ j % B = a := by
    constructor
    · intro h
      rw [← Nat.sub_add_cancel hj, Nat.add_mod, h, zero_add, Nat.mod_mod, Nat.mod_eq_of_lt ha]
    · intro hh
      have he : j = B * (j / B) + a := by
        simpa only [hh, add_comm] using (Nat.mod_add_div j B).symm
      have hDiff : j - a = B * (j / B) := by omega
      rw [hDiff, Nat.mul_mod_right]
  dsimp only [B] at hm
  simp only [hm]
  by_cases h : j % B = a
  · have he : j = B * (j / B) + a := by
      simpa only [h, add_comm] using (Nat.mod_add_div j B).symm
    have hdiv : (j - a) / B = j / B := by
      rw [show j - a = B * (j / B) by omega, Nat.mul_div_cancel_left _ hB]
    have hTop : a / 2 ^ k < 2 := by
      apply (Nat.div_lt_iff_lt_mul (by positivity)).2
      rwa [mul_comm, ← pow_succ]
    dsimp only [B] at h hdiv
    simp only [h, ite_true, hdiv]
    change signValue (rudinShapiroWord (0 + j)) = _
    rw [zero_add, signValue_rudinShapiroWord, Int.toNat_natCast]
    conv_lhs => rw [he, rudinShapiro_binary_block k (j / B) a ha]
    change rudinShapiro (j / B) * rudinShapiro a * (-1 : ℝ) ^ ((j / B % 2) * (a / 2 ^ k)) =
      rudinShapiro a * (if a / 2 ^ k = 0 then rudinShapiro (j / B)
        else (-1 : ℝ) ^ (j / B) * rudinShapiro (j / B))
    obtain h₀ | h₁ := Nat.le_one_iff_eq_zero_or_eq_one.mp (Nat.le_of_lt_succ hTop)
    · simp [h₀, mul_comm]
    · simp only [h₁, one_ne_zero, ite_false, mul_one]
      rw [neg_one_pow_mod_two (j / B)]
      ring
  · dsimp only [B] at h
    simp [h]

/-- Each sign times a residue indicator is a scalar multiple of a translate
of one of the paired zero-class cutoffs. -/
theorem rudinShapiroResidueCutoff_eq_translate {w : SignWords} (hw : w ∈ rudinShapiroSubshift)
    (k a : ℕ) (ha : a < 2 ^ (k + 1)) :
    rudinShapiroResidueCutoff (k + 1) a w =
      rudinShapiro a * (if a / 2 ^ k = 0 then rudinShapiroZeroCutoff (k + 1) (signWordShift (-(a : ℤ)) w)
        else rudinShapiroSignedZeroCutoff (k + 1) (signWordShift (-(a : ℤ)) w)) := by
  let t := -(a : ℤ)
  let I := insert (0 : ℤ) (rudinShapiroResidueWindow (k + 1) a)
  let J := (insert (0 : ℤ) (rudinShapiroZeroPhaseWindow (k + 1) ∪
    rudinShapiroZeroPhaseWindow (k + 2))).image fun i ↦ i + t
  refine rudinShapiro_local_property (P := fun w ↦ rudinShapiroResidueCutoff (k + 1) a w =
    rudinShapiro a * (if a / 2 ^ k = 0 then rudinShapiroZeroCutoff (k + 1) (signWordShift t w)
      else rudinShapiroSignedZeroCutoff (k + 1) (signWordShift t w))) (I ∪ J) ?_ a ?_ hw
  · intro u v h he
    have hI : rudinShapiroResidueCutoff (k + 1) a u = rudinShapiroResidueCutoff (k + 1) a v :=
      if_congr (rudinShapiroResidue_iff_of_agree _ _ _ _ fun _ hi ↦
        h _ (Finset.mem_union_left _ (Finset.mem_insert_of_mem hi)))
        (congrArg signValue (h 0 (Finset.mem_union_left _ (Finset.mem_insert_self _ _)))) rfl
    have hJ (i : ℤ) (hi : i ∈ insert (0 : ℤ) (rudinShapiroZeroPhaseWindow (k + 1) ∪
        rudinShapiroZeroPhaseWindow (k + 2))) : signWordShift t u i = signWordShift t v i :=
      h _ (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨i, hi, rfl⟩))
    have h₁ : rudinShapiroZeroCutoff (k + 1) (signWordShift t u) =
        rudinShapiroZeroCutoff (k + 1) (signWordShift t v) :=
      if_congr (rudinShapiroZeroPhase_iff_of_agree _ _ _ fun _ hi ↦
        hJ _ (Finset.mem_insert_of_mem (Finset.mem_union_left _ hi)))
        (congrArg signValue (hJ _ (Finset.mem_insert_self _ _))) rfl
    have h₂ : rudinShapiroSignedZeroCutoff (k + 1) (signWordShift t u) =
        rudinShapiroSignedZeroCutoff (k + 1) (signWordShift t v) :=
      if_congr (rudinShapiroZeroPhase_iff_of_agree _ _ _ fun _ hi ↦
        hJ _ (Finset.mem_insert_of_mem (Finset.mem_union_right _ hi))) h₁ (congrArg Neg.neg h₁)
    rwa [hI, h₁, h₂] at he
  · intro j hj
    exact residueCutoff_sample k a j ha hj

end Mixing
end

/- Source module Mixing.RudinShapiroSpectralPair. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section

namespace Mixing

open Filter MeasureTheory
open scoped ComplexConjugate InnerProductSpace Topology

private theorem phase_ae_shift (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop) (k : ℤ) :
    ∀ᵐ w ∂(rudinShapiroOrbitLaw p : Measure SignWords),
      rudinShapiroParity (signWordShift k w) = (-1 : ℝ) ^ k * rudinShapiroParity w :=
  (ae_mem_rudinShapiroSubshift p hp).mono fun _ hw ↦ rudinShapiroParity_shift_of_mem hw k

theorem integral_rudinShapiro_signedPair_int (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)
    (k : ℤ) : (∫ w, rudinShapiroParity w * (signValue (w 0) * signValue (w k))
      ∂(rudinShapiroOrbitLaw p : Measure SignWords)) = 0 := by
  have hPos (k : ℤ) (hk : 0 ≤ k) : (∫ w, rudinShapiroParity w *
      (signValue (w 0) * signValue (w k)) ∂(rudinShapiroOrbitLaw p : Measure SignWords)) = 0 := by
    obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hk
    exact integral_rudinShapiro_signedPair p hp n
  by_cases hk : 0 ≤ k
  · exact hPos k hk
  let ν := (rudinShapiroOrbitLaw p : Measure SignWords)
  let f (w : SignWords) := rudinShapiroParity w * (signValue (w 0) * signValue (w (-k)))
  have hf : Continuous f := by
    have h : Continuous signValue := continuous_of_discreteTopology
    exact rudinShapiroParity.continuous.mul ((h.comp (continuous_apply 0)).mul
      (h.comp (continuous_apply (-k))))
  have hm := rudinShapiroOrbitLaw_preserving p hp k
  have hInv : (∫ w, f (signWordShift k w) ∂ν) = 0 := by
    calc
      _ = ∫ w, f w ∂ν.map (signWordShift k) :=
        (integral_map hm.measurable.aemeasurable hf.aestronglyMeasurable).symm
      _ = 0 := by
        rw [hm.map_eq]
        exact hPos (-k) (neg_nonneg.mpr (le_of_not_ge hk))
  have he : (∫ w, f (signWordShift k w) ∂ν) =
      ∫ w, (-1 : ℝ) ^ k * (rudinShapiroParity w * (signValue (w 0) * signValue (w k))) ∂ν := by
    apply integral_congr_ae
    filter_upwards [phase_ae_shift p hp k] with w hw
    unfold f
    rw [hw]
    simp only [signWordShift, zero_add, neg_add_cancel]
    ring
  rw [he, integral_const_mul] at hInv
  exact (mul_eq_zero.mp hInv).resolve_left (zpow_ne_zero _ (by norm_num))

def rudinShapiroCompanionContinuous : C(SignWords, ℂ) where
  toFun w := ((rudinShapiroParity w * signValue (w 0) : ℝ) : ℂ)
  continuous_toFun := Complex.continuous_ofReal.comp (rudinShapiroParity.continuous.mul
    ((continuous_of_discreteTopology : Continuous signValue).comp (continuous_apply 0)))

/-- The two Rudin–Shapiro vectors. The companion is the coordinate sign
multiplied by the intrinsic parity eigenfunction. -/
def rudinShapiroPairLp (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop) (b : Bool) :
    Lp ℂ 2 (rudinShapiroOrbitSystem p hp).measure :=
  if b then ContinuousMap.toLp 2 (rudinShapiroOrbitSystem p hp).measure ℂ
    rudinShapiroCompanionContinuous else rudinShapiroSignLp p hp

theorem coe_rudinShapiroPairLp (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop) (b : Bool) :
    rudinShapiroPairLp p hp b =ᵐ[(rudinShapiroOrbitSystem p hp).measure] fun w ↦
      ((if b then rudinShapiroParity w * signValue (w 0) else signValue (w 0) : ℝ) : ℂ) := by
  cases b
  · exact ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) _ rudinShapiroSignContinuous
  · exact ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) _ rudinShapiroCompanionContinuous

/-- All mixed correlations of the two vectors vanish. Each has Haar
autocorrelations, so they supply two orthogonal cyclic Lebesgue subspaces. -/
theorem rudinShapiroPairLp_correlation (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)
    (a b : Bool) (k : ℤ) :
    ⟪rudinShapiroPairLp p hp a,
      (rudinShapiroOrbitSystem p hp).koopmanRep (Multiplicative.ofAdd k) (rudinShapiroPairLp p hp b)⟫_ℂ =
        if a = b ∧ k = 0 then 1 else 0 := by
  let S := rudinShapiroOrbitSystem p hp
  let g := Multiplicative.ofAdd k
  let f (b : Bool) (w : SignWords) :=
    if b then rudinShapiroParity w * signValue (w 0) else signValue (w 0)
  have h := Lp.coeFn_compMeasurePreserving (rudinShapiroPairLp p hp b) (S.preserves g)
  have h' := (S.preserves g).quasiMeasurePreserving.ae_eq_comp (coe_rudinShapiroPairLp p hp b)
  have he : (∫ w, inner ℂ (rudinShapiroPairLp p hp a w)
      ((S.koopmanRep g (rudinShapiroPairLp p hp b)) w) ∂S.measure) =
      (↑(∫ w, f a w * f b (signWordShift k w) ∂S.measure) : ℂ) := by
    rw [← integral_complex_ofReal]
    apply integral_congr_ae
    filter_upwards [coe_rudinShapiroPairLp p hp a, h.trans h'] with w ha hb
    change rudinShapiroPairLp p hp a w = (f a w : ℂ) at ha
    change (S.koopmanRep g (rudinShapiroPairLp p hp b)) w =
      (f b (signWordShift k w) : ℂ) at hb
    rw [ha, hb, RCLike.inner_apply']
    simp
  rw [L2.inner_def, he]
  have hU := integral_rudinShapiro_pairSign_int p hp k
  have hS : (∫ w, rudinShapiroParity w * (signValue (w 0) * signValue (w k)) ∂S.measure) = 0 :=
    integral_rudinShapiro_signedPair_int p hp k
  cases a <;> cases b
  · have he' : (∫ w, f false w * f false (signWordShift k w) ∂S.measure) =
        ∫ w, signValue (w 0) * signValue (w k)
          ∂(rudinShapiroOrbitLaw p : Measure SignWords) := by
      simp only [f, Bool.false_eq_true, ite_false, signWordShift, zero_add]
      rfl
    rw [he', hU]
    by_cases hk : k = 0 <;> simp [hk]
  · have he' : (∫ w, f false w * f true (signWordShift k w) ∂S.measure) =
        ∫ w, (-1 : ℝ) ^ k * (rudinShapiroParity w * (signValue (w 0) * signValue (w k)))
          ∂S.measure := by
      apply integral_congr_ae
      filter_upwards [phase_ae_shift p hp k] with w hw
      simp only [f, Bool.false_eq_true, ite_false, ite_true, hw]
      simp only [signWordShift, zero_add]
      ring
    rw [he', integral_const_mul, hS]
    simp
  · have he' (w : SignWords) : f true w * f false (signWordShift k w) =
        rudinShapiroParity w * (signValue (w 0) * signValue (w k)) := by
      simp only [f, ite_true, ite_false, Bool.false_eq_true, signWordShift, zero_add]
      ring
    simp_rw [he']
    rw [hS]
    simp
  · have he' : (∫ w, f true w * f true (signWordShift k w) ∂S.measure) =
        ∫ w, (-1 : ℝ) ^ k * (signValue (w 0) * signValue (w k)) ∂S.measure := by
      apply integral_congr_ae
      filter_upwards [phase_ae_shift p hp k] with w hw
      simp only [f, ite_true, hw]
      simp only [signWordShift, zero_add]
      linear_combination ((-1 : ℝ) ^ k * (signValue (w 0) * signValue (w k))) * rudinShapiroParity_sq w
    rw [he', integral_const_mul]
    change (↑((-1 : ℝ) ^ k * (∫ w, signValue (w 0) * signValue (w k)
      ∂(rudinShapiroOrbitLaw p : Measure SignWords))) : ℂ) = _
    rw [hU]
    by_cases hk : k = 0 <;> simp [hk]

theorem rudinShapiroPairLp_spectrum_haar (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)
    (b : Bool) :
    integerVectorSpectralMeasure (rudinShapiroOrbitSystem p hp).koopmanRep
      (rudinShapiroPairLp p hp b) = (AddCircle.haarAddCircle : Measure UnitAddCircle) := by
  apply circleMeasure_eq_of_fourier_eq
  intro n
  rw [integral_fourier_integerVectorSpectralMeasure, rudinShapiroPairLp_correlation p hp b b n]
  by_cases hn : n = 0
  · subst n
    simp
  · rw [integral_haar_fourier_zero n hn]
    simp [hn]

end Mixing
end

/- Source module Mixing.RudinShapiroCyclicSpan. -/
section
/-
Copyright (c) 2026 Sohail Farhangi. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: Sohail Farhangi
-/


noncomputable section

namespace Mixing

open Filter MeasureTheory Set
open scoped Classical InnerProductSpace

private theorem abs_signValue (b : Bool) : |signValue b| = 1 := by
  cases b <;> simp [signValue]

theorem measurable_rudinShapiro_centreSign : Measurable (fun w : SignWords ↦ signValue (w 0)) :=
  ((continuous_of_discreteTopology : Continuous signValue).comp (continuous_apply 0)).measurable

theorem measurable_rudinShapiroZeroCutoff (k : ℕ) : Measurable (rudinShapiroZeroCutoff k) :=
  measurable_rudinShapiro_centreSign.ite (measurableSet_rudinShapiroZeroPhase k) measurable_const

theorem measurable_rudinShapiroSignedZeroCutoff (k : ℕ) :
    Measurable (rudinShapiroSignedZeroCutoff k) :=
  (measurable_rudinShapiroZeroCutoff k).ite (measurableSet_rudinShapiroZeroPhase (k + 1))
    (measurable_rudinShapiroZeroCutoff k).neg

/-- The two zero-class cutoffs as bounded complex observables. -/
def rudinShapiroZeroCutoffObservable (k : ℕ) (b : Bool) : BoundedObservable SignWords where
  toFun w := ((if b then rudinShapiroSignedZeroCutoff k w else rudinShapiroZeroCutoff k w : ℝ) : ℂ)
  measurable := Complex.continuous_ofReal.measurable.comp (by
    cases b
    · exact measurable_rudinShapiroZeroCutoff k
    · exact measurable_rudinShapiroSignedZeroCutoff k)
  bound := 1
  bound_nonneg := zero_le_one
  norm_le w := by
    cases b <;> by_cases hk : rudinShapiroZeroPhase k w <;>
      by_cases hk' : rudinShapiroZeroPhase (k + 1) w <;>
        simp [rudinShapiroZeroCutoff, rudinShapiroSignedZeroCutoff, hk, hk', abs_signValue]

/-- The sign-residue product as a bounded complex observable. -/
def rudinShapiroResidueCutoffObservable (k a : ℕ) : BoundedObservable SignWords where
  toFun w := (rudinShapiroResidueCutoff k a w : ℂ)
  measurable := Complex.continuous_ofReal.measurable.comp
    (measurable_rudinShapiro_centreSign.ite (measurableSet_rudinShapiroResidue k a) measurable_const)
  bound := 1
  bound_nonneg := zero_le_one
  norm_le w := by
    by_cases h : rudinShapiroResidue k a w <;>
      simp [rudinShapiroResidueCutoff, h, abs_signValue]

variable (p : Ultrafilter ℕ) (hp : (p : Filter ℕ) ≤ atTop)

/-- The algebraic span of the translates of the two Haar spectral vectors. -/
def rudinShapiroPairSpan :
    Submodule ℂ (Lp ℂ 2 (rudinShapiroOrbitSystem p hp).measure) :=
  Submodule.span ℂ (range fun (i : Bool × Multiplicative ℤ) ↦
    (rudinShapiroOrbitSystem p hp).koopmanRep i.2 (rudinShapiroPairLp p hp i.1))

theorem rudinShapiroPairSpan_invariant (g : Multiplicative ℤ)
    {v : Lp ℂ 2 (rudinShapiroOrbitSystem p hp).measure}
    (hv : v ∈ rudinShapiroPairSpan p hp) :
    (rudinShapiroOrbitSystem p hp).koopmanRep g v ∈ rudinShapiroPairSpan p hp := by
  let U := (rudinShapiroOrbitSystem p hp).koopmanRep
  have hIncl : rudinShapiroPairSpan p hp ≤
      (rudinShapiroPairSpan p hp).comap (U g).toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨b, n⟩, rfl⟩
    change (U g * U n) (rudinShapiroPairLp p hp b) ∈ rudinShapiroPairSpan p hp
    rw [← map_mul]
    exact Submodule.subset_span ⟨(b, g * n), rfl⟩
  exact hIncl hv

private theorem ae_koopman_rudinShapiro_obs (v : BoundedObservable SignWords) (n : ℤ) :
    ((rudinShapiroOrbitSystem p hp).koopmanRep (Multiplicative.ofAdd n)
      (v.l2 (rudinShapiroOrbitSystem p hp).measure)) =ᵐ[(rudinShapiroOrbitSystem p hp).measure]
        fun w ↦ v (signWordShift n w) := by
  let S := rudinShapiroOrbitSystem p hp
  let μ := S.measure
  let g := Multiplicative.ofAdd n
  exact (Lp.coeFn_compMeasurePreserving (v.l2 μ) (S.preserves g)).trans
    ((S.preserves g).quasiMeasurePreserving.ae_eq_comp (v.coe_l2 μ))

private theorem zeroCutoffObservable_l2_zero (b : Bool) :
    (rudinShapiroZeroCutoffObservable 0 b).l2 (rudinShapiroOrbitSystem p hp).measure =
      rudinShapiroPairLp p hp b := by
  apply Lp.ext
  filter_upwards [(rudinShapiroZeroCutoffObservable 0 b).coe_l2 (rudinShapiroOrbitSystem p hp).measure,
    coe_rudinShapiroPairLp p hp b] with w h₁ h₂
  rw [h₁, h₂]
  have hParity (w : SignWords) : rudinShapiroParity w = 1 ∨ rudinShapiroParity w = -1 := by
    have he := rudinShapiroParity_sq w
    exact sq_eq_one_iff.mp he
  cases b
  · simp [rudinShapiroZeroCutoffObservable, rudinShapiroZeroCutoff, rudinShapiroZeroPhase]
  · rcases hParity w with h | h <;>
      norm_num [rudinShapiroZeroCutoffObservable, rudinShapiroZeroCutoff, rudinShapiroSignedZeroCutoff,
        rudinShapiroZeroPhase, h]

private theorem zeroCutoffObservable_l2_recursion (k : ℕ) :
    let S := rudinShapiroOrbitSystem p hp
    let f b := (rudinShapiroZeroCutoffObservable k b).l2 S.measure
    let g b := (rudinShapiroZeroCutoffObservable (k + 1) b).l2 S.measure
    let time := Multiplicative.ofAdd (((2 : ℕ) ^ k : ℕ) : ℤ)
    (2 : ℂ) • g false = f false + f true ∧
      (2 : ℂ) • g true = S.koopmanRep time (f false) - S.koopmanRep time (f true) := by
  let S := rudinShapiroOrbitSystem p hp
  let μ := S.measure
  let f (b : Bool) := (rudinShapiroZeroCutoffObservable k b).l2 μ
  let g (b : Bool) := (rudinShapiroZeroCutoffObservable (k + 1) b).l2 μ
  let n : ℤ := ((2 : ℕ) ^ k : ℕ)
  let U := S.koopmanRep (Multiplicative.ofAdd n)
  change (2 : ℂ) • g false = f false + f true ∧ (2 : ℂ) • g true = U (f false) - U (f true)
  constructor
  · apply Lp.ext
    filter_upwards [Lp.coeFn_smul (2 : ℂ) (g false), Lp.coeFn_add (f false) (f true),
      (rudinShapiroZeroCutoffObservable (k + 1) false).coe_l2 μ,
      (rudinShapiroZeroCutoffObservable k false).coe_l2 μ,
      (rudinShapiroZeroCutoffObservable k true).coe_l2 μ] with w hG hF hg hf₁ hf₂
    change g false w = _ at hg
    change f false w = _ at hf₁
    change f true w = _ at hf₂
    rw [hG, hF, Pi.smul_apply, Pi.add_apply, hg, hf₁, hf₂, smul_eq_mul]
    change (2 : ℂ) * (rudinShapiroZeroCutoff (k + 1) w : ℂ) =
      (rudinShapiroZeroCutoff k w : ℂ) + (rudinShapiroSignedZeroCutoff k w : ℂ)
    exact_mod_cast rudinShapiroZeroCutoff_succ k w
  · apply Lp.ext
    filter_upwards [Lp.coeFn_smul (2 : ℂ) (g true), Lp.coeFn_sub (U (f false)) (U (f true)),
      (rudinShapiroZeroCutoffObservable (k + 1) true).coe_l2 μ,
      ae_koopman_rudinShapiro_obs p hp (rudinShapiroZeroCutoffObservable k false) n,
      ae_koopman_rudinShapiro_obs p hp (rudinShapiroZeroCutoffObservable k true) n,
      ae_mem_rudinShapiroSubshift p hp] with w hG hF hg hf₁ hf₂ hw
    change g true w = _ at hg
    change U (f false) w = _ at hf₁
    change U (f true) w = _ at hf₂
    rw [hG, hF, Pi.smul_apply, Pi.sub_apply, hg, hf₁, hf₂, smul_eq_mul]
    change (2 : ℂ) * (rudinShapiroSignedZeroCutoff (k + 1) w : ℂ) =
      (rudinShapiroZeroCutoff k (signWordShift n w) : ℂ) -
        (rudinShapiroSignedZeroCutoff k (signWordShift n w) : ℂ)
    exact_mod_cast rudinShapiroSignedZeroCutoff_succ hw k

theorem rudinShapiroZeroCutoffObservable_mem_span (k : ℕ) (b : Bool) :
    (rudinShapiroZeroCutoffObservable k b).l2 (rudinShapiroOrbitSystem p hp).measure ∈
      rudinShapiroPairSpan p hp := by
  induction k generalizing b with
  | zero =>
    rw [zeroCutoffObservable_l2_zero p hp b]
    exact Submodule.subset_span ⟨(b, 1), by simp⟩
  | succ k ih =>
    let S := rudinShapiroOrbitSystem p hp
    let Q := rudinShapiroPairSpan p hp
    have h := zeroCutoffObservable_l2_recursion p hp k
    suffices (2 : ℂ) • (rudinShapiroZeroCutoffObservable (k + 1) b).l2 S.measure ∈ Q by
      simpa [smul_smul] using Q.smul_mem (2 : ℂ)⁻¹ this
    cases b
    · rw [h.1]
      exact Q.add_mem (ih false) (ih true)
    · rw [h.2]
      exact Q.sub_mem (rudinShapiroPairSpan_invariant p hp _ (ih false))
        (rudinShapiroPairSpan_invariant p hp _ (ih true))

theorem rudinShapiroResidueCutoffObservable_mem_span (k a : ℕ) (ha : a < 2 ^ (k + 1)) :
    (rudinShapiroResidueCutoffObservable (k + 1) a).l2 (rudinShapiroOrbitSystem p hp).measure ∈
      rudinShapiroPairSpan p hp := by
  let b : Bool := decide (a / 2 ^ k ≠ 0)
  let f := rudinShapiroZeroCutoffObservable (k + 1) b
  let O := rudinShapiroResidueCutoffObservable (k + 1) a
  let S := rudinShapiroOrbitSystem p hp
  let U := S.koopmanRep (Multiplicative.ofAdd (-(a : ℤ)))
  have he : O.l2 S.measure = (rudinShapiro a : ℂ) • U (f.l2 S.measure) := by
    apply Lp.ext
    filter_upwards [O.coe_l2 S.measure, Lp.coeFn_smul (rudinShapiro a : ℂ) (U (f.l2 S.measure)),
      ae_koopman_rudinShapiro_obs p hp f (-(a : ℤ)), ae_mem_rudinShapiroSubshift p hp] with w hO hU hf hw
    change U (f.l2 S.measure) w = _ at hf
    rw [hO, hU, Pi.smul_apply, hf, smul_eq_mul]
    have hh := rudinShapiroResidueCutoff_eq_translate hw k a ha
    by_cases h : a / 2 ^ k = 0 <;> simpa [O, f, b, h, rudinShapiroResidueCutoffObservable,
      rudinShapiroZeroCutoffObservable] using congrArg Complex.ofReal hh
  rw [he]
  exact (rudinShapiroPairSpan p hp).smul_mem _ (rudinShapiroPairSpan_invariant p hp _
    (rudinShapiroZeroCutoffObservable_mem_span p hp (k + 1) b))

end Mixing
end

