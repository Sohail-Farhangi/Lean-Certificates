      simp
    _ = _ := by
      rw [integral_complex_ofReal]
      change (↑(∫ w, signValue (w 0) * signValue (w n) ∂(rudinShapiroOrbitLaw p : Measure SignWords)) : ℂ) = _
      rw [integral_rudinShapiro_pairSign_int p hp n]
