    (hQ : ∀ r, ∀ᶠ j in (p : Filter I), q r j < chaconTowerHeight (n r j) ∧
      t j = m r * chaconTowerHeight (n r j) + q r j)
    (hDecay : ∀ v : meanZero chaconTowerSystem.measure,
