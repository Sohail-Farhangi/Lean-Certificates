    calc
      _ ≤ (B.card : ℝ) * (D*C) + D*C := add_le_add hh hE
      _ ≤ (2*m+1 : ℝ) * (D*C) + D*C :=
        add_le_add (mul_le_mul_of_nonneg_right hcard (mul_nonneg hD₀ hC₀)) le_rfl
