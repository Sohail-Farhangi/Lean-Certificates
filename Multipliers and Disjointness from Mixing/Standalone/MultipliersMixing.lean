/-- Corollary 4. Every nonempty ultrafilter mixing family forces weak mixing. -/
theorem isWeaklyMixing_of_isUMixing (U : G →* (H ≃ₗᵢ[ℂ] H)) {P : Set (Ultrafilter G)}
