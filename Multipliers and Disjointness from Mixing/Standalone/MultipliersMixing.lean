/-! # Ultrafilter eigenvectors in the Cantor skew rotation -/


open MeasureTheory Filter
open scoped ComplexConjugate InnerProductSpace Topology

namespace Mixing

local notation "𝕋" => UnitAddCircle
local notation "𝕏" => (UnitAddCircle × UnitAddCircle)

private def torusAsProduct : UnitAddTorus (Fin 2) ≃ₜ 𝕏 := Homeomorph.finTwoArrow

private noncomputable def torusPrecomposition : C(UnitAddTorus (Fin 2), ℂ) →L[ℂ] C(𝕏, ℂ) := by
  let e : C(𝕏, UnitAddTorus (Fin 2)) := ⟨torusAsProduct.symm, torusAsProduct.symm.continuous⟩
  exact ⟨(ContinuousMap.compRightAlgHom ℂ ℂ e).toLinearMap,
    ContinuousMap.compRightAlgHom_continuous ℂ ℂ e⟩

private theorem torusPrecomposition_surjective : Function.Surjective torusPrecomposition := by
  intro f
  refine ⟨f.comp ⟨torusAsProduct, torusAsProduct.continuous⟩, ?_⟩
  ext x
  change f (torusAsProduct (torusAsProduct.symm x)) = f x
  rw [torusAsProduct.apply_symm_apply]

/-- The two-frequency continuous character on the base and fibre circle. -/
noncomputable def circlePairFourier (n : Fin 2 → ℤ) : C(𝕏, ℂ) where
  toFun := example5CantorCharacter (n 0) (n 1)
  continuous_toFun := by unfold example5CantorCharacter; fun_prop

theorem circlePairFourier_apply (n : Fin 2 → ℤ) (x : 𝕏) :
    circlePairFourier n x = example5CantorCharacter (n 0) (n 1) x := rfl

private theorem torusPrecomposition_mFourier (n : Fin 2 → ℤ) :
    torusPrecomposition (UnitAddTorus.mFourier n) = circlePairFourier n := by
  ext x
  change (∏ i : Fin 2, fourier (n i) (torusAsProduct.symm x i)) =
    example5CantorCharacter (n 0) (n 1) x
  rw [Fin.prod_univ_two]
  rfl

private theorem circlePairFourier_closure_span :
    (Submodule.span ℂ (Set.range circlePairFourier)).topologicalClosure = ⊤ := by
  have hdense := torusPrecomposition_surjective.denseRange.topologicalClosure_map_submodule
    (UnitAddTorus.span_mFourier_closure_eq_top (d := Fin 2))
  have hRange : (⇑torusPrecomposition.toLinearMap) ''
      Set.range (UnitAddTorus.mFourier (d := Fin 2)) = Set.range circlePairFourier := by
    ext f
    constructor
    · rintro ⟨_, ⟨n, rfl⟩, rfl⟩
      exact ⟨n, (torusPrecomposition_mFourier n).symm⟩
    · rintro ⟨n, rfl⟩
      exact ⟨_, ⟨n, rfl⟩, torusPrecomposition_mFourier n⟩
  rwa [Submodule.map_span, hRange] at hdense

/-- The two-frequency character viewed as a vector in the complex L² space. -/
noncomputable def circlePairFourierLp (μ : Measure 𝕏) [IsFiniteMeasure μ]
    (n : Fin 2 → ℤ) : Lp ℂ 2 μ :=
  ContinuousMap.toLp (E := ℂ) 2 μ ℂ (circlePairFourier n)

theorem circlePairFourierLp_ae_eq (μ : Measure 𝕏) [IsFiniteMeasure μ]
    (n : Fin 2 → ℤ) : circlePairFourierLp μ n =ᵐ[μ] example5CantorCharacter (n 0) (n 1) := by
  filter_upwards [ContinuousMap.coeFn_toLp (𝕜 := ℂ) (p := 2) μ (circlePairFourier n)] with x hx
  exact hx.trans (circlePairFourier_apply n x)

theorem circlePairFourierLp_closure_span (μ : Measure 𝕏) [IsFiniteMeasure μ] [μ.WeaklyRegular] :
    (Submodule.span ℂ (Set.range (circlePairFourierLp μ))).topologicalClosure = ⊤ := by
  have hLp : DenseRange (ContinuousMap.toLp (E := ℂ) 2 μ ℂ) :=
    ContinuousMap.toLp_denseRange ℂ μ ℂ (by norm_num : (2 : ENNReal) ≠ ⊤)
  have hdense := hLp.topologicalClosure_map_submodule circlePairFourier_closure_span
  rw [Submodule.map_span, ← Set.range_comp'] at hdense
  exact hdense

/-- The Cantor skew rotation in Example 5. -/
noncomputable def example5CantorSystem : System (Multiplicative ℤ) 𝕏 :=
  circleSkew cantorCircleMeasure 1

theorem cantorSkew_inner_character (m n : Fin 2 → ℤ) (g : Multiplicative ℤ) :
    ⟪circlePairFourierLp example5CantorSystem.measure m, example5CantorSystem.koopmanRep g (circlePairFourierLp example5CantorSystem.measure n)⟫_ℂ =
      ∫ x, example5CantorCharacter (-(m 0)) (-(m 1)) x *
        example5CantorCharacter (n 0) (n 1) (example5CantorSystem.act g x) ∂example5CantorSystem.measure := by
  rw [MeasureTheory.L2.inner_def]
  have hn : example5CantorSystem.koopmanRep g (circlePairFourierLp example5CantorSystem.measure n) =ᵐ[example5CantorSystem.measure]
      fun x ↦ example5CantorCharacter (n 0) (n 1) (example5CantorSystem.act g x) :=
    (Lp.coeFn_compMeasurePreserving _ (example5CantorSystem.preserves g)).trans
      ((example5CantorSystem.preserves g).quasiMeasurePreserving.ae_eq_comp (circlePairFourierLp_ae_eq example5CantorSystem.measure n))
  refine integral_congr_ae ?_
  filter_upwards [circlePairFourierLp_ae_eq example5CantorSystem.measure m, hn] with x hmx hnx
  rw [hmx, hnx, RCLike.inner_apply']
  simp only [example5CantorCharacter, map_mul, ← fourier_neg]

private theorem cantorSkew_ultrafilter_inner_character (m n : Fin 2 → ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    ⟪circlePairFourierLp example5CantorSystem.measure m,
      ultrafilterOperator example5CantorSystem.koopmanRep p (circlePairFourierLp example5CantorSystem.measure n)⟫_ℂ =
      ⟪circlePairFourierLp example5CantorSystem.measure m,
        cantorFourier ((-(n 1) : ℤ) : ℝ) • circlePairFourierLp example5CantorSystem.measure n⟫_ℂ := by
  have hlim := tendsto_ultrafilterOperator_coeff example5CantorSystem.koopmanRep p
    (circlePairFourierLp example5CantorSystem.measure m) (circlePairFourierLp example5CantorSystem.measure n)
  simp_rw [cantorSkew_inner_character] at hlim
  have hvalue := tendsto_nhds_unique hlim
    (example5_cantor_character_correlation_tendsto_ultrafilter (-(m 0)) (-(m 1)) (n 1) (n 0)
      p hp hsupp)
  have h₀ := (cantorSkew_inner_character m n (Multiplicative.ofAdd 0)).trans
    (example5_cantor_character_correlation (-(m 0)) (-(m 1)) (n 1) (n 0) 0)
  rw [show Multiplicative.ofAdd (0 : ℤ) = 1 from rfl, map_one] at h₀
  change ⟪circlePairFourierLp example5CantorSystem.measure m, circlePairFourierLp example5CantorSystem.measure n⟫_ℂ = _ at h₀
  rw [hvalue, inner_smul_right, h₀, mul_zero, zero_sub]
  ring

/-- The ultrafilter eigenvector equation in Example 5, on the actual Koopman L² space. -/
theorem example5_cantor_ultrafilter_eigenvector (n : Fin 2 → ℤ)
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    ultrafilterOperator example5CantorSystem.koopmanRep p (circlePairFourierLp example5CantorSystem.measure n) =
      cantorFourier ((-(n 1) : ℤ) : ℝ) • circlePairFourierLp example5CantorSystem.measure n := by
  let y := ultrafilterOperator example5CantorSystem.koopmanRep p (circlePairFourierLp example5CantorSystem.measure n) -
    cantorFourier ((-(n 1) : ℤ) : ℝ) • circlePairFourierLp example5CantorSystem.measure n
  have hspan : Submodule.span ℂ (Set.range (circlePairFourierLp example5CantorSystem.measure)) ≤
      (innerSL ℂ y).ker := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨m, rfl⟩
    change ⟪y, circlePairFourierLp example5CantorSystem.measure m⟫_ℂ = 0
    rw [inner_eq_zero_symm]
    dsimp only [y]
    rw [inner_sub_right,
      cantorSkew_ultrafilter_inner_character m n p hp hsupp, sub_self]
  have htop := Submodule.topologicalClosure_minimal _ hspan (innerSL ℂ y).isClosed_ker
  rw [circlePairFourierLp_closure_span] at htop
  have hy : ⟪y, y⟫_ℂ = 0 := htop Submodule.mem_top
  exact sub_eq_zero.mp ((inner_self_eq_zero (𝕜 := ℂ)).mp hy)


/-- A character has unit pointwise norm and gives a nonzero vector for every probability measure. -/
theorem circlePairFourierLp_ne_zero (μ : Measure 𝕏) [IsProbabilityMeasure μ] (n : Fin 2 → ℤ) :
    circlePairFourierLp μ n ≠ 0 := by
  intro hzero
  have hAE : circlePairFourierLp μ n =ᵐ[μ] (fun _ : 𝕏 ↦ (0 : ℂ)) := by
    rw [hzero]
    exact Lp.coeFn_zero ℂ 2 μ
  obtain ⟨x, hx, hxzero⟩ := ((circlePairFourierLp_ae_eq μ n).and hAE).exists
  have hnorm : ‖example5CantorCharacter (n 0) (n 1) x‖ = 1 := by
    simp only [example5CantorCharacter, norm_mul, fourier_apply, Circle.norm_coe, mul_one]
  rw [← hx, hxzero, norm_zero] at hnorm
  exact zero_ne_one hnorm

/-- The fibre character of frequency two is a nonzero p-mixing vector in Example 5. -/
theorem example5_cantor_annihilated_fibre_character
    (p : Ultrafilter (Multiplicative ℤ)) (hp : (p : Filter (Multiplicative ℤ)) ≤ cofinite)
    (hsupp : Set.range (fun j : ℕ ↦ Multiplicative.ofAdd ((4 : ℤ)^j)) ∈ p) :
    ∃ f : Lp ℂ 2 example5CantorSystem.measure, f ≠ 0 ∧
      ultrafilterOperator example5CantorSystem.koopmanRep p f = 0 := by
  let n : Fin 2 → ℤ := ![0, 2]
  refine ⟨circlePairFourierLp example5CantorSystem.measure n, circlePairFourierLp_ne_zero _ _, ?_⟩
  rw [example5_cantor_ultrafilter_eigenvector n p hp hsupp]
  have hz : cantorFourier ((-(n 1) : ℤ) : ℝ) = 0 := by
    have hn₂ : n 1 = 2 := rfl
    rw [hn₂]
    have h := cantorFourier_eq_zero_mod_four_two (-1)
    norm_num at h ⊢
    exact h
  rw [hz, zero_smul]

end Mixing
end

/- Source module Mixing.VanDerCorput. -/
section
/-! # The nested ultrafilter van der Corput lemma -/


open Filter Set
open scoped BigOperators Topology

namespace Mixing

/-- Ordered product of ultrafilters. The limit in the second variable is taken first. -/
def fubiniUltrafilter {A B : Type*} (p : Ultrafilter A) (q : Ultrafilter B) :
    Ultrafilter (A × B) :=
  p.bind (fun a => q.map (fun b => (a, b)))

theorem eventually_fubiniUltrafilter {A B : Type*} {p : Ultrafilter A}
    {q : Ultrafilter B} {P : A × B → Prop} :
    (∀ᶠ w in (fubiniUltrafilter p q : Filter (A × B)), P w) ↔
      ∀ᶠ a in (p : Filter A), ∀ᶠ b in (q : Filter B), P (a, b) :=
  Iff.rfl

theorem map_fubiniUltrafilter {A B C D : Type*} (p : Ultrafilter A)
    (q : Ultrafilter B) (f : A → C) (g : B → D) :
    (fubiniUltrafilter p q).map (Prod.map f g) = fubiniUltrafilter (p.map f) (q.map g) :=
  Ultrafilter.coe_injective rfl

@[simp]
theorem map_fubiniUltrafilter_fst {A B : Type*} (p : Ultrafilter A) (q : Ultrafilter B) :
    (fubiniUltrafilter p q).map Prod.fst = p := by
  apply Ultrafilter.coe_injective
  ext s
  change (∀ᶠ a in (p : Filter A), ∀ᶠ _ in (q : Filter B), a ∈ s) ↔ s ∈ (p : Filter A)
  change (∀ᶠ a in (p : Filter A), ∀ᶠ _ in (q : Filter B), a ∈ s) ↔
    ∀ᶠ a in (p : Filter A), a ∈ s
  exact eventually_congr (Filter.Eventually.of_forall fun _ => eventually_const)

@[simp]
theorem map_fubiniUltrafilter_snd {A B : Type*} (p : Ultrafilter A) (q : Ultrafilter B) :
    (fubiniUltrafilter p q).map Prod.snd = q := by
  apply Ultrafilter.coe_injective
  ext s
  change (∀ᶠ _ in (p : Filter A), ∀ᶠ b in (q : Filter B), b ∈ s) ↔ s ∈ (q : Filter B)
  exact eventually_const

/-- Iterated sampling with one ultrafilter for each coordinate. -/
def coordinateUltrafilter {S : Type*} :
    {n : ℕ} → (Fin n → Ultrafilter S) → Ultrafilter (Fin n → S)
  | 0, _ => pure Fin.elim0
  | n + 1, p =>
      (fubiniUltrafilter (p 0) (coordinateUltrafilter (fun i : Fin n => p i.succ))).map
        (fun v => Fin.cons v.1 v.2)

@[simp]
theorem map_coordinateUltrafilter {S : Type*} {n : ℕ} (p : Fin n → Ultrafilter S)
    (i : Fin n) : (coordinateUltrafilter p).map (fun a => a i) = p i := by
  induction n with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    rcases i with ⟨i, hi⟩
    cases i with
    | zero =>
      change (coordinateUltrafilter p).map (fun a => a 0) = p 0
      rw [coordinateUltrafilter, Ultrafilter.map_map]
      change (fubiniUltrafilter (p 0) (coordinateUltrafilter (fun i : Fin n => p i.succ))).map
        Prod.fst = p 0
      exact map_fubiniUltrafilter_fst _ _
    | succ i =>
      have hk : i < n := Nat.lt_of_succ_lt_succ hi
      change (coordinateUltrafilter p).map (fun a => a (Fin.succ ⟨i, hk⟩)) = _
      rw [coordinateUltrafilter, Ultrafilter.map_map]
      change (fubiniUltrafilter (p 0) (coordinateUltrafilter (fun i : Fin n => p i.succ))).map
        ((fun a => a ⟨i, hk⟩) ∘ Prod.snd) = p (Fin.succ ⟨i, hk⟩)
      rw [← Ultrafilter.map_map, map_fubiniUltrafilter_snd, ih]

theorem map_coordinateUltrafilter_pair {S : Type*} {n : ℕ} (p : Fin n → Ultrafilter S)
    {i j : Fin n} (h : i < j) :
    (coordinateUltrafilter p).map (fun a => (a i, a j)) = fubiniUltrafilter (p i) (p j) := by
  induction n with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    cases i using Fin.cases with
    | zero =>
      cases j using Fin.cases with
      | zero => exact (lt_irrefl _ h).elim
      | succ j =>
        rw [coordinateUltrafilter, Ultrafilter.map_map]
        change (fubiniUltrafilter (p 0) (coordinateUltrafilter (fun k : Fin n => p k.succ))).map
          (Prod.map id (fun a => a j)) = _
        rw [map_fubiniUltrafilter, Ultrafilter.map_id, map_coordinateUltrafilter]
    | succ i =>
      cases j using Fin.cases with
      | zero => exact (Nat.not_lt_zero _ h).elim
      | succ j =>
        rw [coordinateUltrafilter, Ultrafilter.map_map]
        change (fubiniUltrafilter (p 0) (coordinateUltrafilter (fun k : Fin n => p k.succ))).map
          ((fun a => (a i, a j)) ∘ Prod.snd) = _
        rw [← Ultrafilter.map_map, map_fubiniUltrafilter_snd,
          ih (fun k : Fin n => p k.succ) (Fin.succ_lt_succ_iff.mp h)]

/-- A scalar ultrafilter limit, used only for families bounded in norm. -/
noncomputable def scalarUltralimit {A K : Type*} [TopologicalSpace K] [Nonempty K]
    (p : Ultrafilter A) (f : A → K) : K :=
  limUnder (p : Filter A) f

theorem tendsto_scalarUltralimit {A K : Type*} [NormedAddCommGroup K] [ProperSpace K]
    (p : Ultrafilter A) {f : A → K} {M : ℝ} (hb : ∀ a, ‖f a‖ ≤ M) :
    Tendsto f (p : Filter A) (𝓝 (scalarUltralimit p f)) := by
  apply tendsto_nhds_limUnder
  obtain ⟨z, _, hz⟩ := (isCompact_closedBall (0 : K) M).ultrafilter_le_nhds' (p.map f)
    (Ultrafilter.mem_map.mpr (Filter.Eventually.of_forall fun a =>
      Metric.mem_closedBall.mpr (by simpa using hb a)))
  exact ⟨z, hz⟩

theorem norm_scalarUltralimit_le {A K : Type*} [NormedAddCommGroup K] [ProperSpace K]
    (p : Ultrafilter A) {f : A → K} {M : ℝ} (hb : ∀ a, ‖f a‖ ≤ M) :
    ‖scalarUltralimit p f‖ ≤ M :=
  le_of_tendsto' (tendsto_scalarUltralimit p hb).norm hb

theorem tendsto_fubiniUltrafilter {A B Z : Type*} [TopologicalSpace Z]
    {p : Ultrafilter A} {q : Ultrafilter B} {f : A × B → Z} {g : A → Z} {z : Z}
    (hf : ∀ a, Tendsto (fun b => f (a, b)) (q : Filter B) (𝓝 (g a)))
    (hg : Tendsto g (p : Filter A) (𝓝 z)) :
    Tendsto f (fubiniUltrafilter p q : Filter (A × B)) (𝓝 z) := by
  refine tendsto_def.mpr fun s hs => ?_
  change ∀ᶠ w in (fubiniUltrafilter p q : Filter (A × B)), f w ∈ s
  rw [eventually_fubiniUltrafilter]
  obtain ⟨t, hts, ht, hzt⟩ := mem_nhds_iff.mp hs
  filter_upwards [hg.eventually (ht.mem_nhds hzt)] with a hat
  exact (hf a).eventually (mem_of_superset (ht.mem_nhds hat) hts)

theorem scalarUltralimit_fubini {A B K : Type*} [NormedAddCommGroup K] [ProperSpace K]
    (p : Ultrafilter A) (q : Ultrafilter B) {f : A × B → K}
    {M : ℝ} (hb : ∀ v, ‖f v‖ ≤ M) :
    scalarUltralimit (fubiniUltrafilter p q) f =
      scalarUltralimit p (fun a => scalarUltralimit q (fun b => f (a, b))) :=
  tendsto_nhds_unique (tendsto_scalarUltralimit _ hb) <|
    tendsto_fubiniUltrafilter
      (fun a => tendsto_scalarUltralimit q (fun b => hb (a, b)))
      (tendsto_scalarUltralimit p (fun a => norm_scalarUltralimit_le q (fun b => hb (a, b))))

private theorem tendsto_along_ultrafilter_map {A B Z : Type*} [TopologicalSpace Z]
    {p : Ultrafilter A} {q : Ultrafilter B} {f : A → B} {g : B → Z} {L : Filter Z}
    (hm : p.map f = q) (hg : Tendsto g (q : Filter B) L) :
    Tendsto (g ∘ f) (p : Filter A) L := by
  have hf : Tendsto f (p : Filter A) (q : Filter B) := by
    change Filter.map f (p : Filter A) ≤ (q : Filter B)
    rw [← Ultrafilter.coe_map, hm]
  exact hg.comp hf

private theorem map_fubini_middle {A B C D : Type*}
    (q : Ultrafilter A) (p : Ultrafilter B) (w : Ultrafilter C) (g : B → D) :
    (fubiniUltrafilter q (fubiniUltrafilter p w)).map (Prod.map id (Prod.map g id)) =
      fubiniUltrafilter q (fubiniUltrafilter (p.map g) w) := by
  rw [map_fubiniUltrafilter, map_fubiniUltrafilter, Ultrafilter.map_id, Ultrafilter.map_id]

private theorem norm_sum_sq_decomposition {N : ℕ} {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] (v : Fin N → E) :
    ‖∑ i, v i‖ ^ 2 =
      (∑ i, ‖v i‖ ^ 2) + ∑ i, ∑ j ∈ Finset.univ.erase i, (inner ℂ (v i) (v j)).re := by
  classical
  conv_lhs => rw [← inner_self_eq_norm_sq (𝕜 := ℂ), sum_inner]
  change (∑ x, inner ℂ (v x) (∑ i, v i)).re = _
  simp only [inner_sum, Complex.re_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  have h := inner_self_eq_norm_sq (𝕜 := ℂ) (v i)
  change (inner ℂ (v i) (v i)).re = _ at h
  rw [← h, add_comm]
  exact (Finset.sum_erase_add _ _ (Finset.mem_univ i)).symm

/-- Lemma 10, with the coordinates before and after the selected one grouped into two blocks.
The ordered ultrafilter product takes limits from the innermost variable to the outermost.
Taking either block to be a one-point type covers the first or last coordinate. -/
theorem tendsto_inner_zero_of_fubini_correlations {A S B E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (q : Ultrafilter A) (p : Ultrafilter S) (w : Ultrafilter B)
    (x : A → S → B → E) (y : A → B → E)
    {X Y : ℝ} (hx : ∀ a s b, ‖x a s b‖ ≤ X) (hy : ∀ a b, ‖y a b‖ ≤ Y)
    (hc : Tendsto (fun v : A × ((S × S) × B) =>
        inner ℂ (x v.1 v.2.1.1 v.2.2) (x v.1 v.2.1.2 v.2.2))
      (fubiniUltrafilter q (fubiniUltrafilter (fubiniUltrafilter p p) w) : Filter _)
      (𝓝 0)) :
    Tendsto (fun v : A × (S × B) => inner ℂ (y v.1 v.2.2) (x v.1 v.2.1 v.2.2))
      (fubiniUltrafilter q (fubiniUltrafilter p w) : Filter _) (𝓝 0) := by
  classical
  let coeff (v : A × (S × B)) : ℂ := inner ℂ (y v.1 v.2.2) (x v.1 v.2.1 v.2.2)
  let P := fubiniUltrafilter q (fubiniUltrafilter p w)
  let L := scalarUltralimit P coeff
  have hprod (v : A × (S × B)) : ‖coeff v‖ ≤ Y * X :=
    (norm_inner_le_norm _ _).trans
      (mul_le_mul (hy v.1 v.2.2) (hx v.1 v.2.1 v.2.2) (norm_nonneg _)
        ((norm_nonneg _).trans (hy v.1 v.2.2)))
  have hL : Tendsto coeff (P : Filter _) (𝓝 L) := tendsto_scalarUltralimit P hprod
  suffices L = 0 by simpa only [← this] using hL
  have hbound (N : ℕ) (hN : 0 < N) : (N : ℝ) * ‖L‖ ^ 2 ≤ Y ^ 2 * X ^ 2 := by
    let reps := coordinateUltrafilter (fun _ : Fin N => p)
    let P' := fubiniUltrafilter q (fubiniUltrafilter reps w)
    let V (v : A × ((Fin N → S) × B)) (i : Fin N) := x v.1 (v.2.1 i) v.2.2
    let z (v : A × ((Fin N → S) × B)) := y v.1 v.2.2
    have hSingle (i : Fin N) : Tendsto (fun v => inner ℂ (z v) (V v i))
        (P' : Filter _) (𝓝 L) := by
      have hm : P'.map (Prod.map id (Prod.map (fun a => a i) id)) = P := by
        simp [P', P, reps, map_fubini_middle]
      exact tendsto_along_ultrafilter_map hm hL
    have hOrdered (i j : Fin N) (hij : i < j) :
        Tendsto (fun v => (inner ℂ (V v i) (V v j)).re) (P' : Filter _) (𝓝 0) := by
      have hm : P'.map (Prod.map id (Prod.map (fun a => (a i, a j)) id)) =
          fubiniUltrafilter q (fubiniUltrafilter (fubiniUltrafilter p p) w) := by
        dsimp only [P', reps]
        rw [map_fubini_middle, map_coordinateUltrafilter_pair _ hij]
      have h := (Complex.continuous_re.tendsto _).comp (tendsto_along_ultrafilter_map hm hc)
      simpa only [Function.comp_def, Prod.map_fst, Prod.map_snd, id_eq, V, Complex.zero_re] using h
    have hDouble (i j : Fin N) (hij : i ≠ j) :
        Tendsto (fun v => (inner ℂ (V v i) (V v j)).re) (P' : Filter _) (𝓝 0) := by
      rcases lt_or_gt_of_ne hij with h | h
      · exact hOrdered i j h
      · convert hOrdered j i h using 1
        funext v
        exact inner_re_symm (𝕜 := ℂ) _ _
    let off (v : A × ((Fin N → S) × B)) :=
      ∑ i, ∑ j ∈ Finset.univ.erase i, (inner ℂ (V v i) (V v j)).re
    have hOff : Tendsto off (P' : Filter _) (𝓝 0) := by
      have hRow (i : Fin N) :
          Tendsto (fun v => ∑ j ∈ Finset.univ.erase i, (inner ℂ (V v i) (V v j)).re)
            (P' : Filter _) (𝓝 0) := by
        simpa only [Finset.sum_const_zero] using
          tendsto_finsetSum (Finset.univ.erase i) (fun j hj =>
            hDouble i j (Finset.ne_of_mem_erase hj).symm)
      simpa only [off, Finset.sum_const_zero] using
        tendsto_finsetSum Finset.univ (fun i _ => hRow i)
    let vSum (v : A × ((Fin N → S) × B)) := ∑ i, V v i
    have hs : Tendsto (fun v => inner ℂ (z v) (vSum v)) (P' : Filter _)
        (𝓝 ((N : ℂ) * L)) := by
      simpa [vSum, inner_sum, nsmul_eq_mul] using
        tendsto_finsetSum Finset.univ (fun i _ => hSingle i)
    have hGram (v : A × ((Fin N → S) × B)) : ‖vSum v‖ ^ 2 ≤ (N : ℝ) * X ^ 2 + off v := by
      have hDiag : (∑ i : Fin N, ‖V v i‖ ^ 2) ≤ (N : ℝ) * X ^ 2 := by
        calc
          _ ≤ ∑ _i : Fin N, X ^ 2 :=
            Finset.sum_le_sum fun i _ =>
              pow_le_pow_left₀ (norm_nonneg _) (hx v.1 (v.2.1 i) v.2.2) _
          _ = _ := by simp [nsmul_eq_mul]
      exact (norm_sum_sq_decomposition (V v)).le.trans (add_le_add_left hDiag _)
    have hCauchy (v : A × ((Fin N → S) × B)) :
        ‖inner ℂ (z v) (vSum v)‖ ^ 2 ≤ Y ^ 2 * ((N : ℝ) * X ^ 2 + off v) := calc
      _ ≤ (‖z v‖ * ‖vSum v‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (norm_inner_le_norm _ _) _
      _ = ‖z v‖ ^ 2 * ‖vSum v‖ ^ 2 := mul_pow _ _ _
      _ ≤ Y ^ 2 * ‖vSum v‖ ^ 2 :=
        mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hy _ _) _) (sq_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_left (hGram v) (sq_nonneg _)
    have hrhs : Tendsto (fun v => Y ^ 2 * ((N : ℝ) * X ^ 2 + off v))
        (P' : Filter _) (𝓝 (Y ^ 2 * ((N : ℝ) * X ^ 2))) := by
      simpa only [add_zero] using tendsto_const_nhds.mul (tendsto_const_nhds.add hOff)
    have h := le_of_tendsto_of_tendsto' (hs.norm.pow 2) hrhs hCauchy
    rw [norm_mul, Complex.norm_natCast, mul_pow] at h
    apply (mul_le_mul_iff_right₀ (Nat.cast_pos.mpr hN : 0 < (N : ℝ))).mp
    convert h using 1 <;> ring
  by_contra hz
  have hPos : 0 < ‖L‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hz)
  obtain ⟨N, hN⟩ := exists_nat_gt (Y ^ 2 * X ^ 2 / ‖L‖ ^ 2)
  have hNpos : 0 < N := Nat.cast_pos.mp
    ((div_nonneg (mul_nonneg (sq_nonneg Y) (sq_nonneg X)) hPos.le).trans_lt hN)
  exact ((div_lt_iff₀ hPos).mp hN).not_ge (hbound N hNpos)

/-- The first-coordinate case of Lemma 10, used in the proof of Lemma 11. -/
theorem tendsto_inner_zero_of_fubini_correlations_first {S B E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (p : Ultrafilter S) (w : Ultrafilter B)
    (x : S → B → E) (y : B → E)
    {X Y : ℝ} (hx : ∀ s b, ‖x s b‖ ≤ X) (hy : ∀ b, ‖y b‖ ≤ Y)
    (hc : Tendsto (fun v : (S × S) × B => inner ℂ (x v.1.1 v.2) (x v.1.2 v.2))
      (fubiniUltrafilter (fubiniUltrafilter p p) w : Filter _) (𝓝 0)) :
    Tendsto (fun v : S × B => inner ℂ (y v.2) (x v.1 v.2))
      (fubiniUltrafilter p w : Filter _) (𝓝 0) := by
  have h := tendsto_inner_zero_of_fubini_correlations (pure ()) p w (fun _ => x)
    (fun _ => y) (fun _ => hx) (fun _ => hy)
    (tendsto_fubiniUltrafilter (fun _ => hc) tendsto_const_nhds)
  have hm : (fubiniUltrafilter p w).map (fun v => ((), v)) =
      fubiniUltrafilter (pure ()) (fubiniUltrafilter p w) := by
    apply Ultrafilter.coe_injective
    rfl
  exact tendsto_along_ultrafilter_map hm h

/-- The one-variable van der Corput consequence used for product joinings. -/
theorem tendsto_inner_zero_of_fubini_correlations_single {S E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] (p : Ultrafilter S)
    (x : S → E) {C : ℝ} (hx : ∀ s, ‖x s‖ ≤ C)
    (hc : Tendsto (fun v : S × S => inner ℂ (x v.1) (x v.2))
      (fubiniUltrafilter p p : Filter _) (𝓝 0)) (z : E) :
    Tendsto (fun s => inner ℂ z (x s)) (p : Filter _) (𝓝 0) := by
  let w : Ultrafilter Unit := pure ()
  have hCorr : Tendsto (fun v : (S × S) × Unit => inner ℂ (x v.1.1) (x v.1.2))
      (fubiniUltrafilter (fubiniUltrafilter p p) w : Filter _) (𝓝 0) :=
    tendsto_fubiniUltrafilter (fun _ => tendsto_const_nhds) hc
  have h := tendsto_inner_zero_of_fubini_correlations_first p w
    (fun s _ => x s) (fun _ => z) (fun s _ => hx s) (fun _ => le_rfl) hCorr
  have hm : p.map (fun s => (s, ())) = fubiniUltrafilter p w := by
    apply Ultrafilter.coe_injective
    rfl
  exact tendsto_along_ultrafilter_map
    (g := fun v : S × Unit => inner ℂ z (x v.1)) hm h

/-- Hilbert coefficients give convergence for the weak topology. -/
theorem tendsto_weakSpace_of_tendsto_inner {I E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    {l : Filter I} {f : I → E} {v : E}
    (h : ∀ z, Tendsto (fun i => inner ℂ z (f i)) l (𝓝 (inner ℂ z v))) :
    Tendsto (fun i => toWeakSpace ℂ E (f i)) l (𝓝 (toWeakSpace ℂ E v)) := by
  have hB : Function.Injective (topDualPairing ℂ E).flip := by
    intro x y hxy
    apply (SeparatingDual.eq_iff_forall_dual_eq (R := ℂ)).2
    intro a
    exact DFunLike.congr_fun hxy a
  refine (WeakBilin.tendsto_iff_forall_eval_tendsto _ hB).2 ?_
  intro a
  change Tendsto (fun i => a (f i)) l (𝓝 (a v))
  obtain ⟨z, rfl⟩ := (InnerProductSpace.toDual ℂ E).surjective a
  exact h z

/-- The weak-limit conclusion of Lemma 10. -/
theorem tendsto_weak_zero_of_fubini_correlations {A S B E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (q : Ultrafilter A) (p : Ultrafilter S) (w : Ultrafilter B)
    (x : A → S → B → E) {X : ℝ} (hx : ∀ a s b, ‖x a s b‖ ≤ X)
    (hc : Tendsto (fun v : A × ((S × S) × B) =>
        inner ℂ (x v.1 v.2.1.1 v.2.2) (x v.1 v.2.1.2 v.2.2))
      (fubiniUltrafilter q (fubiniUltrafilter (fubiniUltrafilter p p) w) : Filter _)
      (𝓝 0)) :
    Tendsto (fun v : A × (S × B) => toWeakSpace ℂ E (x v.1 v.2.1 v.2.2))
      (fubiniUltrafilter q (fubiniUltrafilter p w) : Filter _) (𝓝 0) := by
  rw [← map_zero (toWeakSpace ℂ E)]
  apply tendsto_weakSpace_of_tendsto_inner
  intro z
  simpa only [inner_zero_right] using
    tendsto_inner_zero_of_fubini_correlations q p w x (fun _ _ => z) hx
      (fun _ _ => le_rfl) hc

end Mixing
end

/- Source module Mixing.JoiningCorrelation. -/
section
/-! # Van der Corput for correlations of a joining -/


open Filter MeasureTheory
open scoped BigOperators ComplexConjugate Topology

namespace Mixing

/-- A bounded measurable representative of an essentially bounded complex function. -/
structure BoundedObservable (X : Type*) [MeasurableSpace X] where
  toFun : X → ℂ
  measurable : Measurable toFun
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  norm_le : ∀ x, ‖toFun x‖ ≤ bound

namespace BoundedObservable

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]

instance : CoeFun (BoundedObservable X) (fun _ => X → ℂ) :=
  ⟨toFun⟩

/-- The product of bounded measurable functions. -/
def mul (f g : BoundedObservable X) : BoundedObservable X where
  toFun x := f x * g x
  measurable := f.measurable.mul g.measurable
  bound := f.bound * g.bound
  bound_nonneg := mul_nonneg f.bound_nonneg g.bound_nonneg
  norm_le x := by
    rw [norm_mul]
    exact mul_le_mul (f.norm_le x) (g.norm_le x) (norm_nonneg _) f.bound_nonneg

/-- The difference of bounded measurable functions. -/
def sub (f g : BoundedObservable X) : BoundedObservable X where
  toFun x := f x - g x
  measurable := f.measurable.sub g.measurable
  bound := f.bound + g.bound
  bound_nonneg := add_nonneg f.bound_nonneg g.bound_nonneg
  norm_le x := (norm_sub_le _ _).trans (add_le_add (f.norm_le x) (g.norm_le x))

/-- The constant observable. -/
noncomputable def const (c : ℂ) : BoundedObservable X where
  toFun _ := c
  measurable := measurable_const
  bound := ‖c‖
  bound_nonneg := norm_nonneg c
  norm_le _ := le_rfl

/-- Pointwise complex conjugation. -/
def conjugate (f : BoundedObservable X) : BoundedObservable X where
  toFun x := conj (f x)
  measurable := Complex.continuous_conj.measurable.comp f.measurable
  bound := f.bound
  bound_nonneg := f.bound_nonneg
  norm_le x := by simpa using f.norm_le x

/-- Pullback along a measurable map. -/
def comp (f : BoundedObservable Y) (π : X → Y) (hπ : Measurable π) : BoundedObservable X where
  toFun x := f (π x)
  measurable := f.measurable.comp hπ
  bound := f.bound
  bound_nonneg := f.bound_nonneg
  norm_le x := f.norm_le (π x)

/-- Finite products of bounded observables. -/
def prod {ι : Type*} (s : Finset ι) (f : ι → BoundedObservable X) :
    BoundedObservable X where
  toFun x := ∏ i ∈ s, f i x
  measurable := Finset.measurable_prod s (fun i _ => (f i).measurable)
  bound := ∏ i ∈ s, (f i).bound
  bound_nonneg := Finset.prod_nonneg (fun i _ => (f i).bound_nonneg)
  norm_le x := by
    rw [norm_prod]
    exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun i _ => (f i).norm_le x)

@[simp] theorem mul_apply (f g : BoundedObservable X) (x : X) : f.mul g x = f x * g x := rfl
@[simp] theorem sub_apply (f g : BoundedObservable X) (x : X) : f.sub g x = f x - g x := rfl
@[simp] theorem const_apply (c : ℂ) (x : X) : (const c : BoundedObservable X) x = c := rfl
@[simp] theorem conjugate_apply (f : BoundedObservable X) (x : X) :
    f.conjugate x = conj (f x) := rfl
@[simp] theorem comp_apply (f : BoundedObservable Y) (π : X → Y) (hπ : Measurable π) (x : X) :
    f.comp π hπ x = f (π x) := rfl
@[simp] theorem prod_apply {ι : Type*} (s : Finset ι) (f : ι → BoundedObservable X) (x : X) :
    prod s f x = ∏ i ∈ s, f i x := rfl

theorem memLp (f : BoundedObservable X) (μ : Measure X) [IsFiniteMeasure μ] (p : ENNReal) :
    MemLp f p μ :=
  MemLp.of_bound f.measurable.aestronglyMeasurable f.bound (Eventually.of_forall f.norm_le)

theorem integrable (f : BoundedObservable X) (μ : Measure X) [IsFiniteMeasure μ] :
    Integrable f μ :=
  memLp_one_iff_integrable.mp (f.memLp μ 1)

/-- Regard a bounded observable as a vector in the probability-space Hilbert space. -/
noncomputable def l2 (f : BoundedObservable X) (μ : Measure X) [IsFiniteMeasure μ] :
    Lp ℂ 2 μ :=
  (f.memLp μ 2).toLp f

theorem coe_l2 (f : BoundedObservable X) (μ : Measure X) [IsFiniteMeasure μ] :
    f.l2 μ =ᵐ[μ] f :=
  (f.memLp μ 2).coeFn_toLp

theorem norm_l2_le (f : BoundedObservable X) (μ : Measure X) [IsProbabilityMeasure μ] :
    ‖f.l2 μ‖ ≤ f.bound := by
  have h := Lp.norm_le_of_ae_bound (f := f.l2 μ) f.bound_nonneg
    ((f.coe_l2 μ).mono fun x h => h ▸ f.norm_le x)
  simpa [measureUnivNNReal, measure_univ] using h

theorem inner_l2 (f g : BoundedObservable X) (μ : Measure X) [IsFiniteMeasure μ] :
    inner ℂ (f.l2 μ) (g.l2 μ) = ∫ x, conj (f x) * g x ∂μ := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [f.coe_l2 μ, g.coe_l2 μ] with x hfx hgx
  rw [hfx, hgx, RCLike.inner_apply']

theorem norm_integral_le (f : BoundedObservable X) (μ : Measure X) [IsProbabilityMeasure μ] :
    ‖∫ x, f x ∂μ‖ ≤ f.bound := by
  simpa using norm_integral_le_of_norm_le_const
    (Eventually.of_forall f.norm_le : ∀ᵐ x ∂μ, ‖f x‖ ≤ f.bound)

theorem integral_comp_of_preserving (f : BoundedObservable Y)
    {μ : Measure X} {ν : Measure Y} {π : X → Y} (hπ : MeasurePreserving π μ ν) :
    (∫ x, f (π x) ∂μ) = ∫ y, f y ∂ν := by
  rw [← hπ.map_eq]
  exact (integral_map hπ.measurable.aemeasurable f.measurable.aestronglyMeasurable).symm

end BoundedObservable

namespace System

variable {G X : Type*} [Group G] [MeasurableSpace X]

/-- The translate of a bounded observable by the system action. -/
def translated (S : System G X) (g : G) (f : BoundedObservable X) : BoundedObservable X :=
  f.comp (S.act g) (S.preserves g).measurable

@[simp] theorem translated_apply (S : System G X) (g : G) (f : BoundedObservable X) (x : X) :
    S.translated g f x = f (S.act g x) := rfl

@[simp] theorem translated_bound (S : System G X) (g : G) (f : BoundedObservable X) :
    (S.translated g f).bound = f.bound := rfl

end System

section Joining

variable {G X Y Z : Type*} [CommGroup G]
variable [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]

/-- The coefficient formulation of U-mixing on bounded observables. -/
def HasMixingCorrelations (R : System G Z) (U : Set (Ultrafilter G)) : Prop :=
  ∀ p ∈ U, ∀ f h : BoundedObservable Z,
    Tendsto (fun g => ∫ z, conj (f z) * h (R.act g z) ∂R.measure) (p : Filter G)
      (𝓝 (conj (∫ z, f z ∂R.measure) * ∫ z, h z ∂R.measure))

private def translatedProduct {n : ℕ}
    (T : System G X) (f : Fin n → BoundedObservable X) (g : Fin n → G) : BoundedObservable X :=
  BoundedObservable.prod Finset.univ (fun i => T.translated (g i) (f i))

private def joiningTest {n : ℕ} (T : System G X)
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (g : Fin n → G) :
    BoundedObservable (X × Y) :=
  ((translatedProduct T f g).comp Prod.fst measurable_fst).mul
    (F.comp Prod.snd measurable_snd)

private def joiningTest₃ {n : ℕ} (T : System G X)
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (H : BoundedObservable Z)
    (g : Fin n → G) : BoundedObservable ((X × Y) × Z) :=
  ((joiningTest T f F g).comp Prod.fst measurable_fst).mul
    (H.comp Prod.snd measurable_snd)

/-- A two-coordinate correlation at the given translates. -/
noncomputable def joiningCorrelation {n : ℕ} (T : System G X) (σ : Measure (X × Y))
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (g : Fin n → G) : ℂ :=
  ∫ w, (∏ i, f i (T.act (g i) w.1)) * F w.2 ∂σ

/-- A three-coordinate correlation at the given translates. -/
noncomputable def joiningCorrelation₃ {n : ℕ} (T : System G X) (τ : Measure ((X × Y) × Z))
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (H : BoundedObservable Z)
    (g : Fin n → G) : ℂ :=
  ∫ w, (∏ i, f i (T.act (g i) w.1.1)) * F w.1.2 * H w.2 ∂τ

private theorem norm_joiningCorrelation_le {n : ℕ} (T : System G X) (σ : Measure (X × Y))
    [IsProbabilityMeasure σ] (f : Fin n → BoundedObservable X) (F : BoundedObservable Y)
    (g : Fin n → G) :
    ‖joiningCorrelation T σ f F g‖ ≤ (∏ i, (f i).bound) * F.bound :=
  (joiningTest T f F g).norm_integral_le σ

private theorem diff_joiningCorrelation₃ {n : ℕ}
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (H : BoundedObservable Z)
    (c : ℂ) (g : Fin n → G) :
    joiningCorrelation₃ T τ f F (H.sub (BoundedObservable.const c)) g =
      joiningCorrelation₃ T τ f F H g - joiningCorrelation T σ f F g * c := by
  let := hτ.probability
  let v := joiningTest T f F g
  let vc := v.comp Prod.fst (measurable_fst (β := Z))
  let C : BoundedObservable ((X × Y) × Z) := BoundedObservable.const c
  change (∫ w, v w.1 * (H w.2 - c) ∂τ) =
    (∫ w, v w.1 * H w.2 ∂τ) - (∫ w, v w ∂σ) * c
  simp_rw [mul_sub]
  have hfirst : Integrable (fun w : (X × Y) × Z => v w.1 * H w.2) τ :=
    (joiningTest₃ T f F H g).integrable τ
  have hsecond : Integrable (fun w : (X × Y) × Z => v w.1 * c) τ :=
    (vc.mul C).integrable τ
  rw [integral_sub hfirst hsecond]
  rw [integral_mul_const, v.integral_comp_of_preserving hτ.fst]
  rfl

private theorem joiningCorrelation₃_empty
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    (hDisjoint : Disjoint S R) (f : Fin 0 → BoundedObservable X)
    (F : BoundedObservable Y) (H : BoundedObservable Z) (g : Fin 0 → G) :
    joiningCorrelation₃ T τ f F H g =
      joiningCorrelation T σ f F g * ∫ z, H z ∂R.measure := by
  let idR : FactorMap R R := ⟨id, MeasurePreserving.id _, fun _ => rfl⟩
  have hmap := hDisjoint _ (hτ.map hσ.sndFactor idR)
  have hπ : MeasurePreserving (fun w : (X × Y) × Z => (w.1.2, w.2))
      τ (S.measure.prod R.measure) :=
    ⟨measurable_snd.comp measurable_fst |>.prodMk measurable_snd, hmap⟩
  let φ := (F.comp Prod.fst (measurable_fst (β := Z))).mul
    (H.comp Prod.snd (measurable_snd (α := Y)))
  have h₃ := φ.integral_comp_of_preserving hπ
  have h₂ := F.integral_comp_of_preserving hσ.snd
  simpa [joiningCorrelation₃, joiningCorrelation, joiningTest₃,
    joiningTest, translatedProduct, φ, h₂, integral_prod_mul] using h₃

private def orbitPair (T : System G X) (d : G) (f : BoundedObservable X) :
    BoundedObservable X :=
  f.conjugate.mul (T.translated d f)

private def joiningShift {n : ℕ}
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (H : BoundedObservable Z)
    (a : G) (g : Fin n → G) : BoundedObservable ((X × Y) × Z) :=
  (joiningTest₃ T f F H g).comp (hσ.system.prodAct R a⁻¹)
    (hτ.invariant a⁻¹).measurable

private theorem act_mul_at {M : Type*} [MeasurableSpace M]
    (Q : System G M) (g h : G) (x : M) : Q.act (g * h) x = Q.act g (Q.act h x) :=
  congrFun (Q.act_mul g h) x

private theorem joiningShift_first
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    {n : ℕ} (f : Fin (n + 1) → BoundedObservable X)
    (F : BoundedObservable Y) (H : BoundedObservable Z) (a : G) (g : Fin n → G) :
    (∫ w, f 0 w.1.1 * joiningShift hτ (Fin.tail f) F H a g w ∂τ) =
      joiningCorrelation₃ T τ f F H (Fin.cons a g) := by
  change _ = ∫ w, joiningTest₃ T f F H (Fin.cons a g) w ∂τ
  rw [← (joiningTest₃ T f F H (Fin.cons a g)).integral_comp_of_preserving
    (hτ.invariant a⁻¹)]
  congr 1
  funext w
  simp only [joiningShift, joiningTest₃, joiningTest, translatedProduct, IsJoining.system,
    System.prodAct, BoundedObservable.comp_apply, BoundedObservable.prod_apply,
    BoundedObservable.mul_apply, System.translated_apply, Prod.map_fst, Prod.map_snd]
  rw [Fin.prod_univ_succ]
  simp only [Fin.cons_zero, Fin.cons_succ, Fin.tail, ← act_mul_at, mul_inv_cancel,
    T.act_one, id_eq]
  ring

private theorem joiningShift_pair
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    {n : ℕ} (f : Fin n → BoundedObservable X)
    (F : BoundedObservable Y) (H : BoundedObservable Z) (r t : G) (g : Fin n → G) :
    (∫ w, conj (joiningShift hτ f F H r g w) * joiningShift hτ f F H t g w ∂τ) =
      joiningCorrelation₃ T τ (fun i => orbitPair T (t⁻¹ * r) (f i))
        (orbitPair S (t⁻¹ * r) F) (orbitPair R (t⁻¹ * r) H) g := by
  let v := (joiningShift hτ f F H r g).conjugate.mul (joiningShift hτ f F H t g)
  change (∫ w, v w ∂τ) = _
  rw [← v.integral_comp_of_preserving (hτ.invariant r)]
  unfold joiningCorrelation₃
  congr 1
  funext w
  simp only [v, joiningShift, joiningTest₃, joiningTest, translatedProduct, orbitPair,
    IsJoining.system, System.prodAct, BoundedObservable.comp_apply, BoundedObservable.conjugate_apply,
    BoundedObservable.prod_apply, BoundedObservable.mul_apply, System.translated_apply,
    Prod.map_fst, Prod.map_snd, ← act_mul_at, inv_mul_cancel,
    T.act_one, S.act_one, R.act_one, id_eq]
  simp only [map_mul, map_prod, Finset.prod_mul_distrib]
  have hcomm (i : Fin n) :
      T.act ((t⁻¹ * r) * g i) w.1.1 = T.act (g i * (t⁻¹ * r)) w.1.1 := by
    rw [mul_comm (t⁻¹ * r)]
  simp only [hcomm]
  ring

private theorem tendsto_orbitPair_mean_zero
    {R : System G Z} {U : Set (Ultrafilter G)} (hMix : HasMixingCorrelations R U)
    {p : Ultrafilter G} (hp : p ∈ U) (H : BoundedObservable Z)
    (hMean : ∫ z, H z ∂R.measure = 0) (r : G) :
    Tendsto (fun t => ∫ z, orbitPair R (t⁻¹ * r) H z ∂R.measure)
      (p : Filter G) (𝓝 0) := by
  let Hr := R.translated r H
  have h := (Complex.continuous_conj.tendsto _).comp (hMix p hp Hr H)
  have heq (t : G) :
      conj (∫ z, conj (Hr z) * H (R.act t z) ∂R.measure) =
        ∫ z, orbitPair R (t⁻¹ * r) H z ∂R.measure := by
    rw [← (orbitPair R (t⁻¹ * r) H).integral_comp_of_preserving (R.preserves t)]
    rw [← integral_conj]
    congr 1
    funext z
    have hact : R.act (t⁻¹ * r) (R.act t z) = R.act r z := calc
      _ = R.act ((t⁻¹ * r) * t) z := congrFun (R.act_mul _ _).symm z
      _ = _ := by rw [mul_comm t⁻¹ r, mul_assoc, inv_mul_cancel, mul_one]
    simp only [orbitPair, Hr, BoundedObservable.mul_apply, BoundedObservable.conjugate_apply,
      System.translated_apply, map_mul, starRingEnd_self_apply, hact]
    exact mul_comm _ _
  simpa only [Function.comp_def, heq, hMean, mul_zero, map_zero] using h

/-- Factorization of the ordered scalar ultralimits of the joining correlations in Lemma 11.
The indices are ordered from the outermost limit to the innermost limit. -/
theorem tendsto_joiningCorrelation₃
    {T : System G X} {S : System G Y} {R : System G Z}
    {σ : Measure (X × Y)} {τ : Measure ((X × Y) × Z)}
    {hσ : IsJoining T S σ} (hτ : IsJoining hσ.system R τ)
    {U : Set (Ultrafilter G)} (hMix : HasMixingCorrelations R U) (hDisjoint : Disjoint S R)
    {n : ℕ} (p : Fin n → Ultrafilter G) (hp : ∀ i, p i ∈ U)
    (f : Fin n → BoundedObservable X) (F : BoundedObservable Y) (H : BoundedObservable Z) :
    Tendsto (joiningCorrelation₃ T τ f F H) (coordinateUltrafilter p : Filter _)
      (𝓝 (scalarUltralimit (coordinateUltrafilter p) (joiningCorrelation T σ f F) *
        ∫ z, H z ∂R.measure)) := by
  let := hσ.probability
  let := hτ.probability
  induction n generalizing F H with
  | zero =>
    have h := (tendsto_scalarUltralimit (coordinateUltrafilter p)
      (norm_joiningCorrelation_le T σ f F)).mul
      (tendsto_const_nhds (x := ∫ z, H z ∂R.measure))
    convert h using 1
    funext g
    exact joiningCorrelation₃_empty hτ hDisjoint f F H g
  | succ n ih =>
    let w := coordinateUltrafilter (fun i : Fin n => p i.succ)
    let c := ∫ z, H z ∂R.measure
    let H₀ := H.sub (BoundedObservable.const c)
    have hMean : ∫ z, H₀ z ∂R.measure = 0 := by
      have hH : Integrable (fun z => H z) R.measure := H.integrable _
      have hC : Integrable (fun _ : Z => c) R.measure := integrable_const c
      change (∫ z, H z - c ∂R.measure) = 0
      rw [integral_sub hH hC]
      simp [c]
    have centered : Tendsto (joiningCorrelation₃ T τ f F H₀)
        (coordinateUltrafilter p : Filter _) (𝓝 0) := by
      let Y₀ := (f 0).conjugate.comp (fun v : (X × Y) × Z => v.1.1)
        (measurable_fst.comp measurable_fst)
      let y (_ : Fin n → G) := Y₀.l2 τ
      let x (a : G) (g : Fin n → G) := (joiningShift hτ (Fin.tail f) F H₀ a g).l2 τ
      have hx (a : G) (g : Fin n → G) :
          ‖x a g‖ ≤ (∏ i : Fin n, (f i.succ).bound) * F.bound * H₀.bound :=
        (joiningShift hτ (Fin.tail f) F H₀ a g).norm_l2_le τ
      have hy (g : Fin n → G) : ‖y g‖ ≤ (f 0).bound := Y₀.norm_l2_le τ
      let A (v : G × G) :=
        scalarUltralimit w (joiningCorrelation T σ
          (fun i => orbitPair T (v.2⁻¹ * v.1) (f i.succ)) (orbitPair S (v.2⁻¹ * v.1) F))
      let B (v : G × G) := ∫ z, orbitPair R (v.2⁻¹ * v.1) H₀ z ∂R.measure
      have hA (v : G × G) :
          ‖A v‖ ≤ (∏ i : Fin n, (f i.succ).bound * (f i.succ).bound) * (F.bound * F.bound) :=
        norm_scalarUltralimit_le w (norm_joiningCorrelation_le T σ _ _)
      have hAB : Tendsto (fun v => A v * B v)
          (fubiniUltrafilter (p 0) (p 0) : Filter _) (𝓝 0) := by
        apply tendsto_fubiniUltrafilter (g := fun _ => 0) _ tendsto_const_nhds
        intro r
        exact Filter.isBoundedUnder_le_mul_tendsto_zero
          ⟨_, eventually_map.mpr (Eventually.of_forall fun t => hA (r, t))⟩
          (tendsto_orbitPair_mean_zero hMix (hp 0) H₀ hMean r)
      have hPair : Tendsto (fun v : (G × G) × (Fin n → G) =>
          inner ℂ (x v.1.1 v.2) (x v.1.2 v.2))
          (fubiniUltrafilter (fubiniUltrafilter (p 0) (p 0)) w : Filter _) (𝓝 0) := by
        apply tendsto_fubiniUltrafilter (g := fun v => A v * B v) _ hAB
        intro v
        simp only [x, BoundedObservable.inner_l2, joiningShift_pair]
        exact ih (Fin.tail p) (fun i => hp i.succ)
          (fun i => orbitPair T (v.2⁻¹ * v.1) (f i.succ))
          (orbitPair S (v.2⁻¹ * v.1) F) (orbitPair R (v.2⁻¹ * v.1) H₀)
      have hVdc := tendsto_inner_zero_of_fubini_correlations_first (p 0) w x y hx hy hPair
      rw [coordinateUltrafilter, Ultrafilter.coe_map, tendsto_map'_iff]
      simpa only [x, y, Y₀, w, BoundedObservable.inner_l2, BoundedObservable.comp_apply,
        BoundedObservable.conjugate_apply, starRingEnd_self_apply, joiningShift_first,
        Function.comp_def]
        using hVdc
    have hProd := (tendsto_scalarUltralimit (coordinateUltrafilter p)
      (norm_joiningCorrelation_le T σ f F)).mul (tendsto_const_nhds (x := c))
    have hTotal := centered.add hProd
    simpa only [H₀, diff_joiningCorrelation₃ hτ, sub_add_cancel, zero_add, c] using hTotal

end Joining

end Mixing
end

/- Source module Mixing.BoundedKoopman. -/
section
/-! # Bounded observables and weak Koopman limits -/


open Filter MeasureTheory Set
open scoped BigOperators ComplexConjugate Topology

namespace Mixing

variable {G X A : Type*} [CommGroup G] [MeasurableSpace X] [MeasurableSpace A]

private def aeNormBounded (μ : Measure X) (C : ℝ) : Set (Lp ℂ 2 μ) :=
  {f | ∀ᵐ x ∂μ, ‖f x‖ ≤ C}

private theorem convex_aeNormBounded (μ : Measure X) (C : ℝ) :
    Convex ℝ (aeNormBounded μ C) := by
  intro f hf g hg a b ha hb hab
  change ∀ᵐ x ∂μ, ‖(a • f + b • g : Lp ℂ 2 μ) x‖ ≤ C
  filter_upwards [hf, hg, Lp.coeFn_add (a • f) (b • g),
    Lp.coeFn_smul a f, Lp.coeFn_smul b g] with x hfx hgx hAdd hAf hBg
  change ‖f x‖ ≤ C at hfx
  change ‖g x‖ ≤ C at hgx
  rw [hAdd, Pi.add_apply, hAf, hBg, Pi.smul_apply, Pi.smul_apply]
  calc
    _ ≤ ‖a • f x‖ + ‖b • g x‖ := norm_add_le _ _
    _ = a * ‖f x‖ + b * ‖g x‖ := by
      simp only [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg hb]
    _ ≤ a * C + b * C :=
      add_le_add (mul_le_mul_of_nonneg_left hfx ha) (mul_le_mul_of_nonneg_left hgx hb)
    _ = C := by rw [← add_mul, hab, one_mul]

private theorem isClosed_aeNormBounded (μ : Measure X) (C : ℝ) :
    IsClosed (aeNormBounded μ C) := by
  apply IsSeqClosed.isClosed
  intro f v hf hv
  obtain ⟨φ, _, hφ⟩ := (tendstoInMeasure_of_tendsto_Lp hv).exists_seq_tendsto_ae
  have hAll : ∀ᵐ x ∂μ, ∀ n, ‖f n x‖ ≤ C := ae_all_iff.mpr hf
  change ∀ᵐ x ∂μ, ‖v x‖ ≤ C
  filter_upwards [hφ, hAll] with x hLim hBound
  exact le_of_tendsto' hLim.norm fun n => hBound (φ n)

namespace BoundedObservable

/-- Clip a measurable L² representative to obtain a pointwise bounded version. -/
noncomputable def ofLp {μ : Measure X} {q : ENNReal} (f : Lp ℂ q μ) (C : ℝ) (hC : 0 ≤ C) :
    BoundedObservable X where
  toFun x := if ‖f x‖ ≤ C then f x else 0
  measurable := Measurable.ite
    (measurableSet_le (Lp.stronglyMeasurable f).measurable.norm measurable_const)
      (Lp.stronglyMeasurable f).measurable measurable_const
  bound := C
  bound_nonneg := hC
  norm_le x := by split_ifs with h <;> simpa

theorem ofLp_ae {μ : Measure X} {q : ENNReal} (f : Lp ℂ q μ) (C : ℝ) (hC : 0 ≤ C)
    (h : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) :
    BoundedObservable.ofLp f C hC =ᵐ[μ] f := by
  filter_upwards [h] with x hx
  exact ite_eq_left hx

theorem l2_ofLp {μ : Measure X} [IsFiniteMeasure μ] (f : Lp ℂ 2 μ) (C : ℝ) (hC : 0 ≤ C)
    (h : ∀ᵐ x ∂μ, ‖f x‖ ≤ C) :
    (BoundedObservable.ofLp f C hC).l2 μ = f := by
  apply Lp.ext
  exact ((BoundedObservable.ofLp f C hC).coe_l2 μ).trans (ofLp_ae f C hC h)

/-- A pointwise bounded representative of an arbitrary L∞ class. -/
noncomputable def ofLInf {μ : Measure X} (f : Lp ℂ ⊤ μ) : BoundedObservable X :=
  ofLp f (lpNorm f ⊤ μ) lpNorm_nonneg

theorem ofLInf_ae {μ : Measure X} (f : Lp ℂ ⊤ μ) : ofLInf f =ᵐ[μ] f :=
  ofLp_ae f _ _ (ae_le_lpNorm_exponent_top (Lp.memLp f))

private noncomputable def ofSimpleFunc (f : SimpleFunc X ℂ) : BoundedObservable X where
  toFun := f
  measurable := f.measurable
  bound := ∑ c ∈ f.range, ‖c‖
  bound_nonneg := Finset.sum_nonneg (fun c _ => norm_nonneg c)
  norm_le x := Finset.single_le_sum (fun c _ => norm_nonneg c) (f.mem_range_self x)

/-- Bounded measurable observables are dense in L² on a finite measure space. -/
theorem denseRange_l2 (μ : Measure X) [IsFiniteMeasure μ] :
    DenseRange (fun f : BoundedObservable X => f.l2 μ) := by
  have h : Dense (range (fun f : Lp.simpleFunc ℂ 2 μ => (f : Lp ℂ 2 μ))) :=
    Lp.simpleFunc.denseRange (by norm_num)
  apply h.mono
  rintro _ ⟨f, rfl⟩
  refine ⟨ofSimpleFunc (Lp.simpleFunc.toSimpleFunc f), ?_⟩
  apply Lp.ext
  exact ((ofSimpleFunc (Lp.simpleFunc.toSimpleFunc f)).coe_l2 μ).trans
    (Lp.simpleFunc.toSimpleFunc_eq_toFun f)

end BoundedObservable

namespace System

/-- The translated observable represents the Koopman vector. -/
theorem koopman_ae_observable (T : System G X) (g : G) (f : BoundedObservable X) :
    T.koopmanRep g (f.l2 T.measure) =ᵐ[T.measure] T.translated g f := by
  exact (Lp.coeFn_compMeasurePreserving (f.l2 T.measure) (T.preserves g)).trans
    ((T.preserves g).quasiMeasurePreserving.ae_eq_comp (f.coe_l2 T.measure))

/-- Weak Koopman limits preserve the essential uniform bound. -/
theorem ultrafilterOperator_ae_bound (T : System G X) (p : Ultrafilter G)
    (f : BoundedObservable X) :
    ∀ᵐ x ∂T.measure, ‖ultrafilterOperator T.koopmanRep p (f.l2 T.measure) x‖ ≤ f.bound := by
  let C := aeNormBounded T.measure f.bound
  have hC : IsClosed ((toWeakSpace ℂ (Lp ℂ 2 T.measure)) '' C) := by
    have h := (convex_aeNormBounded T.measure f.bound).toWeakSpace_closure ℂ
    rw [(isClosed_aeNormBounded T.measure f.bound).closure_eq] at h
    rw [h]
    exact isClosed_closure
  have hlim := tendsto_weakSpace_of_tendsto_inner
    (fun z => tendsto_ultrafilterOperator_coeff T.koopmanRep p z (f.l2 T.measure))
  have hMem := hC.mem_of_tendsto hlim (Eventually.of_forall fun g => by
    refine ⟨_, ?_, rfl⟩
    change ∀ᵐ x ∂T.measure, ‖T.koopmanRep g (f.l2 T.measure) x‖ ≤ f.bound
    filter_upwards [T.koopman_ae_observable g f] with x hx
    rw [hx]
    exact f.norm_le _)
  obtain ⟨v, hv, heq⟩ := hMem
  exact (toWeakSpace ℂ (Lp ℂ 2 T.measure)).injective heq ▸ hv

/-- A bounded representative of the weak Koopman limit, written Tᵖf in the paper. -/
noncomputable def ultrafilterTranslate (T : System G X) (p : Ultrafilter G)
    (f : BoundedObservable X) : BoundedObservable X :=
  BoundedObservable.ofLp (ultrafilterOperator T.koopmanRep p (f.l2 T.measure))
    f.bound f.bound_nonneg

theorem ultrafilterTranslate_ae (T : System G X) (p : Ultrafilter G)
    (f : BoundedObservable X) :
    T.ultrafilterTranslate p f =ᵐ[T.measure] ultrafilterOperator T.koopmanRep p (f.l2 T.measure) :=
  BoundedObservable.ofLp_ae _ _ _ (T.ultrafilterOperator_ae_bound p f)

theorem l2_ultrafilterTranslate (T : System G X) (p : Ultrafilter G)
    (f : BoundedObservable X) :
    (T.ultrafilterTranslate p f).l2 T.measure = ultrafilterOperator T.koopmanRep p (f.l2 T.measure) :=
  BoundedObservable.l2_ofLp _ _ _ (T.ultrafilterOperator_ae_bound p f)

/-- Pairing with a pulled-back observable gives the associated weighted integral. -/
theorem inner_pullback_observable
    {μ : Measure A} {ν : Measure X} [IsFiniteMeasure μ]
    {π : A → X} (hπ : MeasurePreserving π μ ν)
    (B : BoundedObservable A) (f : BoundedObservable X)
    {v : Lp ℂ 2 ν} (hv : v =ᵐ[ν] f) :
    inner ℂ (B.conjugate.l2 μ) (Lp.compMeasurePreserving π hπ v) =
      ∫ a, B a * f (π a) ∂μ := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [B.conjugate.coe_l2 μ, Lp.coeFn_compMeasurePreserving v hπ,
    hπ.quasiMeasurePreserving.ae_eq_comp hv] with a hB hp hf
  rw [hB, hp]
  change inner ℂ (B.conjugate a) (v (π a)) = _
  rw [show v (π a) = f (π a) from hf]
  simp only [RCLike.inner_apply', BoundedObservable.conjugate_apply]
  exact congrArg (· * f (π a)) (starRingEnd_self_apply (B a))

/-- A weak Koopman limit can be taken inside a joining integral with a fixed bounded factor. -/
theorem tendsto_integral_mul_translated (T : System G X)
    {μ : Measure A} [IsFiniteMeasure μ] {π : A → X}
    (hπ : MeasurePreserving π μ T.measure)
    (B : BoundedObservable A) (p : Ultrafilter G) (f : BoundedObservable X) :
    Tendsto (fun g => ∫ a, B a * f (T.act g (π a)) ∂μ) (p : Filter G)
      (𝓝 (∫ a, B a * T.ultrafilterTranslate p f (π a) ∂μ)) := by
  let d : Lp ℂ 2 T.measure →L[ℂ] Lp ℂ 2 μ :=
    (Lp.compMeasurePreservingₗᵢ ℂ π hπ).toContinuousLinearMap
  have h := tendsto_ultrafilterOperator_coeff T.koopmanRep p
    (d.adjoint (B.conjugate.l2 μ)) (f.l2 T.measure)
  simp only [ContinuousLinearMap.adjoint_inner_left] at h
  have hTranslate (g : G) :
      inner ℂ (B.conjugate.l2 μ) (d (T.koopmanRep g (f.l2 T.measure))) =
        ∫ a, B a * f (T.act g (π a)) ∂μ :=
    inner_pullback_observable hπ B (T.translated g f) (T.koopman_ae_observable g f)
  have hLimit :
      inner ℂ (B.conjugate.l2 μ) (d (ultrafilterOperator T.koopmanRep p (f.l2 T.measure))) =
        ∫ a, B a * T.ultrafilterTranslate p f (π a) ∂μ :=
    inner_pullback_observable hπ B (T.ultrafilterTranslate p f)
      (T.ultrafilterTranslate_ae p f).symm
  simpa only [hTranslate, hLimit] using h

/-- Complex conjugation commutes with the weak Koopman limits, up to null sets. -/
theorem ultrafilterTranslate_conjugate_ae (T : System G X) (p : Ultrafilter G)
    (f : BoundedObservable X) :
    T.ultrafilterTranslate p f.conjugate =ᵐ[T.measure]
      (T.ultrafilterTranslate p f).conjugate := by
  let u := T.ultrafilterTranslate p f.conjugate
  let v := (T.ultrafilterTranslate p f).conjugate
  have hTest (B : BoundedObservable X) :
      (∫ x, B x * u x ∂T.measure) = ∫ x, B x * v x ∂T.measure := by
    have h₁ := T.tendsto_integral_mul_translated (MeasurePreserving.id T.measure) B p f.conjugate
    have h₂ := T.tendsto_integral_mul_translated (MeasurePreserving.id T.measure) B.conjugate p f
    have hAct (g : G) :
        conj (∫ x, B.conjugate x * f (T.act g x) ∂T.measure) =
          ∫ x, B x * f.conjugate (T.act g x) ∂T.measure := by
      rw [← integral_conj]
      simp only [BoundedObservable.conjugate_apply, map_mul, starRingEnd_self_apply]
    have hLim :
        conj (∫ x, B.conjugate x * T.ultrafilterTranslate p f x ∂T.measure) =
          ∫ x, B x * v x ∂T.measure := by
      rw [← integral_conj]
      simp only [v, BoundedObservable.conjugate_apply, map_mul, starRingEnd_self_apply]
    exact tendsto_nhds_unique h₁ (by
      simpa only [Function.comp_def, id_eq, hAct, hLim] using
        (Complex.continuous_conj.tendsto _).comp h₂)
  let D := u.sub v
  have hu : Integrable (fun x => D.conjugate x * u x) T.measure :=
    (D.conjugate.mul u).integrable _
  have hv : Integrable (fun x => D.conjugate x * v x) T.measure :=
    (D.conjugate.mul v).integrable _
  have hInner : inner ℂ (D.l2 T.measure) (D.l2 T.measure) = 0 := by
    rw [D.inner_l2]
    change (∫ x, D.conjugate x * (u x - v x) ∂T.measure) = 0
    simp_rw [mul_sub]
    rw [integral_sub hu hv, hTest D.conjugate, sub_self]
  have hz : D.l2 T.measure = 0 := inner_self_eq_zero.mp hInner
  have hD := D.coe_l2 T.measure
  rw [hz] at hD
  filter_upwards [hD, Lp.coeFn_zero (E := ℂ) (p := 2) (μ := T.measure)] with x hx hzero
  exact sub_eq_zero.mp (hx.symm.trans hzero)

/-- Successive weak limits of the separate translate variables in a finite product. -/
theorem tendsto_integral_prod_translated (T : System G X)
    {μ : Measure A} [IsFiniteMeasure μ] {π : A → X}
    (hπ : MeasurePreserving π μ T.measure)
    {n : ℕ} (p : Fin n → Ultrafilter G) (f : Fin n → BoundedObservable X)
    (B : BoundedObservable A) :
    Tendsto (fun g : Fin n → G => ∫ a, B a * (∏ i, f i (T.act (g i) (π a))) ∂μ)
      (coordinateUltrafilter p : Filter _)
      (𝓝 (∫ a, B a * (∏ i, T.ultrafilterTranslate (p i) (f i) (π a)) ∂μ)) := by
  induction n generalizing B with
  | zero => simp
  | succ n ih =>
    let Bnext (g : G) := B.mul ((T.translated g (f 0)).comp π hπ.measurable)
    let Bouter := B.mul (BoundedObservable.prod Finset.univ (fun i : Fin n =>
      (T.ultrafilterTranslate (p i.succ) (f i.succ)).comp π hπ.measurable))
    have hInner (g₀ : G) := ih (Fin.tail p) (Fin.tail f) (Bnext g₀)
    have hOuter := T.tendsto_integral_mul_translated hπ Bouter (p 0) (f 0)
    have hInside (g₀ : G) :
        (∫ a, Bnext g₀ a *
          (∏ i : Fin n, T.ultrafilterTranslate (p i.succ) (f i.succ) (π a)) ∂μ) =
        ∫ a, Bouter a * f 0 (T.act g₀ (π a)) ∂μ := by
      apply integral_congr_ae
      refine Eventually.of_forall fun a => ?_
      simp only [Bnext, Bouter, BoundedObservable.mul_apply, BoundedObservable.comp_apply,
        BoundedObservable.prod_apply, System.translated_apply]
      ring
    have hInner' (g₀ : G) :
        Tendsto (fun g : Fin n → G => ∫ a, Bnext g₀ a *
          (∏ i : Fin n, f i.succ (T.act (g i) (π a))) ∂μ) (coordinateUltrafilter (Fin.tail p) : Filter _)
          (𝓝 (∫ a, Bouter a * f 0 (T.act g₀ (π a)) ∂μ)) := by
      simpa only [Fin.tail, hInside] using hInner g₀
    have h := tendsto_fubiniUltrafilter (f := fun v : G × (Fin n → G) =>
      ∫ a, Bnext v.1 a * (∏ i : Fin n, f i.succ (T.act (v.2 i) (π a))) ∂μ) hInner' hOuter
    rw [coordinateUltrafilter, Ultrafilter.coe_map, tendsto_map'_iff]
    have hTail : Fin.tail p = fun i : Fin n => p i.succ := rfl
    simpa only [Bnext, Bouter, BoundedObservable.mul_apply, BoundedObservable.comp_apply,
      BoundedObservable.prod_apply, System.translated_apply, Function.comp_def,
      Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ, hTail, mul_left_comm, mul_comm, mul_assoc] using h

end System

