      ((tendsto_ultrafilterOperator_coeff U (p.map f) x y).comp
        (show Tendsto f (p : Filter I) (p.map f : Filter _) from le_rfl)).norm
    have h (r : ℕ) : ‖⟪x, L y⟫_ℂ‖ ≤ B *
