    have hh : ‖∑ l ∈ B, A l‖ ≤ (B.card : ℝ) * (D*C) := by
      exact (norm_sum_le _ _).trans ((Finset.sum_le_sum fun l _ ↦ hB l).trans_eq (by simp))
