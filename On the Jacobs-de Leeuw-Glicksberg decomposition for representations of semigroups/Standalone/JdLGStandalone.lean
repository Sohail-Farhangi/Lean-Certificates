      rw [hcancel]
      exact hb.trans_lt (by linarith)
    obtain ⟨x, hx⟩ := hrange
    refine ⟨toWeakSpace ℂ E x, WeakDual.toStrongDual.injective ?_⟩
    rw [hj, LinearEquiv.symm_apply_apply, hx]
