section MonotheticL1SupportDevelopment

/-! # The support of a positive fixed point on L¹ -/

@[expose] public section

namespace JdLG

open Filter MeasureTheory Set
open scoped ENNReal Topology

variable {X 𝕜 E : Type*} [MeasurableSpace X] {μ : Measure X}
  [NontriviallyNormedField 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- The region on which the magnitude of f is bounded by an integer multiple of h. -/
def lpOneFixedPointCut (h : Lp ℝ 1 μ) (f : Lp E 1 μ) (n : ℕ) : Set X :=
  {x | ‖f x‖ ≤ (n : ℝ) * h x}

theorem measurableSet_lpOneFixedPointCut (h : Lp ℝ 1 μ) (f : Lp E 1 μ) (n : ℕ) :
    MeasurableSet (lpOneFixedPointCut h f n) :=
  measurableSet_le (Lp.stronglyMeasurable f).norm.measurable
    ((Lp.stronglyMeasurable h).measurable.const_mul _)

/-- A vector supported on the positive region of h is the norm limit of
its restrictions to regions where it is dominated by multiples of h. -/
theorem tendsto_lpOneFixedPointCut (h : Lp ℝ 1 μ) (f : Lp E 1 μ) (hh : 0 ≤ h)
    (hf : ∀ᵐ x ∂μ, ¬ 0 < h x → f x = 0) :
    Tendsto (fun n ↦ lpOneRestrict (𝕜 := 𝕜) (measurableSet_lpOneFixedPointCut h f n) f)
      atTop (𝓝 f) := by
  let A : ℕ → Set X := fun n ↦ lpOneFixedPointCut h f n
  let hA : ∀ n, MeasurableSet (A n) := measurableSet_lpOneFixedPointCut h f
  have hv : ∀ᵐ x ∂μ, ∀ᶠ n in atTop, x ∉ (A n)ᶜ := by
    filter_upwards [hf, (Lp.coeFn_nonneg h).2 hh] with x hfx hhx
    change 0 ≤ h x at hhx
    simp only [mem_compl_iff, not_not]
    by_cases hpos : 0 < h x
    · obtain ⟨N, hN⟩ := exists_nat_ge (‖f x‖ / h x)
      exact eventually_atTop.2 ⟨N, fun n hn ↦
        (div_le_iff₀ hpos).1 (hN.trans (by exact_mod_cast hn))⟩
    · have hx := hfx hpos
      exact Eventually.of_forall fun n ↦
        (by rw [hx, norm_zero]; positivity : ‖f x‖ ≤ (n : ℝ) * h x)
  have hnorm := tendsto_norm_lpOneRestrict_zero (𝕜 := 𝕜) f (fun n ↦ (hA n).compl) hv
  apply Metric.tendsto_nhds.2
  intro ε hε
  have he := (Metric.tendsto_nhds.1 hnorm ε hε)
  refine he.mono fun n hn ↦ ?_
  have hm : f - lpOneRestrict (𝕜 := 𝕜) (hA n) f =
      lpOneRestrict (𝕜 := 𝕜) (hA n).compl f :=
    sub_eq_iff_eq_add.2 ((lpOneRestrict_add_compl (𝕜 := 𝕜) (hA n) f).symm.trans
      (add_comm _ _))
  rw [dist_eq_norm, norm_sub_rev, hm]
  simpa only [Real.dist_eq, sub_zero, abs_norm] using hn

theorem lpOneFixedPointCut_domination (h : Lp ℝ 1 μ) (f : Lp E 1 μ) (hh : 0 ≤ h)
    (n : ℕ) :
    ∀ᵐ x ∂μ, ‖lpOneRestrict (𝕜 := 𝕜) (measurableSet_lpOneFixedPointCut h f n) f x‖
      ≤ (n : ℝ) * h x := by
  filter_upwards [(Lp.coeFn_nonneg h).2 hh,
    lpOneRestrict_ae (𝕜 := 𝕜) (measurableSet_lpOneFixedPointCut h f n) f] with x hhn hx
  rw [hx]
  by_cases hc : x ∈ lpOneFixedPointCut h f n
  · rw [indicator_of_mem hc]
    exact hc
  · rw [indicator_of_notMem hc, norm_zero]
    change 0 ≤ h x at hhn
    exact mul_nonneg (by positivity) hhn

omit [NontriviallyNormedField 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E] in
theorem lpOneRestrict_nonneg {A : Set X} (hA : MeasurableSet A) {f : Lp ℝ 1 μ}
    (hf : 0 ≤ f) : 0 ≤ lpOneRestrict (𝕜 := ℝ) hA f := by
  apply (Lp.coeFn_nonneg _).1
  filter_upwards [(Lp.coeFn_nonneg f).2 hf,
    lpOneRestrict_ae (𝕜 := ℝ) hA f] with x hfx hx
  rw [hx]
  by_cases ha : x ∈ A
  · rw [indicator_of_mem ha]
    exact hfx
  · rw [indicator_of_notMem ha]
    exact le_rfl

section PositiveOperator

variable (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ)
  (hP : ∀ f : Lp ℝ 1 μ, 0 ≤ f → 0 ≤ P f)

include hP

theorem lpOne_positive_monotone : Monotone P := by
  intro f g h
  have he := hP (g - f) (sub_nonneg.2 h)
  rw [map_sub] at he
  exact sub_nonneg.1 he

theorem lpOne_positive_pow_monotone (n : ℕ) : Monotone (P ^ n) := by
  induction n with
  | zero =>
    rw [pow_zero]
    exact monotone_id
  | succ n ih =>
    rw [pow_succ']
    exact (lpOne_positive_monotone P hP).comp ih

theorem lpOne_positive_pow_nonneg (n : ℕ) {f : Lp ℝ 1 μ} (hf : 0 ≤ f) : 0 ≤ (P ^ n) f := by
  simpa only [map_zero] using lpOne_positive_pow_monotone P hP n hf

/-- A positive operator preserves the subspace supported by a nonnegative
fixed point, here stated on its positive cone. -/
theorem lpOneRestrict_compl_positive_fixed_support (h : Lp ℝ 1 μ) (hh : 0 ≤ h)
    (hfix : P h = h) (f : Lp ℝ 1 μ) (hf : 0 ≤ f) :
    let A : Set X := {x | 0 < h x}
    let hA : MeasurableSet A :=
      measurableSet_lt measurable_const (Lp.stronglyMeasurable h).measurable
    lpOneRestrict (𝕜 := ℝ) hA.compl (P (lpOneRestrict (𝕜 := ℝ) hA f)) = 0 := by
  dsimp only
  let A : Set X := {x | 0 < h x}
  let hA : MeasurableSet A :=
    measurableSet_lt measurable_const (Lp.stronglyMeasurable h).measurable
  let g := lpOneRestrict (𝕜 := ℝ) hA f
  have hg : 0 ≤ g := lpOneRestrict_nonneg hA hf
  have hz : ∀ᵐ x ∂μ, ¬ 0 < h x → g x = 0 := by
    filter_upwards [lpOneRestrict_ae (𝕜 := ℝ) hA f] with x hx hc
    exact hx.trans (indicator_of_notMem hc _)
  let e (n : ℕ) := lpOneRestrict (𝕜 := ℝ) (measurableSet_lpOneFixedPointCut h g n) g
  have hlim : Tendsto e atTop (𝓝 g) := tendsto_lpOneFixedPointCut h g hh hz
  let Q := (lpOneRestrict (𝕜 := ℝ) hA.compl).comp P
  change Q g = 0
  have hQ (n : ℕ) : Q (e n) = 0 := by
    have hen : 0 ≤ e n := lpOneRestrict_nonneg (measurableSet_lpOneFixedPointCut h g n) hg
    have hge : e n ≤ (n : ℝ) • h := by
      apply (Lp.coeFn_le _ _).1
      filter_upwards [lpOneFixedPointCut_domination (𝕜 := ℝ) h g hh n,
        Lp.coeFn_smul (n : ℝ) h] with x hbound hs
      exact (le_abs_self ((e n) x)).trans (hbound.trans_eq hs.symm)
    have hpBound := lpOne_positive_monotone P hP hge
    rw [map_smul, hfix] at hpBound
    apply Lp.ext
    filter_upwards [(Lp.coeFn_nonneg (P (e n))).2 (hP (e n) hen),
      (Lp.coeFn_le _ _).2 hpBound, Lp.coeFn_smul (n : ℝ) h, Lp.coeFn_zero ℝ 1 μ,
      lpOneRestrict_ae (𝕜 := ℝ) hA.compl (P (e n))] with x hp0 hp hs hz' hq
    change 0 ≤ P (e n) x at hp0
    change P (e n) x ≤ ((n : ℝ) • h) x at hp
    change ((n : ℝ) • h) x = (n : ℝ) * h x at hs
    change lpOneRestrict (𝕜 := ℝ) hA.compl (P (e n)) x = (0 : Lp ℝ 1 μ) x
    rw [hq, hz']
    by_cases hx : x ∈ A
    · exact indicator_of_notMem (by simpa using hx) _
    · rw [indicator_of_mem (mem_compl hx)]
      have hn : h x ≤ 0 := le_of_not_gt hx
      rw [hs] at hp
      exact le_antisymm (hp.trans (mul_nonpos_of_nonneg_of_nonpos (by positivity) hn)) hp0
  have hzero : Tendsto (fun n : ℕ ↦ Q (e n)) atTop (𝓝 (0 : Lp ℝ 1 μ)) :=
    tendsto_const_nhds.congr (fun n ↦ (hQ n).symm)
  exact tendsto_nhds_unique ((Q.continuous.tendsto g).comp hlim) hzero

end PositiveOperator

end JdLG

end

end MonotheticL1SupportDevelopment

/- Source: JdLG/MonotheticL1Mean.lean -/
section MonotheticL1MeanDevelopment

/-! # A positive mean-ergodic contraction loses all mass off its fixed support -/

@[expose] public section

namespace JdLG

open Filter MeasureTheory Set
open scoped ENNReal Topology

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

noncomputable def lpOneCesaro (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ) (f : Lp ℝ 1 μ) (N : ℕ) :
    Lp ℝ 1 μ :=
  (N : ℝ)⁻¹ • ∑ j ∈ Finset.range N, (P ^ j) f

theorem lpOne_positive_apply_pow_norm_le (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ)
    (hP : ‖P‖ ≤ 1) (n : ℕ) (f : Lp ℝ 1 μ) : ‖(P ^ n) f‖ ≤ ‖f‖ := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change ‖P ((P ^ n) f)‖ ≤ ‖f‖
    refine ((P.le_of_opNorm_le hP) _).trans ?_
    simpa only [one_mul] using ih

theorem lpOneCesaro_nonneg (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ)
    (hP : ∀ f : Lp ℝ 1 μ, 0 ≤ f → 0 ≤ P f) {f : Lp ℝ 1 μ} (hf : 0 ≤ f) (n : ℕ) :
    0 ≤ lpOneCesaro P f n := by
  let g := ∑ j ∈ Finset.range n, (P ^ j) f
  have hg : 0 ≤ g := Finset.sum_nonneg fun j _ ↦ lpOne_positive_pow_nonneg P hP j hf
  apply (Lp.coeFn_nonneg _).1
  filter_upwards [(Lp.coeFn_nonneg g).2 hg, Lp.coeFn_smul (n : ℝ)⁻¹ g] with x hp hs
  change 0 ≤ g x at hp
  change ((n : ℝ)⁻¹ • g) x = (n : ℝ)⁻¹ * g x at hs
  change 0 ≤ ((n : ℝ)⁻¹ • g) x
  rw [hs]
  positivity

theorem lpOneCesaro_fixed_limit (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ)
    (hP : ‖P‖ ≤ 1) {f h : Lp ℝ 1 μ} (hlim : Tendsto (lpOneCesaro P f) atTop (𝓝 h)) :
    P h = h := by
  have heq (n : ℕ) : P (lpOneCesaro P f n) - lpOneCesaro P f n =
      (n : ℝ)⁻¹ • ((P ^ n) f - f) := by
    simp only [lpOneCesaro, map_smul, map_sum, ← smul_sub]
    congr 1
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ, Finset.sum_range_succ,
        add_sub_add_comm, ih, pow_succ']
      change (P ^ n) f - f + (P ((P ^ n) f) - (P ^ n) f) = P ((P ^ n) f) - f
      abel
  have hi : Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
  have hv := hi.mul (tendsto_const_nhds (x := ‖f‖ + ‖f‖))
  have hv0 : Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * (‖f‖ + ‖f‖)) atTop (𝓝 0) := by
    simpa only [zero_mul] using hv
  have hz : Tendsto (fun n ↦ P (lpOneCesaro P f n) - lpOneCesaro P f n) atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.2
    refine squeeze_zero (fun _ ↦ norm_nonneg _) (fun n ↦ ?_) hv0
    rw [heq, norm_smul, Real.norm_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left
      ((norm_sub_le _ _).trans (add_le_add_left (lpOne_positive_apply_pow_norm_le P hP n f) _))
      (by positivity)
  have hfinal := tendsto_nhds_unique (((P.continuous.tendsto h).comp hlim).sub hlim) hz
  exact sub_eq_zero.mp hfinal

/-- The norm on nonnegative real L¹ vectors is the integral. -/
theorem norm_realLpOne_eq_integral_of_nonneg {f : Lp ℝ 1 μ} (hf : 0 ≤ f) :
    ‖f‖ = L1.integralCLM f := by
  rw [lpOne_norm_eq_integral_norm, ← L1.integral_eq]
  have hi := memLp_one_iff_integrable.mp (Lp.memLp f)
  have hIntegral : (∫ x, f x ∂μ) = L1.integral f := by
    rw [MeasureTheory.integral_eq (⇑f) hi, Integrable.toL1_coeFn]
  rw [← hIntegral]
  refine integral_congr_ae ?_
  filter_upwards [(Lp.coeFn_nonneg f).2 hf] with x hp
  change 0 ≤ f x at hp
  exact Real.norm_of_nonneg hp

/-- A nonnegative input whose Cesàro averages converge loses all its
off-support mass under the powers of the positive contraction. -/
theorem tendsto_lpOne_away_from_fixed_support
    (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ) (hP : ‖P‖ ≤ 1)
    (hp : ∀ f : Lp ℝ 1 μ, 0 ≤ f → 0 ≤ P f)
    {f h : Lp ℝ 1 μ} (hf : 0 ≤ f) (hlim : Tendsto (lpOneCesaro P f) atTop (𝓝 h)) :
    let A : Set X := {x | 0 < h x}
    let hA : MeasurableSet A :=
      measurableSet_lt measurable_const (Lp.stronglyMeasurable h).measurable
    Tendsto (fun n ↦ ‖lpOneRestrict (𝕜 := ℝ) hA.compl ((P ^ n) f)‖) atTop (𝓝 0) := by
  let A : Set X := {x | 0 < h x}
  let hA : MeasurableSet A :=
    measurableSet_lt measurable_const (Lp.stronglyMeasurable h).measurable
  let R := lpOneRestrict (μ := μ) (E := ℝ) (𝕜 := ℝ) hA.compl
  let m (n : ℕ) := ‖R ((P ^ n) f)‖
  have hclosed : IsClosed (Ici (0 : Lp ℝ 1 μ)) := isClosed_Ici
  have hh : 0 ≤ h := hclosed.mem_of_tendsto hlim
    (Eventually.of_forall fun n ↦ lpOneCesaro_nonneg P hp hf n)
  have hfix := lpOneCesaro_fixed_limit P hP hlim
  have hRh : R h = 0 := by
    apply Lp.ext
    filter_upwards [lpOneRestrict_ae (𝕜 := ℝ) hA.compl h, Lp.coeFn_zero ℝ 1 μ,
      (Lp.coeFn_nonneg h).2 hh] with x he hz hhx
    change R h x = (0 : Lp ℝ 1 μ) x
    rw [he, hz]
    by_cases hx : x ∈ A
    · exact indicator_of_notMem (by simpa using hx) _
    · rw [indicator_of_mem (mem_compl hx)]
      exact le_antisymm (le_of_not_gt hx) hhx
  have hm : Antitone m := by
    apply antitone_nat_of_succ_le
    intro n
    let g := (P ^ n) f
    let Q := lpOneRestrict (μ := μ) (E := ℝ) (𝕜 := ℝ) hA
    have hg : 0 ≤ g := lpOne_positive_pow_nonneg P hp n hf
    have hs : Q g + R g = g := lpOneRestrict_add_compl hA g
    have hvanish : R (P (Q g)) = 0 := lpOneRestrict_compl_positive_fixed_support P hp h hh hfix g hg
    have hsplit : R (P g) = R (P (R g)) := by
      calc
        R (P g) = R (P (Q g + R g)) := congrArg (fun z ↦ R (P z)) hs.symm
        _ = R (P (R g)) := by rw [map_add, map_add, hvanish, zero_add]
    change ‖R ((P ^ (n + 1)) f)‖ ≤ ‖R g‖
    rw [pow_succ']
    change ‖R (P g)‖ ≤ ‖R g‖
    rw [hsplit]
    exact (norm_lpOneRestrict_le hA.compl (P (R g))).trans
      (by simpa only [one_mul] using P.le_of_opNorm_le hP (R g))
  let φ := (L1.integralCLM (μ := μ) (E := ℝ)).comp R
  have hφ (n : ℕ) : m n = φ ((P ^ n) f) :=
    norm_realLpOne_eq_integral_of_nonneg
      (lpOneRestrict_nonneg hA.compl (lpOne_positive_pow_nonneg P hp n hf))
  have hz : φ h = 0 := by
    change L1.integralCLM (R h) = 0
    rw [hRh, map_zero]
  have hl : Tendsto (fun n ↦ φ (lpOneCesaro P f n)) atTop (𝓝 0) := by
    rw [← hz]
    exact (φ.continuous.tendsto h).comp hlim
  change Tendsto m atTop (𝓝 0)
  refine squeeze_zero' (Eventually.of_forall fun _ ↦ norm_nonneg _) ?_ hl
  filter_upwards [eventually_ge_atTop (1 : ℕ)] with n hn
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (Nat.succ_le_iff.mp hn)
  change m n ≤ φ (lpOneCesaro P f n)
  rw [lpOneCesaro, map_smul, map_sum, smul_eq_mul, inv_mul_eq_div]
  rw [le_div_iff₀ hn0, mul_comm]
  calc
    (n : ℝ) * m n = ∑ j ∈ Finset.range n, m n := by simp [nsmul_eq_mul]
    _ ≤ _ := Finset.sum_le_sum fun j hj ↦
      (hm (Finset.mem_range.1 hj).le).trans_eq (hφ j)

end JdLG

end

end MonotheticL1MeanDevelopment

/- Source: JdLG/WeakCompactApproximation.lean -/
section WeakCompactApproximationDevelopment

/-! # Norm approximation by weakly compact subsets -/

@[expose] public section

open NormedSpace Set

namespace JdLG

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]

/-- A set that can be uniformly approximated in norm by weakly compact sets
has compact weak closure. The weak-star bidual gives compact sets containing
the weak-star closure at every scale, so the latter lies in the norm-closed
image of the original Banach space. -/
theorem isCompact_closure_weak_of_approx (A : Set (WeakSpace ℂ E))
    (hA : ∀ ε > 0, ∃ K : Set (WeakSpace ℂ E), IsCompact K ∧
      ∀ x ∈ A, ∃ y ∈ K, ‖(toWeakSpace ℂ E).symm x - (toWeakSpace ℂ E).symm y‖ ≤ ε) :
    IsCompact (closure A) := by
  let D := WeakDual ℂ (StrongDual ℂ E)
  let j := inclusionInDoubleDualWeak ℂ E
  let J := inclusionInDoubleDualLi ℂ (E := E)
  let B (r : ℝ) : Set D := {u | ‖WeakDual.toStrongDual u‖ ≤ r}
  let Z := closure (j '' A)
  let add (u : D × D) := u.1 + u.2
  have hB (r : ℝ) : IsCompact (B r) := by
    have he : B r = WeakDual.toStrongDual ⁻¹' Metric.closedBall
        (0 : StrongDual ℂ (StrongDual ℂ E)) r := by
      ext u
      change ‖WeakDual.toStrongDual u‖ ≤ r ↔
        WeakDual.toStrongDual u ∈ Metric.closedBall (0 : StrongDual ℂ (StrongDual ℂ E)) r
      exact (mem_closedBall_zero_iff (a := WeakDual.toStrongDual u) (r := r)).symm
    rw [he]
    exact WeakDual.isCompact_closedBall (0 : StrongDual ℂ (StrongDual ℂ E)) r
  have hj (w : WeakSpace ℂ E) : WeakDual.toStrongDual (j w) = J ((toWeakSpace ℂ E).symm w) :=
    rfl
  have hsum (r : ℝ) (hr : 0 < r) : ∃ K : Set (WeakSpace ℂ E), IsCompact K ∧
      Z ⊆ add '' ((j '' K) ×ˢ B r) := by
    obtain ⟨K, hK, hnear⟩ := hA r hr
    refine ⟨K, hK, closure_minimal ?_ ?_⟩
    · rintro _ ⟨x, hx, rfl⟩
      obtain ⟨y, hy, hxy⟩ := hnear x hx
      refine ⟨(j y, j x - j y), ⟨⟨y, hy, rfl⟩, ?_⟩, ?_⟩
      · change ‖WeakDual.toStrongDual (j x - j y)‖ ≤ r
        rw [← map_sub j, hj, J.norm_map, map_sub]
        exact hxy
