  let : FiniteDimensional 𝕜 W := hJW ▸ inferInstanceAs (FiniteDimensional 𝕜 J.range)
  let : FiniteDimensional 𝕜 V :=
    FiniteDimensional.of_injective _ (Submodule.inclusion_injective hVW)
