/- Source: JdLG/RepresentationNormGroup.lean -/
section RepresentationNormGroupDevelopment

/-! # Uniformly bounded subgroups in the operator norm -/

@[expose] public section

open Topology

namespace JdLG

variable {R : Type*} [NormedRing R] (G : Subgroup Rˣ)

/-- The embedding of a subgroup of units into its ambient normed ring. -/
def boundedUnitsInclusion (g : G) : R := ↑(g : Rˣ)

/-- Inversion on a uniformly bounded subgroup of units is norm Lipschitz.
This applies to subgroups of the invertible bounded linear operators. -/
theorem norm_sub_of_boundedUnits_inv_le {C : ℝ} (hC : ∀ g : G, ‖boundedUnitsInclusion G g‖ ≤ C)
    (x y : G) :
    ‖boundedUnitsInclusion G x⁻¹ - boundedUnitsInclusion G y⁻¹‖ ≤
      C ^ 2 * ‖boundedUnitsInclusion G x - boundedUnitsInclusion G y‖ := by
  let a := boundedUnitsInclusion G x
  let b := boundedUnitsInclusion G y
  let ia := boundedUnitsInclusion G x⁻¹
  let ib := boundedUnitsInclusion G y⁻¹
  have hia : ‖ia‖ ≤ C := hC x⁻¹
  have hib : ‖ib‖ ≤ C := hC y⁻¹
  have hC₀ : 0 ≤ C := (norm_nonneg _).trans hia
  have ha : ia * a = 1 := Units.inv_mul (x : Rˣ)
  have hb : b * ib = 1 := Units.mul_inv (y : Rˣ)
  change ‖ia - ib‖ ≤ C ^ 2 * ‖a - b‖
  have he : ia * (b - a) * ib = ia - ib := by
    rw [mul_sub, sub_mul, mul_assoc ia b, hb, ha, mul_one, one_mul]
  rw [← he, ← norm_sub_rev]
  calc
    ‖ia * (b - a) * ib‖ ≤ ‖ia * (b - a)‖ * ‖ib‖ := norm_mul_le _ _
    _ ≤ ‖ia‖ * ‖b - a‖ * ‖ib‖ :=
      mul_le_mul_of_nonneg_right (norm_mul_le _ _) (norm_nonneg _)
    _ ≤ C * ‖b - a‖ * C :=
      mul_le_mul (mul_le_mul_of_nonneg_right hia (norm_nonneg _)) hib (norm_nonneg _)
        (mul_nonneg hC₀ (norm_nonneg _))
    _ = C ^ 2 * ‖b - a‖ := by ring

/-- With the topology inherited from the ambient norm on the operators, a
uniformly bounded subgroup of invertible operators is a topological group. -/
theorem isTopologicalGroup_boundedUnits_induced {C : ℝ}
    (hC : ∀ g : G, ‖boundedUnitsInclusion G g‖ ≤ C) :
    @IsTopologicalGroup G (TopologicalSpace.induced (boundedUnitsInclusion G) inferInstance)
      inferInstance := by
  let : PseudoMetricSpace G := .induced (boundedUnitsInclusion G) inferInstance
  let : TopologicalSpace G := TopologicalSpace.induced (boundedUnitsInclusion G) inferInstance
  have hc : Continuous (boundedUnitsInclusion G) := continuous_induced_dom
  have hinv : LipschitzWith ⟨C ^ 2, sq_nonneg C⟩
      (fun g : G ↦ boundedUnitsInclusion G g⁻¹) := by
    apply LipschitzWith.of_dist_le_mul
    intro x y
    change dist (boundedUnitsInclusion G x⁻¹) (boundedUnitsInclusion G y⁻¹) ≤
      C ^ 2 * dist (boundedUnitsInclusion G x) (boundedUnitsInclusion G y)
    simpa only [dist_eq_norm] using norm_sub_of_boundedUnits_inv_le G hC x y
  exact {
    continuous_mul := continuous_induced_rng.2
      ((hc.comp continuous_fst).mul (hc.comp continuous_snd))
    continuous_inv := continuous_induced_rng.2 hinv.continuous }

end JdLG

end

end RepresentationNormGroupDevelopment

/- Source: JdLG/RepresentationUnitaryContinuity.lean -/
section RepresentationUnitaryContinuityDevelopment

/-! # Strong continuity of weakly continuous unitary representations -/

@[expose] public section

open Filter
open scoped Topology

namespace JdLG

variable {X H : Type*} [TopologicalSpace X] [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Weak continuity of a Hilbert-space valued map with constant norm implies
norm continuity. Control of the real part of the inner product with the
value at the base point controls the square of the norm distance. -/
theorem continuous_of_weaklyContinuous_of_constant_norm (u : X → H) (c : ℝ)
    (hnorm : ∀ x, ‖u x‖ = c) (hweak : ∀ f : StrongDual ℂ H, Continuous fun x ↦ f (u x)) :
    Continuous u := by
  apply continuous_iff_continuousAt.2
  intro y
  apply tendsto_iff_dist_tendsto_zero.2
  let N (x : X) : ℝ := c ^ 2 - 2 * (inner ℂ (u y) (u x)).re + c ^ 2
  have hN : Continuous N := by
    have hi := Complex.continuous_re.comp (hweak (innerSL ℂ (u y)))
    exact (continuous_const.sub (continuous_const.mul hi)).add continuous_const
  have hEq (x : X) : dist (u x) (u y) = Real.sqrt (N x) := by
    rw [dist_eq_norm, norm_sub_rev, ← Real.sqrt_sq (norm_nonneg (u y - u x))]
    congr 1
    have he := norm_sub_sq (𝕜 := ℂ) (u y) (u x)
    rwa [hnorm y, hnorm x] at he
  have hd : Continuous (fun x ↦ dist (u x) (u y)) :=
    (Real.continuous_sqrt.comp hN).congr fun x ↦ (hEq x).symm
  have ht : Tendsto (fun x ↦ dist (u x) (u y)) (𝓝 y) (𝓝 (dist (u y) (u y))) :=
    hd.continuousAt
  rwa [dist_self] at ht

/-- A weakly continuous family of unitary operators is strongly continuous,
in particular for a unitary representation as in §2.4. -/
theorem continuous_orbit_of_weaklyContinuous_unitary
    (U : X → H ≃ₗᵢ[ℂ] H)
    (hU : Continuous fun x ↦
      ContinuousLinearMapWOT.ofCLM (U x).toContinuousLinearEquiv.toContinuousLinearMap)
    (v : H) : Continuous (fun x ↦ U x v) :=
  continuous_of_weaklyContinuous_of_constant_norm (fun x ↦ U x v) ‖v‖
    (fun x ↦ (U x).norm_map v)
    (fun f ↦ (ContinuousLinearMapWOT.continuous_dual_apply v f).comp hU)

end JdLG

end

end RepresentationUnitaryContinuityDevelopment

