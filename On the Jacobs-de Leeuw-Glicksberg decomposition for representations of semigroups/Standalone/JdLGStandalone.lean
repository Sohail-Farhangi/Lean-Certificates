/-!
# Binary rigidity phases for a lacunary sequence

Successive rounding to finer grids gives an injective family of
rigidity phases. The same error bound works for every binary input.
-/

@[expose] public section

namespace JdLG.PaperExamplesRigid

open Filter
open scoped Topology

/-- The integer corresponding to a binary digit. -/
def binaryDigit (b : Bool) : ℤ := if b then 1 else 0

theorem binaryDigit_injective : Function.Injective binaryDigit := by
  intro a b h
  cases a <;> cases b <;> simp_all [binaryDigit]

/-- The integer digit lies between zero and one after casting to the reals. -/
theorem cast_binaryDigit_bounds (b : Bool) :
    0 ≤ (binaryDigit b : ℝ) ∧ (binaryDigit b : ℝ) ≤ 1 := by
  cases b <;> norm_num [binaryDigit]

/-- Integer numerators obtained by rounding to the next grid and choosing a
binary offset at each stage. -/
noncomputable def gridNumerator (r : ℕ → ℝ) (b : ℕ → Bool) : ℕ → ℤ
  | 0 => binaryDigit (b 0)
  | n + 1 => ⌊r (n + 1) * ((gridNumerator r b n : ℝ) / r n)⌋ +
      binaryDigit (b (n + 1))

/-- The successive quotients on the grids with spacing `1 / r n`. -/
noncomputable def gridApproximation (r : ℕ → ℝ) (b : ℕ → Bool) (n : ℕ) : ℝ :=
  (gridNumerator r b n : ℝ) / r n

private theorem gridApproximation_step (r : ℕ → ℝ) (hr : ∀ n, 0 < r n)
    (b : ℕ → Bool) (n : ℕ) :
    dist (gridApproximation r b n) (gridApproximation r b (n + 1)) ≤ 1 / r (n + 1) := by
  let x := r (n + 1) * gridApproximation r b n
  have h₁ : ((⌊x⌋ : ℤ) : ℝ) ≤ x := Int.floor_le _
  have h₂ : x - 1 ≤ ((⌊x⌋ : ℤ) : ℝ) := (Int.sub_one_lt_floor _).le
  have h₃ := cast_binaryDigit_bounds (b (n + 1))
  have heq : gridApproximation r b (n + 1) =
      (((⌊x⌋ : ℤ) : ℝ) + (binaryDigit (b (n + 1)) : ℝ)) / r (n + 1) := by
    simp only [gridApproximation, gridNumerator, Int.cast_add, x]
  rw [Real.dist_eq, abs_le, heq, le_div_iff₀ (hr _)]
  constructor
  · have hp : -(1 : ℝ) / r (n + 1) ≤ gridApproximation r b n -
        (((⌊x⌋ : ℤ) : ℝ) + (binaryDigit (b (n + 1)) : ℝ)) / r (n + 1) := by
      rw [show gridApproximation r b n = x / r (n + 1) by
        dsimp [x]
        rw [mul_div_cancel_left₀ _ (hr _).ne'], ← sub_div, div_le_div_iff_of_pos_right (hr _)]
      linarith
    simpa only [neg_div] using hp
  · rw [show gridApproximation r b n = x / r (n + 1) by
      dsimp [x]
      rw [mul_div_cancel_left₀ _ (hr _).ne'], ← sub_div, div_mul_cancel₀ _ (hr _).ne']
    linarith

private theorem grid_growth (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (m j : ℕ) : r m * 2 ^ j ≤ r (m + j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    rw [pow_succ, ← mul_assoc, Nat.add_succ]
    exact (mul_le_mul_of_nonneg_right ih (by norm_num)).trans
      ((show r (m + j) * 2 ≤ 8 * r (m + j) by linarith [hr (m + j)]).trans (hg (m + j)))

private theorem grid_geometric_step (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) (m j : ℕ) :
    dist (gridApproximation r b (j + m)) (gridApproximation r b (j + 1 + m)) ≤
      (2 / r (m + 1)) / 2 / 2 ^ j := by
  rw [show j + 1 + m = j + m + 1 by omega]
  apply (gridApproximation_step r hr b (j + m)).trans
  have hgr : r (m + 1) * 2 ^ j ≤ r (j + m + 1) := by
    rw [show j + m + 1 = m + 1 + j by omega]
    exact grid_growth r hg hr (m + 1) j
  calc
    1 / r (j + m + 1) ≤ 1 / (r (m + 1) * 2 ^ j) :=
      one_div_le_one_div_of_le (mul_pos (hr _) (by positivity)) hgr
    _ = _ := by
      have h : r (m + 1) ≠ 0 := (hr _).ne'
      field_simp

/-- Each sequence of grid approximations has a real limit. -/
theorem exists_grid_limit (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) :
    ∃ x, Tendsto (gridApproximation r b) atTop (𝓝 x) := by
  apply cauchySeq_tendsto_of_complete
  apply cauchySeq_of_le_geometric_two (C := 2 / r 1)
  intro j
  simpa only [add_zero, zero_add] using grid_geometric_step r hg hr b 0 j

/-- The real phase encoded by a binary input. -/
noncomputable def rigidityPhase (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) : ℝ :=
  (exists_grid_limit r hg hr b).choose

theorem rigidityPhase_limit (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) :
    Tendsto (gridApproximation r b) atTop (𝓝 (rigidityPhase r hg hr b)) :=
  (exists_grid_limit r hg hr b).choose_spec

theorem rigidityPhase_distance (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) (n : ℕ) :
    dist (gridApproximation r b n) (rigidityPhase r hg hr b) ≤ 2 / r (n + 1) := by
  have ht := (rigidityPhase_limit r hg hr b).comp (tendsto_add_atTop_nat n)
  simpa only [zero_add] using dist_le_of_le_geometric_two_of_tendsto₀
    (C := 2 / r (n + 1)) (grid_geometric_step r hg hr b n) ht

/-- Each binary phase is uniformly close to an integer when multiplied by
the grid denominators. -/
theorem rigidityPhase_error (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) (n : ℕ) :
    |r n * rigidityPhase r hg hr b - (gridNumerator r b n : ℝ)| ≤ 2 * r n / r (n + 1) := by
  have hd := rigidityPhase_distance r hg hr b n
  rw [dist_comm, Real.dist_eq] at hd
  have heq : r n * gridApproximation r b n = (gridNumerator r b n : ℝ) := by
    rw [gridApproximation, mul_div_cancel₀ _ (hr n).ne']
  calc
    _ = r n * |rigidityPhase r hg hr b - gridApproximation r b n| := by
      rw [← heq, ← mul_sub, abs_mul, abs_of_pos (hr n)]
    _ ≤ r n * (2 / r (n + 1)) := mul_le_mul_of_nonneg_left hd (hr n).le
    _ = _ := by rw [← mul_div_assoc, mul_comm (r n) 2]

/-- For diverging successive ratios the phase discrepancy converges to zero. -/
theorem rigidityPhase_scaled_tendsto_integer (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n)
    (hRatio : Tendsto (fun n ↦ r (n + 1) / r n) atTop atTop) (b : ℕ → Bool) :
    Tendsto (fun n ↦ r n * rigidityPhase r hg hr b - (gridNumerator r b n : ℝ)) atTop (𝓝 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.2
  have hu : Tendsto (fun n ↦ 2 / (r (n + 1) / r n)) atTop (𝓝 (0 : ℝ)) :=
    tendsto_const_nhds.div_atTop hRatio
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hu
  · exact Eventually.of_forall fun _ ↦ norm_nonneg _
  · refine Eventually.of_forall fun n ↦ ?_
    rw [Real.norm_eq_abs, div_div_eq_mul_div]
    exact rigidityPhase_error r hg hr b n

/-- Two binary inputs cannot encode the same phase. Their grid numerators are
uniquely determined by the common phase, and recover the binary offsets. -/
theorem rigidityPhase_injective (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) : Function.Injective (rigidityPhase r hg hr) := by
  intro b c h
  have hnum (n : ℕ) : gridNumerator r b n = gridNumerator r c n := by
    let x := r n * rigidityPhase r hg hr b
    have hb := rigidityPhase_error r hg hr b n
    have hc := rigidityPhase_error r hg hr c n
    rw [← h] at hc
    have hdiff : |(gridNumerator r b n : ℝ) - (gridNumerator r c n : ℝ)| ≤ (1 / 2 : ℝ) := calc
      _ = |(x - (gridNumerator r c n : ℝ)) - (x - (gridNumerator r b n : ℝ))| := by
        congr 1
        ring
      _ ≤ |x - (gridNumerator r c n : ℝ)| + |x - (gridNumerator r b n : ℝ)| := abs_sub _ _
      _ ≤ 2 * (2 * r n / r (n + 1)) := by
        dsimp [x]
        linarith
      _ ≤ _ := by
        rw [← mul_div_assoc, div_le_iff₀ (hr _)]
        linarith [hg n]
    obtain ⟨hlo, hhi⟩ := abs_le.1 hdiff
    have hlt : gridNumerator r b n < gridNumerator r c n + 1 := by
      exact_mod_cast (show (gridNumerator r b n : ℝ) < (gridNumerator r c n : ℝ) + 1 by linarith)
    have hgt : gridNumerator r c n < gridNumerator r b n + 1 := by
      exact_mod_cast (show (gridNumerator r c n : ℝ) < (gridNumerator r b n : ℝ) + 1 by linarith)
    omega
  funext n
  apply binaryDigit_injective
  cases n with
  | zero => exact hnum 0
  | succ n =>
    have hs := hnum (n + 1)
    simp only [gridNumerator, hnum n] at hs
    omega

end JdLG.PaperExamplesRigid

end

end PaperExamplesRigidityPhasesDevelopment

/- Source: JdLG/PaperExamplesRigidityCircle.lean -/
section PaperExamplesRigidityCircleDevelopment

/-!
# Continuous circle-valued rigidity phases

The binary phases yield a continuous injective circle-valued map
whose powers converge uniformly to one along the given lacunary tail.
-/

@[expose] public section

namespace JdLG.PaperExamplesRigid

open Filter
open scoped Topology

theorem continuous_gridNumerator (r : ℕ → ℝ) (n : ℕ) :
    Continuous (fun b : ℕ → Bool ↦ gridNumerator r b n) := by
  induction n with
  | zero =>
    exact (show Continuous binaryDigit from continuous_of_discreteTopology).comp
      (continuous_apply 0)
  | succ n ih =>
    let step (v : ℤ × Bool) : ℤ := ⌊r (n + 1) * ((v.1 : ℝ) / r n)⌋ + binaryDigit v.2
    have hstep : Continuous step := continuous_of_discreteTopology
    exact hstep.comp (ih.prodMk (continuous_apply (n + 1)))

theorem continuous_gridApproximation (r : ℕ → ℝ) (n : ℕ) :
    Continuous (fun b : ℕ → Bool ↦ gridApproximation r b n) := by
  have hcast : Continuous (Int.cast : ℤ → ℝ) := continuous_of_discreteTopology
  exact (hcast.comp (continuous_gridNumerator r n)).div_const _

theorem growth_tendsto_atTop (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) : Tendsto r atTop atTop := by
  have hl : ∀ n : ℕ, r 0 * 2 ^ n ≤ r n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ← mul_assoc]
      exact (mul_le_mul_of_nonneg_right ih (by norm_num)).trans
        ((show r n * 2 ≤ 8 * r n by linarith [hr n]).trans (hg n))
  exact tendsto_atTop_mono hl (Tendsto.const_mul_atTop (hr 0)
    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)))

theorem continuous_rigidityPhase (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) : Continuous (rigidityPhase r hg hr) := by
  have hu : TendstoUniformly (fun n b ↦ gridApproximation r b n) (rigidityPhase r hg hr)
      atTop := by
    apply Metric.tendstoUniformly_iff.2
    intro ε hε
    have ht : Tendsto (fun n : ℕ ↦ 2 / r (n + 1)) atTop (𝓝 (0 : ℝ)) :=
      tendsto_const_nhds.div_atTop ((growth_tendsto_atTop r hg hr).comp (tendsto_add_atTop_nat 1))
    filter_upwards [(tendsto_order.1 ht).2 ε hε] with n hn b
    rw [dist_comm]
    exact (rigidityPhase_distance r hg hr b n).trans_lt hn
  exact hu.continuous (Frequently.of_forall (continuous_gridApproximation r))

/-- The Fourier phase corresponding to a binary sequence. -/
noncomputable def circlePhase (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (b : ℕ → Bool) : Circle :=
  Real.fourierChar (rigidityPhase r hg hr b)

theorem continuous_circlePhase (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) : Continuous (circlePhase r hg hr) :=
  Real.continuous_fourierChar.comp (continuous_rigidityPhase r hg hr)

private theorem rigidityPhase_bounded (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (h₀ : 4 ≤ r 0) (b : ℕ → Bool) :
    |rigidityPhase r hg hr b| ≤ 1 / 3 := by
  have hg₀ : 32 ≤ r 1 := by linarith [hg 0]
  have hu : 2 / r 1 ≤ 1 / 16 := by
    apply (div_le_iff₀ (hr 1)).2
    linarith
  have hd := rigidityPhase_distance r hg hr b 0
  rw [dist_comm, Real.dist_eq] at hd
  have h₁ : |gridApproximation r b 0| ≤ 1 / 4 := by
    simp only [gridApproximation, gridNumerator, abs_div]
    rw [abs_of_pos (hr 0), abs_of_nonneg (cast_binaryDigit_bounds (b 0)).1,
      div_le_iff₀ (hr 0)]
    linarith [(cast_binaryDigit_bounds (b 0)).2]
  have hsum := abs_sub (rigidityPhase r hg hr b - gridApproximation r b 0)
    (-gridApproximation r b 0)
  rw [sub_neg_eq_add, sub_add_cancel, abs_neg] at hsum
  linarith

theorem circlePhase_injective (r : ℕ → ℝ) (hg : ∀ n, 8 * r n ≤ r (n + 1))
    (hr : ∀ n, 0 < r n) (h₀ : 4 ≤ r 0) : Function.Injective (circlePhase r hg hr) := by
  intro b c hbc
  have hm (x : ℕ → Bool) :
      2 * Real.pi * rigidityPhase r hg hr x ∈ Set.Ioc (-Real.pi) Real.pi := by
    obtain ⟨hl, hu⟩ := abs_le.1 (rigidityPhase_bounded r hg hr h₀ x)
    constructor <;> nlinarith [Real.pi_pos]
  have hi : Set.InjOn Circle.exp (Set.Ioc (-Real.pi) Real.pi) :=
    Circle.exp_injOn_Ioc (by linarith)
  have heq := hi (hm b) (hm c) hbc
  apply rigidityPhase_injective r hg hr
  exact (mul_left_cancel₀ (by positivity : (2 : ℝ) * Real.pi ≠ 0)) heq

private theorem fourierChar_sub_int (x : ℝ) (m : ℤ) :
    Real.fourierChar (x - (m : ℝ)) = Real.fourierChar x := by
  rw [Real.fourierChar_apply', Real.fourierChar_apply', mul_sub, Circle.exp_sub,
    Circle.exp_two_pi_mul_int, div_one]

/-- The powers of the circle phase converge to one uniformly on the binary
parameter space. -/
theorem circlePhase_uniform_rigidity (q : ℕ → ℕ)
    (hg : ∀ n, 8 * (q n : ℝ) ≤ (q (n + 1) : ℝ))
    (hp : ∀ n, 0 < (q n : ℝ))
    (hRatio : Tendsto (fun n ↦ (q (n + 1) : ℝ) / (q n : ℝ)) atTop atTop) :
    TendstoUniformly (fun n b ↦ circlePhase (fun j ↦ (q j : ℝ)) hg hp b ^ q n)
      (fun _ ↦ (1 : Circle)) atTop := by
  let r := fun n ↦ (q n : ℝ)
  refine Metric.tendstoUniformly_iff.2 fun ε hε ↦ ?_
  have hc := Real.continuous_fourierChar.continuousAt (x := (0 : ℝ))
  obtain ⟨δ, hδ, hnear⟩ := Metric.continuousAt_iff.1 hc ε hε
  have hu : Tendsto (fun n ↦ (2 : ℝ) / (r (n + 1) / r n)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop hRatio
  filter_upwards [(tendsto_order.1 hu).2 δ hδ] with n hn b
  let d := r n * rigidityPhase r hg hp b - (gridNumerator r b n : ℝ)
  have hd : dist d 0 < δ := by
    rw [Real.dist_eq, sub_zero]
    rw [div_div_eq_mul_div] at hn
    exact (rigidityPhase_error r hg hp b n).trans_lt hn
  have hmul : Real.fourierChar d = circlePhase r hg hp b ^ q n := by
    rw [show d = r n * rigidityPhase r hg hp b - (gridNumerator r b n : ℝ) from rfl,
      fourierChar_sub_int, circlePhase, ← AddChar.map_nsmul_eq_pow, nsmul_eq_mul]
  have hnear' := hnear hd
  rw [hmul, AddChar.map_zero_eq_one, dist_comm] at hnear'
  exact hnear'

end JdLG.PaperExamplesRigid

end

end PaperExamplesRigidityCircleDevelopment

/- Source: JdLG/PaperExamplesRigidityMultiplier.lean -/
section PaperExamplesRigidityMultiplierDevelopment

/-!
# Unitary multiplication by a circle-valued function

Uniform rigidity of the multiplier implies strong rigidity on the entire
Hilbert space. An injective multiplier on a space with null singletons
gives a generator with no nonzero eigenvectors.
-/

@[expose] public section

namespace JdLG.PaperExamplesRigid

open Filter MeasureTheory
open scoped Topology ENNReal

noncomputable instance : MeasurableSpace Circle := borel _

instance : BorelSpace Circle := ⟨rfl⟩

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

local notation "H" => Lp ℂ 2 μ

/-- An integer power of a measurable circle-valued function is measurable. -/
theorem measurable_circle_zpow {u : Ω → Circle} (hu : Measurable u) (n : ℤ) :
    Measurable (fun a ↦ u a ^ n) :=
  ((continuous_id (X := Circle)).zpow n).measurable.comp hu

theorem memLp_mul_circle (u : Ω → Circle) (hu : Measurable u) (x : H) :
    MemLp (fun a ↦ (u a : ℂ) * x a) 2 μ := by
  have hc : Continuous (fun z : Circle ↦ (z : ℂ)) := continuous_subtype_val
  have hmeas : Measurable (fun a ↦ (u a : ℂ)) := hc.measurable.comp hu
  refine (Lp.memLp x).norm.mono' (hmeas.aestronglyMeasurable.mul (Lp.aestronglyMeasurable x)) ?_
  exact Eventually.of_forall fun _ ↦ by rw [norm_mul, Circle.norm_coe, one_mul]

/-- The pointwise product of a unit-circle valued function with an `L²` vector. -/
noncomputable def circleMulVector (u : Ω → Circle) (hu : Measurable u) (x : H) : H :=
  (memLp_mul_circle u hu x).toLp _

theorem circleMulVector_ae (u : Ω → Circle) (hu : Measurable u) (x : H) :
    circleMulVector u hu x =ᵐ[μ] fun a ↦ (u a : ℂ) * x a :=
  (memLp_mul_circle u hu x).coeFn_toLp

/-- Multiplication by a measurable circle-valued function is unitary. -/
noncomputable def circleMulUnitary (u : Ω → Circle) (hu : Measurable u) : H ≃ₗᵢ[ℂ] H where
  toFun := circleMulVector u hu
  invFun := circleMulVector (fun a ↦ (u a)⁻¹) hu.inv
  left_inv x := Lp.ext (by
    filter_upwards [circleMulVector_ae u hu x,
      circleMulVector_ae (fun a ↦ (u a)⁻¹) hu.inv (circleMulVector u hu x)] with a ha hb
    rw [hb, ha, ← mul_assoc, ← Circle.coe_mul, inv_mul_cancel, Circle.coe_one, one_mul])
  right_inv x := Lp.ext (by
    filter_upwards [circleMulVector_ae (fun a ↦ (u a)⁻¹) hu.inv x,
      circleMulVector_ae u hu (circleMulVector (fun a ↦ (u a)⁻¹) hu.inv x)] with a ha hb
    rw [hb, ha, ← mul_assoc, ← Circle.coe_mul, mul_inv_cancel, Circle.coe_one, one_mul])
  map_add' x y := Lp.ext (by
    filter_upwards [circleMulVector_ae u hu x, circleMulVector_ae u hu y,
      circleMulVector_ae u hu (x + y), Lp.coeFn_add x y,
      Lp.coeFn_add (circleMulVector u hu x) (circleMulVector u hu y)] with a hx hy hz hxy hsum
    rw [hz, hxy, hsum]
    simp only [Pi.add_apply, hx, hy, mul_add])
  map_smul' z x := Lp.ext (by
    filter_upwards [circleMulVector_ae u hu x, circleMulVector_ae u hu (z • x),
      Lp.coeFn_smul z x, Lp.coeFn_smul z (circleMulVector u hu x)] with a h₁ h₂ h₃ h₄
    change circleMulVector u hu (z • x) a = (z • circleMulVector u hu x) a
    rw [h₂, h₃, h₄]
    simp only [Pi.smul_apply, h₁, smul_eq_mul]
    ring)
  norm_map' x := by
    change ‖circleMulVector u hu x‖ = ‖x‖
    have hn : ∀ᵐ a ∂μ, ‖circleMulVector u hu x a‖ = ‖x a‖ :=
      (circleMulVector_ae u hu x).mono fun _ h ↦ by rw [h, norm_mul, Circle.norm_coe, one_mul]
    exact le_antisymm (Lp.norm_le_norm_of_ae_le (hn.mono fun _ h ↦ h.le))
      (Lp.norm_le_norm_of_ae_le (hn.mono fun _ h ↦ h.ge))

/-- The unitary integer action by the integer powers of a circle multiplier. -/
noncomputable def circleMulRepresentation (u : Ω → Circle) (hu : Measurable u) :
    Multiplicative ℤ →* (H ≃ₗᵢ[ℂ] H) where
  toFun n := circleMulUnitary (fun a ↦ u a ^ n.toAdd) (measurable_circle_zpow hu _)
  map_one' := by
    apply LinearIsometryEquiv.ext
    intro x
    apply Lp.ext
    change circleMulVector (fun _ : Ω ↦ (1 : Circle)) measurable_const x =ᵐ[μ] x
    simpa only [Circle.coe_one, one_mul] using
      circleMulVector_ae (fun _ : Ω ↦ (1 : Circle)) measurable_const x
  map_mul' n m := by
    apply LinearIsometryEquiv.ext
    intro x
    apply Lp.ext
    let y := circleMulVector (fun a ↦ u a ^ m.toAdd) (measurable_circle_zpow hu _) x
    change circleMulVector (fun a ↦ u a ^ (n.toAdd + m.toAdd)) (measurable_circle_zpow hu _) x
      =ᵐ[μ] circleMulVector (fun a ↦ u a ^ n.toAdd) (measurable_circle_zpow hu _) y
    filter_upwards [circleMulVector_ae (fun a ↦ u a ^ (n.toAdd + m.toAdd))
      (measurable_circle_zpow hu _) x, circleMulVector_ae (fun a ↦ u a ^ n.toAdd)
      (measurable_circle_zpow hu _) y, circleMulVector_ae (fun a ↦ u a ^ m.toAdd)
      (measurable_circle_zpow hu _) x] with a h₁ h₂ h₃
    rw [h₁, h₂]
    change _ = _ * circleMulVector (fun a ↦ u a ^ m.toAdd) (measurable_circle_zpow hu _) x a
    rw [h₃, zpow_add, Circle.coe_mul, mul_assoc]

theorem circleMulRepresentation_ae (u : Ω → Circle) (hu : Measurable u) (n : ℤ) (x : H) :
    circleMulRepresentation u hu (Multiplicative.ofAdd n) x =ᵐ[μ]
      fun a ↦ ((u a ^ n : Circle) : ℂ) * x a :=
  circleMulVector_ae (fun a ↦ u a ^ n) (measurable_circle_zpow hu n) x

/-- A uniformly rigid circle multiplier acts strongly rigidly on all vectors. -/
theorem circleMulRepresentation_strongly_rigid (u : Ω → Circle) (hu : Measurable u)
    (q : ℕ → ℕ) (hq : TendstoUniformly (fun n a ↦ u a ^ q n) (fun _ ↦ (1 : Circle)) atTop)
    (x : H) : Tendsto (fun n ↦ circleMulRepresentation u hu (Multiplicative.ofAdd (q n : ℤ)) x)
      atTop (𝓝 x) := by
  apply Metric.tendsto_nhds.2
  intro ε hε
  let δ := ε / (‖x‖ + 1)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  filter_upwards [Metric.tendstoUniformly_iff.1 hq δ hδ] with n hn
  let y := circleMulRepresentation u hu (Multiplicative.ofAdd (q n : ℤ)) x
  change dist y x < ε
  rw [dist_eq_norm]
  have hbound : ‖y - x‖ ≤ δ * ‖x‖ := by
    apply Lp.norm_le_mul_norm_of_ae_le_mul
    filter_upwards [Lp.coeFn_sub y x, circleMulRepresentation_ae u hu (q n : ℤ) x] with a ha hb
    rw [ha]
    simp only [Pi.sub_apply]
    rw [hb, show ((u a ^ (q n : ℤ) : Circle) : ℂ) * x a - x a =
      (((u a ^ (q n : ℤ) : Circle) : ℂ) - 1) * x a by ring, norm_mul]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    have hd := hn a
    change dist (1 : ℂ) (((u a ^ q n : Circle) : ℂ)) < δ at hd
    rw [dist_comm, dist_eq_norm] at hd
    simpa only [zpow_natCast] using hd.le
  have heq : δ * (‖x‖ + 1) = ε := div_mul_cancel₀ _ (by positivity)
  linarith

/-- An injective circle multiplier with null singleton fibers has no nonzero
eigenvectors in its Hilbert space. -/
theorem circleMulRepresentation_no_eigenvectors [NullSingletonClass μ]
    (u : Ω → Circle) (hu : Measurable u) (hi : Function.Injective u)
    (c : ℂ) (x : H)
    (h : circleMulRepresentation u hu (Multiplicative.ofAdd 1) x = c • x) :
    x = 0 := by
  have hS : {a | (u a : ℂ) = c}.Subsingleton :=
    fun a ha b hb ↦ hi (Subtype.ext (ha.trans hb.symm))
  have hne : ∀ᵐ a ∂μ, (u a : ℂ) ≠ c := ae_iff.2 (by simpa using hS.measure_zero μ)
  apply Lp.ext
  filter_upwards [circleMulRepresentation_ae u hu 1 x, Lp.coeFn_smul c x, hne,
    (Lp.coeFn_zero (E := ℂ) (p := 2) (μ := μ))] with a ha hb hd hzero
  rw [h] at ha
  change (c • x : H) a = _ at ha
  rw [hb, Pi.smul_apply, smul_eq_mul, zpow_one] at ha
  have hmul : ((u a : ℂ) - c) * x a = 0 := by rw [sub_mul, ← ha, sub_self]
  rw [hzero]
  exact (mul_eq_zero.1 hmul).resolve_left (sub_ne_zero.2 hd)

