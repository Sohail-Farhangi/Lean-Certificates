/- Source: JdLG/HilbertCompactness.lean -/
section HilbertCompactnessDevelopment

/-!
# Weak operator compactness for Hilbert-space contractions

Transport Banach–Alaoglu through the Riesz isometry for the vector balls.
The product of the vector balls is compact, and the equations for a
linear operator cut out a closed subset.
-/

@[expose] public section

open Set
open scoped ComplexConjugate Topology

namespace JdLG

section HilbertBalls

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

theorem isCompact_weakHilbert_ball (r : ℝ) :
    IsCompact {u : WeakSpace ℂ E | ‖(toWeakSpace ℂ E).symm u‖ ≤ r} := by
  let R := InnerProductSpace.toDual ℂ E
  let inverse (f : WeakDual ℂ E) : WeakSpace ℂ E :=
    toWeakSpace ℂ E (R.symm (WeakDual.toStrongDual f))
  have hcont : Continuous inverse := by
    apply WeakBilin.continuous_of_continuous_eval
    intro y
    let v := R.symm y
    have h (f : WeakDual ℂ E) : y (R.symm (WeakDual.toStrongDual f)) = conj (f v) := by
      calc
        _ = inner ℂ v (R.symm (WeakDual.toStrongDual f)) :=
          InnerProductSpace.toDual_symm_apply.symm
        _ = conj (inner ℂ (R.symm (WeakDual.toStrongDual f)) v) :=
          (inner_conj_symm v _).symm
        _ = conj (f v) := congrArg (starRingEnd ℂ)
          (InnerProductSpace.toDual_symm_apply (x := v) (y := WeakDual.toStrongDual f))
    change Continuous (fun f : WeakDual ℂ E ↦ y (R.symm (WeakDual.toStrongDual f)))
    simp_rw [h]
    exact Complex.continuous_conj.comp (WeakBilin.eval_continuous _ v)
  have hset : inverse '' (WeakDual.toStrongDual ⁻¹' Metric.closedBall 0 r) =
      {u : WeakSpace ℂ E | ‖(toWeakSpace ℂ E).symm u‖ ≤ r} := by
    ext u
    constructor
    · rintro ⟨f, hf, rfl⟩
      change dist (WeakDual.toStrongDual f) 0 ≤ r at hf
      change ‖R.symm (WeakDual.toStrongDual f)‖ ≤ r
      rw [R.symm.norm_map]
      rwa [dist_zero_right] at hf
    · intro hu
      let x := (toWeakSpace ℂ E).symm u
      refine ⟨(R x).toWeakDual, ?_, ?_⟩
      · change dist (R x) 0 ≤ r
        rw [dist_zero_right, R.norm_map]
        exact hu
      · change toWeakSpace ℂ E (R.symm (R x)) = u
        rw [R.symm_apply_apply, LinearEquiv.apply_symm_apply]
  rw [← hset]
  exact (WeakDual.isCompact_closedBall (0 : StrongDual ℂ E) r).image hcont

end HilbertBalls

section OperatorBalls

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- A weakly compact vector ball at every radius gives weak operator
compactness of each operator ball. -/
theorem isCompact_wot_operatorBall_of_compact_vectorBalls (R : ℝ) (hR : 0 ≤ R)
    (hballs : ∀ r : ℝ, IsCompact {u : WeakSpace ℂ E | ‖(toWeakSpace ℂ E).symm u‖ ≤ r}) :
    IsCompact {T : E →WOT[ℂ] E | ‖T.toCLM‖ ≤ R} := by
  let ball (x : E) : Set (WeakSpace ℂ E) := {u | ‖(toWeakSpace ℂ E).symm u‖ ≤ R * ‖x‖}
  let addEq (x y : E) : Set (E → WeakSpace ℂ E) := {u | u (x + y) = u x + u y}
  let smulEq (c : ℂ) (x : E) : Set (E → WeakSpace ℂ E) := {u | u (c • x) = c • u x}
  let equations := (⋂ x, ⋂ y, addEq x y) ∩ (⋂ c, ⋂ x, smulEq c x)
  let good := Set.pi Set.univ ball ∩ equations
  have hEq : IsClosed equations := by
    apply IsClosed.inter
    · exact isClosed_iInter fun x ↦ isClosed_iInter fun y ↦
        isClosed_eq (continuous_apply (x + y)) ((continuous_apply x).add (continuous_apply y))
    · exact isClosed_iInter fun c ↦ isClosed_iInter fun x ↦
        isClosed_eq (continuous_apply (c • x)) ((continuous_apply x).const_smul c)
  have hcompact : IsCompact good :=
    (isCompact_univ_pi fun x ↦ hballs (R * ‖x‖)).inter_right hEq
  have hbound (u : good) (x : E) : ‖(toWeakSpace ℂ E).symm (u.val x)‖ ≤ R * ‖x‖ :=
    u.property.1 x (mem_univ x)
  let linear (u : good) : E →ₗ[ℂ] E :=
    { toFun := fun x ↦ (toWeakSpace ℂ E).symm (u.val x)
      map_add' := fun x y ↦ by
        have h : u.val (x + y) = u.val x + u.val y :=
          mem_iInter.1 (mem_iInter.1 u.property.2.1 x) y
        rw [h, map_add]
      map_smul' := fun c x ↦ by
        have h : u.val (c • x) = c • u.val x :=
          mem_iInter.1 (mem_iInter.1 u.property.2.2 c) x
        rw [h, map_smul]
        rfl }
  let operator (u : good) : E →WOT[ℂ] E :=
    ContinuousLinearMapWOT.ofCLM ((linear u).mkContinuous R (hbound u))
  have hcont : Continuous operator := by
    apply ContinuousLinearMapWOT.continuous_of_dual_apply_continuous
    intro x f
    change Continuous (fun u : good ↦ f ((toWeakSpace ℂ E).symm (u.val x)))
    exact (WeakBilin.eval_continuous (topDualPairing ℂ E).flip f).comp
      ((continuous_apply x).comp continuous_subtype_val)
  have hsurj : Set.range operator = {T : E →WOT[ℂ] E | ‖T.toCLM‖ ≤ R} := by
    ext T
    constructor
    · rintro ⟨u, rfl⟩
      exact ContinuousLinearMap.opNorm_le_bound _ hR (hbound u)
    · intro hT
      have hT' : ‖T.toCLM‖ ≤ R := hT
      let u (x : E) := toWeakSpace ℂ E (T x)
      have hu : u ∈ good := by
        refine ⟨fun x _ ↦ ?_, ?_, ?_⟩
        · change ‖(toWeakSpace ℂ E).symm (toWeakSpace ℂ E (T x))‖ ≤ R * ‖x‖
          rw [LinearEquiv.symm_apply_apply]
          exact T.toCLM.le_of_opNorm_le hT' x
        · exact mem_iInter.2 fun x ↦ mem_iInter.2 fun y ↦ by
            change u (x + y) = u x + u y
            simp [u, map_add]
        · exact mem_iInter.2 fun c ↦ mem_iInter.2 fun x ↦ by
            change u (c • x) = c • u x
            simp [u, map_smul]
      refine ⟨⟨u, hu⟩, ?_⟩
      apply ContinuousLinearMapWOT.toCLM_injective
      apply ContinuousLinearMap.ext
      intro x
      exact (toWeakSpace ℂ E).symm_apply_apply (T x)
  let : CompactSpace good := isCompact_iff_compactSpace.mp hcompact
  rw [← hsurj]
  exact isCompact_range hcont

end OperatorBalls

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

theorem isCompact_wot_contractions :
    IsCompact {T : E →WOT[ℂ] E | ‖T.toCLM‖ ≤ 1} :=
  isCompact_wot_operatorBall_of_compact_vectorBalls 1 zero_le_one isCompact_weakHilbert_ball

theorem compact_weakOperatorClosure_hilbert_contractions {S : Type*} [Semigroup S]
    (π : S →ₙ* (E →L[ℂ] E)) (hπ : ∀ s, ‖π s‖ ≤ 1) :
    IsCompact (weakOperatorClosure π : Set (E →WOT[ℂ] E)) := by
  have hc : IsCompact {T : E →WOT[ℂ] E | ‖T.toCLM‖ ≤ 1} := isCompact_wot_contractions
  change IsCompact (closure (range (weakRepresentation π)))
  exact hc.of_isClosed_subset isClosed_closure (closure_minimal
    (by rintro _ ⟨s, rfl⟩; exact hπ s) hc.isClosed)

end JdLG

end

end HilbertCompactnessDevelopment

/- Source: JdLG/ContractiveCriterion.lean -/
section ContractiveCriterionDevelopment

/-!
# The contraction criterion for JdLG admissibility

For a minimal idempotent e, the compact corner eSe is a group.
The inverse of efe forces a contractive idempotent f to preserve norms
on the range of e. Strict convexity gives fe = e. Applying the same
argument to the dual gives ef = e and proves uniqueness.
-/

@[expose] public section

open Set

namespace JdLG

/-- In a compact semitopological semigroup the corner of a minimal
idempotent is a group with that idempotent as identity. -/
theorem inverse_in_minimal_corner {S : Type*} [Semigroup S] [TopologicalSpace S]
    [T2Space S] [CompactSpace S] [SeparatelyContinuousMul S]
    {e : S} (he : IsMinimalIdempotent e) (s : S) :
    ∃ t : S, t * (e * s * e) = e ∧ (e * s * e) * t = e := by
  let C : Subsemigroup S :=
    { carrier := {a | a * e = a ∧ e * a = a}
      mul_mem' := fun {a b} ha hb ↦ by
        change (a * b) * e = a * b ∧ e * (a * b) = a * b
        exact ⟨(mul_assoc a b e).trans (congrArg (a * ·) hb.1),
          (mul_assoc e a b).symm.trans (congrArg (· * b) ha.2)⟩ }
  have hcorner (a : S) : e * a * e ∈ C := by
    change (e * a * e) * e = e * a * e ∧ e * (e * a * e) = e * a * e
    refine ⟨by rw [mul_assoc (e * a), he.1], ?_⟩
    rw [← mul_assoc, ← mul_assoc e e a, he.1]
  have hset : (C : Set S) = range (fun a ↦ e * a * e) := by
    ext a
    constructor
    · exact fun ha ↦ ⟨a, by
        change e * a * e = a
        rw [ha.2, ha.1]⟩
    · rintro ⟨u, rfl⟩
      exact hcorner u
  have hcompact : IsCompact (C : Set S) := by
    rw [hset]
    exact isCompact_range ((continuous_const_mul e).mul_const e)
  let : CompactSpace C := isCompact_iff_compactSpace.mp hcompact
  let ec : C := ⟨e, he.1, he.1⟩
  have hec_idem : ec * ec = ec := Subtype.ext he.1
  have hunique (a : C) (ha : a * a = a) : a = ec :=
    Subtype.ext (he.2 a.1 (congrArg Subtype.val ha) a.2.1 a.2.2)
  obtain ⟨K, _⟩ := exists_compact_groupIdeal_of_existsUnique_minimalIdempotent
    (fun a : C ↦ continuous_mul_const a)
    ⟨ec, ⟨hec_idem, fun a ha _ _ ↦ hunique a ha⟩, fun a ha ↦ hunique a ha.1⟩
  have hKe : K.identity = ec := hunique _ K.identity_idempotent
  let u : C := ⟨e * s * e, hcorner s⟩
  have hu : u ∈ K.carrier := by
    have h : u * K.identity = u := by rw [hKe]; exact Subtype.ext u.2.1
    exact h ▸ K.mul_mem_left u K.identity_mem
  obtain ⟨v, _, hvu, huv⟩ := K.inverse_exists hu
  rw [hKe] at hvu huv
  exact ⟨v, congrArg Subtype.val hvu, congrArg Subtype.val huv⟩

private theorem contractive_idempotent_fixes_of_norm_eq {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] [StrictConvexSpace ℝ E] (B : E →L[ℂ] E)
    (hB : ‖B‖ ≤ 1) (hBB : B * B = B) (x : E) (hn : ‖B x‖ = ‖x‖) :
    B x = x := by
  by_contra hne
  let y := (1 / 2 : ℝ) • (x + B x)
  have hy : ‖y‖ < ‖x‖ := (norm_midpoint_lt_iff hn.symm).2 (Ne.symm hne)
  have hBx : B (B x) = B x := DFunLike.congr_fun hBB x
  have he : B y = B x := by
    change (B.restrictScalars ℝ) ((1 / 2 : ℝ) • (x + B x)) = B x
    rw [map_smul, map_add]
    change (1 / 2 : ℝ) • (B x + B (B x)) = B x
    rw [hBx, ← two_smul ℝ, smul_smul]
    norm_num
  have hb : ‖B y‖ ≤ 1 * ‖y‖ := B.le_of_opNorm_le hB y
  rw [he, hn, one_mul] at hb
  exact hy.not_ge hb

private theorem comp_eq_of_contractive_corner {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] [StrictConvexSpace ℝ E] {A B R : E →L[ℂ] E}
    (hA : ‖A‖ ≤ 1) (hB : ‖B‖ ≤ 1) (hR : ‖R‖ ≤ 1)
    (hAA : A * A = A) (hBB : B * B = B) (hinv : R * (A * B * A) = A) :
    B * A = A := by
  ext x
  change B (A x) = A x
  refine contractive_idempotent_fixes_of_norm_eq B hB hBB (A x) (le_antisymm ?_ ?_)
  · simpa only [one_mul] using B.le_of_opNorm_le hB (A x)
  · have h : R (A (B (A x))) = A x := by
      have h₀ := DFunLike.congr_fun hinv (A x)
      change R (A (B (A (A x)))) = A (A x) at h₀
      rwa [show A (A x) = A x from DFunLike.congr_fun hAA x] at h₀
    calc
      ‖A x‖ = ‖R (A (B (A x)))‖ := congrArg norm h.symm
      _ ≤ ‖A (B (A x))‖ := by simpa only [one_mul] using R.le_of_opNorm_le hR (A (B (A x)))
      _ ≤ ‖B (A x)‖ := by simpa only [one_mul] using A.le_of_opNorm_le hA (B (A x))

private theorem norm_banachAdjoint_le {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {A : E →L[ℂ] E} (hA : ‖A‖ ≤ 1) : ‖banachAdjoint A‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro f
  rw [one_mul]
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg f)
  intro x
  exact (f.le_opNorm (A x)).trans (mul_le_mul_of_nonneg_left
    (by simpa only [one_mul] using A.le_of_opNorm_le hA x) (norm_nonneg f))

/-- A compact WOT closure of contractions on a space with strictly convex
primal and dual norms is JdLG-admissible. The contraction hypothesis is
the additional assumption in this variant of Theorem 1.2(iv). -/
theorem admissible_of_strictConvex_contractions {S E : Type*} [Semigroup S] [Nonempty S]
    [NormedAddCommGroup E] [NormedSpace ℂ E] [StrictConvexSpace ℝ E]
    [StrictConvexSpace ℝ (StrongDual ℂ E)]
    (π : S →ₙ* (E →L[ℂ] E))
    (hcompact : IsCompact (weakOperatorClosure π : Set (E →WOT[ℂ] E)))
    (hπ : ∀ s, ‖π s‖ ≤ 1) : IsJdLGAdmissible π := by
  let T := weakOperatorClosure π
  let : CompactSpace T := isCompact_iff_compactSpace.mp hcompact
  let : Nonempty T := ⟨closureInclusion π (Classical.choice inferInstance)⟩
  let act := closureAction π
  have hcontract (t : T) : ‖act t‖ ≤ 1 := by
    have hc : IsClosed {a : E →WOT[ℂ] E | ‖a.toCLM‖ ≤ 1} := by
      have hset : {a : E →WOT[ℂ] E | ‖a.toCLM‖ ≤ 1} =
          ⋂ x : E, ⋂ f : StrongDual ℂ E, {a | ‖f (a x)‖ ≤ ‖f‖ * ‖x‖} := by
        ext a
        simp only [mem_ofPred_eq, mem_iInter]
        constructor
        · intro ha x f
          exact (f.le_opNorm (a x)).trans (mul_le_mul_of_nonneg_left
              (by
                change ‖a.toCLM x‖ ≤ ‖x‖
                simpa only [one_mul] using a.toCLM.le_of_opNorm_le ha x) (norm_nonneg f))
        · intro ha
          apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
          intro x
          rw [one_mul]
          obtain ⟨f, hf, heq⟩ := exists_dual_vector'' ℂ (a.toCLM x)
          have h := ha x f
          change ‖f (a.toCLM x)‖ ≤ ‖f‖ * ‖x‖ at h
          rw [heq, RCLike.norm_ofReal, abs_norm] at h
          exact h.trans (mul_le_of_le_one_left (norm_nonneg _) hf)
      rw [hset]
      exact isClosed_iInter fun x ↦ isClosed_iInter fun f ↦
        isClosed_le (ContinuousLinearMapWOT.continuous_dual_apply x f).norm continuous_const
    exact closure_minimal (by rintro _ ⟨s, rfl⟩; exact hπ s) hc t.2
  obtain ⟨L, hLcompact, hL⟩ := exists_compact_minimalLeftIdeal (fun t : T ↦ continuous_mul_const t)
  obtain ⟨e, heL, hee⟩ := exists_idempotent_in_compact_subsemigroup
    (fun t : T ↦ continuous_mul_const t) L hL.1 hLcompact
    (fun a _ _ hb ↦ hL.2.1 a hb)
  have he := isMinimalIdempotent_of_mem_minimalLeftIdeal hL heL hee
  refine ⟨hcompact, e, he, fun f hf ↦ ?_⟩
  obtain ⟨t, ht, htr⟩ := inverse_in_minimal_corner he f
  have hA : act e * act e = act e := by rw [← map_mul, he.1]
  have hB : act f * act f = act f := by rw [← map_mul, hf.1]
  have hR : act t * (act e * act f * act e) = act e := by simp_rw [← map_mul, ht]
  have hfe : act f * act e = act e :=
    comp_eq_of_contractive_corner (hcontract e) (hcontract f) (hcontract t) hA hB hR
  have hD (a : T) : ‖banachAdjoint (act a)‖ ≤ 1 := norm_banachAdjoint_le (hcontract a)
  have hAD : banachAdjoint (act e) * banachAdjoint (act e) = banachAdjoint (act e) := by
    rw [← banachAdjoint_mul, hA]
  have hBD : banachAdjoint (act f) * banachAdjoint (act f) = banachAdjoint (act f) := by
    rw [← banachAdjoint_mul, hB]
  have hRD : banachAdjoint (act t) *
      (banachAdjoint (act e) * banachAdjoint (act f) * banachAdjoint (act e)) =
      banachAdjoint (act e) := by
    have h : (act e * act f * act e) * act t = act e := by simp_rw [← map_mul, htr]
    simpa only [banachAdjoint_mul, mul_assoc] using congrArg banachAdjoint h
  have hdual := comp_eq_of_contractive_corner (hD e) (hD f) (hD t) hAD hBD hRD
  have hef : act e * act f = act e := by
    ext x
    apply (separatingDual_iff_injective.mp (inferInstance : SeparatingDual ℂ E))
    ext g
    exact DFunLike.congr_fun (DFunLike.congr_fun hdual g) x
  have hinj : Function.Injective act := fun a b hab ↦
    Subtype.ext (ContinuousLinearMapWOT.toCLM_injective hab)
  have h₁ : e * f = e := hinj ((map_mul act e f).trans hef)
  have h₂ : f * e = e := hinj ((map_mul act f e).trans hfe)
  exact (hf.2 e he.1 h₁ h₂).symm

theorem strictConvexSpace_complexHilbert_dual {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] : StrictConvexSpace ℝ (StrongDual ℂ E) := by
  let : InnerProductSpace ℝ E := InnerProductSpace.complexToReal
  let e := (InnerProductSpace.toDual ℂ E).symm
  let f : StrongDual ℂ E →ₗᵢ[ℝ] E :=
    { toFun := e
      map_add' := e.map_add
      map_smul' := fun r x ↦ by
        have h := e.map_smulₛₗ (r : ℂ) x
        have hstar : star (r : ℂ) = (r : ℂ) := by simp
        change e ((r : ℂ) • x) = star (r : ℂ) • e x at h
        rw [hstar] at h
        change e (r • x) = r • e x
        calc
          _ = e ((r : ℂ) • x) := congrArg e (RCLike.real_smul_eq_coe_smul (K := ℂ) r x)
          _ = (r : ℂ) • e x := h
          _ = r • e x := (RCLike.real_smul_eq_coe_smul (K := ℂ) r (e x)).symm
      norm_map' := e.norm_map }
  exact f.strictConvexSpace

/-- Theorem 1.2(ii) for complex Hilbert spaces. -/
theorem admissible_of_hilbert_contractions {S E : Type*} [Semigroup S] [Nonempty S]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (π : S →ₙ* (E →L[ℂ] E)) (hπ : ∀ s, ‖π s‖ ≤ 1) : IsJdLGAdmissible π := by
  let : InnerProductSpace ℝ E := InnerProductSpace.complexToReal
  let : StrictConvexSpace ℝ (StrongDual ℂ E) := strictConvexSpace_complexHilbert_dual
  exact admissible_of_strictConvex_contractions π
    (compact_weakOperatorClosure_hilbert_contractions π hπ) hπ

end JdLG

end

end ContractiveCriterionDevelopment

/- Source: JdLG/Decomposable.lean -/
section DecomposableDevelopment

/-! # The invariant splitting and the minimal idempotent criterion -/

@[expose] public section

open Set

namespace JdLG

variable {S E : Type*} [Semigroup S] [NormedAddCommGroup E] [NormedSpace ℂ E]
  (π : S →ₙ* (E →L[ℂ] E))

/-- The paper's definition of JdLG decomposability. Its two vector sets must
be closed complementary subspaces invariant under the whole WOT closure. -/
def IsJdLGDecomposable : Prop :=
  IsCompact (weakOperatorClosure π : Set (E →WOT[ℂ] E)) ∧
    ∃ R W : Submodule ℂ E,
      IsClosed (R : Set E) ∧ IsClosed (W : Set E) ∧ IsCompl R W ∧
      (∀ s : weakOperatorClosure π, ∀ x ∈ R, closureAction π s x ∈ R) ∧
      (∀ s : weakOperatorClosure π, ∀ x ∈ W, closureAction π s x ∈ W) ∧
      (∀ x, x ∈ R ↔ IsReversible (closureAction π) x) ∧
      (∀ x, x ∈ W ↔ IsAlmostWeaklyStable (closureAction π) x)

/-- The direct-sum condition and the unique minimal idempotent condition
in Theorem 1.1 are equivalent. -/
theorem isJdLGDecomposable_iff_isJdLGAdmissible [Nonempty S] :
    IsJdLGDecomposable π ↔ IsJdLGAdmissible π := by
  constructor
  · rintro ⟨hcompact, R, W, _, _, hRW, hR, hW, hr, hw⟩
    let T := weakOperatorClosure π
    let : CompactSpace T := isCompact_iff_compactSpace.mp hcompact
    let : Nonempty T := ⟨closureInclusion π (Classical.choice inferInstance)⟩
    let ρ := closureAction π
    have hfix (e : T) (he : e * e = e) {x : E} (hx : x ∈ R) : ρ e x = x := by
      have hRdiff : x - ρ e x ∈ R := R.sub_mem hx (hR e x hx)
      have hWdiff : x - ρ e x ∈ W := (hw _).2 ⟨e, by
        rw [map_sub, show ρ e (ρ e x) = ρ e x from DFunLike.congr_fun
          ((map_mul ρ e e).symm.trans (congrArg ρ he)) x, sub_self]⟩
      have h : x - ρ e x ∈ R ⊓ W := ⟨hRdiff, hWdiff⟩
      rw [hRW.inf_eq_bot] at h
      have hz : x - ρ e x = 0 := (Submodule.mem_bot ℂ).1 h
      exact (sub_eq_zero.mp hz).symm
    have hkill (e : T) (he : IsMinimalIdempotent e) {x : E} (hx : x ∈ W) : ρ e x = 0 := by
      obtain ⟨a, ha⟩ := (hw _).1 (hW e x hx)
      obtain ⟨t, ht, _⟩ := inverse_in_minimal_corner he a
      have h := DFunLike.congr_fun (congrArg ρ ht) x
      simp only [map_mul] at h
      change ρ t (ρ e (ρ a (ρ e x))) = ρ e x at h
      change ρ a (ρ e x) = 0 at ha
      rw [ha, map_zero, map_zero] at h
      exact h.symm
