include hF in
private theorem exists_finiteBlockAverage_limit {f : G → ℝ} (hf : MemLp f ∞ Measure.count) :
    ∃ x : ℝ, Tendsto (finiteBlockAverage F f) (hyperfilter ℕ : Filter ℕ) (𝓝 x) := by
  obtain ⟨C, hC⟩ := bounded_count_function hf
