      rw [hs, Nat.cast_add, add_comm (n : ℤ), neg_add_cancel_left]
    rw [norm_sub_rev, hEq]
    have hBound := norm_scalarCesaro_shift_sub_le v 1
      (fun n ↦ hf (s * Multiplicative.ofAdd (n : ℤ)))
      (N + 1) k
