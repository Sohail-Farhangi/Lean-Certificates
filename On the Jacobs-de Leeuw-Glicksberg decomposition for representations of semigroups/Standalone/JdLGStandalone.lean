    rw [hinter, hunit]
  · intro V hV hinv
    let Z := W ⊓ V.comap A.toLinearMap
    have hZinv (s : S) (x : E) (hx : x ∈ Z) : π s x ∈ Z := by
      refine ⟨?_, ?_⟩
      · have hxW : x ∈ W := hx.1
        rw [← hJW] at hxW ⊢
        obtain ⟨z, rfl⟩ := hxW
