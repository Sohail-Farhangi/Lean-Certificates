theorem LeftFolnerProbabilities.tendsto_defect (hν : LeftFolnerProbabilities ν l)
    (s : S) (f : C_c(T, ℝ)) :
    Tendsto (fun n ↦ continuousTestIntegral (fun n ↦ (ν n).map i) n
