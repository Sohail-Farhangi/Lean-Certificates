  have ht : Tendsto orbit atTop (𝓝 0) := by
    apply hweak.2
    intro f
    change Tendsto (fun n ↦ f (representation (swapOutside n) (e 0))) atTop (𝓝 (f 0))
    rw [map_zero]
    apply tendsto_zero_iff_norm_tendsto_zero.2
