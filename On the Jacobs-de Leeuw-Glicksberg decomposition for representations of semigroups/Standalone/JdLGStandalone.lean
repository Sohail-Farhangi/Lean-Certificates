        apply le_of_tendsto_of_tendsto' (ha f) (ha g)
        intro n
        exact div_le_div_of_nonneg_right
          (Finset.sum_le_sum fun s _ ↦ Measure.ae_count_iff.mp h s) (Nat.cast_nonneg _)
