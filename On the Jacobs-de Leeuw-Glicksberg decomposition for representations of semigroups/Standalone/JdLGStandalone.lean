  let P := topDualPairing ℂ (StrongDual ℂ E)
  let L' : StrongDual ℂ (WeakBilin P) := L
  obtain ⟨f, hf⟩ := LinearMap.dualEmbedding_surjective (𝕜 := ℂ)
    (E := StrongDual ℂ (StrongDual ℂ E)) (F := StrongDual ℂ E) P L'
