section WeakCompactFragmentationDevelopment

/-!
# Small weak neighborhoods in weakly compact sets

A binary splitting argument gives norm fragmentation of weakly compact
sets. The countably many points used at finite stages generate a separable
closed span. If the splitting continued forever, its compact weak closure
would contain uniformly norm-separated points indexed by all binary sequences.
-/

@[expose] public section

namespace JdLG

open Set TopologicalSpace

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

local notation "W" => WeakSpace ℂ E

/-- Distance in the original norm topology of two points of the weak space. -/
noncomputable abbrev weakDist (x y : W) : ℝ :=
  dist ((toWeakSpace ℂ E).symm x) ((toWeakSpace ℂ E).symm y)

/-- A norm-closed convex set is closed in the weak topology. -/
theorem isClosed_weak_image_of_closed_convex {C : Set E}
    (hC : IsClosed C) (hc : Convex ℝ C) :
    IsClosed (toWeakSpace ℂ E '' C) := by
  rw [← hC.closure_eq, hc.toWeakSpace_closure ℂ]
  exact isClosed_closure

private theorem separated_open_descendants (K : Set W) (ε : ℝ) (hε : 0 < ε)
    (U : Set K) (hU : IsOpen U) (x y : K) (hx : x ∈ U) (hy : y ∈ U)
    (hd : ε ≤ weakDist x.val y.val) :
    ∃ V₀ V₁ : Set K, IsOpen V₀ ∧ V₀.Nonempty ∧ V₀ ⊆ U ∧
      IsOpen V₁ ∧ V₁.Nonempty ∧ V₁ ⊆ U ∧
      ∀ a ∈ closure V₀, ∀ b ∈ closure V₁, ε / 2 ≤ weakDist a.val b.val := by
  let val (a : K) : E := (toWeakSpace ℂ E).symm a.val
  obtain ⟨f, hf, hfxy⟩ := exists_dual_vector'' ℂ (val x - val y)
  let g := f ∘ val
  have hcont : Continuous g :=
    (WeakBilin.eval_continuous (topDualPairing ℂ E).flip f).comp continuous_subtype_val
  have hgdist (a b : K) : dist (g a) (g b) ≤ weakDist a.val b.val := by
    change dist (f (val a)) (f (val b)) ≤ dist (val a) (val b)
    simp only [dist_eq_norm, ← map_sub]
    exact ((f.le_opNorm _).trans (mul_le_mul_of_nonneg_right hf (norm_nonneg _))).trans_eq
      (one_mul _)
  have hgxy : dist (g x) (g y) = weakDist x.val y.val := by
    change dist (f (val x)) (f (val y)) = dist (val x) (val y)
    simp only [dist_eq_norm, ← map_sub, hfxy, RCLike.norm_ofReal, abs_norm]
  let V₀ := U ∩ g ⁻¹' Metric.ball (g x) (ε / 4)
  let V₁ := U ∩ g ⁻¹' Metric.ball (g y) (ε / 4)
  refine ⟨V₀, V₁, hU.inter (Metric.isOpen_ball.preimage hcont), ⟨x, hx, ?_⟩, inter_subset_left,
    hU.inter (Metric.isOpen_ball.preimage hcont), ⟨y, hy, ?_⟩, inter_subset_left, ?_⟩
  · exact Metric.mem_ball_self (by positivity)
  · exact Metric.mem_ball_self (by positivity)
  · intro a ha b hb
    have ha' : dist (g a) (g x) ≤ ε / 4 := closure_minimal (show V₀ ⊆
        g ⁻¹' Metric.closedBall (g x) (ε / 4) from
          fun _ hz ↦ Metric.ball_subset_closedBall hz.2)
        (Metric.isClosed_closedBall.preimage hcont) ha
    have hb' : dist (g b) (g y) ≤ ε / 4 := closure_minimal (show V₁ ⊆
        g ⁻¹' Metric.closedBall (g y) (ε / 4) from
          fun _ hz ↦ Metric.ball_subset_closedBall hz.2)
        (Metric.isClosed_closedBall.preimage hcont) hb
    have h₁ := dist_triangle (g x) (g a) (g y)
    have h₂ := dist_triangle (g a) (g b) (g y)
    rw [dist_comm (g x) (g a), hgxy] at h₁
    linarith [hgdist a b]

private theorem no_uniformly_separated_binary_family {X : Type*} [MetricSpace X]
    [SeparableSpace X] (f : (ℕ → Bool) → X) (ε : ℝ) (hε : 0 < ε)
    (hsep : ∀ a b, dist (f a) (f b) < ε → a = b) : False := by
  obtain ⟨D, hD, hd⟩ := exists_countable_dense X
  choose d hdD hdlt using fun a ↦ hd.exists_dist_lt (f a) (by linarith : 0 < ε / 3)
  let g (a : ℕ → Bool) : D := ⟨d a, hdD a⟩
  have hi : Function.Injective g := by
    intro a b h
    have he : d a = d b := congrArg Subtype.val h
    apply hsep
    have h₁ := hdlt a
    have ht := dist_triangle (f a) (d a) (f b)
    rw [he] at h₁
    rw [dist_comm (d a) (f b), he] at ht
    linarith [hdlt b]
  let : Countable D := hD
  let : Countable (ℕ → Bool) := hi.countable
  obtain ⟨e, he⟩ := exists_surjective_nat (ℕ → Bool)
  obtain ⟨n, hn⟩ := he (fun n ↦ !(e n n))
  exact (Bool.not_eq_self (e n n)).1 (congrFun hn n).symm

private def binaryPrefix (a : ℕ → Bool) : ℕ → List Bool
  | 0 => []
  | n + 1 => a n :: binaryPrefix a n

/-- Every nonempty weakly compact set contains a nonempty relatively weak-open
subset whose pairwise norm distances are smaller than any given positive
number. -/
theorem exists_small_weakOpen_of_weakCompact {K : Set W} (hK : IsCompact K) (hKn : K.Nonempty)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ U : Set K, IsOpen U ∧ U.Nonempty ∧ ∀ x ∈ U, ∀ y ∈ U, weakDist x.val y.val < ε := by
  classical
  by_contra hcontra
  let : CompactSpace K := isCompact_iff_compactSpace.1 hK
  let : Nonempty K := hKn.to_subtype
  let Node := {U : Set K // IsOpen U ∧ U.Nonempty}
  have hlarge (U : Node) : ∃ x ∈ U.val, ∃ y ∈ U.val, ε ≤ weakDist x.val y.val := by
    by_contra! h
    exact hcontra ⟨U.val, U.property.1, U.property.2, h⟩
  have hspl (U : Node) : ∃ V₀ V₁ : Node, V₀.val ⊆ U.val ∧ V₁.val ⊆ U.val ∧
      ∀ a ∈ closure V₀.val, ∀ b ∈ closure V₁.val, ε / 2 ≤ weakDist a.val b.val := by
    obtain ⟨x, hx, y, hy, hxy⟩ := hlarge U
    obtain ⟨V₀, V₁, hV₀, hn₀, hs₀, hV₁, hn₁, hs₁, hs⟩ :=
      separated_open_descendants K ε hε U.val U.property.1 x y hx hy hxy
    exact ⟨⟨V₀, hV₀, hn₀⟩, ⟨V₁, hV₁, hn₁⟩, hs₀, hs₁, hs⟩
  choose left right hleft hright hsep using hspl
  let tree : List Bool → Node := List.rec ⟨univ, isOpen_univ, univ_nonempty⟩
    (fun b _ U ↦ if b then right U else left U)
  have htree (b : Bool) (t : List Bool) : (tree (b :: t)).val ⊆ (tree t).val := by
    cases b
    · exact hleft _
    · exact hright _
  let z (t : List Bool) : K := (tree t).property.2.choose
  let base (t : List Bool) : E := (toWeakSpace ℂ E).symm (z t).val
  let M := (Submodule.span ℂ (range base)).topologicalClosure
  have hM : IsSeparable (M : Set E) := (countable_range base).isSeparable.span.closure
  let : SeparableSpace M := hM.separableSpace
  let D : Set K := closure (range z)
  have hD (a : K) (ha : a ∈ D) : (toWeakSpace ℂ E).symm a.val ∈ M := by
    have hc : IsClosed (toWeakSpace ℂ E '' (M : Set E)) :=
      isClosed_weak_image_of_closed_convex (Submodule.isClosed_topologicalClosure _)
        ((M.restrictScalars ℝ).convex)
    have hm : a ∈ (Subtype.val : K → W) ⁻¹' (toWeakSpace ℂ E '' (M : Set E)) :=
      closure_minimal (fun p hp ↦ by
        obtain ⟨t, rfl⟩ := hp
        exact ⟨base t, Submodule.le_topologicalClosure _
          (Submodule.subset_span (mem_range_self t)), LinearEquiv.apply_symm_apply _ _⟩)
        (hc.preimage continuous_subtype_val) ha
    obtain ⟨v, hv, hveq⟩ := hm
    rw [← hveq, LinearEquiv.symm_apply_apply]
    exact hv
  have hbranch (b : ℕ → Bool) :
      ∃ a ∈ D, ∀ n, a ∈ closure (tree (binaryPrefix b n)).val := by
    let A (n : ℕ) := D ∩ closure (tree (binaryPrefix b n)).val
    have hclosed (n : ℕ) : IsClosed (A n) := isClosed_closure.inter isClosed_closure
    obtain ⟨a, ha⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed A
      (fun n ↦ inter_subset_inter_right _ (closure_mono (htree _ _)))
      (fun n ↦ ⟨z (binaryPrefix b n), subset_closure (mem_range_self _),
        subset_closure (tree (binaryPrefix b n)).property.2.choose_spec⟩)
      (hclosed 0).isCompact hclosed
    exact ⟨a, (mem_iInter.1 ha 0).1, fun n ↦ (mem_iInter.1 ha n).2⟩
  choose p hpD hp using hbranch
  let f (b : ℕ → Bool) : M := ⟨(toWeakSpace ℂ E).symm (p b).val, hD _ (hpD b)⟩
  refine no_uniformly_separated_binary_family f (ε / 2) (by positivity) fun a b hab ↦ ?_
  change weakDist (p a).val (p b).val < ε / 2 at hab
  have hprefix (n : ℕ) : binaryPrefix a n = binaryPrefix b n := by
    induction n with
    | zero => rfl
    | succ n ih =>
      have hbit : a n = b n := by
        have ha := hp a (n + 1)
        have hb := hp b (n + 1)
        cases h₀ : a n <;> cases h₁ : b n
        · rfl
        · have ha' : p a ∈ closure (left (tree (binaryPrefix b n))).val := by
            rw [binaryPrefix, h₀, ih] at ha
            exact ha
          have hb' : p b ∈ closure (right (tree (binaryPrefix b n))).val := by
            rw [binaryPrefix, h₁] at hb
            exact hb
          exact ((not_lt_of_ge (hsep _ _ ha' _ hb')) hab).elim
        · have hb' : p b ∈ closure (left (tree (binaryPrefix b n))).val := by
            rw [binaryPrefix, h₁] at hb
            exact hb
          have ha' : p a ∈ closure (right (tree (binaryPrefix b n))).val := by
            rw [binaryPrefix, h₀, ih] at ha
            exact ha
          have he := hsep _ _ hb' _ ha'
          have hcomm : weakDist (p b).val (p a).val = weakDist (p a).val (p b).val :=
            dist_comm _ _
          have he' := he.trans_eq hcomm
          exact ((not_lt_of_ge he') hab).elim
        · rfl
      simp only [binaryPrefix, hbit, ih]
  funext n
  exact Option.some.inj (congrArg List.head? (hprefix (n + 1)))

/-- The small weak-open subset may be chosen inside any given nonempty
relatively weak-open subset of a weakly compact set. -/
theorem exists_small_weakOpen_subset {K : Set W} (hK : IsCompact K)
    {O : Set K} (hO : IsOpen O) (hOn : O.Nonempty) (ε : ℝ) (hε : 0 < ε) :
    ∃ U : Set K, IsOpen U ∧ U.Nonempty ∧ U ⊆ O ∧
      ∀ x ∈ U, ∀ y ∈ U, weakDist x.val y.val < ε := by
  let C := closure ((Subtype.val : K → W) '' O)
  have hC : C ⊆ K := closure_minimal (image_subset_iff.2 fun x _ ↦ x.property) hK.isClosed
  obtain ⟨V, hV, ⟨v, hv⟩, hsmall⟩ := exists_small_weakOpen_of_weakCompact
    (hK.of_isClosed_subset isClosed_closure hC) (hOn.image _ |>.mono subset_closure) ε hε
  obtain ⟨V', hV', rfl⟩ := isOpen_induced_iff.1 hV
  have hhit := mem_closure_iff.1 v.property V' hV' hv
  obtain ⟨x, hxV', x', hx'O, rfl⟩ := hhit
  refine ⟨O ∩ (Subtype.val : K → W) ⁻¹' V', hO.inter (hV'.preimage continuous_subtype_val),
    ⟨x', hx'O, hxV'⟩, inter_subset_left, fun x hx y hy ↦ ?_⟩
  let xC : C := ⟨x.val, subset_closure (mem_image_of_mem _ hx.1)⟩
  let yC : C := ⟨y.val, subset_closure (mem_image_of_mem _ hy.1)⟩
  exact hsmall xC hx.2 yC hy.2

end JdLG

end

end WeakCompactFragmentationDevelopment

/- Source: JdLG/WeakCompactCountableChain.lean -/
section WeakCompactCountableChainDevelopment

/-!
# Countable chain condition for weakly compact sets

Norm fragmentation and maximal disjoint families of small open sets give a
separable subspace containing a weakly compact set with the countable chain
condition. On this compact set countably many Hahn–Banach extensions of
dual tests on that subspace generate the induced topology.
-/

@[expose] public section

namespace JdLG

open Filter Set TopologicalSpace
open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

local notation "W" => WeakSpace ℂ E

private theorem exists_dense_family_of_small_weakOpens {K : Set W} (hK : IsCompact K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ D : Set (Set K), D.Pairwise Disjoint ∧ Dense (⋃₀ D) ∧
      ∀ U ∈ D, IsOpen U ∧ U.Nonempty ∧ ∀ x ∈ U, ∀ y ∈ U, weakDist x.val y.val < ε := by
  classical
  let P (U : Set K) := IsOpen U ∧ U.Nonempty ∧
    ∀ x ∈ U, ∀ y ∈ U, weakDist x.val y.val < ε
  let C : Set (Set (Set K)) := {D | D.Pairwise Disjoint ∧ ∀ U ∈ D, P U}
  obtain ⟨D, hD⟩ := zorn_subset C fun c hc hchain ↦ by
    refine ⟨⋃₀ c, ⟨?_, ?_⟩, fun A hA ↦ subset_sUnion_of_mem hA⟩
    · intro U hU V hV hUV
      obtain ⟨A, hAc, hUA⟩ := mem_sUnion.1 hU
      obtain ⟨B, hBc, hVB⟩ := mem_sUnion.1 hV
      rcases hchain.total hAc hBc with hAB | hBA
      · exact (hc hBc).1 (hAB hUA) hVB hUV
      · exact (hc hAc).1 hUA (hBA hVB) hUV
    · intro U hU
      obtain ⟨A, hA, hUA⟩ := mem_sUnion.1 hU
      exact (hc hA).2 U hUA
  refine ⟨D, hD.prop.1, ?_, hD.prop.2⟩
  by_contra hn
  have hO : ((closure (⋃₀ D))ᶜ).Nonempty := by
    simpa only [nonempty_compl, dense_iff_closure_eq] using hn
  obtain ⟨U, hUo, hUn, hUs, hUd⟩ := exists_small_weakOpen_subset hK
    isClosed_closure.isOpen_compl hO ε hε
  have hdis (V : Set K) (hV : V ∈ D) : Disjoint U V :=
    disjoint_left.2 fun _ hx hy ↦ hUs hx (subset_closure (mem_sUnion_of_mem hy hV))
  have hbig : insert U D ∈ C := by
    refine ⟨?_, ?_⟩
    · exact hD.prop.1.insert (fun V hV _ ↦ ⟨hdis V hV, (hdis V hV).symm⟩)
    · intro V hV
      rcases mem_insert_iff.1 hV with rfl | hVD
      · exact ⟨hUo, hUn, hUd⟩
      · exact hD.prop.2 V hVD
  have hUD : U ∈ D := hD.2 hbig (subset_insert _ _) (mem_insert _ _)
  obtain ⟨x, hx⟩ := hUn
  exact disjoint_left.1 (hdis U hUD) hx hx

/-- A weakly compact set with the countable chain condition is contained in a
closed norm-separable subspace of the ambient normed space. -/
theorem exists_separable_closedSpan_of_weakCompact_ccc {K : Set W} (hK : IsCompact K)
    (hccc : ∀ D : Set (Set K), D.Pairwise Disjoint →
      (∀ U ∈ D, IsOpen U ∧ U.Nonempty) → D.Countable) :
    ∃ M : Submodule ℂ E, IsClosed (M : Set E) ∧ IsSeparable (M : Set E) ∧
      K ⊆ toWeakSpace ℂ E '' (M : Set E) := by
  classical
  let ε (n : ℕ) : ℝ := 1 / (n + 1)
  have hε (n : ℕ) : 0 < ε n := by dsimp [ε]; positivity
  choose D hDpair hDdense hDsmall using fun n ↦ exists_dense_family_of_small_weakOpens hK
    (ε n) (hε n)
  have hD (n : ℕ) : Countable (D n) := hccc _ (hDpair n)
    fun U hU ↦ ⟨(hDsmall n U hU).1, (hDsmall n U hU).2.1⟩
  let anchor (n : ℕ) (U : D n) : K := (hDsmall n U.val U.property).2.1.choose
  let a (n : ℕ) (U : D n) : E := (toWeakSpace ℂ E).symm (anchor n U).val
  let B := ⋃ n : ℕ, range (a n)
  have hB : B.Countable := countable_iUnion fun n ↦ by
    let : Countable (D n) := hD n
    exact countable_range _
  let M := (Submodule.span ℂ B).topologicalClosure
  refine ⟨M, Submodule.isClosed_topologicalClosure _, hB.isSeparable.span.closure, ?_⟩
  intro x hx
  refine ⟨(toWeakSpace ℂ E).symm x, ?_, LinearEquiv.apply_symm_apply _ _⟩
  have hnear (n : ℕ) : (toWeakSpace ℂ E).symm x ∈ Metric.cthickening (ε n) (M : Set E) := by
    let T := toWeakSpace ℂ E '' Metric.cthickening (ε n) (M : Set E)
    have hT : IsClosed T := isClosed_weak_image_of_closed_convex Metric.isClosed_cthickening
      ((M.restrictScalars ℝ).convex.cthickening (ε n))
    have hsub : ⋃₀ D n ⊆ (Subtype.val : K → W) ⁻¹' T := by
      intro y hy
      obtain ⟨U, hU, hyU⟩ := mem_sUnion.1 hy
      let u : D n := ⟨U, hU⟩
      have ha : a n u ∈ M := Submodule.le_topologicalClosure _
        (Submodule.subset_span (mem_iUnion.2 ⟨n, mem_range_self u⟩))
      have hd := (hDsmall n U hU).2.2 y hyU (anchor n u) (hDsmall n U hU).2.1.choose_spec
      refine ⟨(toWeakSpace ℂ E).symm y.val,
        Metric.mem_cthickening_of_dist_le _ (a n u) _ _ ha hd.le,
        LinearEquiv.apply_symm_apply _ _⟩
    have hn : (⟨x, hx⟩ : K) ∈ (Subtype.val : K → W) ⁻¹' T :=
      closure_minimal hsub (hT.preimage continuous_subtype_val) ((hDdense n) ⟨x, hx⟩)
    obtain ⟨z, hz, hz'⟩ := hn
    change toWeakSpace ℂ E z = x at hz'
    rw [← hz', LinearEquiv.symm_apply_apply]
    exact hz
  change (toWeakSpace ℂ E).symm x ∈ (M : Set E)
  rw [← (Submodule.isClosed_topologicalClosure (Submodule.span ℂ B)).closure_eq,
    Metric.closure_eq_iInter_cthickening]
  refine mem_iInter.2 fun δ ↦ mem_iInter.2 fun hδ ↦ ?_
  obtain ⟨n, hn⟩ := exists_nat_gt (1 / δ)
  have hle : ε n ≤ δ := by
    dsimp [ε]
    have hden : 0 < (n : ℝ) + 1 := by positivity
    exact (div_le_iff₀ hden).2 (by nlinarith [(div_lt_iff₀ hδ).1 hn])
  exact Metric.cthickening_mono hle _ (hnear n)

/-- A weakly compact set with the countable chain condition has a first-countable
relative weak topology, even when the ambient space is nonseparable. -/
theorem firstCountableTopology_weakCompact_of_ccc {K : Set W} (hK : IsCompact K)
    (hccc : ∀ D : Set (Set K), D.Pairwise Disjoint →
      (∀ U ∈ D, IsOpen U ∧ U.Nonempty) → D.Countable) : FirstCountableTopology K := by
  obtain ⟨M, _, hM, hsub⟩ := exists_separable_closedSpan_of_weakCompact_ccc hK hccc
  let : SeparableSpace M := hM.separableSpace
  let : CompactSpace K := isCompact_iff_compactSpace.1 hK
  obtain ⟨f, hf⟩ := exists_separating_dual_sequence (E := M)
  choose g hg _ using fun n ↦ exists_extension_norm_eq M (f n)
  let a (x : K) : M := ⟨(toWeakSpace ℂ E).symm x.val, by
    obtain ⟨v, hv, hveq⟩ := hsub x.property
    rw [← hveq, LinearEquiv.symm_apply_apply]
    exact hv⟩
  let eval (x : K) (n : ℕ) := g n ((toWeakSpace ℂ E).symm x.val)
  have hc : Continuous eval :=
    continuous_pi fun n ↦ (WeakBilin.eval_continuous (topDualPairing ℂ E).flip (g n)).comp
      continuous_subtype_val
  have hi : Function.Injective eval := by
    intro x y h
    apply Subtype.ext ((toWeakSpace ℂ E).symm.injective ?_)
    have h₁ : (fun n ↦ f n (a x)) = fun n ↦ f n (a y) := by
      funext n
      rw [← hg n (a x), ← hg n (a y)]
      exact congrFun h n
    exact congrArg (fun z : M ↦ (z : E)) (hf h₁)
  exact (hc.isClosedEmbedding hi).isEmbedding.firstCountableTopology

end JdLG

end

end WeakCompactCountableChainDevelopment

/- Source: JdLG/RadonWeakDecay.lean -/
section RadonWeakDecayDevelopment

/-!
# Density-one weak decay without separability

The common support of the countably many Radon pushforwards is weakly
compact and satisfies the countable chain condition. We obtain the
countable neighborhood basis on this support and apply the compact
exhaustion argument to the original sampling probabilities.
-/

@[expose] public section

namespace JdLG

open Filter Function MeasureTheory Set TopologicalSpace
open scoped Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

local notation "W" => WeakSpace ℂ E

/-- A countable family of compact-inner-regular probabilities concentrated
on a weakly compact set has a common weakly compact first-countable support. -/
theorem exists_firstCountable_common_weakSupport [MeasurableSpace W] [BorelSpace W]
    (m : ℕ → Measure W) (hp : ∀ n, IsProbabilityMeasure (m n))
    (hr : ∀ n, (m n).InnerRegularWRT IsCompact IsOpen)
    {K : Set W} (hK : IsCompact K) (hK₀ : ∀ n, m n Kᶜ = 0) :
    ∃ H : Set W, H ⊆ K ∧ IsCompact H ∧ FirstCountableTopology H ∧ ∀ n, m n Hᶜ = 0 := by
  let μ := Measure.sum m
  let H := μ.support
  let (n : ℕ) : IsProbabilityMeasure (m n) := hp n
  let : SFinite μ := inferInstanceAs (SFinite (Measure.sum m))
  have hKμ : K ∈ ae μ := by
    change Measure.sum m Kᶜ = 0
    rw [Measure.sum_apply _ hK.isClosed.isOpen_compl.measurableSet]
    simp only [hK₀, tsum_zero]
  have hHc : IsClosed H := Measure.isClosed_support
  have hsub : H ⊆ K := Measure.support_subset_of_isClosed hK.isClosed hKμ
  have hH : IsCompact H := hK.of_isClosed_subset hHc hsub
  have hz (n : ℕ) : m n Hᶜ = 0 := by
    by_contra hn
    obtain ⟨C, hCs, hCc, hCp⟩ := hr n hHc.isOpen_compl 0 (pos_iff_ne_zero.2 hn)
    have hzero : μ C = 0 := Measure.measure_eq_zero_of_isCompact_subset_compl_support hCc hCs
    have hl : m n C ≤ μ C := Measure.le_sum m n C
    exact (not_lt_of_ge (hzero ▸ hl)) hCp
  have hμz : μ Hᶜ = 0 := by
    change Measure.sum m Hᶜ = 0
    rw [Measure.sum_apply _ hHc.isOpen_compl.measurableSet]
    simp only [hz, tsum_zero]
  refine ⟨H, hsub, hH, firstCountableTopology_weakCompact_of_ccc hH ?_, hz⟩
  intro D hD ho
  let A (U : D) := (Subtype.val : H → W) '' U.val
  have hAV (U : D) : ∃ V : Set W, IsOpen V ∧
      (Subtype.val : H → W) ⁻¹' V = U.val ∧ A U = V ∩ H := by
    obtain ⟨V, hV, he⟩ := isOpen_induced_iff.1 (ho U.val U.property).1
    refine ⟨V, hV, he, ?_⟩
    ext x
    constructor
    · rintro ⟨v, hv, rfl⟩
      refine ⟨?_, v.property⟩
      change v ∈ (Subtype.val : H → W) ⁻¹' V
      rwa [he]
    · rintro ⟨hv, hh⟩
      exact ⟨⟨x, hh⟩, he.symm ▸ hv, rfl⟩
  have hAm (U : D) : MeasurableSet (A U) := by
    obtain ⟨V, hV, _, hA⟩ := hAV U
    rw [hA]
    exact hV.measurableSet.inter hHc.measurableSet
  have hAp (U : D) : 0 < μ (A U) := by
    obtain ⟨V, hV, he, hA⟩ := hAV U
    obtain ⟨x, hx⟩ := (ho U.val U.property).2
    have hxV : x.val ∈ V := by
      change x ∈ (Subtype.val : H → W) ⁻¹' V
      rwa [he]
    rw [hA, measure_inter_conull hμz]
    exact (Measure.mem_support_iff_forall _).1 x.property V (hV.mem_nhds hxV)
  have hd : Pairwise (Disjoint on A) := by
    intro U V hUV
    exact disjoint_image_of_injective Subtype.val_injective
      (hD U.property V.property (fun h ↦ hUV (Subtype.ext h)))
  have hc := Measure.countable_meas_pos_of_disjoint_iUnion (μ := μ) hAm hd
  have he : {U : D | 0 < μ (A U)} = univ := eq_univ_of_forall hAp
  rw [he] at hc
  exact countable_univ_iff.1 hc

variable {S : Type*} [TopologicalSpace S] [MeasurableSpace S]

/-- If all weak neighborhoods of a limit point have asymptotically full
sampling mass, compact-inner-regular probabilities give a single measurable
set of full density on which the weak limit holds along the cocompact filter. -/
theorem exists_density_one_weak_tendsto_of_innerRegular
    (ν : ℕ → Measure S) (hprob : ∀ n, IsProbabilityMeasure (ν n))
    (hreg : ∀ n, (ν n).InnerRegularWRT IsCompact IsOpen)
    (F : ℕ → Set S) (hF : ∀ n, IsCompact (F n)) (hFm : ∀ n, MeasurableSet (F n))
    (hsupp : ∀ n, ν n (F n)ᶜ = 0) (φ : S → W) (hφ : Continuous φ)
    [OpensMeasurableSpace S]
    {K : Set W} (hK : IsCompact K) (hφK : range φ ⊆ K) (y : W)
    (hret : ∀ U : Set W, IsOpen U → y ∈ U →
      Tendsto (fun n ↦ (ν n).real (φ ⁻¹' U)) atTop (𝓝 1)) :
    ∃ A : Set S, MeasurableSet A ∧ Tendsto (fun n ↦ (ν n).real A) atTop (𝓝 1) ∧
      Tendsto φ (cocompact S ⊓ 𝓟 A) (𝓝 y) := by
  classical
  let : MeasurableSpace W := borel W
  let : BorelSpace W := ⟨rfl⟩
  let m (n : ℕ) := Measure.map φ (ν n)
  have hm (n : ℕ) : IsProbabilityMeasure (m n) := by
    let : IsProbabilityMeasure (ν n) := hprob n
    exact (Measure.isProbabilityMeasure_map_iff hφ.measurable.aemeasurable).2 (hprob n)
  have hr (n : ℕ) : (m n).InnerRegularWRT IsCompact IsOpen :=
    (hreg n).map hφ.measurable.aemeasurable (fun _ hU ↦ hU.preimage hφ)
      (fun _ hC ↦ hC.image hφ) (fun _ hU ↦ hU.measurableSet)
  have hK₀ (n : ℕ) : m n Kᶜ = 0 := by
    rw [Measure.map_apply hφ.measurable hK.isClosed.isOpen_compl.measurableSet]
    have hpre : φ ⁻¹' Kᶜ = ∅ := by
      apply eq_empty_iff_forall_notMem.2
      intro s hs
      exact hs (hφK (mem_range_self s))
    rw [hpre, measure_empty]
  obtain ⟨H, _, hH, hHfc, hz⟩ := exists_firstCountable_common_weakSupport m hm hr hK hK₀
  let : FirstCountableTopology H := hHfc
  have hz' (n : ℕ) : ν n (φ ⁻¹' H)ᶜ = 0 := by
    have hn := hz n
    rwa [Measure.map_apply hφ.measurable hH.isClosed.isOpen_compl.measurableSet] at hn
  have hy : y ∈ H := by
    by_contra hyn
    have ht := hret Hᶜ hH.isClosed.isOpen_compl hyn
    have hzero : (fun n ↦ (ν n).real (φ ⁻¹' Hᶜ)) = fun _ ↦ (0 : ℝ) := by
      funext n
      rw [Measure.real, preimage_compl, hz' n, ENNReal.toReal_zero]
    rw [hzero] at ht
    exact zero_ne_one (tendsto_nhds_unique tendsto_const_nhds ht)
  let yH : H := ⟨y, hy⟩
  let : MeasurableSpace H := borel H
  let : BorelSpace H := ⟨rfl⟩
  let φ₀ (s : S) : W := if φ s ∈ H then φ s else y
  let ψ (s : S) : H := ⟨φ₀ s, by
    by_cases hs : φ s ∈ H <;> simp [φ₀, hs, hy]⟩
  have hψ : Measurable ψ := by
    have hu : Measurable φ₀ := Measurable.ite (hφ.measurable hH.isClosed.measurableSet)
      hφ.measurable measurable_const
    let : MeasurableSpace H := MeasurableSpace.comap Subtype.val inferInstance
    have haux : @Measurable S H _ (MeasurableSpace.comap Subtype.val inferInstance) ψ :=
      hu.subtype_mk
    rwa [← borel_comap] at haux
  have hψret (U : Set H) (hU : IsOpen U) (hyU : yH ∈ U) :
      Tendsto (fun n ↦ (ν n).real (ψ ⁻¹' U)) atTop (𝓝 1) := by
    obtain ⟨V, hV, rfl⟩ := isOpen_induced_iff.1 hU
    have he (n : ℕ) : ψ ⁻¹' ((Subtype.val : H → W) ⁻¹' V) =ᵐ[ν n] φ ⁻¹' V := by
      filter_upwards [show φ ⁻¹' H ∈ ae (ν n) from hz' n] with s hs
      change (φ₀ s ∈ V) ↔ (φ s ∈ V)
      change φ s ∈ H at hs
      simp [φ₀, hs]
