  let descend (s : S) : (E ⧸ Y) →L[𝕜] (E ⧸ Y) := Y.liftQL (Y.mkQL.comp (π s)) (by
    intro x hx
    exact (Submodule.Quotient.mk_eq_zero Y).mpr (hY s x hx))
