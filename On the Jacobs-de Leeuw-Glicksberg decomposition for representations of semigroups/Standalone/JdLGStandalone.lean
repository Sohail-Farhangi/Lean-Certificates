      ∃ δ : ℝ, 0 < δ ∧ ∀ s : S, δ ≤ ‖π s y‖) (x : E) :
    IsReversible (closureAction π) x ↔ HasPrecompactOrbit π x :=
  ⟨precompactOrbit_of_reversible hπ x, reversible_of_precompactOrbit_of_separated hπ hseparated x⟩

