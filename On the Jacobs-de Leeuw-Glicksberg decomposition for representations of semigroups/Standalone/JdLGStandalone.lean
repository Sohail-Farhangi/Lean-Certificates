a nonzero eigenvalue whose eigenspace is invariant. -/
theorem exists_finiteDimensional_invariant_of_compact_unitary
    (U : G →* (H ≃ₗᵢ[𝕜] H)) (hU : ∀ x, Continuous fun g ↦ U g x)
    {x : H} (hx : x ≠ 0) :
