/- Source: JdLG/UltrafilterMoreStoneCech.lean -/
section UltrafilterMoreStoneCechDevelopment

/-!
# Inverse translates in the Stone–Čech compactification

The map into the Stone–Čech semigroup of a group of right quotients and
the inverse-translate property of the closure of the smallest ideal.
-/

@[expose] public section

open Filter Set
open scoped Topology

namespace JdLG

variable {S T G : Type*}

/-- Ultrafilter pushforward is continuous for the Stone–Čech topologies of discrete sets. -/
theorem continuous_ultrafilter_map (f : S → T) :
    Continuous (fun p : Ultrafilter S ↦ p.map f) :=
  ultrafilterBasis_is_basis.continuous_iff.2 <|
    Set.forall_mem_range.mpr fun A ↦ ultrafilter_isOpen_basic (f ⁻¹' A)

/-- Pushforward along an injective map is injective on ultrafilters. -/
theorem ultrafilter_map_injective {f : S → T} (hf : Function.Injective f) :
    Function.Injective (fun p : Ultrafilter S ↦ p.map f) := by
  intro p q hpq
  apply Ultrafilter.coe_injective
  exact Filter.map_injective hf (congrArg (·.toFilter) hpq)

theorem ultrafilter_map_mul [Semigroup S] [Semigroup T] (f : S →ₙ* T) (p q : Ultrafilter S) :
    (p * q).map f = p.map f * q.map f := by
  apply Ultrafilter.coe_injective
  apply Filter.ext'
  intro P
  simp only [Ultrafilter.coe_map, Filter.eventually_map, Ultrafilter.eventually_mul, map_mul]

theorem pure_mul_as_map [Semigroup S] (s : S) (p : Ultrafilter S) :
    (pure s : Ultrafilter S) * p = p.map (s * ·) := by
  apply Ultrafilter.coe_injective
  apply Filter.ext'
  intro P
  simp only [Ultrafilter.eventually_mul, Ultrafilter.coe_pure, Filter.eventually_pure,
    Ultrafilter.coe_map, Filter.eventually_map]

/-- Every point of the smallest ideal has a right identity in that ideal. -/
theorem exists_idempotent_right_identity_of_mem_smallestIdeal
    [Semigroup T] [Nonempty T] [TopologicalSpace T] [T2Space T] [CompactSpace T]
    (continuousRight : ∀ b : T, Continuous (· * b)) {p : T} (hp : p ∈ smallestIdeal T) :
    ∃ e ∈ smallestIdeal T, e * e = e ∧ p * e = p := by
  obtain ⟨L, hCompact, hL, hpL⟩ :=
    exists_compact_minimalLeftIdeal_of_mem_smallestIdeal continuousRight hp
  obtain ⟨e, he, hee⟩ := exists_idempotent_in_compact_subsemigroup continuousRight
    L hL.1 hCompact fun a _ _ hb ↦ hL.2.1 a hb
  have hRange := principal_eq_of_minimalLeftIdeal hL he
  obtain ⟨a, ha⟩ := hRange.symm ▸ hpL
  refine ⟨e, minimalLeftIdeal_subset_smallestIdeal hL he, hee, ?_⟩
  rw [← ha, mul_assoc, hee]

section InverseTranslate

variable [Semigroup S] [Group G] {ι : S →ₙ* G}

/-- The inverse map on the group induces this map on its ultrafilters. -/
def ultrafilterInverse (p : Ultrafilter G) : Ultrafilter G := p.map Inv.inv

private theorem pure_inv_mul_mapped_pure_mul (ι : S →ₙ* G) (s : S) (q : Ultrafilter S) :
    (pure (ι s)⁻¹ : Ultrafilter G) * (((pure s : Ultrafilter S) * q).map ι) = q.map ι := by
  rw [pure_mul_as_map, pure_mul_as_map, Ultrafilter.map_map, Ultrafilter.map_map]
  congr 1
  funext z
  simp only [Function.comp_apply, map_mul, inv_mul_cancel_left]

/-- If a compact family of source ultrafilters admits preimages under every principal left
translation, the family embedded in the quotient group is closed under the inverse left
translates used in Section 2.5.2. -/
theorem inverse_product_mem_ultrafilterMap_of_surj_principal
    (ι : S →ₙ* G) {B : Set (Ultrafilter S)} (hB : IsClosed B)
    (hSurj : ∀ s : S, ∀ p ∈ B, ∃ r ∈ B, (pure s : Ultrafilter S) * r = p)
    {p : Ultrafilter S} (hp : p ∈ B) (q : Ultrafilter S) :
    ultrafilterInverse (q.map ι) * p.map ι ∈ (fun r : Ultrafilter S ↦ r.map ι) '' B := by
  let C := (fun r : Ultrafilter S ↦ r.map ι) '' B
  have hC : IsClosed C := (hB.isCompact.image (continuous_ultrafilter_map ι)).isClosed
  let f : Ultrafilter S → Ultrafilter G :=
    fun r ↦ ultrafilterInverse (r.map ι) * p.map ι
  have hf : Continuous f := (Ultrafilter.continuous_mul_left (p.map ι)).comp
    ((continuous_ultrafilter_map Inv.inv).comp (continuous_ultrafilter_map ι))
  have hDense : range (pure : S → Ultrafilter S) ⊆ f ⁻¹' C := by
    rintro _ ⟨s, rfl⟩
    obtain ⟨r, hr, hsr⟩ := hSurj s p hp
    refine ⟨r, hr, ?_⟩
    change r.map ι = ultrafilterInverse ((pure s : Ultrafilter S).map ι) * p.map ι
    rw [← hsr, ultrafilterInverse, Ultrafilter.map_pure, Ultrafilter.map_pure]
    exact (pure_inv_mul_mapped_pure_mul ι s r).symm
  exact closure_minimal hDense (hC.preimage hf) (denseRange_pure q)

private theorem principal_mul_preimage_smallestIdeal [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) (s : S) {p : Ultrafilter S}
    (hp : p ∈ smallestIdeal (Ultrafilter S)) :
    ∃ q ∈ smallestIdeal (Ultrafilter S), (pure s : Ultrafilter S) * q = p := by
  have hLarge : range (s * ·) ∈ p :=
    isThicklySyndetic_iff_forall_mem_closure_smallestIdeal.mp
      (thicklySyndetic_principal_right_ideal hι.isLeftReversible s) p (subset_closure hp)
  have hInject : Function.Injective (s * ·) := by
    intro a b hab
    apply hι.1
    exact mul_left_cancel (by simpa only [map_mul] using congrArg ι hab)
  let q := p.comap hInject hLarge
  have hMul : (pure s : Ultrafilter S) * q = p := by
    rw [pure_mul_as_map]
    exact Ultrafilter.coe_injective (Filter.map_comap_of_mem hLarge)
  obtain ⟨e, he, _, hpe⟩ :=
    exists_idempotent_right_identity_of_mem_smallestIdeal Ultrafilter.continuous_mul_left hp
  have hqe : q * e = q := by
    apply ultrafilter_map_injective hInject
    have hMul' : (pure s : Ultrafilter S) * (q * e) = (pure s : Ultrafilter S) * q := by
      rw [← mul_assoc, hMul, hpe]
    simpa only [pure_mul_as_map] using hMul'
  refine ⟨q, ?_, hMul⟩
  rw [← hqe]
  exact (smallestIdeal_isTwoSidedIdeal (M := Ultrafilter S)).1 q he

/-- Principal left multiplication preserves surjectivity on the closure of the smallest ideal
of the Stone–Čech semigroup of a semigroup embedded in its group of right quotients. -/
theorem principal_mul_surj_closure_smallestIdeal [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) (s : S) {p : Ultrafilter S}
    (hp : p ∈ closure (smallestIdeal (Ultrafilter S))) :
    ∃ q ∈ closure (smallestIdeal (Ultrafilter S)), (pure s : Ultrafilter S) * q = p := by
  let C := closure (smallestIdeal (Ultrafilter S))
  let L := fun q : Ultrafilter S ↦ (pure s : Ultrafilter S) * q
  have hL : Continuous L := by
    simpa only [L, pure_mul_as_map] using continuous_ultrafilter_map (s * ·)
  have hClosed : IsClosed (L '' C) := (isClosed_closure.isCompact.image hL).isClosed
  have hSubset : smallestIdeal (Ultrafilter S) ⊆ L '' C := by
    intro a ha
    obtain ⟨q, hq, hqa⟩ := principal_mul_preimage_smallestIdeal hι s ha
    exact ⟨q, subset_closure hq, hqa⟩
  exact closure_minimal hSubset hClosed hp

/-- The inverse-translate property used in Theorem 5.2(iii). In the quotient group,
`q⁻¹ * p` still belongs to the embedded closure of the smallest ideal. -/
theorem inverse_product_mem_ultrafilterMap_closure_smallestIdeal [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) {p : Ultrafilter S}
    (hp : p ∈ closure (smallestIdeal (Ultrafilter S))) (q : Ultrafilter S) :
    ultrafilterInverse (q.map ι) * p.map ι ∈ (fun r : Ultrafilter S ↦ r.map ι) ''
      closure (smallestIdeal (Ultrafilter S)) :=
  inverse_product_mem_ultrafilterMap_of_surj_principal ι isClosed_closure
    (fun s _ hs ↦ principal_mul_surj_closure_smallestIdeal hι s hs) hp q

end InverseTranslate

end JdLG

end

end UltrafilterMoreStoneCechDevelopment

/- Source: JdLG/UltrafilterMoreDensity.lean -/
section UltrafilterMoreDensityDevelopment

/-!
# Essential ultrafilters on discrete semigroups

Upper Banach density is used here through positivity of a left invariant mean
on sets. The resulting essential ultrafilters form a closed two-sided ideal
and admit the inverse translates in the group of right quotients.
-/

@[expose] public section

open Filter Set

namespace JdLG

/-- A left invariant mean evaluated on indicator functions, in its finitely additive form. -/
structure LeftInvariantSetMean (S : Type*) [Semigroup S] where
  mass : Set S → ℝ
  nonneg (A : Set S) : 0 ≤ mass A
  empty : mass ∅ = 0
  univ : mass univ = 1
  add_disjoint {A B : Set S} (h : Disjoint A B) : mass (A ∪ B) = mass A + mass B
  invariant (s : S) (A : Set S) : mass ((s * ·) ⁻¹' A) = mass A

variable {S : Type*} [Semigroup S]

theorem LeftInvariantSetMean.mass_mono (m : LeftInvariantSetMean S) {A B : Set S}
    (h : A ⊆ B) : m.mass A ≤ m.mass B := by
  have hAdd := m.add_disjoint (disjoint_sdiff_right (s := A) (t := B))
  rw [union_sdiff_self, union_eq_right.mpr h] at hAdd
  linarith [m.nonneg (B \ A)]

theorem LeftInvariantSetMean.mass_compl (m : LeftInvariantSetMean S) (A : Set S) :
    m.mass Aᶜ = 1 - m.mass A := by
  have hAdd := m.add_disjoint (disjoint_compl_right : Disjoint A Aᶜ)
  rw [union_compl_self, m.univ] at hAdd
  linarith

theorem LeftInvariantSetMean.mass_union_le (m : LeftInvariantSetMean S) (A B : Set S) :
    m.mass (A ∪ B) ≤ m.mass A + m.mass B := by
  have hAdd := m.add_disjoint (disjoint_sdiff_right (s := A) (t := B))
  rw [union_sdiff_self] at hAdd
  rw [hAdd]
  exact add_le_add le_rfl (m.mass_mono sdiff_subset)

/-- Convolving on the right by an ultrafilter preserves left invariance. -/
def LeftInvariantSetMean.rightConvolve (m : LeftInvariantSetMean S) (p : Ultrafilter S) :
    LeftInvariantSetMean S where
  mass A := m.mass {s | (s * ·) ⁻¹' A ∈ p}
  nonneg _ := m.nonneg _
  empty := by simp [m.empty]
  univ := by
    have h : {s : S | (s * ·) ⁻¹' (Set.univ : Set S) ∈ p} = Set.univ := by
      ext s
      exact iff_true_intro (Filter.univ_mem (f := (p : Filter S)))
    rw [h, m.univ]
  add_disjoint := by
    intro A B hAB
    have hDisjoint : Disjoint {s | (s * ·) ⁻¹' A ∈ p} {s | (s * ·) ⁻¹' B ∈ p} := by
      apply Set.disjoint_left.mpr
      intro s hs ht
      have h := inter_mem hs ht
      rw [← preimage_inter, Set.disjoint_iff_inter_eq_empty.mp hAB, preimage_empty] at h
      exact p.empty_notMem h
    have hUnion : {s | (s * ·) ⁻¹' (A ∪ B) ∈ p} =
        {s | (s * ·) ⁻¹' A ∈ p} ∪ {s | (s * ·) ⁻¹' B ∈ p} := by
      ext s
      simp only [mem_ofPred_eq, mem_union, preimage_union, Ultrafilter.union_mem_iff]
    rw [hUnion, m.add_disjoint hDisjoint]
  invariant s A := by
    have h : {x | (x * ·) ⁻¹' ((s * ·) ⁻¹' A) ∈ p} =
        (s * ·) ⁻¹' {x | (x * ·) ⁻¹' A ∈ p} := by
      ext x
      simp only [mem_ofPred_eq, mem_preimage]
      have heq : (x * ·) ⁻¹' ((s * ·) ⁻¹' A) = ((s * x) * ·) ⁻¹' A := by
        ext y
        simp only [mem_preimage, mul_assoc]
      rw [heq]
    rw [h, m.invariant]

/-- Positive upper Banach density in terms of an indicator mean. -/
def HasPositiveBanachDensity (A : Set S) : Prop :=
  ∃ m : LeftInvariantSetMean S, 0 < m.mass A

/-- The space `D*` of ultrafilters for which every member has positive upper Banach density. -/
def essentialUltrafilters (S : Type*) [Semigroup S] : Set (Ultrafilter S) :=
  {p | ∀ A ∈ p, HasPositiveBanachDensity A}

theorem mem_essentialUltrafilters_of_dominates (m : LeftInvariantSetMean S) {p : Ultrafilter S}
    (h : ∀ A : Set S, m.mass Aᶜ = 0 → A ∈ p) : p ∈ essentialUltrafilters S := by
  intro A hA
  refine ⟨m, ?_⟩
  by_contra hNot
  have hZero : m.mass A = 0 := le_antisymm (le_of_not_gt hNot) (m.nonneg A)
  exact (Ultrafilter.compl_mem_iff_notMem.mp (h Aᶜ (by rwa [compl_compl]))) hA

/-- Every left invariant mean on sets is positive on the members of some ultrafilter. -/
theorem essentialUltrafilters_nonempty (m : LeftInvariantSetMean S) :
    (essentialUltrafilters S).Nonempty := by
  let F : Filter S :=
    { sets := {A | m.mass Aᶜ = 0}
      univ_sets := by simp [m.empty]
      sets_of_superset := fun {A B} hA hAB ↦
        le_antisymm ((m.mass_mono (compl_subset_compl.mpr hAB)).trans_eq hA) (m.nonneg Bᶜ)
      inter_sets := fun {A B} hA hB ↦ by
        change m.mass (A ∩ B)ᶜ = 0
        rw [compl_inter]
        apply le_antisymm _ (m.nonneg (Aᶜ ∪ Bᶜ))
        exact (m.mass_union_le Aᶜ Bᶜ).trans_eq (by rw [hA, hB, add_zero]) }
  have hF : F.NeBot := by
    refine Filter.neBot_iff.mpr fun hb ↦ ?_
    have he := Filter.empty_mem_iff_bot.mpr hb
    change m.mass (∅ : Set S)ᶜ = 0 at he
    simp [m.univ] at he
  let p := @Ultrafilter.of S F hF
  exact ⟨p, mem_essentialUltrafilters_of_dominates m fun A hA ↦ Ultrafilter.of_le F hA⟩

theorem isClosed_essentialUltrafilters : IsClosed (essentialUltrafilters S) := by
  have hEq : essentialUltrafilters S = ⋂ A : {A : Set S // ¬ HasPositiveBanachDensity A},
      {p : Ultrafilter S | A.1 ∉ p} := by
    ext p
    simp only [essentialUltrafilters, mem_ofPred_eq, mem_iInter]
    constructor
    · exact fun h A hA ↦ A.2 (h A.1 hA)
    · exact fun h A hA ↦ by_contradiction fun hNot ↦ h ⟨A, hNot⟩ hA
  rw [hEq]
  exact isClosed_iInter fun A ↦ (ultrafilter_isOpen_basic A.1).isClosed_compl

/-- The essential ultrafilters are a two-sided ideal. -/
theorem essentialUltrafilters_isTwoSidedIdeal : IsTwoSidedIdeal (essentialUltrafilters S) := by
  constructor
  · intro q p hp A hA
    change (∀ᶠ z in ((q * p : Ultrafilter S) : Filter S), z ∈ A) at hA
    rw [Ultrafilter.eventually_mul] at hA
    obtain ⟨s, hs⟩ := hA.exists
    obtain ⟨m, hm⟩ := hp ((s * ·) ⁻¹' A) hs
    exact ⟨m, (m.invariant s A) ▸ hm⟩
  · intro p hp q A hA
    change (∀ᶠ z in ((p * q : Ultrafilter S) : Filter S), z ∈ A) at hA
    rw [Ultrafilter.eventually_mul] at hA
    obtain ⟨m, hm⟩ := hp {s | (s * ·) ⁻¹' A ∈ q} hA
    exact ⟨m.rightConvolve q, hm⟩

theorem closure_smallestIdeal_subset_essentialUltrafilters (m : LeftInvariantSetMean S) :
    closure (smallestIdeal (Ultrafilter S)) ⊆ essentialUltrafilters S :=
  closure_minimal (smallestIdeal_subset (essentialUltrafilters_nonempty m)
    essentialUltrafilters_isTwoSidedIdeal) isClosed_essentialUltrafilters

variable {G : Type*} [Group G] {ι : S →ₙ* G}

/-- Each principal left translation is onto the essential ultrafilters. -/
theorem principal_mul_surj_essentialUltrafilters (hι : Function.Injective ι)
    (s : S) {p : Ultrafilter S} (hp : p ∈ essentialUltrafilters S) :
    ∃ q ∈ essentialUltrafilters S, (pure s : Ultrafilter S) * q = p := by
  have hInject : Function.Injective (s * ·) := by
    intro a b hab
    apply hι
    exact mul_left_cancel (by simpa only [map_mul] using congrArg ι hab)
  have hLarge : range (s * ·) ∈ p := by
    by_contra hNot
    obtain ⟨m, hm⟩ := hp (range (s * ·))ᶜ (Ultrafilter.compl_mem_iff_notMem.mpr hNot)
    have hRange : m.mass (range (s * ·)) = 1 := by
      rw [← m.invariant s]
      simp [m.univ]
    rw [m.mass_compl, hRange, sub_self] at hm
    exact lt_irrefl _ hm
  let q := p.comap hInject hLarge
  refine ⟨q, ?_, ?_⟩
  · intro A hA
    obtain ⟨m, hm⟩ := hp ((s * ·) '' A) ((p.mem_comap hInject hLarge).mp hA)
    rw [← m.invariant s, preimage_image_eq _ hInject] at hm
    exact ⟨m, hm⟩
  · rw [pure_mul_as_map]
    exact Ultrafilter.coe_injective (Filter.map_comap_of_mem hLarge)

/-- The inverse translates of essential ultrafilters used in Theorem 5.2(iv) remain in `D*`. -/
theorem inverse_product_mem_ultrafilterMap_essentialUltrafilters
    (hι : Function.Injective ι) {p : Ultrafilter S} (hp : p ∈ essentialUltrafilters S)
    (q : Ultrafilter S) :
    ultrafilterInverse (q.map ι) * p.map ι ∈
      (fun r : Ultrafilter S ↦ r.map ι) '' essentialUltrafilters S :=
  inverse_product_mem_ultrafilterMap_of_surj_principal ι isClosed_essentialUltrafilters
    (fun s _ hs ↦ principal_mul_surj_essentialUltrafilters hι s hs) hp q

end JdLG

end

end UltrafilterMoreDensityDevelopment

/- Source: JdLG/UltrafilterMoreIdeal.lean -/
section UltrafilterMoreIdealDevelopment

/-! # Stone–Čech ideals in the group of right quotients -/

@[expose] public section

open Filter Set

namespace JdLG

variable {S G : Type*} [Semigroup S] [Group G] {ι : S →ₙ* G}

private theorem pure_mul_pure_eq {M : Type*} [Semigroup M] (a b : M) :
    (pure a : Ultrafilter M) * pure b = pure (a * b) := by
  rw [pure_mul_as_map, Ultrafilter.map_pure]

private theorem ultrafilter_image_isLeftIdeal_of_surj_principal (hι : IsGroupOfRightQuotients ι)
    {D : Set (Ultrafilter S)} (hD : IsClosed D)
    (hLeft : ∀ a : Ultrafilter S, ∀ {p : Ultrafilter S}, p ∈ D → a * p ∈ D)
    (hSurj : ∀ b : S, ∀ p ∈ D, ∃ r ∈ D, (pure b : Ultrafilter S) * r = p) :
    ∀ a : Ultrafilter G, ∀ {p : Ultrafilter G},
      p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' D →
      a * p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' D := by
  rintro a _ ⟨p, hp, rfl⟩
  let C := (fun u : Ultrafilter S ↦ u.map ι) '' D
  have hC : IsClosed C := (hD.isCompact.image (continuous_ultrafilter_map ι)).isClosed
  let f : Ultrafilter G → Ultrafilter G := (· * p.map ι)
  have hf : Continuous f := Ultrafilter.continuous_mul_left (p.map ι)
  have hRange : range (pure : G → Ultrafilter G) ⊆ f ⁻¹' C := by
    rintro _ ⟨g, rfl⟩
    obtain ⟨u, v, rfl⟩ := hι.2 g
    obtain ⟨r, hr, hvr⟩ := hSurj v p hp
    refine ⟨pure u * r, hLeft (pure u) hr, ?_⟩
    change (pure u * r).map ι = pure (ι u * (ι v)⁻¹) * p.map ι
    rw [ultrafilter_map_mul, Ultrafilter.map_pure]
    nth_rewrite 1 [← hvr]
    rw [ultrafilter_map_mul, Ultrafilter.map_pure, ← mul_assoc, pure_mul_pure_eq,
      inv_mul_cancel_right]
  exact closure_minimal hRange (hC.preimage hf) (denseRange_pure a)

/-- The embedded closure of the smallest ideal in βS is a left ideal in βG. -/
theorem ultrafilter_image_closure_smallestIdeal_isLeftIdeal [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) (a : Ultrafilter G) {p : Ultrafilter G}
    (hp : p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' closure (smallestIdeal (Ultrafilter S))) :
    a * p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' closure (smallestIdeal (Ultrafilter S)) := by
  apply ultrafilter_image_isLeftIdeal_of_surj_principal hι isClosed_closure _ _ a hp
  · intro b q hq
    have hmem : ∀ s : S, (pure s : Ultrafilter S) * q ∈
        closure (smallestIdeal (Ultrafilter S)) := by
      intro s
      let f : Ultrafilter S → Ultrafilter S := ((pure s : Ultrafilter S) * ·)
      have hf : Continuous f := by
        simpa only [f, pure_mul_as_map] using continuous_ultrafilter_map (s * ·)
      exact closure_minimal (s := smallestIdeal (Ultrafilter S))
        (t := f ⁻¹' closure (smallestIdeal (Ultrafilter S)))
        (fun _ ht ↦ subset_closure ((smallestIdeal_isTwoSidedIdeal (M := Ultrafilter S)).1 _ ht))
        (isClosed_closure.preimage hf) hq
    apply closure_minimal (s := range (pure : S → Ultrafilter S))
      (t := (· * q) ⁻¹' closure (smallestIdeal (Ultrafilter S))) _
      (isClosed_closure.preimage (Ultrafilter.continuous_mul_left q)) (denseRange_pure b)
    rintro _ ⟨s, rfl⟩
    exact hmem s
  · exact fun s _ hs ↦ principal_mul_surj_closure_smallestIdeal hι s hs

/-- The embedded smallest ideal in βS is a left ideal in βG. -/
theorem ultrafilter_image_smallestIdeal_isLeftIdeal [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) (a : Ultrafilter G) {p : Ultrafilter G}
    (hp : p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' smallestIdeal (Ultrafilter S)) :
    a * p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' smallestIdeal (Ultrafilter S) := by
  obtain ⟨q, hq, rfl⟩ := hp
  obtain ⟨r, _, hr⟩ := ultrafilter_image_closure_smallestIdeal_isLeftIdeal hι a
    ⟨q, subset_closure hq, rfl⟩
  obtain ⟨e, he, _, hqe⟩ := exists_idempotent_right_identity_of_mem_smallestIdeal
    Ultrafilter.continuous_mul_left hq
  have hre : r * e = r := by
    apply ultrafilter_map_injective hι.1
    change (r * e).map ι = r.map ι
    change r.map ι = a * q.map ι at hr
    rw [ultrafilter_map_mul, hr, mul_assoc, ← ultrafilter_map_mul, hqe]
  exact ⟨r, hre ▸ (smallestIdeal_isTwoSidedIdeal (M := Ultrafilter S)).1 r he, hr⟩

/-- The embedded essential ultrafilters of βS form a left ideal in βG. -/
theorem ultrafilter_image_essentialUltrafilters_isLeftIdeal
    (hι : IsGroupOfRightQuotients ι) (a : Ultrafilter G) {p : Ultrafilter G}
    (hp : p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' essentialUltrafilters S) :
    a * p ∈ (fun u : Ultrafilter S ↦ u.map ι) '' essentialUltrafilters S :=
  ultrafilter_image_isLeftIdeal_of_surj_principal hι isClosed_essentialUltrafilters
    essentialUltrafilters_isTwoSidedIdeal.1
    (fun s _ hs ↦ principal_mul_surj_essentialUltrafilters hι.1 s hs) a hp

end JdLG

end

end UltrafilterMoreIdealDevelopment

/- Source: JdLG/UltrafilterMoreQuotientFacts.lean -/
section UltrafilterMoreQuotientFactsDevelopment

/-! # Thickness, smallest ideals, and density in the group of right quotients -/

public section

open Filter Set

namespace JdLG

variable {S G : Type*} [Semigroup S] [Group G]

/-- A group of right quotients contains the semigroup as a thick set. -/
theorem IsGroupOfRightQuotients.isThick_range {ι : S →ₙ* G} [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) : IsThick (range ι) := by
  classical
  have hAll (F : Finset G) : ∃ x : S, ∀ g ∈ F, g * ι x ∈ range ι := by
    induction F using Finset.induction_on with
    | empty => exact ⟨Classical.arbitrary S, by simp⟩
    | @insert g F _ ih =>
      obtain ⟨x, hx⟩ := ih
      obtain ⟨a, b, rfl⟩ := hι.2 g
      obtain ⟨u, v, huv⟩ := hι.isLeftReversible x b
      refine ⟨x * u, fun g hg ↦ ?_⟩
      rcases Finset.mem_insert.mp hg with rfl | hg
      · refine ⟨a * v, ?_⟩
        simp [huv, map_mul, mul_assoc]
      · obtain ⟨z, hz⟩ := hx g hg
        exact ⟨z * u, by rw [map_mul, map_mul, ← mul_assoc, hz]⟩
  intro F
  obtain ⟨x, hx⟩ := hAll F
  exact ⟨ι x, hx⟩

/-- In the ambient Stone–Čech space, the image of the source consists exactly of
ultrafilters containing the embedded semigroup. -/
theorem ultrafilterMap_range_eq {ι : S →ₙ* G} (hι : Function.Injective ι) :
    range (fun p : Ultrafilter S ↦ p.map ι) = {q | range ι ∈ q} := by
  ext p
  constructor
  · rintro ⟨q, rfl⟩
    change ι ⁻¹' range ι ∈ q
    rw [preimage_range]
    exact Filter.univ_mem
  · intro hp
    exact ⟨p.comap hι hp, Ultrafilter.coe_injective (Filter.map_comap_of_mem hp)⟩

/-- The smallest ideal of the embedded Stone–Čech semigroup is its intersection
with the ambient smallest ideal. -/
theorem ultrafilterMap_smallestIdeal_eq_inter {ι : S →ₙ* G} [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) :
    (fun p : Ultrafilter S ↦ p.map ι) '' smallestIdeal (Ultrafilter S) =
      range (fun p : Ultrafilter S ↦ p.map ι) ∩ smallestIdeal (Ultrafilter G) := by
  let C := (fun p : Ultrafilter S ↦ p.map ι) '' smallestIdeal (Ultrafilter S)
  let P := (fun p : Ultrafilter S ↦ p.map ι) ⁻¹' smallestIdeal (Ultrafilter G)
  obtain ⟨e, he, _⟩ := exists_idempotent_ultrafilter_in_smallestIdeal (S := S)
  obtain ⟨k, hk, _⟩ := exists_idempotent_ultrafilter_in_smallestIdeal (S := G)
  have hP : P.Nonempty := by
    obtain ⟨r, _, hr⟩ := ultrafilter_image_smallestIdeal_isLeftIdeal hι k ⟨e, he, rfl⟩
    refine ⟨r, ?_⟩
    change r.map ι ∈ smallestIdeal (Ultrafilter G)
    change r.map ι = k * e.map ι at hr
    rw [hr]
    exact smallestIdeal_isTwoSidedIdeal.2 hk _
  have hIdealP : IsTwoSidedIdeal P := by
    constructor
    · intro a b hb
      change (a * b).map ι ∈ smallestIdeal (Ultrafilter G)
      rw [ultrafilter_map_mul]
      exact smallestIdeal_isTwoSidedIdeal.1 _ hb
    · intro a ha b
      change (a * b).map ι ∈ smallestIdeal (Ultrafilter G)
      rw [ultrafilter_map_mul]
      exact smallestIdeal_isTwoSidedIdeal.2 ha _
  ext q
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨⟨p, rfl⟩, smallestIdeal_subset hP hIdealP hp⟩
  · rintro ⟨⟨p, rfl⟩, hp⟩
    obtain ⟨L, _, hL, hLp⟩ := exists_compact_minimalLeftIdeal_of_mem_smallestIdeal
      Ultrafilter.continuous_mul_left hp
    have h₁ : e.map ι * p.map ι ∈ L := hL.2.1 _ hLp
    have h₂ : e.map ι * p.map ι ∈ C :=
      ⟨e * p, smallestIdeal_isTwoSidedIdeal.2 he _, ultrafilter_map_mul ι e p⟩
    obtain ⟨a, ha⟩ := (principal_eq_of_minimalLeftIdeal hL h₁).symm ▸ hLp
    rw [← ha]
    exact ultrafilter_image_smallestIdeal_isLeftIdeal hι a h₂

/-- The corresponding intersection identity for the closures of the smallest ideals. -/
theorem ultrafilterMap_closure_smallestIdeal_eq_inter {ι : S →ₙ* G} [Nonempty S]
    (hι : IsGroupOfRightQuotients ι) :
    (fun p : Ultrafilter S ↦ p.map ι) '' closure (smallestIdeal (Ultrafilter S)) =
      range (fun p : Ultrafilter S ↦ p.map ι) ∩ closure (smallestIdeal (Ultrafilter G)) := by
  let f : Ultrafilter S → Ultrafilter G := fun p ↦ p.map ι
  have hf : Continuous f := continuous_ultrafilter_map ι
  have hR : IsClopen (range f) := by
    dsimp only [f]
    rw [ultrafilterMap_range_eq hι.1]
    exact ⟨ultrafilter_isClosed_basic (range ι), ultrafilter_isOpen_basic (range ι)⟩
  have himage : f '' closure (smallestIdeal (Ultrafilter S)) =
      closure (f '' smallestIdeal (Ultrafilter S)) :=
    subset_antisymm (image_closure_subset_closure_image hf)
      (closure_minimal (image_mono subset_closure) (isClosed_closure.isCompact.image hf).isClosed)
  change f '' closure (smallestIdeal (Ultrafilter S)) = _
  rw [himage, ultrafilterMap_smallestIdeal_eq_inter hι]
  refine subset_antisymm (closure_minimal (inter_subset_inter_right _ subset_closure)
      (hR.isClosed.inter isClosed_closure)) ?_
  intro p hp
  apply mem_closure_iff.mpr
  intro U hU hpU
  obtain ⟨y, hy, hyK⟩ := mem_closure_iff.mp hp.2 (U ∩ range f) (hU.inter hR.isOpen) ⟨hpU, hp.1⟩
  exact ⟨y, hy.1, hy.2, hyK⟩

/-- Left amenability implies left reversibility. -/
theorem leftReversible_of_leftInvariantSetMean (m : LeftInvariantSetMean S) :
    IsLeftReversible S := by
  intro a b
  have hrange (s : S) : m.mass (range (s * ·)) = 1 := by
    rw [← m.invariant s]
    simp [m.univ]
  have hNonempty : (range (a * ·) ∩ range (b * ·)).Nonempty := by
    by_contra h
    have hd : Disjoint (range (a * ·)) (range (b * ·)) :=
      Set.disjoint_iff_inter_eq_empty.mpr (Set.not_nonempty_iff_eq_empty.mp h)
    have hadd := m.add_disjoint hd
    have hBound := m.mass_mono (subset_univ (range (a * ·) ∪ range (b * ·)))
    rw [hrange, hrange] at hadd
    linarith [m.univ]
  obtain ⟨_, ⟨u, hu⟩, ⟨v, hv⟩⟩ := hNonempty
  exact ⟨u, v, hu.trans hv.symm⟩

/-- A left invariant mean on the semigroup extends to the group of right
quotients by pulling back sets to the semigroup. -/
def LeftInvariantSetMean.extendRightQuotients {ι : S →ₙ* G} (m : LeftInvariantSetMean S)
    (hι : IsGroupOfRightQuotients ι) : LeftInvariantSetMean G where
  mass A := m.mass (ι ⁻¹' A)
  nonneg A := m.nonneg _
  empty := m.empty
  univ := m.univ
  add_disjoint h := m.add_disjoint (h.preimage ι)
  invariant g A := by
    let v (A : Set G) := m.mass (ι ⁻¹' A)
    have hl (s : S) (A : Set G) : v ((ι s * ·) ⁻¹' A) = v A := by
      have hpre : ι ⁻¹' ((ι s * ·) ⁻¹' A) = (s * ·) ⁻¹' (ι ⁻¹' A) := by
        ext a
        simp only [mem_preimage, map_mul]
      exact (congrArg m.mass hpre).trans (m.invariant s _)
    have hi (s : S) (A : Set G) : v (((ι s)⁻¹ * ·) ⁻¹' A) = v A := by
      have heq : (ι s * ·) ⁻¹' (((ι s)⁻¹ * ·) ⁻¹' A) = A := by
        ext a
        simp only [mem_preimage, inv_mul_cancel_left]
      have h := hl s (((ι s)⁻¹ * ·) ⁻¹' A)
      rw [heq] at h
      exact h.symm
    obtain ⟨a, b, rfl⟩ := hι.2 g
    change v ((ι a * (ι b)⁻¹ * ·) ⁻¹' A) = v A
    have heq : (ι a * (ι b)⁻¹ * ·) ⁻¹' A = ((ι b)⁻¹ * ·) ⁻¹' ((ι a * ·) ⁻¹' A) := by
      ext c
      simp only [mem_preimage, mul_assoc]
    rw [heq, hi, hl]

/-- Every embedded essential ultrafilter remains essential in the group of right quotients. -/
theorem ultrafilterMap_essentialUltrafilters_subset {ι : S →ₙ* G}
    (hι : IsGroupOfRightQuotients ι) :
    (fun p : Ultrafilter S ↦ p.map ι) '' essentialUltrafilters S ⊆ essentialUltrafilters G := by
  rintro _ ⟨p, hp, rfl⟩ A hA
  obtain ⟨m, hm⟩ := hp (ι ⁻¹' A) hA
  exact ⟨m.extendRightQuotients hι, hm⟩

/-- The nonnegative integers embed in their additive group of differences. -/
theorem nat_int_groupOfRightQuotients :
    IsGroupOfRightQuotients (Int.ofNatHom.toMultiplicative.toMulHom) := by
  constructor
  · intro a b hab
    change ((a.toAdd : ℕ) : ℤ) = ((b.toAdd : ℕ) : ℤ) at hab
    exact congrArg Multiplicative.ofAdd (Int.ofNat.inj hab)
  · intro g
    refine ⟨Multiplicative.ofAdd g.toAdd.toNat, Multiplicative.ofAdd (-g.toAdd).toNat, ?_⟩
    change g.toAdd = (g.toAdd.toNat : ℤ) + -(((-g.toAdd).toNat : ℕ) : ℤ)
    omega

/-- The nonzero integers form a multiplicative subsemigroup. -/
def nonzeroIntSemigroup : Subsemigroup ℤ where
  carrier := {x | x ≠ 0}
  mul_mem' := mul_ne_zero

/-- The canonical embedding of the nonzero integers into the nonzero rationals. -/
def nonzeroInt_to_ratUnits : nonzeroIntSemigroup →ₙ* ℚˣ where
  toFun a := Units.mk0 (((a : ℤ) : ℚ)) (by exact_mod_cast a.property)
  map_mul' a b := Units.ext (Int.cast_mul (a : ℤ) (b : ℤ))

/-- The nonzero rationals form the multiplicative group of right quotients of the
nonzero integers. -/
theorem nonzeroInt_rat_groupOfRightQuotients : IsGroupOfRightQuotients nonzeroInt_to_ratUnits := by
  constructor
  · intro a b hab
    apply Subtype.ext
    have h := congrArg (fun q : ℚˣ ↦ (q : ℚ)) hab
    change ((a : ℤ) : ℚ) = ((b : ℤ) : ℚ) at h
    exact_mod_cast h
  · intro g
    have hnd : ((g : ℚ).num : ℚ) / ((g : ℚ).den : ℚ) = (g : ℚ) := Rat.num_div_den _
    have hn : (g : ℚ).num ≠ 0 := by
      intro h
      apply g.ne_zero
      rw [← hnd, h, Int.cast_zero, zero_div]
    have hd : ((g : ℚ).den : ℤ) ≠ 0 := by
      exact_mod_cast Rat.den_nz (g : ℚ)
    refine ⟨⟨(g : ℚ).num, hn⟩, ⟨(g : ℚ).den, hd⟩, ?_⟩
    apply Units.ext
    change (g : ℚ) = ((g : ℚ).num : ℚ) * ((((g : ℚ).den : ℕ) : ℤ) : ℚ)⁻¹
    rw [Int.cast_natCast, ← div_eq_mul_inv, hnd]

end JdLG

end

end UltrafilterMoreQuotientFactsDevelopment

