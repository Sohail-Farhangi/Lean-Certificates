    change (f + t • g) x = f x + (t • g) x at h₁
    change (t • g) x = t • g x at h₂
    change ‖(f + t • g) x‖ ^ r = ‖f x + t • g x‖ ^ r
    rw [h₁, h₂]
  rw [show (fun t : ℝ ↦ ‖f + t • g‖ ^ p.toReal) =
    (fun t : ℝ ↦ ∫ x, F t x ∂μ) from funext hEq]
  exact hid.differentiableAt

