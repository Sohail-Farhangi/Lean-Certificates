        intro c f
        apply Lp.ext
        filter_upwards [(hm (c • f)).coeFn_toLp, (hm f).coeFn_toLp,
          Lp.coeFn_smul c f, Lp.coeFn_smul c ((hm f).toLp _)] with x ha hf hcf hs
