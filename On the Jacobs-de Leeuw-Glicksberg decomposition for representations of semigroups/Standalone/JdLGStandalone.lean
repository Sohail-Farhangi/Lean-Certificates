    rcases hpull D hD with h | h
    · left
      apply le_antisymm _ bot_le
      intro y hy
      obtain ⟨x, hx, rfl⟩ := hDW hy
      have hx' : x ∈ A ⊓ D.comap T.toLinearMap := ⟨hx, hy⟩
