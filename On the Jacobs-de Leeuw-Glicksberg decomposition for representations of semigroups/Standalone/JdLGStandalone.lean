    · left
      apply le_antisymm _ bot_le
      intro y hy
      obtain ⟨x, hx, rfl⟩ := hV hy
      have hx' : x ∈ Z := ⟨hx, hy⟩
      rw [h, Submodule.mem_bot] at hx'
