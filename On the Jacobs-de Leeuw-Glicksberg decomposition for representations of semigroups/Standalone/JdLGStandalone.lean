      rw [normalizedRestrictedMeasure_real_eq_div Measure.count (F : Set S) hB,
        inter_eq_left.2 (show B ⊆ (F : Set S) from Finset.sdiff_subset)]
      simp only [B, Measure.real, Measure.count_apply_finset, ENNReal.toReal_natCast]
