variable (Y : Submodule 𝕜 E) (π : S →ₙ* (E →L[𝕜] E))
  (hY : ∀ s : S, ∀ x ∈ Y, π s x ∈ Y)

/-- The induced representation on the Banach quotient by a closed invariant subspace. -/
