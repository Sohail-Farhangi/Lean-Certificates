/-! # Countably additive realization of a discrete mean on the Stone–Čech space -/

@[expose] public section

open Filter MeasureTheory Set
open scoped BigOperators ENNReal

namespace JdLG

variable {S : Type*} [Semigroup S]

/-- The clopens of the Stone–Čech compactification form a ring of sets. -/
theorem stoneCechClopens_ring {S : Type*} :
    IsSetRing {U : Set (Ultrafilter S) | IsClopen U} where
  empty_mem := isClopen_empty
  union_mem := by
    intro U V hU hV
    exact (show IsClopen U from hU).union hV
  sdiff_mem := by
    intro U V hU hV
    exact (show IsClopen U from hU).diff hV

theorem mass_finite_sUnion (m : LeftInvariantSetMean S)
    (I : Finset (Set (Ultrafilter S))) (hI : (I : Set (Set (Ultrafilter S))).PairwiseDisjoint id) :
    ENNReal.ofReal (m.mass (pure ⁻¹' (⋃₀ (I : Set (Set (Ultrafilter S)))))) =
      ∑ U ∈ I, ENNReal.ofReal (m.mass (pure ⁻¹' U)) := by
  classical
  induction I using Finset.induction_on with
  | empty => simp [m.empty]
  | @insert U I hU ih =>
    have hI' : (I : Set (Set (Ultrafilter S))).PairwiseDisjoint id := by
      intro V hV W hW hVW
      exact hI (Finset.mem_insert_of_mem hV) (Finset.mem_insert_of_mem hW) hVW
    have hDis : Disjoint U (⋃₀ (I : Set (Set (Ultrafilter S)))) := by
      rw [sUnion_eq_biUnion, disjoint_iUnion₂_right]
      intro V hV
      exact hI (Finset.mem_insert_self U I) (Finset.mem_insert_of_mem hV)
        (fun h ↦ hU (h ▸ hV))
    rw [Finset.coe_insert, sUnion_insert, preimage_union,
      m.add_disjoint (hDis.preimage pure), ENNReal.ofReal_add (m.nonneg _) (m.nonneg _),
      Finset.sum_insert hU, ih hI']

/-- The clopen content induced by taking preimages of principal ultrafilters. -/
noncomputable def LeftInvariantSetMean.stoneCechContent (m : LeftInvariantSetMean S) :
    AddContent ℝ≥0∞ {U : Set (Ultrafilter S) | IsClopen U} where
  toFun U := ENNReal.ofReal (m.mass (pure ⁻¹' U))
  empty' := by simp [m.empty]
  sUnion' I _ hI _ := mass_finite_sUnion m I hI

theorem stoneCechContent_sigmaSubadditive (m : LeftInvariantSetMean S) :
    m.stoneCechContent.IsSigmaSubadditive := by
  intro f hf hUnion
  have hClopen : IsClopen (⋃ i, f i) := hUnion
  obtain ⟨I, hI⟩ := hClopen.isClosed.isCompact.elim_finite_subcover f
    (fun i ↦ (show IsClopen (f i) from hf i).isOpen) subset_rfl
  have hEq : (⋃ i, f i) = ⋃ i ∈ I, f i :=
    subset_antisymm hI (iUnion₂_subset fun _ _ ↦ subset_iUnion f _)
  calc
    m.stoneCechContent (⋃ i, f i) = m.stoneCechContent (⋃ i ∈ I, f i) := congrArg _ hEq
    _ ≤ ∑ i ∈ I, m.stoneCechContent (f i) :=
      addContent_biUnion_le stoneCechClopens_ring (fun i _ ↦ hf i)
    _ ≤ ∑' i, m.stoneCechContent (f i) := sum_le_tsum I

/-- The measurable structure generated by the Stone–Čech clopen sets. -/
@[instance_reducible]
def stoneCechClopenMeasurableSpace (S : Type*) : MeasurableSpace (Ultrafilter S) :=
  MeasurableSpace.generateFrom {U | IsClopen U}

attribute [local instance] stoneCechClopenMeasurableSpace

/-- The probability on the Stone–Čech clopen σ-algebra that realizes a set mean. -/
noncomputable def LeftInvariantSetMean.stoneCechMeasure (m : LeftInvariantSetMean S) :
    Measure (Ultrafilter S) :=
  m.stoneCechContent.measure stoneCechClopens_ring.isSetSemiring le_rfl
    (stoneCechContent_sigmaSubadditive m)

theorem LeftInvariantSetMean.stoneCechMeasure_clopen (m : LeftInvariantSetMean S)
    {U : Set (Ultrafilter S)} (hU : IsClopen U) :
    m.stoneCechMeasure U = ENNReal.ofReal (m.mass (pure ⁻¹' U)) :=
  m.stoneCechContent.measure_eq stoneCechClopens_ring.isSetSemiring rfl
    (stoneCechContent_sigmaSubadditive m) hU

instance LeftInvariantSetMean.stoneCechMeasure_probability (m : LeftInvariantSetMean S) :
    IsProbabilityMeasure m.stoneCechMeasure :=
  ⟨by rw [m.stoneCechMeasure_clopen isClopen_univ, preimage_univ, m.univ, ENNReal.ofReal_one]⟩

omit [Semigroup S] in
theorem stoneCechClopenMeasurable_of_continuous_selfmap (f : Ultrafilter S → Ultrafilter S)
    (hf : Continuous f) : Measurable f :=
  measurable_generateFrom fun _ hU ↦
    MeasurableSpace.measurableSet_generateFrom ((show IsClopen _ from hU).preimage hf)

/-- The Stone–Čech probability is invariant under each principal left translate. -/
theorem LeftInvariantSetMean.stoneCechMeasure_map_principal_left (m : LeftInvariantSetMean S)
    (s : S) : m.stoneCechMeasure.map ((pure s : Ultrafilter S) * ·) = m.stoneCechMeasure := by
  let f : Ultrafilter S → Ultrafilter S := ((pure s : Ultrafilter S) * ·)
  have hf : Continuous f := by
    simpa only [f, pure_mul_as_map] using continuous_ultrafilter_map (s * ·)
  have hm : Measurable f := stoneCechClopenMeasurable_of_continuous_selfmap f hf
  apply Measure.ext_of_generateFrom_of_iUnion {U | IsClopen U} (fun _ ↦ Set.univ) rfl
    stoneCechClopens_ring.isSetSemiring.isPiSystem (Set.iUnion_const Set.univ)
    (fun _ ↦ isClopen_univ)
  · intro _
    rw [Measure.map_apply hm MeasurableSet.univ, preimage_univ, measure_univ]
    exact ENNReal.one_ne_top
  · intro U hU
    rw [Measure.map_apply hm (MeasurableSpace.measurableSet_generateFrom hU),
      m.stoneCechMeasure_clopen ((show IsClopen U from hU).preimage hf),
      m.stoneCechMeasure_clopen hU]
    have h : (pure ⁻¹' (f ⁻¹' U) : Set S) = (s * ·) ⁻¹' (pure ⁻¹' U) := by
      ext t
      simp only [mem_preimage, f, pure_mul_as_map, Ultrafilter.map_pure]
    rw [h, m.invariant]

omit [Semigroup S] in
/-- A continuous real function on a Stone–Čech space is measurable for the σ-algebra
generated by the clopens. -/
theorem stoneCechClopenMeasurable_of_continuous {f : Ultrafilter S → ℝ}
    (hf : Continuous f) : Measurable f := by
  apply measurable_of_Ioi
  intro a
  let U : Set (Ultrafilter S) := f ⁻¹' Ioi a
  let K (n : ℕ) : Set (Ultrafilter S) := f ⁻¹' Ici (a + 1 / (n + 1 : ℝ))
  have hKU (n : ℕ) : K n ⊆ U := fun p hp ↦
    lt_of_lt_of_le (lt_add_of_pos_right a (by positivity)) hp
  have hU : IsOpen U := isOpen_Ioi.preimage hf
  have hK (n : ℕ) : IsClosed (K n) := isClosed_Ici.preimage hf
  have hcover : U = ⋃ n, K n := by
    refine subset_antisymm (fun p hp ↦ ?_) (iUnion_subset hKU)
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.mpr (show a < f p from hp))
    exact mem_iUnion.mpr ⟨n, (lt_sub_iff_add_lt'.mp hn).le⟩
  choose W hW hKW hWU using fun n ↦ exists_clopen_of_closed_subset_open (hK n) hU (hKU n)
  have hWCover : U = ⋃ n, W n :=
    subset_antisymm (hcover ▸ iUnion_mono hKW) (iUnion_subset hWU)
  change MeasurableSet U
  rw [hWCover]
  exact MeasurableSet.iUnion fun n ↦ MeasurableSpace.measurableSet_generateFrom (hW n)

end JdLG
