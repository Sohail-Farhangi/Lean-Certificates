module

public import JdLG.ReversibleOrbitFunctions

/-! # Haar averaging operators into Banach spaces -/

@[expose] public section

open Filter MeasureTheory Set
open scoped ENNReal

namespace JdLG

variable {G 𝕜 E : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [MeasurableSpace G] [BorelSpace G] [RCLike 𝕜]
  [NormedAddCommGroup E] [NormedSpace 𝕜 E] [CompleteSpace E]

omit [CompleteSpace E] in
/-- Multiplying a Haar L² coefficient by a bounded continuous vector function is integrable. -/
theorem integrable_scaleHaarL2 (v : G → E) (hv : Continuous v)
    (C : ℝ) (hC : ∀ g, ‖v g‖ ≤ C) (φ : HaarL2 G 𝕜) :
    Integrable (fun g ↦ φ g • v g) (normalizedHaar G) :=
  ((Lp.memLp (φ : Lp 𝕜 2 (normalizedHaar G))).integrable fact_one_le_two_ennreal.elim).smul_bdd C
    hv.aestronglyMeasurable_of_compactSpace (Eventually.of_forall hC)

/-- Integration of a bounded continuous Banach-valued function against a Haar L²
coefficient, viewed as a bounded linear map of the coefficient. -/
noncomputable def integrateHaarL2 (v : G → E) (hv : Continuous v)
    (C : ℝ) (hC : ∀ g, ‖v g‖ ≤ C) : HaarL2 G 𝕜 →L[𝕜] E := by
  letI : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ 𝕜 E
  letI : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let μ := normalizedHaar G
  let integrate : HaarL2 G 𝕜 →ₗ[𝕜] E :=
    { toFun := fun φ ↦ ∫ g, φ g • v g ∂μ
      map_add' := fun φ ψ ↦ by
        have h : (fun g ↦ (φ + ψ) g • v g) =ᵐ[μ]
            (fun g ↦ φ g • v g + ψ g • v g) := by
          filter_upwards [Lp.coeFn_add φ ψ] with g hg
          change (φ + ψ) g = φ g + ψ g at hg
          rw [hg, add_smul]
        exact (integral_congr_ae h).trans (integral_add
          (integrable_scaleHaarL2 v hv C hC φ) (integrable_scaleHaarL2 v hv C hC ψ))
      map_smul' := fun c φ ↦ by
        have h : (fun g ↦ (c • φ) g • v g) =ᵐ[μ] (fun g ↦ c • (φ g • v g)) := by
          filter_upwards [Lp.coeFn_smul c φ] with g hg
          change (c • φ) g = c • φ g at hg
          rw [hg, smul_assoc]
        exact (integral_congr_ae h).trans (integral_smul c _) }
  refine integrate.mkContinuous C fun φ ↦ ?_
  have hφi : Integrable (fun g ↦ φ g) μ :=
    (Lp.memLp (φ : Lp 𝕜 2 (normalizedHaar G))).integrable fact_one_le_two_ennreal.elim
  have hφ : ∫ g, ‖φ g‖ ∂μ ≤ ‖φ‖ := by
    rw [integral_norm_eq_lintegral_eNorm hφi.aestronglyMeasurable, Lp.norm_def,
      ← eLpNorm_one_eq_lintegral_eNorm hφi.aestronglyMeasurable]
    exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top φ)
      (eLpNorm_le_eLpNorm_of_exponent_le fact_one_le_two_ennreal.elim)
  have hC₀ := (norm_nonneg (v 1)).trans (hC 1)
  calc
    ‖integrate φ‖ ≤ ∫ g, ‖φ g • v g‖ ∂μ := norm_integral_le_integral_norm _
    _ ≤ ∫ g, ‖φ g‖ * C ∂μ := integral_mono
      (integrable_scaleHaarL2 v hv C hC φ).norm (hφi.norm.mul_const C) fun g ↦ by
        rw [norm_smul]
        gcongr
        exact hC g
    _ = (∫ g, ‖φ g‖ ∂μ) * C := integral_mul_const _ _
    _ ≤ C * ‖φ‖ := (mul_le_mul_of_nonneg_right hφ hC₀).trans_eq (mul_comm _ _)

section Equivariance

variable (ρ : G →* (E →L[𝕜] E)) (hρ : ∀ x, Continuous fun g ↦ ρ g x)
  (C : ℝ) (hC : ∀ g, ‖ρ g‖ ≤ C)

/-- The Haar convolution map generated by one vector. -/
noncomputable def orbitConvolution (x : E) : HaarL2 G 𝕜 →L[𝕜] E :=
  integrateHaarL2 (fun g ↦ ρ g⁻¹ x) ((hρ x).comp continuous_inv) (C * ‖x‖)
    (fun g ↦ (ρ g⁻¹).le_of_opNorm_le (hC _) _)

/-- Right translation of the Haar L² weight intertwines convolution with the given action. -/
theorem orbitConvolution_intertwines (x : E) (g : G) (φ : HaarL2 G 𝕜) :
    orbitConvolution ρ hρ C hC x (haarRightTranslation (𝕜 := 𝕜) g φ) =
      ρ g (orbitConvolution ρ hρ C hC x φ) := by
  let : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ 𝕜 E
  let : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let μ := normalizedHaar G
  let v : G → E := fun t ↦ ρ t⁻¹ x
  have hi := integrable_scaleHaarL2 v ((hρ x).comp continuous_inv) (C * ‖x‖)
    (fun t ↦ (ρ t⁻¹).le_of_opNorm_le (hC _) _) φ
  change (∫ t, haarRightTranslation (𝕜 := 𝕜) g φ t • v t ∂μ) =
    ρ g (∫ t, φ t • v t ∂μ)
  calc
    _ = ∫ t, φ (t * g) • v t ∂μ :=
      integral_congr_ae ((haarRightTranslation_coeFn (𝕜 := 𝕜) g φ).mono fun t ht ↦
        congrArg (· • v t) ht)
    _ = ∫ t, ρ g (φ (t * g) • v (t * g)) ∂μ := by
      apply integral_congr_ae
      refine Eventually.of_forall fun t ↦ ?_
      change φ (t * g) • v t = ρ g (φ (t * g) • v (t * g))
      rw [map_smul]
      congr 1
      change ρ t⁻¹ x = ρ g (ρ (t * g)⁻¹ x)
      rw [← mul_apply_eq_comp, ← map_mul, mul_inv_rev, ← mul_assoc, mul_inv_cancel, one_mul]
    _ = ∫ t, ρ g (φ t • v t) ∂μ :=
      integral_mul_right_eq_self (μ := μ) (fun t ↦ ρ g (φ t • v t)) g
    _ = _ := (ρ g).integral_comp_comm hi

/-- Every vector is approximated by convolutions of that vector with Haar L²
weights. The weights are normalized indicators of small identity neighborhoods. -/
theorem exists_orbitConvolution_close (x : E) (ε : ℝ) (hε : 0 < ε) :
    ∃ φ : HaarL2 G 𝕜, ‖orbitConvolution ρ hρ C hC x φ - x‖ < ε := by
  let : NormedSpace ℝ E := NormedSpace.restrictScalars ℝ 𝕜 E
  let : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let μ := normalizedHaar G
  let v : G → E := fun t ↦ ρ t⁻¹ x
  have hv : Continuous v := (hρ x).comp continuous_inv
  let s := v ⁻¹' Metric.ball x (ε / 2)
  have hso : IsOpen s := Metric.isOpen_ball.preimage hv
  have hs1 : 1 ∈ s := by
    change v 1 ∈ Metric.ball x (ε / 2)
    have h : v 1 = x := by dsimp [v]; rw [inv_one, map_one]; rfl
    rw [h]
    exact Metric.mem_ball_self (by positivity)
  have hsμ : μ s ≠ ∞ := measure_ne_top μ s
  have hc : 0 < μ.real s := lt_of_le_of_ne measureReal_nonneg
    ((measureReal_ne_zero_iff hsμ).2 (hso.measure_pos μ ⟨1, hs1⟩).ne').symm
  let φ₀ : HaarL2 G 𝕜 := indicatorConstLp 2 hso.measurableSet hsμ 1
  let φ : HaarL2 G 𝕜 := (μ.real s)⁻¹ • φ₀
  have huv : (fun g ↦ φ g • v g) =ᵐ[μ] fun g ↦ (μ.real s)⁻¹ • s.indicator v g := by
    filter_upwards [Lp.coeFn_smul (μ.real s)⁻¹ φ₀,
      indicatorConstLp_coeFn (p := 2) (μ := μ) (hs := hso.measurableSet) (hμs := hsμ)
        (c := (1 : 𝕜))] with g hg hi
    change φ g = (μ.real s)⁻¹ • φ₀ g at hg
    change φ₀ g = s.indicator (fun _ ↦ (1 : 𝕜)) g at hi
    by_cases hgs : g ∈ s
    · rw [hg, hi, indicator_of_mem hgs, indicator_of_mem hgs, smul_assoc, one_smul]
    · rw [hg, hi, indicator_of_notMem hgs, indicator_of_notMem hgs, smul_zero, zero_smul,
        smul_zero]
  have havg : orbitConvolution ρ hρ C hC x φ = (μ.real s)⁻¹ • ∫ g in s, v g ∂μ := by
    change (∫ g, φ g • v g ∂μ) = _
    rw [integral_congr_ae huv, integral_smul, integral_indicator hso.measurableSet]
  have hvi : IntegrableOn v s μ :=
    (hv.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)).integrableOn
  have hconst : ∫ _ in s, x ∂μ = μ.real s • x := by
    rw [integral_const, measureReal_restrict_apply_univ]
  have hclose (t : G) (ht : t ∈ s) : ‖v t - x‖ ≤ ε / 2 := by
    simpa only [dist_eq_norm] using (show dist (v t) x < ε / 2 from ht).le
  have hnorm := norm_setIntegral_le_of_norm_le_const (lt_top_iff_ne_top.2 hsμ) hclose
  have heq : orbitConvolution ρ hρ C hC x φ - x =
      (μ.real s)⁻¹ • (∫ t in s, (v t - x) ∂μ) := by
    rw [havg, integral_sub hvi (integrableOn_const hsμ), hconst, smul_sub, ← mul_smul,
      inv_mul_cancel₀ hc.ne', one_smul]
  refine ⟨φ, ?_⟩
  rw [heq, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hc.le)]
  calc
    (μ.real s)⁻¹ * ‖∫ t in s, (v t - x) ∂μ‖ ≤ (μ.real s)⁻¹ * (μ.real s * (ε / 2)) :=
      mul_le_mul_of_nonneg_left (hnorm.trans_eq (mul_comm _ _)) (inv_nonneg.mpr hc.le)
    _ = ε / 2 := by rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul]
    _ < ε := by linarith


end Equivariance

end JdLG
