module

public import JdLG.FolnerCriteria
public import Mathlib.Topology.Order.LiminfLimsup
public import Mathlib.Topology.Ultrafilter

/-!
# Invariant means generated by Følner averages

A limit along an ultrafilter extending the averaging filter is a positive
normalized linear functional on real L∞. Nonsingularity allows each
translation test to use a bounded measurable representative. The same
construction realizes the upper and lower density of a fixed measurable
set along the averaging net as values of invariant means.
-/

@[expose] public section

open Filter Function MeasureTheory Set
open scoped ENNReal Topology

namespace JdLG

variable {S I : Type*} [MeasurableSpace S] {μ : Measure S}

private theorem exists_ae_norm_bound {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ C : ℝ, 0 < C ∧ ∀ᵐ s ∂μ, ‖f s‖ ≤ C := by
  refine ⟨max 1 (eLpNorm f ∞ μ).toReal, zero_lt_one.trans_le (le_max_left ..), ?_⟩
  filter_upwards [eNorm_ae_le_eLpNormEssSup f μ] with s hs
  rw [← eLpNorm_exponent_top hf.aestronglyMeasurable] at hs
  exact (by simpa using (ENNReal.toReal_mono hf.eLpNorm_ne_top hs).trans (le_max_right ..))

private theorem memLp_top_integrable_of_ac {f : S → ℝ} (hf : MemLp f ∞ μ)
    {ν : Measure S} [IsFiniteMeasure ν] (hac : ν ≪ μ) : Integrable f ν := by
  obtain ⟨C, _, hb⟩ := exists_ae_norm_bound hf
  exact (integrable_const C).mono' (hf.aestronglyMeasurable.mono_ac hac)
    (hb.filter_mono hac.ae_le)

private theorem exists_integral_limit (ν : I → Measure S)
    (hp : ∀ i, IsProbabilityMeasure (ν i)) (hac : ∀ i, ν i ≪ μ)
    (q : Ultrafilter I) {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ a : ℝ, Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 a) := by
  obtain ⟨C, _, hC⟩ := exists_ae_norm_bound hf
  have hb (i : I) : ‖∫ s, f s ∂ν i‖ ≤ C := by
    let : IsProbabilityMeasure (ν i) := hp i
    simpa only [probReal_univ, mul_one] using
      norm_integral_le_of_norm_le_const (hC.filter_mono (hac i).ae_le)
  have hmem : Metric.closedBall (0 : ℝ) C ∈ q.map (fun i ↦ ∫ s, f s ∂ν i) := by
    change ∀ᶠ i in (q : Filter I), (∫ s, f s ∂ν i) ∈ Metric.closedBall 0 C
    exact Eventually.of_forall fun i ↦ by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hb i
  obtain ⟨a, _, ha⟩ := (isCompact_closedBall (0 : ℝ) C).ultrafilter_le_nhds' _ hmem
  exact ⟨a, ha⟩

/-- Taking an ultrafilter limit of probability integrals defines a genuine
mean on L∞ of the base measure, provided the probabilities are absolutely
continuous with respect to that measure. -/
theorem exists_measuredMean_of_probability_ultrafilter (ν : I → Measure S)
    (hp : ∀ i, IsProbabilityMeasure (ν i)) (hac : ∀ i, ν i ≪ μ) (q : Ultrafilter I) :
    ∃ m : MeasuredMean μ, ∀ (f : S → ℝ) (hf : MemLp f ∞ μ),
      Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (m.value f hf)) := by
  let a := fun f : Lp ℝ ∞ μ ↦ (exists_integral_limit ν hp hac q (Lp.memLp f)).choose
  have ha (f : Lp ℝ ∞ μ) : Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (a f)) :=
    (exists_integral_limit ν hp hac q (Lp.memLp f)).choose_spec
  have hInt (i : I) (f : Lp ℝ ∞ μ) : Integrable (⇑f) (ν i) := by
    let : IsProbabilityMeasure (ν i) := hp i
    exact memLp_top_integrable_of_ac (Lp.memLp f) (hac i)
  let Φ : Lp ℝ ∞ μ →ₗ[ℝ] ℝ :=
    { toFun := a
      map_add' f g := by
        apply tendsto_nhds_unique (ha (f + g))
        apply ((ha f).add (ha g)).congr'
        exact Eventually.of_forall fun i ↦ by
          change (∫ s, f s ∂ν i) + (∫ s, g s ∂ν i) = ∫ s, (f + g) s ∂ν i
          rw [integral_congr_ae ((Lp.coeFn_add f g).filter_mono (hac i).ae_le)]
          exact (integral_add (hInt i f) (hInt i g)).symm
      map_smul' c f := by
        change a (c • f) = c * a f
        apply tendsto_nhds_unique (ha (c • f))
        apply ((ha f).const_mul c).congr'
        exact Eventually.of_forall fun i ↦ by
          change c * (∫ s, f s ∂ν i) = ∫ s, (c • f) s ∂ν i
          rw [integral_congr_ae ((Lp.coeFn_smul c f).filter_mono (hac i).ae_le)]
          exact (integral_const_mul c (⇑f)).symm }
  let m : MeasuredMean μ :=
    { functional := Φ
      monotone' f g h := by
        apply le_of_tendsto_of_tendsto' (ha f) (ha g)
        exact fun i ↦ integral_mono_ae (hInt i f) (hInt i g) (h.filter_mono (hac i).ae_le)
      unit' := by
        let z := (memLp_top_constant (μ := μ) 1).toLp (fun _ ↦ 1)
        change a z = 1
        apply tendsto_nhds_unique (ha z)
        apply (tendsto_const_nhds (x := (1 : ℝ))).congr'
        exact Eventually.of_forall fun i ↦ by
          let : IsProbabilityMeasure (ν i) := hp i
          exact (integral_eq_const ((MemLp.coeFn_toLp (memLp_top_constant 1)).filter_mono
            (hac i).ae_le)).symm }
  refine ⟨m, fun f hf ↦ (ha (hf.toLp f)).congr' ?_⟩
  exact Eventually.of_forall fun i ↦ integral_congr_ae (hf.coeFn_toLp.filter_mono (hac i).ae_le)

/-- Nonsingular composition preserves essential boundedness and the
almost-everywhere class of the translated representative. -/
theorem memLp_top_comp_nonsingular {f : S → ℝ} (hf : MemLp f ∞ μ)
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ) : MemLp (f ∘ t) ∞ μ := by
  obtain ⟨C, _, hb⟩ := exists_ae_norm_bound hf
  exact memLp_top_of_bound (hf.aestronglyMeasurable.comp_quasiMeasurePreserving ht) C (ht.ae hb)

private theorem exists_measurable_bounded_representative {f : S → ℝ} (hf : MemLp f ∞ μ) :
    ∃ g : S → ℝ, Measurable g ∧ f =ᵐ[μ] g ∧ ∃ C : ℝ, 0 < C ∧ ∀ s, ‖g s‖ ≤ C := by
  classical
  obtain ⟨C, hC, hb⟩ := exists_ae_norm_bound hf
  let h := hf.aestronglyMeasurable.aemeasurable
  let g (s : S) := min (max (-C) (h.mk f s)) C
  have hm : Measurable g := (measurable_const.max h.measurable_mk).min measurable_const
  refine ⟨g, hm, ?_, C, hC, ?_⟩
  · filter_upwards [hb, h.ae_eq_mk] with s hs he
    rw [Real.norm_eq_abs, abs_le] at hs
    show f s = g s
    dsimp only [g]
    rw [← he, max_eq_right hs.1, min_eq_left hs.2]
  · intro s
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨le_min (le_max_left ..) (by linarith), min_le_right ..⟩

/-- The total-variation defect against measurable tests of norm at most one
also bounds the asymptotic defect against any essentially bounded function,
when the underlying translation is nonsingular. -/
theorem tendsto_integral_translate_defect_of_nonsingular
    (ν : I → Measure S) (hac : ∀ i, ν i ≪ μ) {l : Filter I}
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ)
    (h : ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g → (∀ s, ‖g s‖ ≤ 1) →
      ‖(∫ s, g (t s) ∂ν i) - ∫ s, g s ∂ν i‖ < ε)
    {f : S → ℝ} (hf : MemLp f ∞ μ) :
    Tendsto (fun i ↦ (∫ s, f (t s) ∂ν i) - ∫ s, f s ∂ν i) l (𝓝 0) := by
  obtain ⟨g, hgm, hfg, C, hC, hb⟩ := exists_measurable_bounded_representative hf
  have hpre : ∀ s, ‖g s / C‖ ≤ 1 := by
    intro s
    simpa only [norm_div, Real.norm_of_nonneg hC.le, div_le_iff₀ hC, one_mul] using hb s
  refine Metric.tendsto_nhds.2 fun ε hε ↦ ?_
  filter_upwards [h (ε / C) (div_pos hε hC)] with i hi
  have htfg := (ht.ae_eq_comp hfg).filter_mono (hac i).ae_le
  have hg := hi (fun s ↦ g s / C) (hgm.div_const C) hpre
  rw [integral_div, integral_div, ← sub_div, norm_div, Real.norm_of_nonneg hC.le,
    div_lt_div_iff_of_pos_right hC] at hg
  rw [dist_zero_right, integral_congr_ae (hfg.filter_mono (hac i).ae_le)]
  have he : (∫ s, f (t s) ∂ν i) = ∫ s, g (t s) ∂ν i := integral_congr_ae htfg
  rwa [he]

/-- A mean is generated by a net of probabilities if some ultrafilter
extending its index filter gives simultaneous convergence on all L∞ tests. -/
def MeasuredMean.IsGeneratedBy (m : MeasuredMean μ) (ν : I → Measure S) (l : Filter I) : Prop :=
  ∃ q : Ultrafilter I, (q : Filter I) ≤ l ∧ ∀ (f : S → ℝ) (hf : MemLp f ∞ μ),
    Tendsto (fun i ↦ ∫ s, f s ∂ν i) (q : Filter I) (𝓝 (m.value f hf))

theorem MeasuredMean.IsGeneratedBy.translate_value {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    {t : S → S} (ht : QuasiMeasurePreserving t μ μ)
    (h : ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g → (∀ s, ‖g s‖ ≤ 1) →
      ‖(∫ s, g (t s) ∂ν i) - ∫ s, g s ∂ν i‖ < ε)
    {f : S → ℝ} (hf : MemLp f ∞ μ) (hft : MemLp (f ∘ t) ∞ μ) :
    m.value (f ∘ t) hft = m.value f hf := by
  obtain ⟨q, hq, hlim⟩ := hm
  have hdiff := (tendsto_integral_translate_defect_of_nonsingular ν hac ht h hf).mono_left hq
  exact sub_eq_zero.1 (tendsto_nhds_unique ((hlim _ hft).sub (hlim _ hf)) hdiff)

variable [Semigroup S]

/-- Right-translation analogue of the left Følner probability condition. -/
def RightFolnerProbabilities (ν : I → Measure S) (l : Filter I) : Prop :=
  ∀ s : S, ∀ ε > 0, ∀ᶠ i in l, ∀ g : S → ℝ, Measurable g →
    (∀ t, ‖g t‖ ≤ 1) → ‖(∫ t, g (t * s) ∂ν i) - ∫ t, g t ∂ν i‖ < ε

/-- Every measured mean generated by a left Følner net is left invariant. -/
theorem MeasuredMean.IsGeneratedBy.leftInvariant {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ) (hν : LeftFolnerProbabilities ν l) :
    m.IsLeftInvariant := by
  intro s f hf hft
  exact hm.translate_value hac (hns s) (hν s) hf hft

/-- Every measured mean generated by a right Følner net is right invariant. -/
theorem MeasuredMean.IsGeneratedBy.rightInvariant {m : MeasuredMean μ}
    {ν : I → Measure S} {l : Filter I} (hm : m.IsGeneratedBy ν l) (hac : ∀ i, ν i ≪ μ)
    (hns : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ) (hν : RightFolnerProbabilities ν l) :
    m.IsRightInvariant := by
  intro s f hf hft
  exact hm.translate_value hac (hns s) (hν s) hf hft

omit [Semigroup S] in
/-- Normalized restrictions are absolutely continuous with respect to the underlying measure. -/
theorem normalizedRestrictedMeasure_absolutelyContinuous (μ : Measure S) (F : Set S) :
    normalizedRestrictedMeasure μ F ≪ μ :=
  Measure.smul_absolutelyContinuous.trans Measure.absolutelyContinuous_restrict

omit [Semigroup S] in
/-- Integration against the normalized restriction is the normalized
block integral used to generate a mean in Section 2.3. -/
theorem normalizedRestrictedMeasure_integral_eq_div (μ : Measure S)
    (F : Set S) (f : S → ℝ) :
    (∫ s, f s ∂normalizedRestrictedMeasure μ F) = (∫ s in F, f s ∂μ) / μ.real F := by
  rw [normalizedRestrictedMeasure, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul,
    div_eq_mul_inv, Measure.real, mul_comm]

/-- The normalized restrictions of a left Følner net of blocks of positive,
finite measure generate left-invariant means on L∞ of the measured semigroup. -/
theorem exists_measuredLeftInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hν : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨q, hq⟩ := Filter.exists_ultrafilter_le l
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter
    (fun i ↦ normalizedRestrictedMeasure μ (F i))
    (fun i ↦ normalizedRestrictedMeasure_probability μ (hpos i) (hfin i))
    (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i)) q
  have hgen : m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := ⟨q, hq, hm⟩
  exact ⟨m, hgen.leftInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i))
    hns hν, hgen⟩

/-- Right Følner blocks likewise generate right-invariant means. -/
theorem exists_measuredRightInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hns : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ)
    (hν : RightFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsRightInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨q, hq⟩ := Filter.exists_ultrafilter_le l
  obtain ⟨m, hm⟩ := exists_measuredMean_of_probability_ultrafilter
    (fun i ↦ normalizedRestrictedMeasure μ (F i))
    (fun i ↦ normalizedRestrictedMeasure_probability μ (hpos i) (hfin i))
    (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ (F i)) q
  have hgen : m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := ⟨q, hq, hm⟩
  exact ⟨m, hgen.rightInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ
    (F i)) hns hν, hgen⟩

/-- The same limit is bi-invariant when the blocks are two-sided Følner
and both translations preserve null sets under preimages. -/
theorem exists_measuredBiInvariantMean_of_folnerBlocks (μ : Measure S)
    (F : I → Set S) (hpos : ∀ i, μ (F i) ≠ 0) (hfin : ∀ i, μ (F i) ≠ ∞)
    {l : Filter I} [NeBot l] (hL : ∀ s : S, QuasiMeasurePreserving (s * ·) μ μ)
    (hR : ∀ s : S, QuasiMeasurePreserving (· * s) μ μ)
    (hl : LeftFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l)
    (hr : RightFolnerProbabilities (fun i ↦ normalizedRestrictedMeasure μ (F i)) l) :
    ∃ m : MeasuredMean μ, m.IsLeftInvariant ∧ m.IsRightInvariant ∧
      m.IsGeneratedBy (fun i ↦ normalizedRestrictedMeasure μ (F i)) l := by
  obtain ⟨m, hm, hg⟩ := exists_measuredLeftInvariantMean_of_folnerBlocks μ F hpos hfin hL hl
  exact ⟨m, hm, hg.rightInvariant (fun i ↦ normalizedRestrictedMeasure_absolutelyContinuous μ
    (F i)) hR hr, hg⟩

end JdLG
