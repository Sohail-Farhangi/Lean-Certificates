module

public import JdLG.MonotheticL1Modulus

/-! # The semigroup generated by one operator -/

@[expose] public section

namespace JdLG

open MeasureTheory Set
open scoped ENNReal

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

/-- The inclusion of the subsemigroup algebraically generated by T. -/
noncomputable def generatedLpOne (T : Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ) :
    Subsemigroup.closure ({T} : Set (Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ)) →ₙ*
      (Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ) :=
  MulMemClass.subtype _

theorem admissible_generatedLpOne
    (T : Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ)
    (hT : IsJdLGAdmissible (monotheticLpOne T)) : IsJdLGAdmissible (generatedLpOne T) := by
  let U := Subsemigroup.closure ({T} : Set (Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ))
  let : Nonempty U := ⟨⟨T, Subsemigroup.subset_closure (mem_singleton T)⟩⟩
  have hsubset : U ≤ (monotheticLpOne T).srange :=
    (Subsemigroup.closure_singleton_le_iff_mem _ _).2
      (MulHom.mem_srange.2 ⟨Multiplicative.ofAdd 1, by
        change T ^ 1 = T
        exact pow_one T⟩)
  have hrange (s : U) : ∃ n, monotheticLpOne T n = (generatedLpOne T) s :=
    MulHom.mem_srange.1 (hsubset s.property)
  apply admissible_of_commutative
  · exact hT.1.of_isClosed_subset isClosed_closure (closure_mono (by
      rintro _ ⟨s, rfl⟩
      obtain ⟨n, hn⟩ := hrange s
      exact ⟨n, congrArg ContinuousLinearMapWOT.ofCLM hn⟩))
  · intro s t
    obtain ⟨m, hm⟩ := hrange s
    obtain ⟨n, hn⟩ := hrange t
    rw [← hm, ← hn, ← map_mul, ← map_mul, mul_comm]

variable [IsFiniteMeasure μ]

/-- Theorem 1.2, Remark 2, stated for the subsemigroup generated by T. -/
theorem admissible_generatedLpOne_of_meanErgodicModulus
    (T : Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ) (hT : ‖T‖ ≤ 1)
    (P : Lp ℝ 1 μ →L[ℝ] Lp ℝ 1 μ) (hP : ‖P‖ ≤ 1)
    (pPos : ∀ f : Lp ℝ 1 μ, 0 ≤ f → 0 ≤ P f)
    (hdom : ∀ f, lpOneModulus (T f) ≤ P (lpOneModulus f))
    (hmean : ∀ f, ∃ h, Filter.Tendsto (lpOneCesaro P f) Filter.atTop (nhds h)) :
    IsJdLGAdmissible (generatedLpOne T) :=
  admissible_generatedLpOne T
    (admissible_monotheticLpOne_of_meanErgodicModulus T hT P hP pPos hdom hmean)

/-- The Dunford–Schwartz instance of Theorem 1.2, Remark 2. -/
theorem admissible_generatedLpOne_of_dunfordSchwartz
    (T : Lp ℂ 1 μ →L[ℂ] Lp ℂ 1 μ) (hT : ‖T‖ ≤ 1)
    (hbound : ∀ (f : Lp ℂ 1 μ) (C : ℝ), (∀ᵐ x ∂μ, ‖f x‖ ≤ C) →
      ∀ᵐ x ∂μ, ‖T f x‖ ≤ C) : IsJdLGAdmissible (generatedLpOne T) :=
  admissible_generatedLpOne T (admissible_monotheticLpOne_of_dunfordSchwartz T hT hbound)

end JdLG

